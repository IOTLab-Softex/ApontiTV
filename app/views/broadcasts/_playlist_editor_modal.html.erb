<div class="broadcast-publish-modal broadcast-playlist-editor-modal" data-playlist-editor-modal hidden>
  <div class="broadcast-publish-modal__backdrop" data-playlist-editor-close></div>
  <div class="broadcast-publish-modal__dialog broadcast-playlist-editor-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="playlist-editor-title">
    <div class="broadcast-publish-modal__header broadcast-playlist-editor__header">
      <div class="broadcast-playlist-editor__title">
        <span class="broadcast-playlist-editor__mark"><i class="fas fa-film" aria-hidden="true"></i></span>
        <div>
          <strong id="playlist-editor-title" data-playlist-editor-title><%= I18n.t("CreatePlaylist") %></strong>
          <p><%= I18n.t("PlaylistEditorDescription") %></p>
        </div>
      </div>
      <button type="button" class="broadcast-playlist-icon-btn" data-playlist-editor-close aria-label="<%= I18n.t("Close") %>" title="<%= I18n.t("Close") %>">
        <i class="fas fa-times" aria-hidden="true"></i>
      </button>
    </div>

    <form class="broadcast-playlist-editor" data-playlist-editor-form>
      <input type="hidden" name="id" data-playlist-editor-id>
      <div class="broadcast-publish-modal__body">
        <section class="broadcast-publish-section broadcast-playlist-editor__settings">
          <h3><i class="fas fa-sliders-h" aria-hidden="true"></i> <%= I18n.t("PlaylistSettings") %></h3>
          <div class="broadcast-playlist-editor__settings-grid">
            <label class="broadcast-playlist-field">
              <span><%= I18n.t("PlaylistName") %></span>
              <div class="broadcast-playlist-input-wrap">
                <i class="far fa-file-video" aria-hidden="true"></i>
                <input type="text" name="name" data-playlist-name value="<%= I18n.t("NewPlaylist") %>" required>
              </div>
            </label>
            <label class="broadcast-playlist-field" data-playlist-timing-settings>
              <span><%= I18n.t("ImageDuration") %></span>
              <div class="broadcast-playlist-input-wrap">
                <input type="number" name="image_duration_seconds" data-playlist-image-duration value="10" min="3" max="3600" step="1">
                <small>seg</small>
              </div>
            </label>
            <label class="broadcast-playlist-field" data-playlist-timing-settings>
              <span><%= I18n.t("WhenVideoStarts") %></span>
              <select name="video_duration_mode" data-playlist-video-duration-mode>
                <option value="image_duration"><%= I18n.t("ObeyImageDuration") %></option>
                <option value="video_end"><%= I18n.t("WaitVideoEnd") %></option>
              </select>
            </label>
            <label class="broadcast-playlist-field" data-playlist-timing-settings>
              <span><%= I18n.t("TransitionEffect") %></span>
              <select name="transition_style" data-playlist-transition-style>
                <option value="fade">Fade</option>
                <option value="slide">Slide</option>
                <option value="blur">Blur</option>
                <option value="zoom">Zoom</option>
                <option value="wipe">Wipe vertical</option>
                <option value="push">Push lateral</option>
                <option value="flip">Flip</option>
                <option value="cross_zoom">Cross zoom</option>
                <option value="aponti_smooth">Aponti Smooth</option>
                <option value="none">Sem efeito</option>
              </select>
            </label>
            <label class="broadcast-playlist-field" data-playlist-timing-settings>
              <span><%= I18n.t("TransitionDuration") %></span>
              <div class="broadcast-playlist-input-wrap">
                <input type="number" name="transition_duration_ms" data-playlist-transition-duration value="600" min="0" max="10000" step="100">
                <small>ms</small>
              </div>
            </label>
          </div>
        </section>

        <section class="broadcast-publish-section broadcast-playlist-editor__library-section">
          <div class="broadcast-publish-section__title">
            <h3><i class="fas fa-folder-open" aria-hidden="true"></i> <%= I18n.t("Library") %></h3>
            <div class="broadcast-publish-section__actions">
              <%= link_to new_video_editor_path, class: "broadcast-playlist-icon-btn", title: I18n.t("CreateVideo"), aria: { label: I18n.t("CreateVideo") } do %>
                <i class="fas fa-video" aria-hidden="true"></i>
              <% end %>
              <label class="broadcast-playlist-icon-btn broadcast-publish-upload-control" title="<%= I18n.t("UploadMedia") %>" aria-label="<%= I18n.t("UploadMedia") %>">
                <i class="fas fa-upload" aria-hidden="true"></i>
                <%= file_field_tag "playlist_media_files[]", accept: "video/*,image/*", multiple: true, data: { playlist_upload: true } %>
              </label>
              <button type="button" class="broadcast-playlist-icon-btn" data-playlist-clear-items title="<%= I18n.t("ClearSelection") %>" aria-label="<%= I18n.t("ClearSelection") %>">
                <i class="fas fa-trash-alt" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <div class="broadcast-playlist-editor__tabs" role="tablist" aria-label="<%= I18n.t("PlaylistItems") %>">
            <button type="button" class="broadcast-playlist-editor__tab is-active" data-playlist-library-tab="library" role="tab" aria-selected="true">
              <i class="fas fa-folder-open" aria-hidden="true"></i>
              <span><%= I18n.t("Library") %></span>
            </button>
            <button type="button" class="broadcast-playlist-editor__tab" data-playlist-library-tab="selected" role="tab" aria-selected="false">
              <i class="fas fa-check-circle" aria-hidden="true"></i>
              <span><%= I18n.t("SelectedItems") %></span>
              <small data-playlist-selected-count>0</small>
            </button>
          </div>
          <div class="broadcast-publish-library broadcast-publish-library--selected" data-playlist-library-panel="selected" data-playlist-selected-library hidden>
            <div class="broadcast-playlist-order__empty">
              <i class="far fa-file-video" aria-hidden="true"></i>
              <strong><%= I18n.t("PlaylistEmpty") %></strong>
              <span><%= I18n.t("SelectLibraryItemsToStart") %></span>
            </div>
          </div>
          <div class="broadcast-publish-library" data-playlist-library>
            <% @video_library_blobs.each do |blob| %>
              <% media_type = blob.content_type.to_s.start_with?("image/") ? I18n.t("Image") : I18n.t("Video") %>
              <% thumbnail_url = media_library_thumbnail_path(blob, v: blob.checksum.presence || blob.created_at.to_i) %>
              <label class="broadcast-publish-video" data-library-blob-id="<%= blob.id %>">
                <%= check_box_tag "playlist_media_blob_ids[]", blob.id, false, data: { playlist_media_choice: true } %>
                <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
                  <%= image_tag "data:image/gif;base64,R0lGODlhAQABAAAAACw=", alt: blob.filename.to_s, loading: "lazy", decoding: "async", data: { lazy_preview: true, preview_src: thumbnail_url } %>
                  <i class="fas fa-eye" aria-hidden="true"></i>
                </span>
                <span>
                  <strong><%= blob.filename.to_s %></strong>
                  <small><%= media_type %> - <%= number_to_human_size(blob.byte_size) %> - <%= blob.created_at.strftime("%d/%m/%Y %H:%M") %></small>
                </span>
                <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
              </label>
            <% end %>
          </div>
          <p class="broadcast-playlist-editor__count"><%= I18n.t("ShowingItems", count: @video_library_blobs.size) %></p>
        </section>

        <section class="broadcast-publish-section broadcast-playlist-editor__order-section">
          <div class="broadcast-publish-section__title">
            <h3><i class="fas fa-list-ul" aria-hidden="true"></i> <%= I18n.t("PlaylistOrder") %></h3>
            <span class="broadcast-playlist-editor__pill" data-playlist-order-count><%= I18n.t("ItemsCount", count: 0) %></span>
          </div>
          <div class="broadcast-playlist-order" data-playlist-order>
            <div class="broadcast-playlist-order__empty" data-playlist-order-empty>
              <i class="far fa-file-video" aria-hidden="true"></i>
              <strong><%= I18n.t("PlaylistEmpty") %></strong>
              <span><%= I18n.t("SelectLibraryItemsToStart") %></span>
            </div>
          </div>
          <button type="button" class="broadcast-playlist-clear-order" data-playlist-clear-items title="<%= I18n.t("ClearOrder") %>">
            <i class="fas fa-trash-alt" aria-hidden="true"></i>
            <span><%= I18n.t("ClearOrder") %></span>
          </button>
        </section>
      </div>

      <div class="broadcast-publish-modal__footer">
        <button type="button" class="broadcast-preview-modal__close" data-playlist-editor-close><%= I18n.t("Cancel") %></button>
        <button type="submit" class="broadcasts-toolbar__btn broadcasts-toolbar__btn--primary">
          <i class="fas fa-save" aria-hidden="true"></i>
          <span><%= I18n.t("SavePlaylist") %></span>
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  .broadcast-publish-modal[hidden] { display: none; }
  .broadcast-publish-modal {
    position: fixed;
    inset: 0;
    z-index: 1400;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .broadcast-publish-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 6, 23, .72);
    backdrop-filter: blur(10px);
  }
  .broadcast-publish-modal__dialog {
    position: relative;
    width: min(980px, 100%);
    max-height: min(92vh, 900px);
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .22);
    border-radius: 16px;
    background: radial-gradient(circle at 20% 0%, rgba(127, 56, 230, .14), transparent 280px), #0d1426;
    color: #f8fbff;
    box-shadow: 0 28px 90px rgba(0, 0, 0, .5);
  }
  .broadcast-playlist-editor-modal__dialog { width: min(1420px, calc(100vw - 28px)); }
  .broadcast-playlist-editor-modal__dialog {
    height: min(92vh, 900px);
    max-height: min(92vh, 900px);
    display: flex;
    flex-direction: column;
  }
  .broadcast-playlist-editor {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .broadcast-publish-modal__header,
  .broadcast-publish-modal__footer {
    position: sticky;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(148, 163, 184, .16);
    background: rgba(13, 20, 38, .96);
    backdrop-filter: blur(12px);
  }
  .broadcast-publish-modal__header { top: 0; }
  .broadcast-publish-modal__footer {
    bottom: 0;
    border-top: 1px solid rgba(148, 163, 184, .16);
    border-bottom: 0;
    justify-content: space-between;
    position: relative;
    flex: 0 0 auto;
  }
  .broadcast-playlist-editor__title {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .broadcast-playlist-editor__mark {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 24px;
    background: linear-gradient(135deg, #b92cff, #6b4dff);
    box-shadow: 0 18px 36px rgba(139, 47, 242, .26);
  }
  .broadcast-publish-modal__header strong {
    display: block;
    font-size: 22px;
  }
  .broadcast-publish-modal__header p {
    margin: 8px 0 0;
    color: #a8b4ce;
    font-size: 14px;
  }
  .broadcast-publish-modal__body {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(320px, .9fr);
    gap: 16px;
    padding: 18px 24px;
    flex: 1 1 auto;
    min-height: 0;
    max-height: none;
    overflow-y: auto;
    overflow-x: hidden;
    padding-bottom: 24px;
  }
  .broadcast-publish-section {
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 12px;
    background: rgba(15, 23, 42, .42);
    padding: 18px;
  }
  .broadcast-publish-section h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #ffffff;
    font-size: 16px;
  }
  .broadcast-publish-section h3 i { color: #a855f7; }
  .broadcast-publish-section__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .broadcast-publish-section__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
  }
  .broadcast-playlist-icon-btn {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(148, 163, 184, .2);
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, .62);
    color: #f8fbff;
    cursor: pointer;
    text-decoration: none;
  }
  .broadcast-playlist-icon-btn:hover {
    border-color: rgba(168, 85, 247, .65);
    background: rgba(139, 47, 242, .28);
  }
  .broadcast-playlist-editor__tabs {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    padding: 5px;
    border: 1px solid rgba(148, 163, 184, .16);
    border-radius: 12px;
    background: rgba(15, 23, 42, .46);
  }
  .broadcast-playlist-editor__tab {
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    color: #a8b4ce;
    font-weight: 800;
    cursor: pointer;
    transition: background .18s ease, color .18s ease, transform .18s ease;
  }
  .broadcast-playlist-editor__tab:hover {
    color: #ffffff;
    background: rgba(139, 47, 242, .13);
  }
  .broadcast-playlist-editor__tab.is-active {
    color: #ffffff;
    background: rgba(139, 47, 242, .9);
  }
  .broadcast-playlist-editor__tab small {
    min-width: 22px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, .16);
    color: currentColor;
    font-size: 12px;
  }
  [data-playlist-editor-panel] {
    grid-column: 1 / -1;
  }
  [data-playlist-editor-panel][hidden] {
    display: none !important;
  }
  [data-playlist-library-panel][hidden],
  .broadcast-publish-library[hidden] {
    display: none !important;
  }
  .broadcast-publish-library--selected {
    min-height: 250px;
  }
  .broadcast-publish-video--selected {
    grid-template-columns: 34px 64px minmax(0, 1fr);
  }
  .broadcast-playlist-selected-remove {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    border: 1px solid rgba(248, 113, 113, .38);
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, rgba(127, 29, 29, .24), rgba(69, 10, 10, .14));
    color: #fb7185;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .07), 0 4px 12px rgba(0, 0, 0, .12);
    transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
  }
  .broadcast-playlist-selected-remove:hover {
    transform: translateY(-2px) scale(1.04);
    border-color: rgba(251, 113, 133, .9);
    background: linear-gradient(145deg, #ef4444, #be123c);
    color: #ffffff;
    box-shadow: 0 8px 20px rgba(225, 29, 72, .32), 0 0 0 3px rgba(244, 63, 94, .1);
  }
  .broadcast-playlist-selected-remove:active {
    transform: translateY(0) scale(.97);
  }
  .broadcast-playlist-selected-remove:focus-visible {
    outline: 2px solid #fda4af;
    outline-offset: 3px;
  }
  .broadcast-playlist-selected-remove i {
    font-size: 13px;
    line-height: 1;
  }
  .broadcast-playlist-editor__settings {
    padding: 8px 10px;
    border-radius: 10px;
  }
  .broadcast-playlist-editor__settings h3 {
    gap: 7px;
    font-size: 12px;
    line-height: 1;
  }
  .broadcast-playlist-editor__settings h3 i {
    font-size: 12px;
  }
  .broadcast-playlist-editor__settings-grid {
    grid-template-columns: minmax(170px, 1.35fr) minmax(82px, .5fr) minmax(150px, .85fr) minmax(120px, .68fr) minmax(92px, .46fr);
    gap: 7px;
    margin-top: 8px;
  }
  .broadcast-playlist-field {
    gap: 4px;
  }
  .broadcast-playlist-field > span {
    font-size: 10px;
    line-height: 1.1;
  }
  .broadcast-playlist-field small {
    display: none;
  }
  .broadcast-playlist-field input,
  .broadcast-playlist-field select,
  .broadcast-playlist-input-wrap {
    min-height: 30px;
    border-radius: 7px;
    font-size: 12px;
  }
  .broadcast-playlist-input-wrap {
    gap: 7px;
    padding: 0 8px;
  }
  .broadcast-playlist-input-wrap small {
    display: inline;
    font-size: 10px;
  }
  .broadcast-publish-modal__header {
    padding: 14px 24px;
  }
  .broadcast-playlist-editor__mark {
    width: 40px;
    height: 40px;
    font-size: 18px;
  }
  .broadcast-playlist-editor__title {
    gap: 12px;
  }
  .broadcast-publish-modal__header strong {
    font-size: 18px;
  }
  .broadcast-publish-modal__header p {
    font-size: 12px;
    margin-top: 4px;
  }
  .broadcast-publish-upload-control {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .broadcast-publish-upload-control input[type="file"] {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .broadcast-playlist-editor__settings {
    grid-column: 1 / -1;
    border-color: rgba(139, 47, 242, .55);
    padding: 12px 14px;
    box-shadow: none;
  }
  .broadcast-playlist-editor__settings-grid {
    display: grid;
    grid-template-columns: minmax(190px, 1.15fr) minmax(112px, .65fr) minmax(190px, 1fr) minmax(140px, .8fr) minmax(112px, .62fr);
    gap: 10px;
    margin-top: 10px;
  }
  .broadcast-playlist-field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .broadcast-playlist-field span { font-size: 12px; }
  .broadcast-playlist-field span,
  .broadcast-publish-video strong {
    color: #f8fbff;
    font-weight: 800;
  }
  .broadcast-playlist-input-wrap {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    min-height: 38px;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid rgba(172, 188, 230, .18);
    background: rgba(8, 12, 26, .42);
    color: #aeb9d0;
  }
  .broadcast-playlist-field input,
  .broadcast-playlist-field select {
    width: 100%;
    box-sizing: border-box;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid rgba(172, 188, 230, .18);
    background: rgba(8, 12, 26, .42);
    color: #f8fbff;
    font-weight: 700;
  }
  .broadcast-playlist-input-wrap input {
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .broadcast-playlist-field small,
  .broadcast-publish-video small {
    color: #a8b4ce;
  }
  .broadcast-playlist-field small { font-size: 11px; line-height: 1.25; }
  .broadcast-playlist-editor__library-section,
  .broadcast-playlist-editor__order-section {
    min-height: min(56vh, 520px);
    display: flex;
    flex-direction: column;
  }
  .broadcast-publish-library,
  .broadcast-playlist-order {
    display: grid;
    align-content: start;
    gap: 12px;
    flex: 1 1 auto;
    max-height: none;
    min-height: 0;
    padding-bottom: 14px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
    contain: layout paint style;
    -webkit-overflow-scrolling: touch;
  }
  .broadcast-publish-video {
    display: grid;
    grid-template-columns: auto 64px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-height: 58px;
    padding: 7px;
    border-bottom: 1px solid rgba(148, 163, 184, .12);
    color: #f8fbff;
    cursor: pointer;
    contain: layout paint style;
    content-visibility: auto;
    contain-intrinsic-size: 68px;
    backface-visibility: hidden;
  }
  .broadcast-publish-video:hover {
    background: rgba(139, 47, 242, .08);
  }
  .broadcast-publish-video > i { display: none; }
  .broadcast-publish-video input[type="checkbox"] {
    accent-color: #a855f7;
  }
  .broadcast-publish-video img,
  .broadcast-publish-video video,
  .broadcast-playlist-order__thumb {
    width: 64px;
    height: 38px;
    object-fit: cover;
    border-radius: 7px;
    background: #020617;
    contain: paint;
  }
  .broadcast-playlist-thumb-preview {
    position: relative;
    width: 64px;
    height: 38px;
    flex: 0 0 64px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 7px;
    background: #020617;
  }
  .broadcast-playlist-thumb-preview img,
  .broadcast-playlist-thumb-preview video,
  .broadcast-playlist-thumb-preview .broadcast-playlist-order__thumb {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: inherit;
  }
  .broadcast-playlist-thumb-preview > i {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    background: rgba(2, 6, 23, .52);
    transition: opacity .16s ease;
  }
  .broadcast-playlist-thumb-preview:hover > i {
    opacity: 1;
  }
  .broadcast-publish-video:hover .broadcast-playlist-thumb-preview > i,
  .broadcast-playlist-order__item:hover .broadcast-playlist-thumb-preview > i {
    opacity: 1;
  }
  .broadcast-playlist-hover-preview {
    position: fixed;
