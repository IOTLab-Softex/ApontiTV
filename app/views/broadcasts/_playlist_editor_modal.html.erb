  .broadcast-playlist-clear-order {
    width: 100%;
    min-height: 48px;
    margin-top: 18px;
    border: 1px solid rgba(148, 163, 184, .14);
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgba(15, 23, 42, .42);
    color: #7d879f;
    cursor: pointer;
    font-weight: 800;
  }
  .broadcast-playlist-clear-order:hover {
    color: #f8fbff;
    border-color: rgba(248, 113, 113, .34);
    background: rgba(127, 29, 29, .2);
  }
  .broadcast-preview-modal__close,
  .broadcasts-toolbar__btn {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 9px;
    border: 1px solid rgba(148, 163, 184, .2);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-weight: 800;
  }
  .broadcast-preview-modal__close {
    background: rgba(226, 232, 240, .96);
    color: #172033;
  }
  .broadcasts-toolbar__btn--primary {
    background: #8b35ee;
    color: #fff;
    border-color: rgba(168, 85, 247, .55);
  }
  @media (max-width: 1100px) {
    .broadcast-publish-modal__body {
      grid-template-columns: 1fr;
    }

    .broadcast-playlist-editor__settings-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .broadcast-playlist-editor__settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initializeBroadcastPlaylistEditorModal() {
    const modal = document.querySelector("[data-playlist-editor-modal]");
    // Turbo retains this listener after leaving the standalone editor page.
    // The broadcasts index owns its editor and its draggable four-column rows.
    if (modal?.dataset.playlistEditorOwner === "broadcast-index") return;
    const form = document.querySelector("[data-playlist-editor-form]");
    const library = document.querySelector("[data-playlist-library]");
    const upload = document.querySelector("[data-playlist-upload]");
    const orderList = document.querySelector("[data-playlist-order]");
    const orderCount = document.querySelector("[data-playlist-order-count]");
    const libraryTabs = Array.from(document.querySelectorAll("[data-playlist-library-tab]"));
    const selectedLibrary = document.querySelector("[data-playlist-selected-library]");
    const selectedCount = document.querySelector("[data-playlist-selected-count]");
    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content || "";
    let playlistRefreshFrame = null;
    if (!modal || !form || modal.dataset.bound === "true") return;
    modal.dataset.bound = "true";

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function previewPlaceholder() {
      return "data:image/gif;base64,R0lGODlhAQABAAAAACw=";
    }

    function mediaPreviewSrcFromRow(row) {
      if (!row) return "";
      const image = row.querySelector("img");
      if (image) return image.dataset.previewSrc || image.getAttribute("src") || "";
      const videoSource = row.querySelector("video source");
      return videoSource?.dataset.src || videoSource?.getAttribute("src") || "";
    }

    function hydrateLazyPreviews(scope) {
      const container = scope || document;
      const targets = Array.from(container.querySelectorAll("img[data-lazy-preview], video source[data-src]"));
      if (targets.length === 0) return;

      function hydrate(target) {
        if (target.matches("img[data-lazy-preview]") && target.dataset.previewSrc) {
          target.src = target.dataset.previewSrc;
          target.removeAttribute("data-lazy-preview");
          return;
        }

        if (target.matches("source[data-src]")) {
          target.src = target.dataset.src;
          target.removeAttribute("data-src");
          const video = target.closest("video");
          if (video) video.load();
        }
      }

      if (!("IntersectionObserver" in window)) {
        targets.forEach(hydrate);
        return;
      }

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          hydrate(entry.target);
          observer.unobserve(entry.target);
        });
      }, { rootMargin: "260px 0px" });

      targets.forEach(function(target) {
        observer.observe(target);
      });
    }

    function bindPlaylistHoverPreview(scope) {
      const container = scope || document;
      if (!container || container.dataset?.hoverPreviewBound === "true") return;
      if (container.dataset) container.dataset.hoverPreviewBound = "true";

      let preview = null;
      let showTimer = null;

      function ensurePreview() {
        if (preview) return preview;

        preview = document.createElement("div");
        preview.className = "broadcast-playlist-hover-preview";
        preview.innerHTML = '<img alt="">';
        document.body.appendChild(preview);
        return preview;
      }

      function previewSrcFor(target) {
        const image = target.querySelector("img");
        return image?.dataset.previewSrc || image?.getAttribute("src") || "";
      }

      function positionPreview(target, element) {
        const box = target.getBoundingClientRect();
        const width = Math.min(280, window.innerWidth - 24);
        const height = Math.round((width * 9) / 16) + 12;
        const left = Math.min(window.innerWidth - width - 12, Math.max(12, box.left + (box.width / 2) - (width / 2)));
        const topAbove = box.top - height - 10;
        const topBelow = box.bottom + 10;
        const top = topAbove >= 12 ? topAbove : Math.min(window.innerHeight - height - 12, topBelow);

        element.style.left = `${left}px`;
        element.style.top = `${Math.max(12, top)}px`;
        element.style.width = `${width}px`;
      }

      function showPreview(target) {
        const src = previewSrcFor(target);
        if (!src || src === previewPlaceholder()) return;

        const element = ensurePreview();
        element.querySelector("img").src = src;
        positionPreview(target, element);
        element.classList.add("is-visible");
      }

      function hidePreview() {
        window.clearTimeout(showTimer);
        if (preview) preview.classList.remove("is-visible");
      }

      container.addEventListener("mouseover", function(event) {
        const row = event.target.closest(".broadcast-publish-video, .broadcast-playlist-order__item");
        const target = event.target.closest("[data-playlist-hover-preview]") || row?.querySelector("[data-playlist-hover-preview]");
        if (!target || !container.contains(target)) return;

        hydrateLazyPreviews(target);
        window.clearTimeout(showTimer);
        showTimer = window.setTimeout(function() {
          showPreview(target);
        }, 80);
      });

      container.addEventListener("mouseout", function(event) {
        const row = event.target.closest(".broadcast-publish-video, .broadcast-playlist-order__item");
        const target = event.target.closest("[data-playlist-hover-preview]") || row?.querySelector("[data-playlist-hover-preview]");
        if (!target) return;
        if (target.contains(event.relatedTarget) || row?.contains(event.relatedTarget)) return;
        hidePreview();
      });

      container.addEventListener("scroll", hidePreview, true);
      window.addEventListener("resize", hidePreview);
    }

    function mediaKindLabel(type) {
      return type === "image" ? "<%= j I18n.t("Image") %>" : "<%= j I18n.t("Video") %>";
    }

    function renderLibraryMedia(media, checked) {
      const preview = `
        <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
          <img src="${previewPlaceholder()}" data-lazy-preview data-preview-src="${escapeHtml(media.preview_url)}" alt="${escapeHtml(media.filename)}" loading="lazy" decoding="async">
          <i class="fas fa-eye" aria-hidden="true"></i>
        </span>
      `;

      return `
        <label class="broadcast-publish-video" data-library-blob-id="${media.id}">
          <input type="checkbox" name="playlist_media_blob_ids[]" value="${media.id}" data-playlist-media-choice ${checked ? "checked" : ""}>
          ${preview}
          <span>
            <strong>${escapeHtml(media.filename)}</strong>
            <small>${mediaKindLabel(media.type)} - ${escapeHtml(media.size_label)} - ${escapeHtml(media.created_at_label)}</small>
          </span>
          <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
        </label>
      `;
    }

    function selectedMediaInputs() {
      return Array.from(form.querySelectorAll("[data-playlist-media-choice]:checked"));
    }

    function selectedMediaCount() {
      return selectedMediaInputs().length;
    }

    function setLibraryTab(tabName) {
      const activeTab = tabName === "selected" ? "selected" : "library";

      libraryTabs.forEach(function(button) {
        const isActive = button.dataset.playlistLibraryTab === activeTab;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      if (library) library.hidden = activeTab !== "library";
      if (selectedLibrary) selectedLibrary.hidden = activeTab !== "selected";
    }

    function updateOrderPreview() {
      if (!orderList || !orderCount) return;

      const inputs = selectedMediaInputs();
      renderSelectedLibraryPreview(inputs);
      orderCount.textContent = `${inputs.length} ${inputs.length === 1 ? "<%= j I18n.t("ItemSingular") %>" : "<%= j I18n.t("ItemPlural") %>"}`;

      if (inputs.length === 0) {
        orderList.innerHTML = `
          <div class="broadcast-playlist-order__empty" data-playlist-order-empty>
            <i class="far fa-file-video" aria-hidden="true"></i>
            <strong><%= j I18n.t("PlaylistEmpty") %></strong>
            <span><%= j I18n.t("SelectLibraryItemsToStart") %></span>
          </div>
        `;
        return;
      }

      orderList.innerHTML = inputs.map(function(input, index) {
        const row = input.closest("[data-library-blob-id]");
        const title = row?.querySelector("strong")?.textContent || "<%= j I18n.t("Media") %>";
        const meta = row?.querySelector("small")?.textContent || "";
        const previewSrc = mediaPreviewSrcFromRow(row);
        const thumb = `
          <span class="broadcast-playlist-thumb-preview broadcast-playlist-thumb-preview--order" data-playlist-hover-preview>
            <img class="broadcast-playlist-order__thumb" src="${escapeHtml(previewSrc)}" alt="" loading="lazy" decoding="async">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </span>
        `;

        return `
          <div class="broadcast-playlist-order__item">
            <span class="broadcast-playlist-order__index">${index + 1}</span>
            ${thumb}
            <span>
              <strong>${escapeHtml(title)}</strong>
              <small>${escapeHtml(meta)}</small>
            </span>
          </div>
        `;
      }).join("");
      hydrateLazyPreviews(orderList);
      bindPlaylistHoverPreview(modal);
    }

    function renderSelectedLibraryPreview(inputs) {
      if (selectedCount) selectedCount.textContent = inputs.length;
      if (!selectedLibrary) return;

      if (inputs.length === 0) {
        selectedLibrary.innerHTML = `
          <div class="broadcast-playlist-order__empty">
            <i class="far fa-file-video" aria-hidden="true"></i>
            <strong><%= j I18n.t("PlaylistEmpty") %></strong>
            <span><%= j I18n.t("SelectLibraryItemsToStart") %></span>
          </div>
        `;
        return;
      }

      selectedLibrary.innerHTML = inputs.map(function(input) {
        const row = input.closest("[data-library-blob-id]");
        const title = row?.querySelector("strong")?.textContent || "<%= j I18n.t("Media") %>";
        const meta = row?.querySelector("small")?.textContent || "";
        const previewSrc = mediaPreviewSrcFromRow(row);

        return `
          <div class="broadcast-publish-video broadcast-publish-video--selected" data-selected-library-blob-id="${escapeHtml(input.value)}">
            <button type="button" class="broadcast-playlist-selected-remove" data-playlist-remove-selected="${escapeHtml(input.value)}" title="<%= j I18n.t("Remove", default: "Remover") %>" aria-label="<%= j I18n.t("Remove", default: "Remover") %>">
              <i class="fas fa-trash-alt" aria-hidden="true"></i>
            </button>
            <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
              <img src="${escapeHtml(previewSrc)}" alt="" loading="lazy" decoding="async">
              <i class="fas fa-eye" aria-hidden="true"></i>
            </span>
            <span>
              <strong>${escapeHtml(title)}</strong>
              <small>${escapeHtml(meta)}</small>
            </span>
          </div>
        `;
      }).join("");
      hydrateLazyPreviews(selectedLibrary);
      bindPlaylistHoverPreview(modal);
    }

    function updateTimingVisibility() {
      playlistRefreshFrame = null;
      const shouldShow = selectedMediaCount() > 1;
      form.querySelectorAll("[data-playlist-timing-settings]").forEach(function(field) {
        field.hidden = !shouldShow;
      });
      updateOrderPreview();
    }

    function scheduleTimingVisibility() {
      if (playlistRefreshFrame) return;
      playlistRefreshFrame = requestAnimationFrame(updateTimingVisibility);
    }

    function resetEditor() {
      form.reset();
      form.querySelector("[data-playlist-editor-id]").value = "";
      form.querySelector("[data-playlist-name]").value = "<%= j I18n.t("NewPlaylist") %>";
      form.querySelector("[data-playlist-image-duration]").value = "10";
      form.querySelector("[data-playlist-video-duration-mode]").value = "image_duration";
      form.querySelector("[data-playlist-transition-style]").value = "fade";
      form.querySelector("[data-playlist-transition-duration]").value = "600";
      form.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
        input.checked = false;
      });
      document.querySelector("[data-playlist-editor-title]").textContent = "<%= j I18n.t("CreatePlaylist") %>";
      updateTimingVisibility();
      setLibraryTab("selected");
      bindPlaylistHoverPreview(modal);
    }

    function openEditor(playlist) {
      resetEditor();
      if (playlist) {
        form.querySelector("[data-playlist-editor-id]").value = playlist.id;
        form.querySelector("[data-playlist-name]").value = playlist.name || "Playlist";
        form.querySelector("[data-playlist-image-duration]").value = playlist.image_duration_seconds || 10;
        form.querySelector("[data-playlist-video-duration-mode]").value = playlist.video_duration_mode || "image_duration";
        form.querySelector("[data-playlist-transition-style]").value = playlist.transition_style || "fade";
        form.querySelector("[data-playlist-transition-duration]").value = playlist.transition_duration_ms || 600;
        const selectedIds = new Set((playlist.items || []).map(function(item) { return String(item.blob_id); }));
        form.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
          input.checked = selectedIds.has(String(input.value));
        });
        document.querySelector("[data-playlist-editor-title]").textContent = "<%= j I18n.t("EditPlaylist") %>";
      }
      updateTimingVisibility();
      modal.hidden = false;
      hydrateLazyPreviews(modal);
      bindPlaylistHoverPreview(modal);
    }

    function closeEditor() {
      modal.hidden = true;
    }

    function closeEditorAndReturnToPublish() {
      closeEditor();
      const publishModal = document.querySelector("[data-publish-modal]");
      if (publishModal) publishModal.hidden = false;
    }

    function refreshPublishPlaylistList(selectedId) {
      if (typeof window.refreshBroadcastPublishPlaylistList === "function") {
        return window.refreshBroadcastPublishPlaylistList(selectedId);
      }

      document.dispatchEvent(new CustomEvent("broadcast-playlist:saved", {
        detail: { playlistId: selectedId }
      }));
      return Promise.resolve();
    }

    document.addEventListener("click", function(event) {
      const newButton = event.target.closest("[data-playlist-new]");
      if (newButton) {
        event.preventDefault();
        openEditor(null);
        return;
      }

      const editButton = event.target.closest("[data-playlist-edit]");
      if (editButton) {
        event.preventDefault();
        event.stopPropagation();
        fetch(`/broadcast_playlists/${editButton.dataset.playlistEdit}.json`)
          .then(function(response) { return response.ok ? response.json() : Promise.reject(response); })
          .then(openEditor);
      }
    });

    document.querySelectorAll("[data-playlist-editor-close]").forEach(function(button) {
      button.addEventListener("click", closeEditorAndReturnToPublish);
    });

    document.querySelectorAll("[data-playlist-clear-items]").forEach(function(button) {
      button.addEventListener("click", function() {
        form.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
          input.checked = false;
        });
        updateTimingVisibility();
      });
    });

    libraryTabs.forEach(function(button) {
      button.addEventListener("click", function() {
        setLibraryTab(button.dataset.playlistLibraryTab);
      });
    });

    document.addEventListener("click", function(event) {
      const removeButton = event.target.closest("[data-playlist-remove-selected]");
      if (!removeButton || !modal.contains(removeButton)) return;

      event.preventDefault();
      const input = Array.from(form.querySelectorAll("[data-playlist-media-choice]")).find(function(choice) {
        return String(choice.value) === String(removeButton.dataset.playlistRemoveSelected);
      });
      if (input) input.checked = false;
      updateTimingVisibility();
    });

    form.addEventListener("change", function(event) {
      if (event.target.matches("[data-playlist-media-choice]")) scheduleTimingVisibility();
    });

    if (upload) {
      upload.addEventListener("change", function() {
        if (!upload.files || upload.files.length === 0) return;

        const formData = new FormData();
        Array.from(upload.files).forEach(function(file) {
          formData.append("media_files[]", file);
        });

        fetch("/broadcast_playlists/upload_media.json", {
          method: "POST",
          headers: { "X-CSRF-Token": csrfToken },
          body: formData
        })
          .then(function(response) { return response.ok ? response.json() : response.json().then(function(data) { throw data; }); })
          .then(function(mediaItems) {
            const existingIds = new Set(Array.from(library.querySelectorAll("[data-library-blob-id]")).map(function(el) {
              return el.dataset.libraryBlobId;
            }));
            const html = mediaItems
              .filter(function(media) { return !existingIds.has(String(media.id)); })
              .map(function(media) { return renderLibraryMedia(media, true); })
              .join("");
            library.insertAdjacentHTML("afterbegin", html);
            hydrateLazyPreviews(library);
            upload.value = "";
            updateTimingVisibility();
          })
          .catch(function(error) {
            alert(error.error || "<%= j I18n.t("MediaUploadFailed") %>");
          });
      });
    }

    form.addEventListener("submit", function(event) {
      event.preventDefault();
      const playlistId = form.querySelector("[data-playlist-editor-id]").value;
      const formData = new FormData();
      formData.append("name", form.querySelector("[data-playlist-name]").value);
      formData.append("image_duration_seconds", form.querySelector("[data-playlist-image-duration]").value);
      formData.append("video_duration_mode", form.querySelector("[data-playlist-video-duration-mode]").value);
      formData.append("transition_style", form.querySelector("[data-playlist-transition-style]").value);
      formData.append("transition_duration_ms", form.querySelector("[data-playlist-transition-duration]").value);
      selectedMediaInputs().forEach(function(input) {
        formData.append("media_blob_ids[]", input.value);
      });

      fetch(playlistId ? `/broadcast_playlists/${playlistId}.json` : "/broadcast_playlists.json", {
        method: playlistId ? "PATCH" : "POST",
        headers: { "X-CSRF-Token": csrfToken },
        body: formData
      })
        .then(function(response) {
          return response.text().then(function(text) {
            let data = {};
            try {
              data = text ? JSON.parse(text) : {};
            } catch (error) {
              data = { error: text || "<%= j I18n.t("PlaylistSaveFailed") %>" };
            }

            if (!response.ok) throw data;
            return data;
          });
        })
        .then(function(playlist) {
          closeEditorAndReturnToPublish();
          refreshPublishPlaylistList(playlist.id);
        })
        .catch(function(error) {
          alert(error.error || "<%= j I18n.t("PlaylistSaveFailed") %>");
        });
    });

    updateTimingVisibility();
  }

  document.addEventListener("DOMContentLoaded", initializeBroadcastPlaylistEditorModal);
  document.addEventListener("turbo:load", initializeBroadcastPlaylistEditorModal);
</script>
