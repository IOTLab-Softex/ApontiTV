<% tv_type_value = form.object.tv_device_type.presence || "normal_tv" %>
<% control_hint = %w[android_tv fire_tv].include?(tv_type_value) ? I18n.t("AdbPowerHint") : I18n.t("WakeOnLanPowerHint") %>
<% selected_disabled_weekdays = Array(form.object.tv_disabled_weekdays).map(&:to_s) %>
<% playback_type_value = form.object.playback_app_type.presence || "official_app" %>
<% current_playlist_blob_ids = form.object.playlist_items.includes(media_attachment: :blob).map { |item| item.media.attached? ? item.media.blob_id : nil }.compact %>
<% matched_playlist = @saved_playlists&.detect { |playlist| playlist.items.map(&:media_blob_id) == current_playlist_blob_ids } %>
<% selected_playlist_id = params.dig(:broadcast, :selected_playlist_id).presence || matched_playlist&.id %>

<nav class="broadcast-config-tabs" role="tablist" aria-label="Configuracoes da TV">
  <button type="button" class="broadcast-config-tab is-active" data-broadcast-config-tab="general" role="tab"><i class="fas fa-info-circle"></i><span>Geral</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="content" role="tab"><i class="fas fa-photo-video"></i><span>Conteudo</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="playback" role="tab"><i class="fas fa-play-circle"></i><span>Reproducao</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="device" role="tab"><i class="fas fa-tv"></i><span>Dispositivo</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="display" role="tab"><i class="fas fa-sliders-h"></i><span>Tela e aparencia</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="power" role="tab"><i class="fas fa-power-off"></i><span>Energia</span></button>
  <button type="button" class="broadcast-config-tab" data-broadcast-config-tab="controls" role="tab"><i class="fas fa-tools"></i><span>Controles e atualizacao</span></button>
</nav>

<div class="broadcast-config-panels">
<div class="broadcast-config-panel is-active" data-broadcast-config-panel="general" role="tabpanel">

<section class="broadcast-settings-card broadcast-settings-card--identity">
  <div class="broadcast-settings-card__header">
    <span><i class="fas fa-tv" aria-hidden="true"></i></span>
    <div><h3>Identificação</h3><p>Nome usado para localizar esta TV no painel.</p></div>
  </div>
  <div class="field">
    <%= form.label :name, "Nome da TV" %>
    <%= form.text_field :name, class: "input-field", placeholder: "Ex.: TV Recepção" %>
  </div>
</section>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="content" role="tabpanel" hidden>

<section class="broadcast-settings-card broadcast-settings-card--content">
  <div class="broadcast-settings-card__header">
    <span><i class="fas fa-photo-video" aria-hidden="true"></i></span>
    <div><h3>Conteúdo e playlist</h3><p>Escolha o conteúdo que será reproduzido nesta tela.</p></div>
  </div>
<div class="field">
  <div class="broadcast-playlist-picker__header">
    <div>
      <label><%= I18n.t("LibraryPlaylists") %></label>
      <p class="helper-text"><%= I18n.t("LibraryPlaylistsHelp") %></p>
    </div>
    <button type="button" class="secondary-btn" data-playlist-new><%= I18n.t("ManagePlaylists") %></button>
  </div>

  <% if @saved_playlists.present? %>
    <div class="broadcast-playlist-picker" id="broadcast-playlist-picker">
      <% @saved_playlists.each do |playlist| %>
        <% is_selected = selected_playlist_id.to_s == playlist.id.to_s %>
        <% playlist_items = playlist.items.first(4) %>
        <label class="broadcast-playlist-card <%= "is-selected" if is_selected %>" data-broadcast-playlist-card>
          <%= radio_button_tag "broadcast[selected_playlist_id]", playlist.id, is_selected, class: "broadcast-playlist-card__radio" %>
          <div class="broadcast-playlist-card__thumbs">
            <% if playlist_items.any? %>
              <% playlist_items.each do |item| %>
                <% blob = item.media_blob %>
                <div class="broadcast-playlist-card__thumb">
                  <% if blob.content_type.to_s.start_with?("image/") %>
                    <%= image_tag rails_blob_path(blob, only_path: true), alt: blob.filename.to_s, loading: "lazy" %>
                  <% else %>
                    <video muted playsinline preload="metadata">
                      <source src="<%= rails_blob_path(blob, only_path: true) %>" type="<%= blob.content_type %>">
                    </video>
                    <i class="fas fa-play" aria-hidden="true"></i>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="broadcast-playlist-card__empty">
                <i class="fas fa-photo-video" aria-hidden="true"></i>
              </div>
            <% end %>
          </div>
          <div class="broadcast-playlist-card__body">
            <strong><%= playlist.name %></strong>
            <span><%= I18n.t("MediaCount", count: playlist.item_count) %></span>
            <span><%= playlist.video_duration_mode == "video_end" ? I18n.t("VideoUntilEnd") : I18n.t("TimedVideo") %> - <%= playlist.transition_style %></span>
          </div>
          <button type="button" class="broadcast-playlist-card__edit" data-playlist-edit="<%= playlist.id %>"><%= I18n.t("Edit") %></button>
        </label>
      <% end %>
    </div>
  <% else %>
    <p class="helper-text"><%= I18n.t("NoPlaylistFound") %></p>
  <% end %>
</div>

<div class="broadcast-sync-panel">
  <div class="broadcast-power-card__header">
    <h3>Sincronização automática</h3>
    <p>Controle geral da sincronização desta TV com outras que utilizam a mesma playlist.</p>
  </div>
  <div class="field">
    <label class="broadcast-checkbox">
      <%= form.check_box :playlist_sync_enabled %>
      <span>Manter esta TV sincronizada com a playlist compartilhada</span>
    </label>
    <p class="helper-text">Quando ativada, fotos e vídeos seguem o mesmo slide e posição das demais TVs sincronizadas. Quando desativada, esta TV reproduz de forma independente.</p>
  </div>
</div>
</section>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="playback" role="tabpanel" hidden>

<section class="broadcast-settings-card broadcast-settings-card--playback">
  <div class="broadcast-settings-card__header">
    <span><i class="fas fa-play-circle" aria-hidden="true"></i></span>
    <div><h3>Reprodução e página web</h3><p>Defina o aplicativo e a alternância com conteúdo web.</p></div>
  </div>
<div class="field">
  <%= form.label :official_app_web_enabled, I18n.t("ShowOfficialWebPage") %>
  <label class="broadcast-checkbox">
    <%= form.check_box :official_app_web_enabled, id: "broadcast_official_app_web_enabled" %>
    <span><%= I18n.t("EnableOfficialWebRotation") %></span>
  </label>
</div>

<div class="field">
  <%= form.label :playback_app_type, I18n.t("PlaybackApp") %>
  <%= form.select :playback_app_type,
                  options_for_select([[I18n.t("OfficialApp"), "official_app"], [I18n.t("GenericApp"), "generic_app"]], playback_type_value),
                  {},
                  class: "input-field",
                  id: "broadcast_playback_app_type" %>
</div>

<div class="broadcast-power-card" id="official-app-browser-card" style="<%= playback_type_value == 'official_app' ? '' : 'display:none;' %>">
  <div class="broadcast-power-card__header">
    <h3><%= I18n.t("OfficialAppWebPage") %></h3>
    <p><%= I18n.t("OfficialAppWebPageHelp") %></p>
  </div>

  <div class="field">
    <%= form.label :official_app_page_url, I18n.t("WebPageUrl") %>
    <%= form.url_field :official_app_page_url, class: "input-field", placeholder: "https://seusite.com/painel" %>
    <p class="helper-text"><%= I18n.t("WebPageUrlHelp") %></p>
  </div>

  <div class="field">
    <label class="broadcast-checkbox">
      <%= form.check_box :official_app_login_enabled %>
      <span>Fazer login automático na página</span>
    </label>
    <p class="helper-text">Para páginas com usuário e senha, como o Grafana. Use uma conta com acesso de visualização. Login por Google/Microsoft, CAPTCHA ou verificação em duas etapas exige acesso manual.</p>
    <%= form.label :official_app_login_username, "Usuário ou e-mail da página" %>
    <%= form.text_field :official_app_login_username, class: "input-field", autocomplete: "off" %>
    <%= form.label :official_app_login_password, "Senha da página" %>
    <%= form.password_field :official_app_login_password, value: nil, class: "input-field", autocomplete: "new-password", placeholder: (form.object.official_app_login_password_ciphertext.present? ? "Senha salva — deixe em branco para manter" : "Digite a senha") %>
    <p class="helper-text">O login é feito pelo app oficial atualizado, na TV com o IP cadastrado neste card.</p>
  </div>

  <div class="field">
    <%= form.label :official_app_web_only, I18n.t("OfficialAppWebDisplayMode") %>
    <label class="broadcast-checkbox">
      <%= form.check_box :official_app_web_only, id: "broadcast_official_app_web_only" %>
      <span><%= I18n.t("OfficialAppWebOnly") %></span>
    </label>
    <p class="helper-text"><%= I18n.t("OfficialAppWebOnlyHelp") %></p>
  </div>

  <div id="official-app-web-rotation-fields">

  <div class="field">
    <%= form.label :official_app_rotation_trigger, I18n.t("WhenOpenWebPage") %>
    <%= form.select :official_app_rotation_trigger,
                    [[I18n.t("ConfiguredTime"), "time_interval"], [I18n.t("WhenVideoEnds"), "video_end"]],
                    {},
                    class: "input-field",
                    id: "broadcast_official_app_rotation_trigger" %>
    <p class="helper-text"><%= I18n.t("WhenVideoEndsHelp") %></p>
  </div>

  <div class="broadcast-power-card__grid broadcast-power-card__grid--triple">
    <div class="field" id="official-app-switch-interval-field">
      <%= label_tag :official_app_switch_interval_value, I18n.t("SwitchVideoToWebEvery") %>
      <%= number_field_tag :official_app_switch_interval_value, 1, class: "input-field", id: "official_app_switch_interval_value", min: 1, step: 1 %>
      <%= form.hidden_field :official_app_switch_interval_seconds, id: "broadcast_official_app_switch_interval_seconds" %>
    </div>

    <div class="field" id="official-app-switch-interval-unit-field">
      <%= label_tag :official_app_switch_interval_unit, I18n.t("SwitchUnit") %>
      <%= form.select :official_app_switch_interval_unit,
                      [[I18n.t("Seconds"), "seconds"], [I18n.t("Minutes"), "minutes"]],
                      {},
                      class: "input-field",
                      id: "official_app_switch_interval_unit" %>
    </div>

    <div class="field">
      <%= label_tag :official_app_page_duration_value, I18n.t("ShowPageFor") %>
      <%= number_field_tag :official_app_page_duration_value, 1, class: "input-field", id: "official_app_page_duration_value", min: 1, step: 1 %>
      <%= form.hidden_field :official_app_page_duration_seconds, id: "broadcast_official_app_page_duration_seconds" %>
    </div>
  </div>

  <div class="broadcast-power-card__grid">
    <div class="field">
      <%= label_tag :official_app_page_duration_unit, I18n.t("DisplayUnit") %>
      <%= form.select :official_app_page_duration_unit,
                      [[I18n.t("Seconds"), "seconds"], [I18n.t("Minutes"), "minutes"]],
                      {},
                      class: "input-field",
                      id: "official_app_page_duration_unit" %>
    </div>

    <div class="field">
      <%= form.label :official_app_transition_style, I18n.t("Transition") %>
      <%= form.select :official_app_transition_style,
                      [["Aponti Smooth", "aponti_smooth"], ["Fade", "fade"], ["Slide", "slide"], ["Blur", "blur"], ["Zoom", "zoom"], ["Wipe vertical", "wipe"], ["Push lateral", "push"], ["Flip", "flip"], ["Cross zoom", "cross_zoom"], [I18n.t("NoEffect"), "none"]],
                      {},
                      class: "input-field" %>
    </div>

    <div class="field">
      <%= form.label :official_app_transition_duration_ms, I18n.t("TransitionDurationMs") %>
      <%= form.number_field :official_app_transition_duration_ms, class: "input-field", min: 0, max: 10000, step: 100 %>
    </div>
  </div>

  <p class="helper-text"><%= I18n.t("OfficialWebDefaults") %></p>
  </div>
</div>
</section>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="device" role="tabpanel" hidden>

<section class="broadcast-settings-card broadcast-settings-card--device">
  <div class="broadcast-settings-card__header">
    <span><i class="fas fa-network-wired" aria-hidden="true"></i></span>
    <div><h3>Dispositivo e conexão</h3><p>Configure o modelo da TV, endereço de rede e controle remoto.</p></div>
  </div>
<div class="field">
  <%= form.label :tv_device_type, I18n.t("TvType") %>
  <%= form.select :tv_device_type,
                  [[I18n.t("NormalTv"), "normal_tv"], ["TV Android", "android_tv"], ["Fire Stick", "fire_tv"]],
                  {},
                  class: "input-field",
                  id: "broadcast_tv_device_type" %>
</div>

<div class="field" id="keep-app-foreground-wrapper">
  <label><%= I18n.t("KeepApontiOpen") %></label>
  <label class="broadcast-checkbox">
    <%= form.check_box :keep_app_foreground_enabled %>
    <span><%= I18n.t("KeepApontiOpenHelp") %></span>
  </label>
  <p class="helper-text"><%= I18n.t("KeepApontiOpenNote") %></p>
</div>

<div class="field">
  <label><%= I18n.t("PowerFunction") %></label>
  <p id="power-method-hint" class="helper-text"><%= control_hint %></p>
</div>

<div class="field">
  <%= form.label :tv_ip, I18n.t("TvIp") %>
  <div class="inline-field">
    <%= form.text_field :tv_ip, class: "input-field", id: "broadcast_tv_ip", placeholder: "192.168.0.10" %>
    <button type="button" id="check-tv-status" class="secondary-btn"><%= I18n.t("CheckTv") %></button>
  </div>
  <p id="tv-status-result" class="helper-text"></p>
</div>

<div class="field" id="adb-host-wrapper">
  <%= form.label :adb_host, I18n.t("TvAdbVpnIp") %>
  <%= form.text_field :adb_host, class: "input-field", id: "broadcast_adb_host", placeholder: "100.x.x.x ou tv-corredor.tailnet.ts.net" %>
  <p class="helper-text"><%= I18n.t("TvAdbVpnIpHelp") %></p>
</div>

<div class="field" id="tv-mac-wrapper">
  <%= form.label :tv_mac_address, I18n.t("TvMac") %>
  <%= form.text_field :tv_mac_address, class: "input-field", placeholder: "AA:BB:CC:DD:EE:FF" %>
</div>

<div class="field" id="adb-port-wrapper">
  <%= form.label :adb_port, I18n.t("AdbPort") %>
  <%= form.number_field :adb_port, class: "input-field", min: 1, max: 65535 %>
</div>
</section>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="display" role="tabpanel" hidden>

<section class="broadcast-settings-card broadcast-settings-card--display">
  <div class="broadcast-settings-card__header">
    <span><i class="fas fa-sliders-h" aria-hidden="true"></i></span>
    <div><h3>Tela e aparência</h3><p>Ajuste widgets, margens e orientação da exibição.</p></div>
  </div>
<div class="field">
  <label>Widgets na tela</label>
  <label class="broadcast-checkbox">
    <%= form.check_box :show_widgets %>
    <span>Exibir widgets durante a reprodução</span>
  </label>
</div>

<div class="field">
  <label><%= I18n.t("WidgetBarSpacing", default: "Espacamento da barra") %></label>
  <label class="broadcast-checkbox">
    <%= form.check_box :widget_bar_edge_spacing_enabled %>
    <span><%= I18n.t("EnableWidgetBarSpacing", default: "Usar espacamento inferior/lateral da barra nesta TV") %></span>
  </label>
  <p class="helper-text"><%= I18n.t("WidgetBarSpacingHelp", default: "Desative quando a TV nao cortar a barra; mantenha ativo em aparelhos que precisam de margem de seguranca.") %></p>
</div>

<div class="field">
  <label>Previsao do tempo</label>
  <label class="broadcast-checkbox">
    <%= form.check_box :widget_forecast_enabled %>
    <span>Exibir os cards dos proximos dias nesta TV</span>
  </label>
  <p class="helper-text">A configuracao geral da previsao tambem precisa estar ativa.</p>
</div>

<div class="field">
  <%= form.label :orientation, I18n.t("ScreenOrientation") %>
  <%= form.select :orientation,
                  options_for_select([[I18n.t("Portrait"), "portrait"], [I18n.t("PortraitInverted"), "portrait_inverted"], [I18n.t("Landscape"), "landscape"]], form.object.orientation),
                  {},
                  class: "input-field" %>
</div>
</section>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="power" role="tabpanel" hidden>

<div class="broadcast-power-card broadcast-settings-card broadcast-settings-card--schedule">
  <div class="broadcast-power-card__header">
    <span><i class="fas fa-calendar-alt" aria-hidden="true"></i></span>
    <div><h3><%= I18n.t("TvPowerSchedule") %></h3><p><%= I18n.t("TvPowerScheduleHelp") %></p></div>
  </div>

  <div class="broadcast-power-card__grid">
    <div class="field">
      <%= form.label :tv_power_on_time, I18n.t("PowerOnTime") %>
      <%= form.text_field :tv_power_on_time, type: "time", value: form.object.tv_power_on_time_input_value, class: "input-field", step: 60 %>
    </div>

    <div class="field">
      <%= form.label :tv_power_off_time, I18n.t("PowerOffTime") %>
      <%= form.text_field :tv_power_off_time, type: "time", value: form.object.tv_power_off_time_input_value, class: "input-field", step: 60 %>
    </div>
  </div>

  <div class="field">
    <label><%= I18n.t("DaysKeepOff") %></label>
    <div class="broadcast-weekdays">
      <% Broadcast::WEEKDAY_OPTIONS.each do |label, value| %>
        <label class="broadcast-weekdays__item">
          <%= check_box_tag "broadcast[tv_disabled_weekdays][]", value, selected_disabled_weekdays.include?(value), id: "broadcast_tv_disabled_weekdays_#{value}" %>
          <span><%= label %></span>
        </label>
      <% end %>
    </div>
    <%= hidden_field_tag "broadcast[tv_disabled_weekdays][]", "" %>
    <p class="helper-text"><%= I18n.t("DaysKeepOffHelp") %></p>
    <% if form.object.tv_schedule_blocked_today? %>
      <p class="helper-text status-offline"><%= form.object.tv_schedule_blocked_today_label %></p>
    <% end %>
  </div>
</div>

</div>
<div class="broadcast-config-panel" data-broadcast-config-panel="controls" role="tabpanel" hidden>
  <section class="broadcast-settings-card broadcast-settings-card--controls">
    <div class="broadcast-settings-card__header">
      <span><i class="fas fa-tools" aria-hidden="true"></i></span>
      <div><h3>Controles e atualizacao</h3><p>Abra o aplicativo, configure o launcher e instale a versao mais recente nesta TV.</p></div>
    </div>

    <% if form.object.persisted? && current_user&.admin? %>
      <div class="broadcast-app-update-status <%= form.object.official_app_outdated? ? 'is-outdated' : 'is-current' %>">
        <span><i class="fas <%= form.object.official_app_outdated? ? 'fa-exclamation-circle' : 'fa-check-circle' %>"></i></span>
        <div>
          <strong>Aplicativo Aponti TV</strong>
          <p>Instalada: <%= form.object.app_version_name.present? ? "v#{form.object.app_version_name}" : "versao nao informada" %></p>
          <p>Disponivel: v<%= Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME %></p>
        </div>
      </div>

      <div class="broadcast-control-actions">
        <button type="submit" form="broadcast-open-app-form" class="broadcast-control-action" data-turbo-confirm="<%= I18n.t('ConfirmOpenApontiApp') %>"><i class="fas fa-external-link-alt"></i><span><%= I18n.t('OpenApontiApp') %></span></button>
        <button type="submit" form="broadcast-update-app-form" class="broadcast-control-action broadcast-control-action--update" data-turbo-confirm="Atualizar o Aponti TV nesta tela?"><i class="fas fa-cloud-download-alt"></i><span>Atualizar para v<%= Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME %></span></button>
        <% root_email = ENV.fetch("ROOT_USER_EMAIL", "root@apontitv.local") %>
        <% if current_user.email.to_s == root_email %>
          <button type="submit" form="broadcast-set-launcher-form" class="broadcast-control-action" data-turbo-confirm="<%= I18n.t('ConfirmSetApontiLauncher') %>"><i class="fas fa-home"></i><span><%= I18n.t('SetApontiLauncher') %></span></button>
          <button type="submit" form="broadcast-remove-launcher-form" class="broadcast-control-action broadcast-control-action--danger" data-turbo-confirm="<%= I18n.t('ConfirmRemoveApontiLauncher') %>"><i class="fas fa-undo"></i><span><%= I18n.t('RemoveApontiLauncher') %></span></button>
        <% end %>
      </div>
    <% else %>
      <p class="helper-text">Os controles ficam disponiveis para administradores depois que a TV for salva.</p>
    <% end %>
  </section>
</div>
</div>

<script>
  function initializeBroadcastForm() {
    initializeBroadcastConfigTabs();
    const broadcastForm = document.querySelector(".broadcast-edit-form");
    if (broadcastForm && broadcastForm.dataset.broadcastFormBound === "true") return;
    if (broadcastForm) broadcastForm.dataset.broadcastFormBound = "true";

    const playlistPicker = document.getElementById("broadcast-playlist-picker");
    const playbackTypeField = document.getElementById("broadcast_playback_app_type");
    const officialAppWebEnabledField = document.getElementById("broadcast_official_app_web_enabled");
    const officialAppWebOnlyField = document.getElementById("broadcast_official_app_web_only");
    const officialAppWebRotationFields = document.getElementById("official-app-web-rotation-fields");
    const officialAppRotationTrigger = document.getElementById("broadcast_official_app_rotation_trigger");
    const tvTypeField = document.getElementById("broadcast_tv_device_type");
    const tvIpField = document.getElementById("broadcast_tv_ip");
    const adbHostField = document.getElementById("broadcast_adb_host");
    const adbPortField = document.getElementById("broadcast_adb_port");
    const statusButton = document.getElementById("check-tv-status");
    const statusResult = document.getElementById("tv-status-result");
    const powerMethodHint = document.getElementById("power-method-hint");
    const adbPortWrapper = document.getElementById("adb-port-wrapper");
    const tvMacWrapper = document.getElementById("tv-mac-wrapper");
    const keepAppForegroundWrapper = document.getElementById("keep-app-foreground-wrapper");
    const officialAppBrowserCard = document.getElementById("official-app-browser-card");
    const switchIntervalUnit = document.getElementById("official_app_switch_interval_unit");
    const pageDurationUnit = document.getElementById("official_app_page_duration_unit");
    const switchIntervalValue = document.getElementById("official_app_switch_interval_value");
    const pageDurationValue = document.getElementById("official_app_page_duration_value");
    const switchIntervalSeconds = document.getElementById("broadcast_official_app_switch_interval_seconds");
    const pageDurationSeconds = document.getElementById("broadcast_official_app_page_duration_seconds");
    const switchIntervalField = document.getElementById("official-app-switch-interval-field");
    const switchIntervalUnitField = document.getElementById("official-app-switch-interval-unit-field");

    if (playlistPicker) {
      playlistPicker.querySelectorAll("video").forEach((preview) => {
        preview.addEventListener("loadeddata", function () {
          try {
            preview.currentTime = 0.1;
          } catch (_error) {
          }
        });
      });

      const syncVideoSelectionState = () => {
        playlistPicker.querySelectorAll("[data-broadcast-playlist-card]").forEach((item) => {
          const radio = item.querySelector(".broadcast-playlist-card__radio");
          item.classList.toggle("is-selected", radio && radio.checked);
        });
      };

      playlistPicker.addEventListener("change", syncVideoSelectionState);

      syncVideoSelectionState();
    }

    function updatePlaybackModeFields() {
      if (!playbackTypeField || !officialAppBrowserCard) return;

      const showOfficialAppFields = playbackTypeField.value === "official_app";
      officialAppBrowserCard.style.display = showOfficialAppFields ? "block" : "none";
      officialAppBrowserCard.style.opacity = officialAppWebEnabledField && !officialAppWebEnabledField.checked ? "0.65" : "1";
      if (officialAppWebRotationFields) {
        officialAppWebRotationFields.style.display = officialAppWebOnlyField && officialAppWebOnlyField.checked ? "none" : "block";
      }
    }

    function updateRotationTriggerFields() {
      if (!officialAppRotationTrigger || !switchIntervalField || !switchIntervalUnitField) return;

      const useVideoEnd = officialAppRotationTrigger.value === "video_end";
      switchIntervalField.style.display = useVideoEnd ? "none" : "block";
      switchIntervalUnitField.style.display = useVideoEnd ? "none" : "block";
    }

    function fillBrowserRotationFields() {
      if (!switchIntervalUnit || !pageDurationUnit || !switchIntervalValue || !pageDurationValue || !switchIntervalSeconds || !pageDurationSeconds) {
        return;
      }

      const switchDivisor = switchIntervalUnit.value === "minutes" ? 60 : 1;
      const durationDivisor = pageDurationUnit.value === "minutes" ? 60 : 1;

      switchIntervalValue.value = switchIntervalSeconds.value ? Math.max(1, Number(switchIntervalSeconds.value) / switchDivisor) : "";
      pageDurationValue.value = pageDurationSeconds.value ? Math.max(1, Number(pageDurationSeconds.value) / durationDivisor) : "";
    }

    function syncBrowserRotationHiddenFields() {
      if (!switchIntervalUnit || !pageDurationUnit || !switchIntervalValue || !pageDurationValue || !switchIntervalSeconds || !pageDurationSeconds) {
        return;
      }

      const switchMultiplier = switchIntervalUnit.value === "minutes" ? 60 : 1;
      const durationMultiplier = pageDurationUnit.value === "minutes" ? 60 : 1;

      switchIntervalSeconds.value = switchIntervalValue.value ? Math.max(1, Math.round(Number(switchIntervalValue.value) * switchMultiplier)) : "";
      pageDurationSeconds.value = pageDurationValue.value ? Math.max(1, Math.round(Number(pageDurationValue.value) * durationMultiplier)) : "";
    }

    if (!tvTypeField) return;

    function updatePowerHint() {
      const tvType = tvTypeField.value;

      if (tvType === "android_tv" || tvType === "fire_tv") {
        powerMethodHint.textContent = "<%= j I18n.t("AdbPowerHintFull") %>";
        adbPortWrapper.style.display = "block";
        tvMacWrapper.style.display = "none";
        if (keepAppForegroundWrapper) keepAppForegroundWrapper.style.display = "block";
      } else {
        powerMethodHint.textContent = "<%= j I18n.t("WakeOnLanPowerHint") %>";
        adbPortWrapper.style.display = "none";
        tvMacWrapper.style.display = "block";
        if (keepAppForegroundWrapper) keepAppForegroundWrapper.style.display = "none";
      }
    }

    async function checkTvStatus() {
      const tvIp = tvIpField.value.trim();
      const adbHost = adbHostField ? adbHostField.value.trim() : "";
      if (!tvIp && !adbHost) {
        statusResult.textContent = "<%= j I18n.t("InformTvIpToCheck") %>";
        statusResult.className = "helper-text status-offline";
        return;
      }

      const requestUrl = new URL("<%= check_tv_status_broadcasts_path %>", window.location.origin);
      requestUrl.searchParams.set("tv_ip", tvIp);
      requestUrl.searchParams.set("adb_host", adbHost);
      requestUrl.searchParams.set("tv_device_type", tvTypeField.value);
      requestUrl.searchParams.set("adb_port", adbPortField ? adbPortField.value : "");

      statusResult.textContent = "<%= j I18n.t("CheckingTv") %>";
      statusResult.className = "helper-text";

      try {
        const response = await fetch(requestUrl.toString(), {
          headers: { "Accept": "application/json" }
        });
        const data = await response.json();

        powerMethodHint.textContent = data.control_mode;
        statusResult.textContent = data.online ? "<%= j I18n.t("TvOnline") %>" : "<%= j I18n.t("TvOffline") %>";
        statusResult.className = "helper-text " + (data.online ? "status-online" : "status-offline");
      } catch (_error) {
        statusResult.textContent = "<%= j I18n.t("TvCheckFailed") %>";
        statusResult.className = "helper-text status-offline";
      }
    }

    updatePowerHint();
    tvTypeField.addEventListener("change", updatePowerHint);
    updatePlaybackModeFields();
    updateRotationTriggerFields();
    fillBrowserRotationFields();

    if (playbackTypeField) {
      playbackTypeField.addEventListener("change", updatePlaybackModeFields);
    }

    if (officialAppWebEnabledField) {
      officialAppWebEnabledField.addEventListener("change", updatePlaybackModeFields);
    }

    if (officialAppWebOnlyField) {
      officialAppWebOnlyField.addEventListener("change", updatePlaybackModeFields);
    }

    if (officialAppRotationTrigger) {
      officialAppRotationTrigger.addEventListener("change", updateRotationTriggerFields);
    }

    [switchIntervalUnit, pageDurationUnit].forEach((field) => {
      if (!field) return;

      field.addEventListener("change", fillBrowserRotationFields);
    });

    [switchIntervalValue, pageDurationValue].forEach((field) => {
      if (!field) return;

      field.addEventListener("input", syncBrowserRotationHiddenFields);
      field.addEventListener("change", syncBrowserRotationHiddenFields);
    });

    if (statusButton) {
      statusButton.addEventListener("click", checkTvStatus);
    }

    if (tvIpField) {
      tvIpField.addEventListener("blur", function () {
        if (tvIpField.value.trim() !== "") {
          checkTvStatus();
        }
      });
    }

    if (broadcastForm) {
      broadcastForm.addEventListener("submit", syncBrowserRotationHiddenFields);
    }
  }

  function initializeBroadcastConfigTabs() {
    const form = document.querySelector(".broadcast-edit-form");
    if (!form || form.dataset.configTabsBound === "true") return;
    const tabs = Array.from(form.querySelectorAll("[data-broadcast-config-tab]"));
    const panels = Array.from(form.querySelectorAll("[data-broadcast-config-panel]"));
    if (!tabs.length || !panels.length) return;
    form.dataset.configTabsBound = "true";

    const activate = (name, updateHash = true) => {
      const selected = tabs.find((tab) => tab.dataset.broadcastConfigTab === name) || tabs[0];
      const selectedName = selected.dataset.broadcastConfigTab;
      tabs.forEach((tab) => {
        const active = tab === selected;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        const active = selectedName === "general" || panel.dataset.broadcastConfigPanel === selectedName;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
      if (updateHash) history.replaceState(null, "", `#tv-${selectedName}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab.dataset.broadcastConfigTab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = tabs[(index + direction + tabs.length) % tabs.length];
        activate(next.dataset.broadcastConfigTab);
        next.focus();
      });
    });

    form.addEventListener("invalid", (event) => {
      const panel = event.target.closest("[data-broadcast-config-panel]");
      if (panel) activate(panel.dataset.broadcastConfigPanel);
    }, true);

    const requested = window.location.hash.replace("#tv-", "");
    activate(tabs.some((tab) => tab.dataset.broadcastConfigTab === requested) ? requested : "general", false);
  }

  document.addEventListener("DOMContentLoaded", initializeBroadcastForm);
  document.addEventListener("turbo:load", initializeBroadcastForm);
</script>
