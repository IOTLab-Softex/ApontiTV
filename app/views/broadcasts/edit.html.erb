<% content_for :page_kicker, "Broadcast Management" %>
<% content_for :page_title, I18n.t('Edit Broadcast') %>
<% content_for :page_subtitle, I18n.t("EditBroadcastSubtitle") %>

<%= render "editor",
           broadcast: @broadcast,
           show_delete: true,
           show_timeline_button: true,
           submit_label: I18n.t('Update Broadcast'),
           subtitle: I18n.t("EditBroadcastFormSubtitle"),
           form_html: { id: 'broadcast-form' } %>

<%= render "editor_styles" %>
<%= render "playlist_editor_modal" %>

<div id="timeline-modal" class="modal-overlay">
  <div class="modal-content">
    <span class="close-modal" id="close-timeline">&times;</span>
    <h2><%= I18n.t("VideoSchedule") %></h2>

    <div class="field">
      <label><%= I18n.t("SelectPeriod") %>:</label>
      <input type="text" id="date-range" class="input-field" placeholder="<%= I18n.t("ChooseDate") %>">
      <button id="add-period" class="add-period-btn"><%= I18n.t("AddPeriod") %></button>
    </div>

    <div id="period-list"></div>
  </div>
</div>

<div class="broadcast-update-playback-modal" data-update-playback-modal hidden>
  <div class="broadcast-update-playback-modal__backdrop" data-update-playback-choice="0"></div>
  <div class="broadcast-update-playback-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="broadcast-update-playback-title">
    <div class="broadcast-update-playback-modal__header">
      <span class="broadcast-update-playback-modal__icon"><i class="fas fa-broadcast-tower" aria-hidden="true"></i></span>
      <div>
        <strong id="broadcast-update-playback-title"><%= I18n.t("UpdatePlaybackQuestion") %></strong>
        <p><%= I18n.t("SendChangeNowToTv", tv: @broadcast.name.presence || I18n.t("ThisTv")) %></p>
      </div>
    </div>

    <div class="broadcast-update-playback-modal__body">
      <p><%= I18n.t("UpdatePlaybackHelpHtml").html_safe %></p>
    </div>

    <div class="broadcast-update-playback-modal__footer">
      <button type="button" class="broadcast-update-playback-modal__btn broadcast-update-playback-modal__btn--ghost" data-update-playback-choice="0"><%= I18n.t("SaveWithoutUpdating") %></button>
      <button type="button" class="broadcast-update-playback-modal__btn broadcast-update-playback-modal__btn--primary" data-update-playback-choice="1"><%= I18n.t("UpdatePlayback") %></button>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css">
<script src="https://cdn.jsdelivr.net/npm/litepicker/dist/litepicker.js"></script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.css" rel="stylesheet" />

<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("timeline-modal");
  const openModalBtn = document.getElementById("open-timeline");
  const closeModalBtn = document.getElementById("close-timeline");

  openModalBtn.addEventListener("click", function () {
    modal.style.display = "flex";
  });

  closeModalBtn.addEventListener("click", function () {
    modal.style.display = "none";
  });

  window.addEventListener("click", function (event) {
    if (event.target === modal) {
      modal.style.display = "none";
    }
  });
});


document.addEventListener("DOMContentLoaded", function() {
  const broadcastForm = document.getElementById("broadcast-form");
  const updatePlaybackModal = document.querySelector("[data-update-playback-modal]");

  if (broadcastForm) {
    const setUpdatePlaybackChoice = (value) => {
      let input = broadcastForm.querySelector("input[name='update_playback_after_save']");
      if (!input) {
        input = document.createElement("input");
        input.type = "hidden";
        input.name = "update_playback_after_save";
        broadcastForm.appendChild(input);
      }
      input.value = value;
    };

    const submitWithSchedules = async () => {
      const formData = new FormData();
      const broadcastId = "<%= @broadcast.id %>";
      let hasData = false;

      document.querySelectorAll(".period-item").forEach((item, index) => {
        const periodInput = item.querySelector("input[type='hidden']");
        const videoInput = item.querySelector("input[type='file']");

        if (!periodInput || !videoInput) return;

        const period = periodInput.value;
        const video = videoInput.files[0];

        if (!period || !video) return;

        const [start, end] = period.split(" - ");
        const startDate = moment(start, "DD/MM/YYYY").format("YYYY-MM-DD");
        const endDate = moment(end, "DD/MM/YYYY").format("YYYY-MM-DD");

        formData.append(`schedules[${index}][start_date]`, startDate);
        formData.append(`schedules[${index}][end_date]`, endDate);
        formData.append(`schedules[${index}][video]`, video);
        formData.append(`schedules[${index}][broadcast_id]`, broadcastId);

        hasData = true;
      });

      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

      try {
        if (hasData) {
          const response = await fetch("/schedules/bulk_create", {
            method: "POST",
            body: formData,
            headers: {
              "X-CSRF-Token": csrfToken
            }
          });

          if (!response.ok) {
            const text = await response.text();
            throw new Error("Erro inesperado: " + text);
          }
        }

        broadcastForm.submit();
      } catch (error) {
        alert("Erro ao salvar: " + error.message);
        console.error(error);
      }
    };

    const openUpdatePlaybackModal = () => {
      if (!updatePlaybackModal) {
        setUpdatePlaybackChoice("0");
        submitWithSchedules();
        return;
      }

      updatePlaybackModal.hidden = false;
      document.body.classList.add("broadcast-modal-open");
    };

    const closeUpdatePlaybackModal = () => {
      if (!updatePlaybackModal) return;

      updatePlaybackModal.hidden = true;
      document.body.classList.remove("broadcast-modal-open");
    };

    updatePlaybackModal?.querySelectorAll("[data-update-playback-choice]").forEach((button) => {
      button.addEventListener("click", () => {
        setUpdatePlaybackChoice(button.dataset.updatePlaybackChoice || "0");
        closeUpdatePlaybackModal();
        submitWithSchedules();
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && updatePlaybackModal && !updatePlaybackModal.hidden) {
        setUpdatePlaybackChoice("0");
        closeUpdatePlaybackModal();
      }
    });

    broadcastForm.addEventListener("submit", async function(event) {
      event.preventDefault();
      openUpdatePlaybackModal();
    });
  }
});


document.addEventListener("DOMContentLoaded", function() {
  let removedScheduleIds = [];

  const picker = new Litepicker({
    element: document.getElementById('date-range'),
    singleMode: false,
    numberOfMonths: 1,
    numberOfColumns: 1,
    format: 'DD/MM/YYYY',
    allowRepick: true,
    minDate: new Date()
  });

  let periods = [];

  document.getElementById("add-period").addEventListener("click", function () {
    const dateInput = document.getElementById("date-range").value;
    if (dateInput === "") {
      alert("<%= j I18n.t("SelectPeriodBeforeAdd") %>");
      return;
    }

    const periodId = `period-${periods.length}`;
    const [start, end] = dateInput.split(" - ");
    const startDate = moment(start, "DD/MM/YYYY").format("DD/MM/YYYY");
    const endDate = moment(end, "DD/MM/YYYY").format("DD/MM/YYYY");

    const periodHTML = `
      <div class="period-item" id="${periodId}">
        <strong><%= j I18n.t("Period") %>:</strong> ${startDate} - ${endDate}
        <input type="hidden" name="periods[]" value="${startDate} - ${endDate}">
        <input type="file" name="videos[]" class="video-upload" accept="video/*">
        <button class="remove-period" onclick="removePeriod('${periodId}')"><%= j I18n.t("Remove") %></button>
      </div>
    `;

    document.getElementById("period-list").insertAdjacentHTML("beforeend", periodHTML);
    periods.push(dateInput);
    document.getElementById("date-range").value = "";
  });


  window.removePeriod = function(periodId, scheduleId = null) {
    const element = document.getElementById(periodId);
    element.remove();

    if (scheduleId) {
      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

      fetch("/schedules/destroy_schedule", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({ id: scheduleId })
      })
      .then(res => res.json())
      .then(data => {
        if (data.error) {
          alert("Erro ao excluir: " + data.error);
        }
      })
      .catch(err => {
        console.error("Erro ao excluir:", err);
      });
    }
  };



  document.getElementById("save-all")?.addEventListener("click", function() {
    const formData = new FormData();
    const broadcastId = "<%= @broadcast.id %>";
    if (removedScheduleIds.length > 0) {
      removedScheduleIds.forEach(id => {
        formData.append("removed_ids[]", id);
      });
    }
    let hasData = false;


    document.querySelectorAll(".period-item").forEach((item, index) => {
      const period = item.querySelector("input[type='hidden']").value;
      const video = item.querySelector("input[type='file']").files[0];

      if (!period || !video) {
        alert("Cada periodo deve ter um video associado!");
        return;
      }

      const [start, end] = period.split(" - ");
      const startDate = moment.utc(start).format("DD/MM/YYYY");
      const endDate = moment.utc(end).format("DD/MM/YYYY");

      formData.append(`schedules[${index}][start_date]`, startDate);
      formData.append(`schedules[${index}][end_date]`, endDate);
      formData.append(`schedules[${index}][video]`, video);
      formData.append(`schedules[${index}][broadcast_id]`, broadcastId);

      hasData = true;
    });

    if (!hasData) {
      alert("<%= j I18n.t("NoPeriodAdded") %>");
      return;
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

    fetch("/schedules/bulk_create", {
      method: "POST",
      body: formData,
      headers: {
        "X-CSRF-Token": csrfToken
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.error) {
        alert("<%= j I18n.t("SaveErrorPrefix") %>: " + data.error);
      } else {
        alert("<%= j I18n.t("PeriodsSaved") %>");
        location.reload();
      }
    })
    .catch(error => {
      console.error("<%= j I18n.t("SaveErrorPrefix") %>:", error);
      alert("<%= j I18n.t("SendDataError") %>");
    });
  });
});

window.updateVideoName = function(input) {
  const span = input.parentElement.querySelector(".video-name");
  const fileName = input.files[0]?.name || "<%= j I18n.t("NoVideoSelected") %>";
  if (span) span.textContent = `<%= j I18n.t("Video") %>: ${fileName}`;
}


document.addEventListener("DOMContentLoaded", function () {
  const periodList = document.getElementById("period-list");
  const existingSchedules = <%= @schedules.to_json.html_safe %>;

  existingSchedules.forEach(schedule => {
    const startDate = moment.utc(schedule.start).format("DD/MM/YYYY");
    const endDate = moment.utc(schedule.end).format("DD/MM/YYYY");
    const videoName = schedule.video ? schedule.video.split('/').pop() : "<%= j I18n.t("NoVideo") %>";
    const periodId = `period-${schedule.id}`;

    const periodHTML = `
      <div class="period-item" id="${periodId}">
        <strong><%= j I18n.t("Period") %>:</strong> ${startDate} - ${endDate} | <strong><%= j I18n.t("Video") %>:</strong> ${videoName}
        <div>
          <input type="file" name="videos[]" class="video-upload" accept="video/*">
          <button class="remove-period" onclick="removePeriod('${periodId}', ${schedule.id})"><%= j I18n.t("Remove") %></button>
        </div>
      </div>
    `;

    periodList.insertAdjacentHTML("beforeend", periodHTML);
  });
});


$(document).ready(function() {
  $('#calendar').fullCalendar({
    events: '/broadcasts/events',
    editable: true,
    droppable: true,
    eventDrop: function(event) {
      $.ajax({
        url: '/broadcasts/update_event',
        method: 'PATCH',
        data: {
          event_id: event.id,
          start: event.start.format(),
          end: event.end.format()
        }
      });
    },
    eventClick: function(event) {
      alert('Event clicked: ' + event.title);
    }
  });

  $('#schedule_checkbox').change(function() {
    if ($(this).is(':checked')) {
      $('#calendar_field').show();
    } else {
      $('#calendar_field').hide();
    }
  });
});
</script>

