  .notification {
    background: #323232;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    font-size: 14px;
    animation: fadein 0.3s ease, fadeout 0.3s ease 3.7s;
    opacity: 0;
    animation-fill-mode: forwards;
  }

  @keyframes fadein {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
