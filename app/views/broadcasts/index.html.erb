  <script>
    function setupPlaylistEditorHelp(){const modal=document.querySelector('[data-playlist-editor-modal]'),dialog=modal?.querySelector('.broadcast-playlist-editor-modal__dialog'),open=modal?.querySelector('[data-playlist-editor-help-open]'),overlay=document.querySelector('[data-playlist-editor-help-overlay]'),host=overlay?.querySelector('[data-playlist-editor-help-callouts]');if(!modal||!dialog||!open||!overlay||!host||open.dataset.helpBound==='true')return;open.dataset.helpBound='true';let bubbles=[];
      function position(){
