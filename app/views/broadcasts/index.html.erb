  .broadcast-card-modern__wallpaper-frame {
    --wallpaper-apply-left: 75%;
    position: relative;
    overflow: visible;
  }

  .broadcast-card-modern__wallpaper-progress::before,
  .broadcast-card-modern__wallpaper-progress::after {
    content: "";
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }

  .broadcast-card-modern__wallpaper-progress::before {
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    padding: 2px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, .95), rgba(196, 126, 255, .95) 24%, rgba(139, 47, 242, .94) 52%, rgba(255, 255, 255, .78) 76%, rgba(107, 33, 168, .92)) border-box;
    clip-path: inset(0 calc(100% - var(--wallpaper-progress)) 0 0);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    filter: drop-shadow(0 0 9px rgba(168, 85, 247, .9)) drop-shadow(0 0 18px rgba(139, 47, 242, .58));
    transition: clip-path 3s cubic-bezier(.22, 1, .36, 1), opacity .22s ease;
  }

  .broadcast-card-modern__wallpaper-progress::after {
    top: 5px;
    bottom: 5px;
    left: var(--wallpaper-progress);
    z-index: 3;
    width: 3px;
    border-radius: 999px;
    transform: translateX(-50%);
    background:
      linear-gradient(180deg, transparent, rgb(162 77 246) 16%, rgba(196, 126, 255, .98) 45%, rgb(161 76 246) 74%, transparent),
      radial-gradient(circle, rgba(216, 180, 254, .9), rgba(139, 47, 242, 0) 68%);
    box-shadow: 0 0 16px rgba(216, 180, 254, .92), 0 0 28px rgba(139, 47, 242, .68);
    transition: left 3s cubic-bezier(.22, 1, .36, 1), opacity .22s ease;
  }

  .broadcast-card-modern__wallpaper-progress--pending::before,
  .broadcast-card-modern__wallpaper-progress--pending::after,
  .broadcast-card-modern__wallpaper-progress--applying::before,
  .broadcast-card-modern__wallpaper-progress--applying::after {
    opacity: 1;
  }

  .broadcast-card-modern__wallpaper-progress--resetting::before,
  .broadcast-card-modern__wallpaper-progress--resetting::after,
  .broadcast-card-modern__wallpaper-progress--button-catching::before,
  .broadcast-card-modern__wallpaper-progress--button-catching::after {
    transition: none;
  }

  .broadcast-card-modern__wallpaper-progress--applying::before {
    transition-duration: 1.45s;
  }

  .broadcast-card-modern__wallpaper-progress--applying::after {
    transition-duration: 1.45s;
  }

  .broadcast-card-modern__wallpaper-layer {
