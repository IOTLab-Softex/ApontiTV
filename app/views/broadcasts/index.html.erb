      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }

    .broadcasts-toolbar {
      align-items: stretch;
    }

    .broadcasts-view-switch {
      width: 100%;
    }

    .broadcasts-view-switch {
      justify-content: space-between;
    }

    .broadcasts-view-switch__btn {
