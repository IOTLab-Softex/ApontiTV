  }

  .broadcasts-cards-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 22px;
    padding: 10px 0 20px;
    align-items: start;
  }

  .broadcasts-cards-main {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 22px;
    min-width: 0;
  }

  .broadcasts-side-panel {
    display: grid;
    gap: 22px;
    min-width: 0;
  }

  .broadcast-card-modern {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: 16px;
    color: #f8fbff;
    background:
      radial-gradient(circle at 16% 0%, rgba(127, 56, 230, .13), transparent 190px),
      linear-gradient(180deg, #151b31 0%, #12182b 100%);
    border: 1px solid rgba(169, 184, 220, .16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .055),
      0 2px 5px rgba(2, 6, 23, .24),
      0 16px 38px rgba(2, 6, 23, .3);
    isolation: isolate;
    overflow: hidden;
    transition: transform .22s cubic-bezier(.2, 0, 0, 1), border-color .22s ease, box-shadow .22s ease;
  }

  .broadcast-card-modern::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, .045), transparent 38%);
  }

  .broadcast-card-modern:hover {
    transform: translateY(-3px);
    border-color: rgba(167, 139, 250, .3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .07),
      0 5px 10px rgba(2, 6, 23, .25),
      0 24px 52px rgba(2, 6, 23, .38);
  }

  .broadcast-card-modern__top {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    padding-right: 18px;
  }

  .broadcast-card-modern__top h2 {
    margin: 0;
    font-size: 16px;
    line-height: 1.25;
    color: #ffffff;
    text-transform: uppercase;
  }

  .broadcast-card-modern__top p {
    margin: 8px 0 0;
    color: #a8b4ce;
    font-size: 12px;
    line-height: 1.35;
  }

  .broadcast-presentation-toggle-form {
    display: inline-flex;
    margin: 0;
  }

  .broadcast-presentation-toggle {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #9ca8c4;
    background: rgba(148, 163, 184, .09);
    cursor: pointer;
    transition: color .18s ease, background .18s ease, border-color .18s ease, transform .18s ease;
  }

  .broadcast-presentation-toggle:hover {
    color: #fff;
    transform: translateY(-1px);
  }

  .broadcast-presentation-toggle.is-active {
    color: #e9d5ff;
    border-color: rgba(168, 85, 247, .46);
    background: rgba(126, 34, 206, .3);
    box-shadow: 0 0 15px rgba(168, 85, 247, .24);
  }

  .broadcast-card-modern__video {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 20%, rgba(138, 57, 244, .35), transparent 42%),
      linear-gradient(135deg, #28145b 0%, #141b34 56%, #10172b 100%);
    min-height: 210px;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(139, 92, 246, .15);
  }

  .broadcast-card-modern__video--portrait {
    aspect-ratio: 9 / 16;
    min-height: 290px;
    max-width: 150px;
    margin: 0 auto;
    border-color: rgba(172, 188, 230, .18);
  }

  .broadcast-card-modern__video--landscape {
    aspect-ratio: 16 / 9;
  }

  .broadcast-card-modern__video .broadcast-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    transform: none;
    object-fit: contain;
    object-position: center center;
    background: #050917;
  }

  .broadcast-preview-web,
  .broadcast-preview-modal__web {
    border: 0;
  }

  .broadcast-preview-web[hidden],
  .broadcast-preview-modal__web[hidden] {
    display: none !important;
  }

  .broadcast-preview-modal__image[hidden] {
    display: none !important;
  }

  .broadcast-card-modern__preview-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 50% 40%, rgba(139, 47, 242, .24), transparent 42%),
      rgba(5, 9, 23, .82);
  }

  .broadcast-card-modern__preview-loading[hidden] {
    display: none !important;
  }

  .broadcast-card-modern__preview-loading span {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 3px solid rgba(216, 180, 254, .24);
    border-top-color: #a855f7;
    animation: broadcast-preview-spin .85s linear infinite;
  }

  @keyframes broadcast-preview-spin {
    to { transform: rotate(360deg); }
  }

  .broadcast-card-modern__preview-open {
    position: absolute;
    inset: 0;
    z-index: 4;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    background: rgba(2, 6, 23, .08);
    opacity: 0;
    cursor: pointer;
    transition: opacity .18s ease, background .18s ease;
  }

  .broadcast-card-modern__preview-open i {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background: rgba(139, 47, 242, .78);
    box-shadow: 0 18px 36px rgba(88, 28, 135, .36);
    backdrop-filter: blur(12px);
    transform: translateY(-50%) scale(.92);
    transition: transform .18s ease;
  }

  .broadcast-card-modern__slide-dots {
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 100%;
    min-height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 4px 8px;
    margin: 8px auto 0;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(3, 7, 18, .48);
    pointer-events: none;
  }

  .broadcast-card-modern__slide-dots[hidden] {
    display: none;
  }

  .broadcast-card-modern__slide-dots span {
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .42);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .12);
    transition: width .22s ease, background .22s ease, box-shadow .22s ease;
  }

  .broadcast-card-modern__slide-dots span.is-active {
    width: 18px;
    flex-basis: 18px;
    border-radius: 999px;
    background: #a855f7;
    box-shadow: 0 0 10px rgba(168, 85, 247, .82);
    animation: broadcast-slide-dot-active .55s ease-out;
  }

  @keyframes broadcast-slide-dot-active {
    0% {
      opacity: .45;
      transform: scale(.65);
    }
    55% {
      opacity: 1;
      transform: scale(1.12);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .broadcast-card-modern__video:hover .broadcast-card-modern__preview-open,
  .broadcast-card-modern__preview-open:focus-visible {
    opacity: 1;
    background: rgba(2, 6, 23, .34);
  }

  .broadcast-card-modern__video:hover .broadcast-card-modern__preview-open i,
  .broadcast-card-modern__preview-open:focus-visible i {
    transform: scale(1);
  }

  .broadcast-card-modern__video-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background:
      radial-gradient(circle at 76% 12%, rgba(108, 44, 205, .34), transparent 38%),
      radial-gradient(circle at 18% 18%, rgba(160, 80, 255, .28), transparent 42%),
      linear-gradient(135deg, rgba(39, 20, 91, .94), rgba(15, 23, 42, .96));
  }

  .broadcast-card-modern__video-fallback::before {
    content: "\f26c";
    width: 40px;
    height: 34px;
    border: 2px solid rgba(178, 135, 255, .72);
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #b88cff;
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-size: 18px;
  }

  .broadcast-card-modern__video-fallback[hidden] {
    display: none !important;
  }

  .broadcast-preview-modal {
    position: fixed;
    inset: 0;
    z-index: 1500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .broadcast-preview-modal[hidden] {
    display: none !important;
  }

  .broadcast-publish-modal {
    position: fixed;
    inset: 0;
    z-index: 1600;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .broadcast-publish-modal[hidden] {
    display: none !important;
  }

  .broadcast-publish-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 18, 0.78);
    backdrop-filter: blur(8px);
  }

  .broadcast-publish-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100vw - 32px));
    height: min(92vh, 860px);
    max-height: calc(100vh - 48px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 12px;
    color: #f8fbff;
    background: linear-gradient(180deg, #151b31 0%, #101729 100%);
