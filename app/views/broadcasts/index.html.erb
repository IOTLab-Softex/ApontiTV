            <div class="broadcast-playlist-editor__settings-grid">
              <label class="broadcast-playlist-field">
                <span><%= I18n.t("PlaylistName") %></span>
                <div class="broadcast-playlist-input-wrap">
                  <i class="far fa-file-video" aria-hidden="true"></i>
                  <input type="text" name="name" data-playlist-name value="<%= I18n.t("NewPlaylist") %>" required>
