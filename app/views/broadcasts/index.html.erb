.broadcasts-footer {
    display: flex;
    justify-content: flex-end;
    /* margin-top: 16px; */
    color: #64748b;
    font-size: 13px;
    position: fixed;
    bottom: 14px;
    z-index: 9999;
    right: 20px;
}

.broadcasts-footer__release {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(139, 47, 242, .18);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    background: rgba(255, 255, 255, .62);
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    backdrop-filter: blur(10px);
    transition: transform .18s ease, color .18s ease, border-color .18s ease, background .18s ease;
}

.broadcasts-footer__release i {
    color: #8b2ff2;
}

.broadcasts-footer__release:hover {
    transform: translateY(-1px);
    color: #8b2ff2;
    border-color: rgba(139, 47, 242, .42);
    background: rgba(255, 255, 255, .88);
}

html[data-theme="dark"] .broadcasts-footer__release,
body.theme-dark .broadcasts-footer__release {
    background: rgba(15, 23, 42, .72);
    color: #a8b4ce;
    border-color: rgba(168, 85, 247, .22);
}

html[data-theme="dark"] .broadcasts-footer__release:hover,
body.theme-dark .broadcasts-footer__release:hover {
    color: #f8f7ff;
    background: rgba(30, 41, 59, .84);
}

  .notification-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1400;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .notification {
    background: #323232;
    color: white;
    padding: 12px 20px;
    border-radius: 6px;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    font-size: 14px;
    animation: fadein 0.3s ease, fadeout 0.3s ease 3.7s;
    opacity: 0;
    animation-fill-mode: forwards;
  }

  @keyframes fadein {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeout {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

