      function close(){overlay.hidden=true;dialog.classList.remove('is-publish-help-active');open.setAttribute('aria-pressed','false');host.replaceChildren();bubbles=[]}
      function show(){overlay.hidden=false;dialog.classList.add('is-publish-help-active');open.setAttribute('aria-pressed','true');const mainTargets=[dialog.querySelector('.broadcast-playlist-editor__settings[data-playlist-editor-help-tip]'),dialog.querySelector('.broadcast-playlist-editor__library-section[data-playlist-editor-help-tip]'),dialog.querySelector('.broadcast-playlist-editor__order-section[data-playlist-editor-help-tip]')].filter(Boolean),settingTargets=[...dialog.querySelectorAll('[data-playlist-settings-help-tip]')],footerTargets=[...dialog.querySelectorAll('.broadcast-publish-modal__footer [data-playlist-editor-help-tip]')],targets=[...mainTargets,...settingTargets,...footerTargets];bubbles=targets.map((target,index)=>{const bubble=document.createElement('article');bubble.className='publish-help-callout playlist-editor-help-callout';bubble.innerHTML=`<b>${index+1}</b><p>${target.dataset.playlistEditorHelpTip||target.dataset.playlistSettingsHelpTip}</p>`;host.appendChild(bubble);return{target,bubble,settingIndex:target.hasAttribute('data-playlist-settings-help-tip')?settingTargets.indexOf(target):null,footerIndex:footerTargets.includes(target)?footerTargets.indexOf(target):null}});requestAnimationFrame(()=>requestAnimationFrame(position))}
      open.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();overlay.hidden?show():close()});modal.querySelectorAll('[data-playlist-editor-close]').forEach(button=>button.addEventListener('click',close));window.addEventListener('resize',position);document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!overlay.hidden)close()})}
    document.addEventListener('DOMContentLoaded',setupPlaylistEditorHelp);document.addEventListener('turbo:load',setupPlaylistEditorHelp);if(document.readyState!=='loading')setupPlaylistEditorHelp();
  </script>
