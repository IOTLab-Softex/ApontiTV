  .broadcasts-panel--table .broadcasts-table__avatar { width:48px;height:48px;flex-basis:48px;border-radius:11px;background:linear-gradient(145deg,#7c3aed,#a855f7);box-shadow:0 8px 22px rgba(124,58,237,.42),0 0 18px rgba(168,85,247,.22);font-size:18px; }
