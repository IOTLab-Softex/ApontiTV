<script>
    function setupPublishHelp(){const modal=document.querySelector('[data-publish-modal]'),dialog=modal?.querySelector('.broadcast-publish-modal__dialog'),open=modal?.querySelector('[data-publish-help-open]'),footerOpen=modal?.querySelector('[data-publish-footer-help-open]'),overlay=document.querySelector('[data-publish-help-overlay]'),host=overlay?.querySelector('[data-publish-help-callouts]');if(!modal||!dialog||!open||!overlay||!host||open.dataset.helpBound==='true')return;open.dataset.helpBound='true';let bubbles=[];
      function position(){if(overlay.hidden)return;bubbles.forEach(item=>{const r=item.target.getBoundingClientRect(),b=item.bubble,above=r.top>b.offsetHeight+18,top=above?r.top-b.offsetHeight-12:r.bottom+12,left=Math.max(10,Math.min(r.left+r.width/2-b.offsetWidth/2,innerWidth-b.offsetWidth-10));b.classList.toggle('is-top',above);b.classList.toggle('is-bottom',!above);b.style.left=`${left}px`;b.style.top=`${Math.max(8,Math.min(top,innerHeight-b.offsetHeight-8))}px`;b.style.setProperty('--publish-arrow-x',`${Math.max(15,Math.min(r.left+r.width/2-left,b.offsetWidth-15))}px`)})}
      function close(){overlay.hidden=true;dialog.classList.remove('is-publish-help-active');open.setAttribute('aria-pressed','false');footerOpen?.setAttribute('aria-pressed','false');host.replaceChildren();bubbles=[]}
      function show(targets){overlay.hidden=false;dialog.classList.add('is-publish-help-active');host.replaceChildren();bubbles=[...targets].map((target,index)=>{const bubble=document.createElement('article');bubble.className='publish-help-callout';bubble.innerHTML=`<b>${index+1}</b><p>${target.dataset.publishHelpTip}</p>`;host.appendChild(bubble);return{target,bubble}});requestAnimationFrame(()=>requestAnimationFrame(position))}
      open.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();if(overlay.hidden){open.setAttribute('aria-pressed','true');show(dialog.querySelectorAll('[data-publish-help-tip]'))}else close()});footerOpen?.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();if(overlay.hidden){footerOpen.setAttribute('aria-pressed','true');show(dialog.querySelectorAll('.broadcast-publish-modal__footer [data-publish-help-tip]'))}else close()});overlay.querySelector('.publish-help-overlay__shade').addEventListener('click',close);modal.querySelectorAll('[data-publish-close]').forEach(button=>button.addEventListener('click',close));window.addEventListener('resize',position);document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!overlay.hidden)close()});if(new URLSearchParams(location.search).get('help')==='publish_modal'){modal.hidden=false;open.setAttribute('aria-pressed','true');show(dialog.querySelectorAll('[data-publish-help-tip]'))}}
    document.addEventListener('DOMContentLoaded',setupPublishHelp);document.addEventListener('turbo:load',setupPublishHelp);if(document.readyState!=='loading')setupPublishHelp();
    function setupPublishDialogWheel(){const dialog=document.querySelector('[data-publish-modal] .broadcast-publish-modal__dialog'),body=dialog?.querySelector('.broadcast-publish-modal__body');if(!dialog||!body||dialog.dataset.wheelBound==='true')return;dialog.dataset.wheelBound='true';dialog.addEventListener('wheel',function(event){if(body.contains(event.target))return;event.preventDefault();body.scrollBy({top:event.deltaY,left:0,behavior:'auto'})},{passive:false})}
    document.addEventListener('DOMContentLoaded',setupPublishDialogWheel);document.addEventListener('turbo:load',setupPublishDialogWheel);if(document.readyState!=='loading')setupPublishDialogWheel();
  </script>

