    font-size: 12px;
    font-weight: 700;
  }

  .broadcast-publish-requirements.is-ready { color: #6ee7b7; }

  [data-publish-submit]:disabled {
    opacity: .42;
    cursor: not-allowed;
    filter: grayscale(.35);
    box-shadow: none;
  }

  .broadcast-publish-modal__footer {
    border-top: 1px solid rgba(172, 188, 230, .12);
    border-bottom: 0;
    flex: 0 0 auto;
    justify-content: flex-end;
    background: rgba(16, 23, 41, .96);
    backdrop-filter: blur(12px);
