            <div class="broadcast-playlist-editor__tabs" role="tablist" aria-label="<%= I18n.t("PlaylistItems") %>">
              <button type="button" class="broadcast-playlist-editor__tab is-active" data-playlist-library-tab="library" role="tab" aria-selected="true">
                <i class="fas fa-folder-open" aria-hidden="true"></i>
