    text-decoration: none;
  }

  .broadcast-dashboard-status {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }

  .broadcast-dashboard-donut {
    width: 176px;
    aspect-ratio: 1;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle, #111827 0 44%, transparent 45%),
      conic-gradient(#22c55e 0 var(--online), #ef4444 var(--online) calc(var(--online) + var(--offline)), #a855f7 calc(var(--online) + var(--offline)) 100%);
    box-shadow: inset 0 0 24px rgba(2, 6, 23, .55), 0 18px 36px rgba(2, 6, 23, .28);
  }

  .broadcast-dashboard-donut strong,
  .broadcast-dashboard-donut span {
    grid-area: 1 / 1;
  }

  .broadcast-dashboard-donut strong {
    margin-top: -8px;
    color: #fff;
    font-size: 36px;
    font-weight: 950;
  }

  .broadcast-dashboard-donut span {
    margin-top: 40px;
    color: rgba(226, 232, 240, .72);
    font-size: 13px;
    font-weight: 850;
  }

  .broadcast-dashboard-legend {
    display: grid;
    gap: 20px;
  }

  .broadcast-dashboard-legend span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    color: rgba(226, 232, 240, .72);
    font-size: 14px;
    font-weight: 850;
  }

  .broadcast-dashboard-legend i {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    margin-right: 8px;
    box-shadow: 0 0 18px currentColor;
  }

  .broadcast-dashboard-legend strong {
    color: #f8fafc;
    font-size: 13px;
    white-space: nowrap;
  }

  .broadcast-dashboard-legend .is-online { background: #22c55e; color: #22c55e; }
  .broadcast-dashboard-legend .is-offline { background: #ef4444; color: #ef4444; }
  .broadcast-dashboard-legend .is-idle { background: #a855f7; color: #a855f7; }

  .broadcast-dashboard-bars {
    display: grid;
    gap: 15px;
    padding: 8px 4px 0;
  }

  .broadcast-dashboard-bar {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 12px;
    color: rgba(226, 232, 240, .7);
    font-size: 13px;
    font-weight: 850;
  }

  .broadcast-dashboard-bar div {
    height: 34px;
    border-left: 1px solid rgba(148, 163, 184, .15);
    background:
      linear-gradient(90deg, rgba(148, 163, 184, .1) 1px, transparent 1px) 0 0 / 25% 100%,
      rgba(15, 23, 42, .38);
  }

  .broadcast-dashboard-bar i {
    display: block;
    width: var(--bar-size);
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: linear-gradient(90deg, #6d28d9, #a855f7);
    box-shadow: 0 0 22px rgba(168, 85, 247, .25);
  }

  .broadcast-dashboard-bar strong {
    color: #f8fafc;
    font-size: 13px;
  }

  .broadcast-dashboard-activity {
    display: grid;
    gap: 12px;
  }

  .broadcast-dashboard-activity__item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-height: 42px;
  }

  .broadcast-dashboard-activity__item i,
  .broadcast-dashboard-activity__empty i {
    width: 22px;
    height: 22px;
    display: inline-grid;
    place-items: center;
    color: #22c55e;
    font-size: 14px;
  }

  .broadcast-dashboard-activity__item i.is-error {
    color: #fb7185;
  }

  .broadcast-dashboard-activity__item strong {
    display: block;
    overflow: hidden;
    color: #f8fafc;
    font-size: 14px;
    font-weight: 900;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .broadcast-dashboard-activity__item span,
  .broadcast-dashboard-activity__empty span {
    display: block;
    margin-top: 3px;
    color: rgba(226, 232, 240, .52);
    font-size: 12px;
    font-weight: 800;
  }

  .broadcast-dashboard-activity__empty {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 190px;
    justify-content: center;
  }

  .broadcast-dashboard__footer {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .14);
    border-radius: 8px;
    background: rgba(15, 23, 42, .74);
  }

  .broadcast-dashboard__footer article {
    min-height: 92px;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 20px 22px;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }

  .broadcast-dashboard__footer article + article {
    border-left: 1px solid rgba(148, 163, 184, .12);
  }

  .broadcast-dashboard__footer i {
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border-radius: 8px;
    color: #f0abfc;
    background: rgba(168, 85, 247, .18);
    font-size: 18px;
  }

  .broadcast-dashboard__footer strong {
    color: #ffffff;
    font-size: 22px;
    font-weight: 950;
  }

  .broadcast-dashboard__footer em {
    grid-column: 2 / -1;
    margin-top: -16px;
    color: #22c55e;
    font-size: 12px;
    font-style: normal;
    font-weight: 900;
  }

  html[data-theme="light"] .broadcast-dashboard {
    color: #0f172a;
  }

  html[data-theme="light"] .broadcast-dashboard-stat,
  html[data-theme="light"] .broadcast-dashboard-panel,
  html[data-theme="light"] .broadcast-dashboard__footer {
    border-color: rgba(15, 23, 42, .1);
    background:
      radial-gradient(circle at 12% 0%, rgba(168, 85, 247, .11), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(248, 250, 252, .96));
    box-shadow: 0 20px 44px rgba(15, 23, 42, .08), inset 0 1px 0 rgba(255, 255, 255, .8);
  }

  html[data-theme="light"] .broadcast-dashboard-stat span,
  html[data-theme="light"] .broadcast-dashboard-stat small,
  html[data-theme="light"] .broadcast-dashboard-panel h2,
  html[data-theme="light"] .broadcast-dashboard__footer span,
  html[data-theme="light"] .broadcast-dashboard-legend span,
  html[data-theme="light"] .broadcast-dashboard-bar,
  html[data-theme="light"] .broadcast-dashboard-activity__item span,
  html[data-theme="light"] .broadcast-dashboard-activity__empty span {
    color: #64748b;
  }

  html[data-theme="light"] .broadcast-dashboard-stat strong,
  html[data-theme="light"] .broadcast-dashboard-panel h2,
  html[data-theme="light"] .broadcast-dashboard-legend strong,
  html[data-theme="light"] .broadcast-dashboard-bar strong,
  html[data-theme="light"] .broadcast-dashboard-activity__item strong,
  html[data-theme="light"] .broadcast-dashboard__footer strong {
    color: #0f172a;
  }

  html[data-theme="light"] .broadcast-dashboard-donut {
    background:
      radial-gradient(circle, #ffffff 0 44%, transparent 45%),
      conic-gradient(#22c55e 0 var(--online), #ef4444 var(--online) calc(var(--online) + var(--offline)), #a855f7 calc(var(--online) + var(--offline)) 100%);
    box-shadow: inset 0 0 24px rgba(15, 23, 42, .08), 0 18px 36px rgba(15, 23, 42, .08);
  }

  html[data-theme="light"] .broadcast-dashboard-donut strong {
    color: #0f172a;
  }

  html[data-theme="light"] .broadcast-dashboard-donut span {
    color: #64748b;
  }

  @media (max-width: 1280px) {
    .broadcast-dashboard__metrics,
    .broadcast-dashboard__footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .broadcast-dashboard__main {
      grid-template-columns: 1fr;
    }

    .broadcast-dashboard__footer article:nth-child(odd) {
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .broadcast-dashboard__metrics,
    .broadcast-dashboard__footer {
      grid-template-columns: 1fr;
    }

    .broadcast-dashboard-stat {
      min-height: 116px;
      padding: 20px;
    }

    .broadcast-dashboard-status {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .broadcast-dashboard-legend {
      width: 100%;
    }

    .broadcast-dashboard__footer article + article {
      border-left: 0;
      border-top: 1px solid rgba(148, 163, 184, .12);
    }
  }

  .broadcasts-toolbar {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 18px;
    align-items: center;
    margin-bottom: 22px;
    flex-wrap: wrap;
    border-radius: 18px;
    transition: box-shadow .22s ease;
  }

  .broadcasts-toolbar__actions:has(> .broadcasts-toolbar__help:hover),
  .broadcasts-toolbar__actions:has(> .broadcasts-toolbar__help:focus-visible),
  .broadcasts-view-switch:has(> .broadcasts-toolbar__help:hover),
  .broadcasts-view-switch:has(> .broadcasts-toolbar__help:focus-visible) {
    box-shadow: 0 0 0 2px rgba(192, 132, 252, .72), 0 0 34px rgba(168, 85, 247, .48);
  }

  [data-toolbar-help-panel].is-toolbar-help-active {
    z-index: 11002;
    box-shadow: 0 0 0 2px rgba(192, 132, 252, .72), 0 0 34px rgba(168, 85, 247, .48);
  }

  .broadcasts-toolbar__help[aria-pressed="true"] {
    color: #fff;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .toolbar-help-spotlight {
    position: fixed;
    z-index: 11000;
    inset: 0;
    pointer-events: none;
    animation: desktop-help-pane-in .22s ease both;
  }

  .toolbar-help-spotlight svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .toolbar-help-callout {
    transition-delay: var(--toolbar-help-delay, 0ms);
  }

  body.toolbar-help-callouts-visible .toolbar-help-callout {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .broadcasts-toolbar__actions {
    position: relative;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    background: var(--app-banner-border);
    padding: 6px;
    border-radius: 14px;
    transition: box-shadow .22s ease;
  }

  .broadcasts-toolbar__actions form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .broadcasts-toolbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 15px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid transparent;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    background: #fff;
    color: #172033;
    line-height: 1;
    box-sizing: border-box;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    white-space: nowrap;
    vertical-align: middle;
  }

  .broadcasts-toolbar__btn i,
  .broadcasts-toolbar__btn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .broadcasts-toolbar__btn i {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    font-size: 13px;
    text-align: center;
    margin: 0;
  }

  .broadcasts-toolbar__btn i::before {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    line-height: 1;
  }

  .broadcasts-toolbar__actions .broadcasts-toolbar__btn {
    gap: 0;
    width: 44px;
    min-width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 10px;
  }

  .broadcasts-toolbar__actions .broadcasts-toolbar__btn i {
    flex-basis: 18px;
    width: 18px;
    height: 18px;
    font-size: 15px;
  }

  .broadcasts-toolbar__actions .broadcasts-toolbar__btn span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .broadcasts-toolbar__btn:hover {
    transform: translateY(-1px);
  }

  .broadcasts-toolbar__btn--primary {
    background: linear-gradient(135deg, #8b2ff2, #a855f7);
    color: #fff;
    border-color: rgba(168, 85, 247, .28);
    box-shadow: 0 12px 24px rgba(139, 47, 242, 0.24);
  }

  .broadcasts-toolbar__btn--ghost {
    background: rgba(255, 255, 255, 0.82);
    border-color: rgba(23, 32, 51, 0.12);
  }

  .broadcasts-toolbar__btn--ghost:hover {
    border-color: rgba(249, 115, 22, 0.35);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
  }

  .broadcasts-view-switch {
    position: relative;
    display: inline-flex;
    padding: 6px;
    border-radius: 14px;
    background: var(--app-banner-border);
    gap: 6px;
    transition: box-shadow .22s ease;
  }

  .broadcasts-view-switch__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    border: 0;
    background: transparent;
    color: #475569;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: 10px;
    cursor: pointer;
  }

  .broadcasts-view-switch__btn.is-active {
    background: #fff;
    color: #172033;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .broadcasts-panel {
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 22px;
    box-shadow: 0 20px 42px rgba(15, 23, 42, 0.10);
    overflow: visible;
  }

  .broadcasts-panel--cards {
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

.broadcasts-panel--table {
  --table-surface: rgba(255, 255, 255, .82);
  --table-surface-strong: rgba(255, 255, 255, .94);
  --table-row: rgba(248, 250, 252, .66);
  --table-row-hover: rgba(139, 47, 242, .08);
  --table-border: rgba(148, 163, 184, .24);
  --table-text: #111827;
  --table-muted: #64748b;
  --table-icon: #8b2ff2;
  background:
    radial-gradient(circle at 16% 0%, rgba(139, 47, 242, .12), transparent 260px),
    var(--table-surface);
  border-color: var(--table-border);
  border-radius: 18px;
  overflow: visible;
}

[data-theme="dark"] .broadcasts-panel--table,
body.theme-dark .broadcasts-panel--table {
  --table-surface: rgba(14, 20, 38, .88);
  --table-surface-strong: rgba(19, 26, 46, .96);
  --table-row: rgba(20, 27, 48, .72);
  --table-row-hover: rgba(168, 85, 247, .13);
  --table-border: rgba(169, 184, 220, .16);
  --table-text: #f8fbff;
  --table-muted: #a8b4cc;
  --table-icon: #b88aff;
}

.broadcasts-table-wrap {
  overflow-x: auto;
  overflow-y: visible;
  padding: 14px;
  scrollbar-width: thin;
  scrollbar-color: rgba(168, 85, 247, .55) transparent;
}

  .broadcasts-table {
    width: 100%;
    min-width: 820px;
    border-collapse: separate;
    border-spacing: 0 10px;
  }

  .broadcasts-table thead th {
    position: sticky;
    top: 0;
    z-index: 3;
    text-align: left;
    padding: 12px 14px;
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--table-muted);
    background: var(--table-surface);
    border-bottom: 1px solid var(--table-border);
    backdrop-filter: blur(16px);
    white-space: nowrap;
  }

  .broadcasts-table thead th:last-child {
    text-align: center;
    min-width: 178px;
  }

  .broadcasts-table tbody tr {
    position: relative;
    z-index: 1;
    transition: transform .18s ease, filter .18s ease;
  }

  .broadcasts-table tbody tr:hover {
    z-index: 9999;
    transform: translateY(-1px);
  }

  .broadcasts-table tbody tr:has(.broadcasts-dropdown.is-open) {
    z-index: 10001;
  }

  .broadcasts-table tbody td {
    position: relative;
    max-width: 220px;
    padding: 14px;
    vertical-align: middle;
    color: var(--table-text);
    background: var(--table-row);
    border-top: 1px solid var(--table-border);
    border-bottom: 1px solid var(--table-border);
    font-size: 13px;
    overflow: visible !important;
  }

  .broadcasts-table tbody tr:hover td {
    background: var(--table-row-hover);
  }

  .broadcasts-table tbody td:first-child {
    border-left: 3px solid #a855f7;
    border-radius: 12px 0 0 12px;
  }

  .broadcasts-table tbody td:last-child {
    min-width: 178px;
    text-align: center;
    border-right: 1px solid var(--table-border);
    border-radius: 0 12px 12px 0;
  }

  .broadcasts-table__name-cell {
    min-width: 190px;
  }

  .broadcasts-table__status-cell,
  .broadcasts-table__player-cell {
    min-width: 138px;
  }

  .broadcasts-table__status-cell .broadcasts-status + .broadcasts-status {
    margin-top: 7px;
  }

  .broadcasts-table__device,
  .broadcasts-table__energy {
    display: grid;
    justify-items: start;
    gap: 7px;
    min-width: 145px;
  }

  .broadcasts-table__energy strong {
    color: var(--table-text);
    font-size: 12px;
  }

  .broadcasts-table__energy .broadcasts-table__muted,
  .broadcasts-table__stream .broadcasts-table__muted {
    margin-top: 0;
  }

  .broadcasts-table__title {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
  }

  .broadcasts-table__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: #fff;
    background: linear-gradient(135deg, #8b2ff2, #a855f7);
    box-shadow: 0 12px 22px rgba(139, 47, 242, .25);
  }

  .broadcasts-table__title strong,
  .broadcasts-table__title small,
  .broadcasts-table__muted,
  .broadcasts-table__stream code {
    display: block;
    max-width: 190px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .broadcasts-table__title strong {
    font-size: 14px;
    color: var(--table-text);
  }

  .broadcasts-table__title small,
  .broadcasts-table__muted {
    margin-top: 4px;
    color: var(--table-muted);
    font-size: 12px;
  }

  .broadcasts-table__pill,
  .broadcasts-table__code {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 6px 9px;
    border: 1px solid var(--table-border);
    border-radius: 9px;
    color: var(--table-text);
    background: rgba(148, 163, 184, .08);
    font-size: 12px;
    font-weight: 700;
  }

  .broadcasts-table__code {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }

  .broadcasts-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 26px;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .broadcasts-panel--table .broadcasts-status::before {
    content: none;
  }

  .broadcasts-status--online {
    color: #166534;
    background: #dcfce7;
    border-color: rgba(22, 101, 52, .12);
  }

  .broadcasts-status--offline {
    color: #991b1b;
    background: #fee2e2;
    border-color: rgba(153, 27, 27, .12);
  }

  .broadcasts-status--neutral {
    color: #475569;
    background: #e2e8f0;
    border-color: rgba(71, 85, 105, .12);
  }

  .broadcasts-panel--table .broadcasts-status--player-online {
    color: #047857;
    background: rgba(16, 185, 129, .14);
    border-color: rgba(16, 185, 129, .22);
  }

  .broadcasts-panel--table .broadcasts-status--player-offline {
    color: #b45309;
    background: rgba(245, 158, 11, .16);
    border-color: rgba(245, 158, 11, .24);
  }

  [data-theme="dark"] .broadcasts-panel--table .broadcasts-status--online,
  body.theme-dark .broadcasts-panel--table .broadcasts-status--online {
    color: #7ef2a5;
    background: rgba(16, 185, 129, .12);
    border-color: rgba(16, 185, 129, .22);
  }

  [data-theme="dark"] .broadcasts-panel--table .broadcasts-status--offline,
  body.theme-dark .broadcasts-panel--table .broadcasts-status--offline {
    color: #ff8492;
    background: rgba(239, 68, 68, .12);
    border-color: rgba(239, 68, 68, .22);
  }

  [data-theme="dark"] .broadcasts-panel--table .broadcasts-status--neutral,
  body.theme-dark .broadcasts-panel--table .broadcasts-status--neutral {
    color: #b6c3d8;
    background: rgba(148, 163, 184, .12);
    border-color: rgba(148, 163, 184, .2);
  }

  [data-theme="dark"] .broadcasts-panel--table .broadcasts-status--player-online,
  body.theme-dark .broadcasts-panel--table .broadcasts-status--player-online {
    color: #65f0a2;
  }

  [data-theme="dark"] .broadcasts-panel--table .broadcasts-status--player-offline,
  body.theme-dark .broadcasts-panel--table .broadcasts-status--player-offline {
    color: #f7ca74;
  }

  .broadcasts-table__stream {
    display: grid;
    gap: 5px;
    min-width: 180px;
  }

  .broadcasts-table__stream strong {
    color: var(--table-text);
    font-size: 12px;
  }

  .broadcasts-table__stream code {
    color: var(--table-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
