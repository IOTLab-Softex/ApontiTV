            <span data-playlist-upload-progress></span>
          </div>
          <small data-playlist-upload-percent>0%</small>
        </div>
      </div>
    </div>
  </div>
  <div class="publish-help-overlay" data-playlist-editor-help-overlay hidden>
    <div data-playlist-editor-help-callouts></div>
  </div>
  <script>
    function setupPlaylistEditorHelp(){const modal=document.querySelector('[data-playlist-editor-modal]'),dialog=modal?.querySelector('.broadcast-playlist-editor-modal__dialog'),open=modal?.querySelector('[data-playlist-editor-help-open]'),overlay=document.querySelector('[data-playlist-editor-help-overlay]'),host=overlay?.querySelector('[data-playlist-editor-help-callouts]');if(!modal||!dialog||!open||!overlay||!host||open.dataset.helpBound==='true')return;open.dataset.helpBound='true';let bubbles=[];
      function position(){
        if(overlay.hidden)return;
        const dialogRect=dialog.getBoundingClientRect();
        bubbles.forEach((item,index)=>{
          const r=item.target.getBoundingClientRect(),b=item.bubble,center=r.top+r.height/2;
          b.classList.remove('is-side-left','is-side-right','is-top','is-bottom');
          if(item.footerIndex===1){
            const left=Math.min(innerWidth-b.offsetWidth-8,r.right+14),top=Math.max(8,Math.min(center-b.offsetHeight/2,innerHeight-b.offsetHeight-8));
            b.classList.add('is-side-right');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--playlist-help-arrow-y',`${Math.max(12,Math.min(center-top-6,b.offsetHeight-18))}px`);return;
          }
          if(item.settingIndex!==null||item.footerIndex!==null){
            const alternatingIndex=item.settingIndex!==null?item.settingIndex:item.footerIndex,above=alternatingIndex%2===0,left=Math.max(8,Math.min(r.left+r.width/2-b.offsetWidth/2,innerWidth-b.offsetWidth-8)),rawTop=above?r.top-b.offsetHeight-12:r.bottom+12,top=Math.max(8,Math.min(rawTop,innerHeight-b.offsetHeight-8));
            b.classList.add(above?'is-top':'is-bottom');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--publish-arrow-x',`${Math.max(14,Math.min(r.left+r.width/2-left,b.offsetWidth-14))}px`);return;
          }
          const targetOnLeft=r.left+r.width/2<dialogRect.left+dialogRect.width/2,placeLeft=index===1?true:index===2?false:targetOnLeft,left=placeLeft?Math.max(8,r.left-b.offsetWidth-14):Math.min(innerWidth-b.offsetWidth-8,r.right+14),top=Math.max(8,Math.min(center-b.offsetHeight/2,innerHeight-b.offsetHeight-8));
          b.classList.add(placeLeft?'is-side-left':'is-side-right');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--playlist-help-arrow-y',`${Math.max(12,Math.min(center-top-6,b.offsetHeight-18))}px`);
        })
      }
      function close(){overlay.hidden=true;dialog.classList.remove('is-publish-help-active');open.setAttribute('aria-pressed','false');host.replaceChildren();bubbles=[]}
      function show(){overlay.hidden=false;dialog.classList.add('is-publish-help-active');open.setAttribute('aria-pressed','true');const mainTargets=[dialog.querySelector('.broadcast-playlist-editor__settings[data-playlist-editor-help-tip]'),dialog.querySelector('.broadcast-playlist-editor__library-section[data-playlist-editor-help-tip]'),dialog.querySelector('.broadcast-playlist-editor__order-section[data-playlist-editor-help-tip]')].filter(Boolean),settingTargets=[...dialog.querySelectorAll('[data-playlist-settings-help-tip]')],footerTargets=[...dialog.querySelectorAll('.broadcast-publish-modal__footer [data-playlist-editor-help-tip]')],targets=[...mainTargets,...settingTargets,...footerTargets];bubbles=targets.map((target,index)=>{const bubble=document.createElement('article');bubble.className='publish-help-callout playlist-editor-help-callout';bubble.innerHTML=`<b>${index+1}</b><p>${target.dataset.playlistEditorHelpTip||target.dataset.playlistSettingsHelpTip}</p>`;host.appendChild(bubble);return{target,bubble,settingIndex:target.hasAttribute('data-playlist-settings-help-tip')?settingTargets.indexOf(target):null,footerIndex:footerTargets.includes(target)?footerTargets.indexOf(target):null}});requestAnimationFrame(()=>requestAnimationFrame(position))}
      open.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();overlay.hidden?show():close()});modal.querySelectorAll('[data-playlist-editor-close]').forEach(button=>button.addEventListener('click',close));window.addEventListener('resize',position);document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!overlay.hidden)close()})}
    document.addEventListener('DOMContentLoaded',setupPlaylistEditorHelp);document.addEventListener('turbo:load',setupPlaylistEditorHelp);if(document.readyState!=='loading')setupPlaylistEditorHelp();
  </script>
<% end %>
<div class="broadcast-preview-modal" data-preview-modal hidden>
  <div class="broadcast-preview-modal__backdrop" data-preview-close></div>
