<script>
  function initializeBroadcastsIndex() {
    const root = document.querySelector(".broadcasts-index");
    if (!root || root.dataset.broadcastsIndexBound === "true") return;
    root.dataset.broadcastsIndexBound = "true";

    const storageKey = "broadcastsViewMode";
    const switchButtons = document.querySelectorAll("[data-view-target]");
    const panels = document.querySelectorAll("[data-view-panel]");
    const previewModal = document.querySelector("[data-preview-modal]");
    const previewVideo = document.querySelector("[data-preview-video]");
    const previewImage = document.querySelector("[data-preview-image]");
    const previewWrapper = document.querySelector("[data-preview-wrapper]");
    const previewFallback = document.querySelector("[data-preview-fallback]");
    const previewTitle = document.querySelector("[data-preview-title]");
    const previewDescription = document.querySelector("[data-preview-description]");
    const publishModal = document.querySelector("[data-publish-modal]");
    const volumeModal = document.querySelector("[data-volume-modal]");
    const volumeForm = document.querySelector("[data-volume-form]");
    const volumeRange = document.querySelector("[data-volume-range]");
    const volumeValue = document.querySelector("[data-volume-value]");
    const volumeTvLabel = document.querySelector("[data-volume-tv-label]");
    const volumeMuteButton = document.querySelector("[data-volume-mute]");
    const powerScheduleModal = document.querySelector("[data-power-schedule-modal]");
    const powerScheduleForm = document.querySelector("[data-power-schedule-form]");
    const powerScheduleTitle = document.querySelector("[data-power-schedule-title]");
    const powerScheduleSubtitle = document.querySelector("[data-power-schedule-subtitle]");
    const powerScheduleOn = document.querySelector("[data-power-schedule-on-input]");
    const powerScheduleOff = document.querySelector("[data-power-schedule-off-input]");
    const powerScheduleDays = Array.from(document.querySelectorAll("[data-power-schedule-day]"));
    const playlistEditorModal = document.querySelector("[data-playlist-editor-modal]");
    const playlistEditorForm = document.querySelector("[data-playlist-editor-form]");
    const playlistList = document.querySelector("[data-playlist-list]");
    const playlistLibrary = document.querySelector("[data-playlist-library]");
    const playlistUpload = document.querySelector("[data-playlist-upload]");
    const playlistOrder = document.querySelector("[data-playlist-order]");
    const playlistOrderCount = document.querySelector("[data-playlist-order-count]");
    const playlistLibraryTabs = Array.from(document.querySelectorAll("[data-playlist-library-tab]"));
    const playlistSelectedLibrary = document.querySelector("[data-playlist-selected-library]");
    const playlistSelectedCount = document.querySelector("[data-playlist-selected-count]");
    const csrfToken = document.querySelector("meta[name='csrf-token']")?.content || "";
    let previewHls = null;
    let playlistCache = [];
    let playlistOrderIds = [];
    let draggedPlaylistOrderId = null;
    let draggedPlaylistOrderElement = null;
    let playlistDragImage = null;
    let playlistRefreshFrame = null;

    function applyView(view) {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.viewPanel !== view;
      });

      switchButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.viewTarget === view);
      });

      localStorage.setItem(storageKey, view);
    }

    function showFallback(fallback) {
      if (fallback) fallback.hidden = false;
    }

    function hideFallback(fallback) {
      if (fallback) fallback.hidden = true;
    }

    function bindPreviewPlayer(video, wrapper, fallback, sourceUrl, sourceType) {
      if (!video || !wrapper || !sourceUrl) return;

      if (video._previewHandlersBound !== true) {
        video.addEventListener("loadeddata", function () {
          hideFallback(fallback);
        });
        video.addEventListener("canplay", function () {
          hideFallback(fallback);
        });
        video.addEventListener("playing", function () {
          hideFallback(fallback);
        });
        video.addEventListener("error", function () {
          showFallback(fallback);
        });
        video._previewHandlersBound = true;
      }

      if (video._hlsInstance) {
        video._hlsInstance.destroy();
        video._hlsInstance = null;
      }

      video.pause();
      video.removeAttribute("src");
      while (video.firstChild) {
        video.removeChild(video.firstChild);
      }

      if (sourceType === "video/mp4") {
        video.src = sourceUrl;
        video.load();
        video.play().catch(function () {});
        return;
      }

      if (window.Hls && Hls.isSupported()) {
        if (video._hlsInstance) {
          video._hlsInstance.destroy();
        }

        const hls = new Hls({
          enableWorker: true,
          lowLatencyMode: true
        });

        video._hlsInstance = hls;
        hls.loadSource(sourceUrl);
        hls.attachMedia(video);

        hls.on(Hls.Events.MANIFEST_PARSED, function () {
          hideFallback(fallback);
          video.play().catch(function () {});
        });

        hls.on(Hls.Events.FRAG_BUFFERED, function () {
          hideFallback(fallback);
        });

        hls.on(Hls.Events.ERROR, function (_event, data) {
          if (data && data.fatal) {
            showFallback(fallback);
          }
        });
      } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
        video.src = sourceUrl;
        video.addEventListener("loadedmetadata", function onceLoadedMetadata() {
          hideFallback(fallback);
          video.play().catch(function () {});
          video.removeEventListener("loadedmetadata", onceLoadedMetadata);
        });
      } else {
        showFallback(fallback);
      }
    }

    const savedView = localStorage.getItem(storageKey);
    const initialView = savedView === "table" ? "cards" : (savedView || "cards");
    applyView(initialView);

    switchButtons.forEach((button) => {
      button.addEventListener("click", function () {
        applyView(button.dataset.viewTarget);
      });
    });

    document.querySelectorAll("[data-publish-open]").forEach((button) => {
      button.addEventListener("click", function () {
        if (publishModal) publishModal.hidden = false;
        hydrateLazyPreviews(publishModal || document);
      });
    });

    document.querySelectorAll("[data-publish-close]").forEach((button) => {
      button.addEventListener("click", function () {
        if (publishModal) publishModal.hidden = true;
      });
    });

    function updateVolumeDisplay() {
      if (volumeValue && volumeRange) volumeValue.textContent = volumeRange.value;
    }

    document.querySelectorAll("[data-volume-open]").forEach(function(button) {
      button.addEventListener("click", function() {
        if (!volumeModal || !volumeForm || !volumeRange) return;

        volumeForm.action = button.dataset.volumeAction || "";
        if (volumeMuteButton) volumeMuteButton.formAction = button.dataset.volumeMuteAction || "";
        if (volumeTvLabel) {
          volumeTvLabel.textContent = "Defina o volume de " + (button.dataset.volumeTvName || "TV") + ".";
        }
        volumeRange.value = button.dataset.volumeCurrent || "50";
        updateVolumeDisplay();
        volumeModal.hidden = false;
        window.setTimeout(function() { volumeRange.focus(); }, 40);
      });
    });

    document.querySelectorAll("[data-volume-cancel]").forEach(function(button) {
      button.addEventListener("click", function() {
        if (volumeModal) volumeModal.hidden = true;
      });
    });

    if (volumeRange) {
      volumeRange.addEventListener("input", updateVolumeDisplay);
    }

    function openPowerScheduleModal(button) {
      if (!powerScheduleModal || !powerScheduleForm) return;

      const scope = button.dataset.powerScheduleScope || "single";
      const days = (button.dataset.powerScheduleDays || "").split(",").map(function(day) {
        return day.trim();
      }).filter(Boolean);

      powerScheduleForm.action = button.dataset.powerScheduleAction || "#";
      if (powerScheduleOn) powerScheduleOn.value = button.dataset.powerScheduleOn || "";
      if (powerScheduleOff) powerScheduleOff.value = button.dataset.powerScheduleOff || "";
      powerScheduleDays.forEach(function(input) {
        input.checked = days.includes(input.value);
      });

      if (powerScheduleTitle) {
        powerScheduleTitle.textContent = scope === "all" ? "Agendamento global de energia" : "Agendamento de energia da TV";
      }

      if (powerScheduleSubtitle) {
        powerScheduleSubtitle.textContent = scope === "all"
          ? "Aplicar o mesmo horario para todas as TVs cadastradas."
          : "Ajustar horario de ligar, desligar e dias para " + (button.dataset.powerScheduleName || "TV") + ".";
      }

      powerScheduleModal.hidden = false;
      window.setTimeout(function() {
        if (powerScheduleOn) powerScheduleOn.focus();
      }, 40);
    }

    function closePowerScheduleModal() {
      if (powerScheduleModal) powerScheduleModal.hidden = true;
    }

    document.querySelectorAll("[data-power-schedule-open]").forEach(function(button) {
      button.addEventListener("click", function() {
        openPowerScheduleModal(button);
      });
    });

    document.querySelectorAll("[data-power-schedule-close]").forEach(function(button) {
      button.addEventListener("click", closePowerScheduleModal);
    });

    document.addEventListener("keydown", function(event) {
      if (event.key === "Escape" && powerScheduleModal && !powerScheduleModal.hidden) {
        closePowerScheduleModal();
      }
    });

    function mediaKindLabel(kind) {
      return kind === "image" ? "<%= j I18n.t("Image") %>" : "<%= j I18n.t("Video") %>";
    }

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function previewPlaceholder() {
      return "data:image/gif;base64,R0lGODlhAQABAAAAACw=";
    }

    function mediaPreviewSrcFromRow(row) {
      if (!row) return "";
      const image = row.querySelector("img");
      if (image) return image.dataset.previewSrc || image.getAttribute("src") || "";
      const videoSource = row.querySelector("video source");
      return videoSource?.dataset.src || videoSource?.getAttribute("src") || "";
    }

    function hydrateLazyPreviews(scope) {
      const container = scope || document;
      const targets = Array.from(container.querySelectorAll("img[data-lazy-preview], video source[data-src]"));
      if (targets.length === 0) return;

      function hydrate(target) {
        if (target.matches("img[data-lazy-preview]") && target.dataset.previewSrc) {
          target.src = target.dataset.previewSrc;
          target.removeAttribute("data-lazy-preview");
          return;
        }

        if (target.matches("source[data-src]")) {
          target.src = target.dataset.src;
          target.removeAttribute("data-src");
          const video = target.closest("video");
          if (video) video.load();
        }
      }

      if (!("IntersectionObserver" in window)) {
        targets.forEach(hydrate);
        return;
      }

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          hydrate(entry.target);
          observer.unobserve(entry.target);
        });
      }, { rootMargin: "260px 0px" });

      targets.forEach(function(target) {
        observer.observe(target);
      });
    }

    function bindPlaylistHoverPreview(scope) {
      const container = scope || document;
      if (!container || container.dataset?.hoverPreviewBound === "true") return;
      if (container.dataset) container.dataset.hoverPreviewBound = "true";

      let preview = null;
      let showTimer = null;

      function ensurePreview() {
        if (preview) return preview;

        preview = document.createElement("div");
        preview.className = "broadcast-playlist-hover-preview";
        preview.innerHTML = '<img alt="">';
        document.body.appendChild(preview);
        return preview;
      }

      function previewSrcFor(target) {
        const image = target.querySelector("img");
        return image?.dataset.previewSrc || image?.getAttribute("src") || "";
      }

      function positionPreview(target, element) {
        const box = target.getBoundingClientRect();
        const width = Math.min(280, window.innerWidth - 24);
        const height = Math.round((width * 9) / 16) + 12;
        const left = Math.min(window.innerWidth - width - 12, Math.max(12, box.left + (box.width / 2) - (width / 2)));
        const topAbove = box.top - height - 10;
        const topBelow = box.bottom + 10;
        const top = topAbove >= 12 ? topAbove : Math.min(window.innerHeight - height - 12, topBelow);

        element.style.left = `${left}px`;
        element.style.top = `${Math.max(12, top)}px`;
        element.style.width = `${width}px`;
      }

      function showPreview(target) {
        const src = previewSrcFor(target);
        if (!src || src === previewPlaceholder()) return;

        const element = ensurePreview();
        const image = element.querySelector("img");
        image.src = src;
        positionPreview(target, element);
        element.classList.add("is-visible");
      }

      function hidePreview() {
        window.clearTimeout(showTimer);
        if (preview) preview.classList.remove("is-visible");
      }

      container.addEventListener("mouseover", function(event) {
        const row = event.target.closest(".broadcast-publish-video, .broadcast-playlist-order__item");
        const target = event.target.closest("[data-playlist-hover-preview]") || row?.querySelector("[data-playlist-hover-preview]");
        if (!target || !container.contains(target)) return;

        hydrateLazyPreviews(target);
        window.clearTimeout(showTimer);
        showTimer = window.setTimeout(function() {
          showPreview(target);
        }, 80);
      });

      container.addEventListener("mouseout", function(event) {
        const row = event.target.closest(".broadcast-publish-video, .broadcast-playlist-order__item");
        const target = event.target.closest("[data-playlist-hover-preview]") || row?.querySelector("[data-playlist-hover-preview]");
        if (!target) return;
        if (target.contains(event.relatedTarget) || row?.contains(event.relatedTarget)) return;
        hidePreview();
      });

      container.addEventListener("scroll", hidePreview, true);
      window.addEventListener("resize", hidePreview);
    }

    function renderLibraryMedia(media, checked) {
      const preview = `
        <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
          <img src="${previewPlaceholder()}" data-lazy-preview data-preview-src="${escapeHtml(media.preview_url)}" alt="${escapeHtml(media.filename)}" loading="lazy" decoding="async">
          <i class="fas fa-eye" aria-hidden="true"></i>
        </span>
      `;

      return `
        <label class="broadcast-publish-video" data-library-blob-id="${media.id}">
          <input type="checkbox" name="playlist_media_blob_ids[]" value="${media.id}" data-playlist-media-choice ${checked ? "checked" : ""}>
          ${preview}
          <span>
            <strong>${escapeHtml(media.filename)}</strong>
            <small>${mediaKindLabel(media.type)} - ${escapeHtml(media.size_label)} - ${escapeHtml(media.created_at_label)}</small>
          </span>
          <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
        </label>
      `;
    }

    function renderPlaylistOption(playlist, checked) {
      return `
        <label class="broadcast-playlist-option" data-playlist-option-id="${playlist.id}">
          <input type="radio" name="playlist_id" value="${playlist.id}" data-playlist-choice ${checked ? "checked" : ""}>
          ${renderPlaylistThumbnails(playlist)}
          <span>
            <strong>${escapeHtml(playlist.name)}</strong>
            <small>${playlist.item_count || 0} ${playlist.item_count === 1 ? "<%= j I18n.t("MediaSingular") %>" : "<%= j I18n.t("MediaPlural") %>"} - ${playlist.video_duration_mode === "video_end" ? "<%= j I18n.t("VideoUntilEnd") %>" : "<%= j I18n.t("TimedVideo") %>"}${playlist.sync_enabled ? " - <%= j I18n.t("Synced", default: "Sincronizada") %>" : ""} - ${escapeHtml(playlist.updated_at_label)}</small>
          </span>
          <button type="button" class="broadcast-publish-link" data-playlist-edit="${playlist.id}"><%= j I18n.t("Edit") %></button>
        </label>
      `;
    }

    function renderPlaylistThumbnails(playlist) {
      const items = (playlist.items || []).slice(0, 4);
      if (items.length === 0) {
        return `
          <span class="broadcast-playlist-option__thumbs" aria-hidden="true">
            <span class="broadcast-playlist-option__thumb broadcast-playlist-option__thumb--empty">
              <i class="fas fa-film" aria-hidden="true"></i>
            </span>
          </span>
        `;
      }

      const thumbs = items.map(function(item) {
        return `
          <span class="broadcast-playlist-option__thumb">
            <img src="${previewPlaceholder()}" data-lazy-preview data-preview-src="${escapeHtml(item.preview_url)}" alt="" loading="lazy" decoding="async">
            ${item.type === "video" ? '<i class="fas fa-play" aria-hidden="true"></i>' : ""}
          </span>
        `;
      }).join("");

      return `<span class="broadcast-playlist-option__thumbs" aria-hidden="true">${thumbs}</span>`;
    }

    function refreshPlaylistList(selectedId) {
      if (!playlistList) return Promise.resolve();

      return fetch("/broadcast_playlists.json")
        .then(function(response) { return response.ok ? response.json() : Promise.reject(response); })
        .then(function(playlists) {
          playlistCache = playlists;
          if (playlists.length === 0) {
            playlistList.innerHTML = '<p class="broadcast-publish-empty" data-playlist-empty>Nenhuma playlist criada. Crie a primeira playlist para publicar nas TVs.</p>';
            return;
          }

          playlistList.innerHTML = playlists.map(function(playlist) {
            return renderPlaylistOption(playlist, String(playlist.id) === String(selectedId));
          }).join("");
          hydrateLazyPreviews(playlistList);
        });
    }

    window.refreshBroadcastPublishPlaylistList = refreshPlaylistList;
    document.addEventListener("broadcast-playlist:saved", function(event) {
      refreshPlaylistList(event.detail?.playlistId);
    });

    function resetPlaylistEditor() {
      if (!playlistEditorForm) return;

      playlistEditorForm.reset();
      playlistEditorForm.querySelector("[data-playlist-editor-id]").value = "";
      playlistEditorForm.querySelector("[data-playlist-name]").value = "<%= j I18n.t("NewPlaylist") %>";
      playlistEditorForm.querySelector("[data-playlist-image-duration]").value = "10";
      playlistEditorForm.querySelector("[data-playlist-video-duration-mode]").value = "image_duration";
      playlistEditorForm.querySelector("[data-playlist-transition-style]").value = "fade";
      playlistEditorForm.querySelector("[data-playlist-transition-duration]").value = "600";
      const syncInput = playlistEditorForm.querySelector("[data-playlist-sync-enabled]");
      if (syncInput) syncInput.checked = false;
      playlistOrderIds = [];
      draggedPlaylistOrderId = null;
      draggedPlaylistOrderElement = null;
      playlistEditorForm.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
        input.checked = false;
      });
      const title = document.querySelector("[data-playlist-editor-title]");
      if (title) title.textContent = "<%= j I18n.t("CreatePlaylist") %>";
      updatePlaylistTimingVisibility();
      setPlaylistLibraryTab("selected");
    }

    function selectedPlaylistMediaCount() {
      if (!playlistEditorForm) return 0;
      return playlistEditorForm.querySelectorAll("[data-playlist-media-choice]:checked").length;
    }

    function selectedPlaylistMediaInputs() {
      if (!playlistEditorForm) return [];
      const checkedInputs = Array.from(playlistEditorForm.querySelectorAll("[data-playlist-media-choice]:checked"));
      const byId = new Map(checkedInputs.map(function(input) { return [String(input.value), input]; }));
      const orderedInputs = playlistOrderIds
        .map(function(id) { return byId.get(String(id)); })
        .filter(Boolean);

      checkedInputs.forEach(function(input) {
        if (!playlistOrderIds.includes(String(input.value))) {
          playlistOrderIds.push(String(input.value));
          orderedInputs.push(input);
        }
      });

      playlistOrderIds = playlistOrderIds.filter(function(id) { return byId.has(String(id)); });
      return orderedInputs;
    }

    function setPlaylistLibraryTab(tabName) {
      const activeTab = tabName === "selected" ? "selected" : "library";

      playlistLibraryTabs.forEach(function(button) {
        const isActive = button.dataset.playlistLibraryTab === activeTab;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      if (playlistLibrary) playlistLibrary.hidden = activeTab !== "library";
      if (playlistSelectedLibrary) playlistSelectedLibrary.hidden = activeTab !== "selected";
    }

    function addPlaylistOrderId(id) {
      const normalizedId = String(id);
      if (!playlistOrderIds.includes(normalizedId)) {
        playlistOrderIds.push(normalizedId);
      }
    }

    function removePlaylistOrderId(id) {
      const normalizedId = String(id);
      playlistOrderIds = playlistOrderIds.filter(function(currentId) {
        return currentId !== normalizedId;
      });
    }

    function reorderPlaylistOrderIds(sourceId, targetId) {
      sourceId = String(sourceId || "");
      targetId = String(targetId || "");
      if (!sourceId || !targetId || sourceId === targetId) return;

      const fromIndex = playlistOrderIds.indexOf(sourceId);
      const toIndex = playlistOrderIds.indexOf(targetId);
      if (fromIndex < 0 || toIndex < 0) return;

      const moved = playlistOrderIds.splice(fromIndex, 1)[0];
      playlistOrderIds.splice(toIndex, 0, moved);
    }

    function refreshPlaylistOrderIndexes() {
      if (!playlistOrder) return;
      playlistOrder.querySelectorAll("[data-playlist-order-item]").forEach(function(item, index) {
        const indexEl = item.querySelector(".broadcast-playlist-order__index");
        if (indexEl) indexEl.textContent = index + 1;
      });
    }

    function syncPlaylistOrderIdsFromDom() {
      if (!playlistOrder) return;
      playlistOrderIds = Array.from(playlistOrder.querySelectorAll("[data-playlist-order-item]")).map(function(item) {
        return String(item.dataset.playlistOrderItem);
      });
    }

    function getPlaylistOrderInsertBefore(y) {
      if (!playlistOrder) return null;

      const items = Array.from(playlistOrder.querySelectorAll("[data-playlist-order-item]:not(.is-dragging)"));
      return items.reduce(function(closest, item) {
        const box = item.getBoundingClientRect();
        const offset = y - box.top - (box.height / 2);
        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: item };
        }
        return closest;
      }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
    }

    function removePlaylistDragImage() {
      if (!playlistDragImage) return;
      playlistDragImage.remove();
      playlistDragImage = null;
    }

    function createPlaylistDragImage(item, event) {
      removePlaylistDragImage();
      if (!event.dataTransfer) return;

      const rect = item.getBoundingClientRect();
      playlistDragImage = item.cloneNode(true);
      playlistDragImage.classList.add("broadcast-playlist-order__drag-image");
      playlistDragImage.style.width = rect.width + "px";
      playlistDragImage.style.height = rect.height + "px";
      document.body.appendChild(playlistDragImage);

      event.dataTransfer.setDragImage(
        playlistDragImage,
        Math.max(0, event.clientX - rect.left),
        Math.max(0, event.clientY - rect.top)
      );
    }

    function updatePlaylistOrderPreview() {
      if (!playlistOrder || !playlistOrderCount) return;

      const previousIds = new Set(Array.from(playlistOrder.querySelectorAll("[data-playlist-order-item]")).map(function(item) {
        return String(item.dataset.playlistOrderItem);
      }));
      const inputs = selectedPlaylistMediaInputs();
      renderSelectedLibraryPreview(inputs);
      playlistOrderCount.textContent = `${inputs.length} ${inputs.length === 1 ? "<%= j I18n.t("ItemSingular") %>" : "<%= j I18n.t("ItemPlural") %>"}`;

      if (inputs.length === 0) {
        playlistOrder.innerHTML = `
          <div class="broadcast-playlist-order__empty" data-playlist-order-empty>
            <i class="far fa-file-video" aria-hidden="true"></i>
            <strong><%= j I18n.t("PlaylistEmpty") %></strong>
            <span><%= j I18n.t("SelectLibraryItemsToStart") %></span>
          </div>
        `;
        return;
      }

      playlistOrder.innerHTML = inputs.map(function(input, index) {
        const row = input.closest("[data-library-blob-id]");
        const title = row?.querySelector("strong")?.textContent || "<%= j I18n.t("Media") %>";
        const meta = row?.querySelector("small")?.textContent || "";
        const isNewItem = !previousIds.has(String(input.value));
        const previewSrc = mediaPreviewSrcFromRow(row);
        const thumb = `
          <span class="broadcast-playlist-thumb-preview broadcast-playlist-thumb-preview--order" data-playlist-hover-preview>
            <img class="broadcast-playlist-order__thumb" src="${escapeHtml(previewSrc)}" alt="" loading="lazy" decoding="async">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </span>
        `;

        return `
          <div class="broadcast-playlist-order__item ${isNewItem ? "is-entering" : ""}" draggable="true" data-playlist-order-item="${escapeHtml(input.value)}">
            <button type="button" class="broadcast-playlist-order__drag" aria-label="Arrastar item" title="Arrastar item">
              <i class="fas fa-grip-vertical" aria-hidden="true"></i>
            </button>
            <span class="broadcast-playlist-order__index">${index + 1}</span>
            ${thumb}
            <span>
              <strong>${escapeHtml(title)}</strong>
              <small>${escapeHtml(meta)}</small>
            </span>
          </div>
        `;
      }).join("");
      hydrateLazyPreviews(playlistOrder);
      bindPlaylistHoverPreview(playlistEditorModal || document);

      window.setTimeout(function() {
        playlistOrder.querySelectorAll(".broadcast-playlist-order__item.is-entering").forEach(function(item) {
          item.classList.remove("is-entering");
        });
      }, 280);
    }

    function updatePlaylistTimingVisibility() {
      playlistRefreshFrame = null;
      const shouldShow = selectedPlaylistMediaCount() > 1;
      document.querySelectorAll("[data-playlist-timing-settings]").forEach(function(field) {
        field.hidden = !shouldShow;
      });
      updatePlaylistOrderPreview();
    }

    function renderSelectedLibraryPreview(inputs) {
      if (playlistSelectedCount) playlistSelectedCount.textContent = inputs.length;
      if (!playlistSelectedLibrary) return;

      if (inputs.length === 0) {
        playlistSelectedLibrary.innerHTML = `
          <div class="broadcast-playlist-order__empty">
            <i class="far fa-file-video" aria-hidden="true"></i>
            <strong><%= j I18n.t("PlaylistEmpty") %></strong>
            <span><%= j I18n.t("SelectLibraryItemsToStart") %></span>
          </div>
        `;
        return;
      }

      playlistSelectedLibrary.innerHTML = inputs.map(function(input) {
        const row = input.closest("[data-library-blob-id]");
        const title = row?.querySelector("strong")?.textContent || "<%= j I18n.t("Media") %>";
        const meta = row?.querySelector("small")?.textContent || "";
        const previewSrc = mediaPreviewSrcFromRow(row);

        return `
          <div class="broadcast-publish-video broadcast-publish-video--selected" data-selected-library-blob-id="${escapeHtml(input.value)}">
            <button type="button" class="broadcast-playlist-selected-remove" data-playlist-remove-selected="${escapeHtml(input.value)}" title="<%= j I18n.t("Remove", default: "Remover") %>" aria-label="<%= j I18n.t("Remove", default: "Remover") %>">
              <i class="fas fa-times" aria-hidden="true"></i>
            </button>
            <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
              <img src="${escapeHtml(previewSrc)}" alt="" loading="lazy" decoding="async">
              <i class="fas fa-eye" aria-hidden="true"></i>
            </span>
            <span>
              <strong>${escapeHtml(title)}</strong>
              <small>${escapeHtml(meta)}</small>
            </span>
          </div>
        `;
      }).join("");
      hydrateLazyPreviews(playlistSelectedLibrary);
      bindPlaylistHoverPreview(playlistEditorModal || document);
    }

    function schedulePlaylistTimingVisibility() {
      if (playlistRefreshFrame) return;
      playlistRefreshFrame = requestAnimationFrame(updatePlaylistTimingVisibility);
    }

    function openPlaylistEditor(playlist) {
      if (!playlistEditorModal || !playlistEditorForm) return;

      resetPlaylistEditor();
      if (publishModal) publishModal.hidden = true;

      if (playlist) {
        playlistEditorForm.querySelector("[data-playlist-editor-id]").value = playlist.id;
        playlistEditorForm.querySelector("[data-playlist-name]").value = playlist.name || "Playlist";
        playlistEditorForm.querySelector("[data-playlist-image-duration]").value = playlist.image_duration_seconds || 10;
        playlistEditorForm.querySelector("[data-playlist-video-duration-mode]").value = playlist.video_duration_mode || "image_duration";
        playlistEditorForm.querySelector("[data-playlist-transition-style]").value = playlist.transition_style || "fade";
        playlistEditorForm.querySelector("[data-playlist-transition-duration]").value = playlist.transition_duration_ms || 600;
        const syncInput = playlistEditorForm.querySelector("[data-playlist-sync-enabled]");
        if (syncInput) syncInput.checked = !!playlist.sync_enabled;
        const selectedIds = new Set((playlist.items || []).map(function(item) { return String(item.blob_id); }));
        playlistOrderIds = (playlist.items || []).map(function(item) { return String(item.blob_id); });
        playlistEditorForm.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
          input.checked = selectedIds.has(String(input.value));
        });
        updatePlaylistTimingVisibility();
        const title = document.querySelector("[data-playlist-editor-title]");
        if (title) title.textContent = "<%= j I18n.t("EditPlaylist") %>";
      }

      playlistEditorModal.hidden = false;
      hydrateLazyPreviews(playlistEditorModal);
      bindPlaylistHoverPreview(playlistEditorModal);
    }

    function closePlaylistEditor(showPublish) {
      if (playlistEditorModal) playlistEditorModal.hidden = true;
      if (showPublish && publishModal) publishModal.hidden = false;
    }

    function appendUploadedMediaToLibrary(mediaItems) {
      if (!playlistLibrary) return;

      const existingIds = new Set(Array.from(playlistLibrary.querySelectorAll("[data-library-blob-id]")).map(function(el) {
        return el.dataset.libraryBlobId;
      }));
      const html = mediaItems
        .filter(function(media) { return !existingIds.has(String(media.id)); })
        .map(function(media) { return renderLibraryMedia(media, true); })
        .join("");
      playlistLibrary.insertAdjacentHTML("afterbegin", html);
      hydrateLazyPreviews(playlistLibrary);
      mediaItems.forEach(function(media) {
        addPlaylistOrderId(media.id);
      });
      schedulePlaylistTimingVisibility();
    }

    document.addEventListener("change", function(event) {
      if (event.target.matches("[data-playlist-media-choice]")) {
        if (event.target.checked) {
          addPlaylistOrderId(event.target.value);
        } else {
          removePlaylistOrderId(event.target.value);
        }
        schedulePlaylistTimingVisibility();
      }
    });

    playlistLibraryTabs.forEach(function(button) {
      button.addEventListener("click", function() {
        setPlaylistLibraryTab(button.dataset.playlistLibraryTab);
      });
    });

    document.addEventListener("click", function(event) {
      const removeButton = event.target.closest("[data-playlist-remove-selected]");
      if (!removeButton) return;

      event.preventDefault();
      const input = Array.from(playlistEditorForm?.querySelectorAll("[data-playlist-media-choice]") || []).find(function(choice) {
        return String(choice.value) === String(removeButton.dataset.playlistRemoveSelected);
      });
      if (input) input.checked = false;
      removePlaylistOrderId(removeButton.dataset.playlistRemoveSelected);
      schedulePlaylistTimingVisibility();
    });

    document.addEventListener("dragstart", function(event) {
      const item = event.target.closest("[data-playlist-order-item]");
      if (!item) return;

      draggedPlaylistOrderId = item.dataset.playlistOrderItem;
      draggedPlaylistOrderElement = item;
      playlistOrder?.classList.add("is-drag-active");
      item.classList.add("is-dragging");
      if (event.dataTransfer) {
        event.dataTransfer.effectAllowed = "move";
        event.dataTransfer.setData("text/plain", draggedPlaylistOrderId);
        createPlaylistDragImage(item, event);
      }
    });

    document.addEventListener("dragover", function(event) {
      if (!playlistOrder || !draggedPlaylistOrderElement || !playlistOrder.contains(event.target)) return;

      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = "move";
      const insertBefore = getPlaylistOrderInsertBefore(event.clientY);
      if (insertBefore) {
        playlistOrder.insertBefore(draggedPlaylistOrderElement, insertBefore);
      } else {
        playlistOrder.appendChild(draggedPlaylistOrderElement);
      }
      refreshPlaylistOrderIndexes();
    });

    document.addEventListener("drop", function(event) {
      if (!draggedPlaylistOrderElement) return;

      event.preventDefault();
      syncPlaylistOrderIdsFromDom();
      removePlaylistDragImage();
    });

    document.addEventListener("dragend", function() {
      syncPlaylistOrderIdsFromDom();
      removePlaylistDragImage();
      draggedPlaylistOrderId = null;
      draggedPlaylistOrderElement = null;
      playlistOrder?.classList.remove("is-drag-active");
      playlistOrder?.querySelectorAll("[data-playlist-order-item]").forEach(function(item) {
        item.classList.remove("is-dragging", "is-drag-over");
      });
      updatePlaylistTimingVisibility();
      bindPlaylistHoverPreview(playlistEditorModal || document);
    });

    document.querySelectorAll("[data-playlist-new]").forEach(function(button) {
      button.addEventListener("click", function() {
        openPlaylistEditor(null);
      });
    });

    document.addEventListener("click", function(event) {
      const editButton = event.target.closest("[data-playlist-edit]");
      if (!editButton) return;

      event.preventDefault();
      const playlistId = editButton.dataset.playlistEdit;
      const cachedPlaylist = playlistCache.find(function(playlist) { return String(playlist.id) === String(playlistId); });
      if (cachedPlaylist) {
        openPlaylistEditor(cachedPlaylist);
        return;
      }

      fetch(`/broadcast_playlists/${playlistId}.json`)
        .then(function(response) { return response.ok ? response.json() : Promise.reject(response); })
        .then(openPlaylistEditor);
    });

    document.querySelectorAll("[data-playlist-editor-close]").forEach(function(button) {
      button.addEventListener("click", function() {
        closePlaylistEditor(true);
      });
    });

    document.querySelectorAll("[data-playlist-clear-items]").forEach(function(button) {
      button.addEventListener("click", function() {
        document.querySelectorAll("[data-playlist-media-choice]").forEach(function(input) {
          input.checked = false;
        });
        playlistOrderIds = [];
        updatePlaylistTimingVisibility();
      });
    });

    if (playlistUpload) {
      playlistUpload.addEventListener("change", function() {
        if (playlistUpload.files.length === 0) return;

        const formData = new FormData();
        Array.from(playlistUpload.files).forEach(function(file) {
          formData.append("media_files[]", file);
        });

        fetch("/broadcast_playlists/upload_media.json", {
          method: "POST",
          headers: { "X-CSRF-Token": csrfToken },
          body: formData
        })
          .then(function(response) { return response.ok ? response.json() : response.json().then(function(data) { throw data; }); })
          .then(function(mediaItems) {
            appendUploadedMediaToLibrary(mediaItems);
            playlistUpload.value = "";
            showNotification("<%= j I18n.t("MediaAddedToLibrary") %>");
          })
          .catch(function(error) {
            showNotification(error.error || "<%= j I18n.t("MediaUploadFailed") %>");
          });
      });
    }

    if (playlistEditorForm) {
      playlistEditorForm.addEventListener("submit", function(event) {
        event.preventDefault();

        const playlistId = playlistEditorForm.querySelector("[data-playlist-editor-id]").value;
        const formData = new FormData();
        formData.append("name", playlistEditorForm.querySelector("[data-playlist-name]").value);
        formData.append("image_duration_seconds", playlistEditorForm.querySelector("[data-playlist-image-duration]").value);
        formData.append("video_duration_mode", playlistEditorForm.querySelector("[data-playlist-video-duration-mode]").value);
        formData.append("transition_style", playlistEditorForm.querySelector("[data-playlist-transition-style]").value);
        formData.append("transition_duration_ms", playlistEditorForm.querySelector("[data-playlist-transition-duration]").value);
        formData.append("sync_enabled", playlistEditorForm.querySelector("[data-playlist-sync-enabled]")?.checked ? "1" : "0");
        selectedPlaylistMediaInputs().forEach(function(input) {
          formData.append("media_blob_ids[]", input.value);
        });

        const url = playlistId ? `/broadcast_playlists/${playlistId}.json` : "/broadcast_playlists.json";
        const method = playlistId ? "PATCH" : "POST";

        fetch(url, {
          method: method,
          headers: { "X-CSRF-Token": csrfToken },
          body: formData
        })
          .then(function(response) { return response.ok ? response.json() : response.json().then(function(data) { throw data; }); })
          .then(function(playlist) {
            closePlaylistEditor(true);
            refreshPlaylistList(playlist.id);
            showNotification("<%= j I18n.t("PlaylistSaved") %>");
          })
          .catch(function(error) {
            showNotification(error.error || "<%= j I18n.t("PlaylistSaveFailed") %>");
          });
      });
    }

    refreshPlaylistList();

    document.querySelectorAll("[data-publish-select-all]").forEach((button) => {
      button.addEventListener("click", function () {
        const checkboxes = document.querySelectorAll(".broadcast-publish-tv input[type='checkbox']");
        const shouldCheck = Array.from(checkboxes).some((checkbox) => !checkbox.checked);
        checkboxes.forEach((checkbox) => { checkbox.checked = shouldCheck; });
        button.textContent = shouldCheck ? "<%= j I18n.t("ClearSelection") %>" : "<%= j I18n.t("SelectAll") %>";
      });
    });

    function hydrateDashboardPreview(target) {
      if (!target || target.dataset.dashboardPreviewLoaded === "true") return;
      target.dataset.dashboardPreviewLoaded = "true";

      if (target.dataset.dashboardPreviewKind === "image") {
        const src = target.dataset.dashboardPreviewSrc;
        const wrapper = target.closest(".broadcast-card-modern__video");
        const loading = wrapper?.querySelector("[data-dashboard-preview-loading]");
        target.addEventListener("load", function() {
          target.classList.add("is-loaded");
          if (loading) loading.hidden = true;
        }, { once: true });
        target.addEventListener("error", function() {
          if (loading) loading.hidden = true;
          showFallback(wrapper?.querySelector(".broadcast-card-modern__video-fallback"));
        }, { once: true });
        if (src) target.src = src;
        return;
      }

      if (target.tagName === "VIDEO") {
        const sourceUrl = target.dataset.dashboardPreviewSrc;
        if (!sourceUrl) return;
        const wrapper = target.closest(".broadcast-card-modern__video");
        const fallback = target.parentElement.querySelector(".broadcast-card-modern__video-fallback");
        bindPreviewPlayer(target, wrapper, fallback, sourceUrl, target.dataset.dashboardPreviewType || "video/mp4");
      }
    }

    function scheduleDashboardPreviews() {
      const previews = Array.from(document.querySelectorAll("[data-dashboard-preview]"));
      if (previews.length === 0) return;

      const queue = [];
      let active = 0;
      const maxActive = 2;

      function pump() {
        if (active >= maxActive || queue.length === 0) return;
        const target = queue.shift();
        active += 1;
        const run = function() {
          hydrateDashboardPreview(target);
          window.setTimeout(function() {
            active -= 1;
            pump();
          }, 420);
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(run, { timeout: 1800 });
        } else {
          window.setTimeout(run, 120);
        }
        pump();
      }

      function enqueue(target) {
        if (!target || target.dataset.dashboardPreviewQueued === "true") return;
        target.dataset.dashboardPreviewQueued = "true";
        queue.push(target);
        pump();
      }

      if (!("IntersectionObserver" in window)) {
        previews.forEach(enqueue);
        return;
      }

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          enqueue(entry.target);
          observer.unobserve(entry.target);
        });
      }, { rootMargin: "360px 0px" });

      previews.forEach(function(target, index) {
        observer.observe(target);
        if (index < 2) enqueue(target);
      });
    }

    window.setTimeout(scheduleDashboardPreviews, 250);

    function closePreviewModal() {
      if (!previewModal || !previewVideo) return;

      previewModal.hidden = true;
      previewModal.dataset.previewBroadcastId = "";
      previewModal.dataset.previewKey = "";
      document.body.classList.remove("broadcast-preview-open");
      previewVideo.pause();
      previewVideo.removeAttribute("src");
      previewVideo.load();
      if (previewImage) {
        previewImage.hidden = true;
        previewImage.removeAttribute("src");
        previewImage.alt = "";
      }
      previewVideo.hidden = false;

      if (previewVideo._hlsInstance) {
        previewVideo._hlsInstance.destroy();
        previewVideo._hlsInstance = null;
      }
    }

    function showPreviewInModal(options) {
      if (!previewModal || !previewVideo || !previewWrapper || !options || !options.sourceUrl) return;

      const sourceUrl = options.sourceUrl;
      const sourceType = options.sourceType || "application/x-mpegURL";
      const previewMode = options.mode || "FFmpeg / HLS";
      const orientation = options.orientation || "landscape";
      const isPortraitPreview = orientation === "portrait" || orientation === "portrait_inverted";

      previewModal.dataset.previewBroadcastId = options.broadcastId || "";
      previewModal.dataset.previewKey = options.previewKey || "";
      previewTitle.textContent = options.name || "Preview da TV";
      if (previewDescription) {
        previewDescription.textContent = "Modo atual: " + previewMode;
      }

      previewWrapper.dataset.orientation = orientation;
      previewWrapper.classList.toggle("broadcast-card-modern__video--portrait", isPortraitPreview);
      previewWrapper.classList.toggle("broadcast-card-modern__video--landscape", !isPortraitPreview);
      previewWrapper.classList.toggle("broadcast-preview-modal__video--unrotate", previewMode === "FFmpeg / HLS" && isPortraitPreview);
      hideFallback(previewFallback);
      previewModal.hidden = false;
      document.body.classList.add("broadcast-preview-open");

      if (sourceType.indexOf("image/") === 0 && previewImage) {
        if (previewVideo._hlsInstance) {
          previewVideo._hlsInstance.destroy();
          previewVideo._hlsInstance = null;
        }
        previewVideo.pause();
        previewVideo.hidden = true;
        previewImage.hidden = false;
        previewImage.alt = options.name || "Preview";
        if (previewImage.getAttribute("src") !== sourceUrl) {
          previewImage.src = sourceUrl;
        }
      } else {
        if (previewImage) {
          previewImage.hidden = true;
          previewImage.removeAttribute("src");
        }
        previewVideo.hidden = false;
        bindPreviewPlayer(previewVideo, previewWrapper, previewFallback, sourceUrl, sourceType);
      }
    }

    document.querySelectorAll("[data-preview-open]").forEach(function (button) {
      if (button.dataset.previewBound === "true") return;
      button.dataset.previewBound = "true";
      button.addEventListener("click", function () {
        showPreviewInModal({
          broadcastId: button.dataset.previewButtonId,
          previewKey: button.dataset.previewKey,
          name: button.dataset.previewName,
          mode: button.dataset.previewMode,
          orientation: button.dataset.previewOrientation,
          sourceUrl: button.dataset.previewSrc,
          sourceType: button.dataset.previewType
        });
      });
    });

    document.querySelectorAll("[data-preview-close]").forEach(function (button) {
      button.addEventListener("click", closePreviewModal);
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && previewModal && !previewModal.hidden) {
        closePreviewModal();
      }
    });

    <% if flash[:notice].present? %>
      showNotification("<%= j flash[:notice] %>");
    <% end %>

    <% if flash[:alert].present? %>
      showNotification("<%= j flash[:alert] %>");
    <% end %>

    function updateStatusBadge(badge, className, label, iconClass) {
      badge.className = className;

      if (badge.dataset.statusIcon === "true") {
        badge.title = label;
        badge.setAttribute("aria-label", label);

        const icon = badge.querySelector("i");
        if (icon) icon.className = "fas " + iconClass;

        const text = badge.querySelector("[data-status-label]");
        if (text) text.textContent = label;
      } else {
        badge.textContent = label;
      }
    }

    function updateDashboardPreview(channel) {
      if (!channel || !channel.dashboard_preview) return;

      const preview = channel.dashboard_preview;
      const wrapper = document.querySelector("[data-dashboard-preview-card-id='" + channel.id + "']");
      if (!wrapper || wrapper.dataset.dashboardPreviewKey === preview.key) return;

      const image = wrapper.querySelector("[data-dashboard-preview]");
      const loading = wrapper.querySelector("[data-dashboard-preview-loading]");
      const fallback = wrapper.querySelector(".broadcast-card-modern__video-fallback");
      const previewButtons = document.querySelectorAll("[data-preview-button-id='" + channel.id + "']");

      wrapper.dataset.dashboardPreviewKey = preview.key || "";
      wrapper.dataset.orientation = preview.orientation || "landscape";
      const isPortraitPreview = wrapper.dataset.orientation === "portrait" || wrapper.dataset.orientation === "portrait_inverted";
      wrapper.classList.toggle("broadcast-card-modern__video--portrait", isPortraitPreview);
      wrapper.classList.toggle("broadcast-card-modern__video--landscape", !isPortraitPreview);

      previewButtons.forEach(function(button) {
        button.dataset.previewName = preview.name || channel.name || "Preview da TV";
        button.dataset.previewMode = preview.mode || channel.playback_mode || "FFmpeg / HLS";
        button.dataset.previewOrientation = preview.orientation || "landscape";
        button.dataset.previewSrc = preview.source_url || "";
        button.dataset.previewType = preview.source_type || "application/x-mpegURL";
        button.dataset.previewKey = preview.key || "";
        button.hidden = !preview.source_url;
      });

      if (previewModal && !previewModal.hidden && previewModal.dataset.previewBroadcastId === String(channel.id)) {
        showPreviewInModal({
          broadcastId: channel.id,
          previewKey: preview.key,
          name: preview.name || channel.name,
          mode: preview.mode || channel.playback_mode,
          orientation: preview.orientation,
          sourceUrl: preview.source_url,
          sourceType: preview.source_type
        });
      }

      if (!image || !preview.thumb_url) {
        showFallback(fallback);
        return;
      }

      if (loading) loading.hidden = false;
      hideFallback(fallback);
      image.classList.remove("is-loaded");
      image.dataset.dashboardPreviewLoaded = "false";
      image.dataset.dashboardPreviewQueued = "false";
      image.dataset.dashboardPreviewSrc = preview.thumb_url;
      hydrateDashboardPreview(image);
    }

    function pollPlayerStatuses() {
      fetch("/broadcasts/mobile_index.json")
        .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function(channels) {
          var onlineBroadcasts = 0;
          var activePlayers = 0;
          var productionBroadcasts = 0;

          channels.forEach(function(channel) {
            var broadcastOnline = (channel.production_status || channel.status) === "running";
            var playerOnline = channel.app_player_presence_status === "online" || channel.app_player_presence_status === "playing" || channel.app_player_presence_status === "error";
            var tvPowerStatus = channel.tv_power_status || "unavailable";
            var tvIsOn = tvPowerStatus === "on";
            var tvIsUnavailable = tvPowerStatus === "unavailable";

            if (tvIsOn) onlineBroadcasts += 1;
            if (playerOnline) activePlayers += 1;
            if (broadcastOnline) productionBroadcasts += 1;

            document.querySelectorAll("[data-broadcast-status-id='" + channel.id + "']").forEach(function(badge) {
              updateStatusBadge(
                badge,
                "broadcasts-status" + (badge.dataset.statusIcon === "true" ? " broadcast-status-icon" : "") + " " + (broadcastOnline ? "broadcasts-status--online" : "broadcasts-status--offline"),
                broadcastOnline ? "<%= j I18n.t("InProduction") %>" : "<%= j I18n.t("Stopped") %>",
                broadcastOnline ? "fa-broadcast-tower" : "fa-pause"
              );
            });

            document.querySelectorAll("[data-production-play-action-id='" + channel.id + "']").forEach(function(action) {
              action.hidden = broadcastOnline;
            });

            document.querySelectorAll("[data-player-status-id='" + channel.id + "']").forEach(function(badge) {
              updateStatusBadge(
                badge,
                "broadcasts-status" + (badge.dataset.statusIcon === "true" ? " broadcast-status-icon" : "") + " broadcasts-status--player-" + (playerOnline ? "online" : "offline"),
                playerOnline ? "<%= j I18n.t("AppOpen") %>" : "<%= j I18n.t("AppClosed") %>",
                "fa-mobile-alt"
              );
            });

            document.querySelectorAll("[data-tv-power-status-id='" + channel.id + "']").forEach(function(badge) {
              updateStatusBadge(
                badge,
                "broadcasts-status" + (badge.dataset.statusIcon === "true" ? " broadcast-status-icon" : "") + " " + (tvIsOn ? "broadcasts-status--online" : (tvIsUnavailable ? "broadcasts-status--neutral" : "broadcasts-status--offline")),
                tvIsOn ? "<%= j I18n.t("TvOn") %>" : (tvIsUnavailable ? "<%= j I18n.t("TvNoIp") %>" : "<%= j I18n.t("TvOff") %>"),
                tvIsOn ? "fa-tv" : (tvIsUnavailable ? "fa-exclamation-triangle" : "fa-power-off")
              );
            });

            updateDashboardPreview(channel);

            document.querySelectorAll("[data-player-time-id='" + channel.id + "']").forEach(function(timeEl) {
              if (!channel.app_player_presence_updated_at) return;
              var d = new Date(channel.app_player_presence_updated_at);
              timeEl.textContent = d.toLocaleDateString("<%= I18n.locale == :pt ? 'pt-BR' : 'en-US' %>", { day: "2-digit", month: "2-digit" }) + " " +
                d.toLocaleTimeString("<%= I18n.locale == :pt ? 'pt-BR' : 'en-US' %>", { hour: "2-digit", minute: "2-digit" });
            });
          });

          document.querySelectorAll("[data-summary-total-tvs]").forEach(function(el) {
            el.textContent = channels.length;
          });
          document.querySelectorAll("[data-summary-online-tvs]").forEach(function(el) {
            el.textContent = onlineBroadcasts;
          });
          document.querySelectorAll("[data-summary-active-streams]").forEach(function(el) {
            el.textContent = productionBroadcasts;
          });
          document.querySelectorAll(".broadcast-system-summary__health").forEach(function(el) {
            var health = channels.length > 0 ? Math.round((onlineBroadcasts / channels.length) * 100) : 0;
            el.style.setProperty("--summary-health", health + "%");
          });
          document.querySelectorAll("[data-dashboard-donut]").forEach(function(el) {
            var onlinePercent = channels.length > 0 ? Math.round((onlineBroadcasts / channels.length) * 100) : 0;
            var offlinePercent = Math.max(0, 100 - onlinePercent);
            el.style.setProperty("--online", onlinePercent + "%");
            el.style.setProperty("--offline", offlinePercent + "%");
          });
          document.querySelectorAll("[data-dashboard-online-legend]").forEach(function(el) {
            var onlinePercent = channels.length > 0 ? Math.round((onlineBroadcasts / channels.length) * 100) : 0;
            el.textContent = onlineBroadcasts + " (" + onlinePercent + "%)";
          });
          document.querySelectorAll("[data-dashboard-offline-legend]").forEach(function(el) {
            var offlineCount = Math.max(0, channels.length - onlineBroadcasts);
            var offlinePercent = channels.length > 0 ? Math.round((offlineCount / channels.length) * 100) : 0;
            el.textContent = offlineCount + " (" + offlinePercent + "%)";
          });
        })
        .catch(function() {});
    }

    pollPlayerStatuses();
    if (!window.broadcastsStatusPoller) {
      window.broadcastsStatusPoller = setInterval(pollPlayerStatuses, 2500);
    }
  }

  document.addEventListener("DOMContentLoaded", initializeBroadcastsIndex);
  document.addEventListener("turbo:load", initializeBroadcastsIndex);

  function showNotification(message) {
    const container = document.getElementById("notification-container");
    const notification = document.createElement("div");
    notification.className = "notification";
    notification.innerText = message;
    container.appendChild(notification);

    setTimeout(() => {
      notification.remove();
    }, 4000);
  }

  function initializeBroadcastDropdowns() {
    document.querySelectorAll(".broadcasts-dropdown .more").forEach((btn) => {
      if (btn.dataset.broadcastDropdownBound === "true") return;
      btn.dataset.broadcastDropdownBound = "true";
      btn.addEventListener("click", function (e) {
        e.stopPropagation();

        const dropdown = btn.closest(".broadcasts-dropdown");

        document.querySelectorAll(".broadcasts-dropdown").forEach(d => {
          if (d !== dropdown) d.classList.remove("is-open");
        });

        dropdown.classList.toggle("is-open");
      });
    });

    document.querySelectorAll(".broadcasts-dropdown").forEach((dropdown) => {
      if (dropdown.dataset.broadcastMouseleaveBound === "true") return;
      dropdown.dataset.broadcastMouseleaveBound = "true";
      dropdown.addEventListener("mouseleave", function () {
        dropdown.classList.remove("is-open");
      });
    });
  }

  if (window.broadcastDropdownGlobalCloseBound !== true) {
    window.broadcastDropdownGlobalCloseBound = true;
    document.addEventListener("click", function () {
      document.querySelectorAll(".broadcasts-dropdown").forEach(d => {
        d.classList.remove("is-open");
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initializeBroadcastDropdowns);
  document.addEventListener("turbo:load", initializeBroadcastDropdowns);
</script>

