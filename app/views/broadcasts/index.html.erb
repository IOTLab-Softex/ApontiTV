      <div>
        <strong id="broadcast-preview-title" data-preview-title><%= I18n.t("TvPreview") %></strong>
        <p data-preview-description><%= I18n.t("PreviewDescription") %></p>
      </div>
      <button type="button" class="broadcast-preview-modal__close" data-preview-close aria-label="<%= I18n.t("ClosePreview") %>"><%= I18n.t("Close") %></button>
