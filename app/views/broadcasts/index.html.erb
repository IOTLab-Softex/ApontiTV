  <style>
    .broadcast-publish-modal__help{flex:0 0 30px;width:30px;height:30px;display:grid;place-items:center;padding:0;margin-left:auto;border:0;border-radius:50%;background:transparent;color:#d8b4fe;font-size:16px;cursor:pointer;filter:drop-shadow(0 0 5px rgba(168,85,247,.58));transition:.2s}.broadcast-publish-modal__help:hover,.broadcast-publish-modal__help:focus-visible,.broadcast-publish-modal__help[aria-pressed="true"]{color:#fff;outline:0;transform:scale(1.14);filter:drop-shadow(0 0 10px #c084fc)}.broadcast-publish-modal__dialog:has(.broadcast-publish-modal__help:hover),.broadcast-publish-modal__dialog:has(.broadcast-publish-modal__help:focus-visible){border-color:#c084fc;box-shadow:0 0 0 2px rgba(192,132,252,.45),0 0 38px rgba(168,85,247,.48),0 30px 80px rgba(2,6,23,.65)}html[data-theme="light"] .broadcast-publish-modal__help{color:#6d28d9}.publish-help-overlay{position:fixed;z-index:15000;inset:0}.publish-help-overlay[hidden]{display:none}.publish-help-overlay__shade{position:absolute;inset:0;background:rgba(2,6,23,.76);backdrop-filter:blur(1px)}.broadcast-publish-modal__dialog.is-publish-help-active{z-index:15002!important;border-color:#a855f7!important;box-shadow:0 0 0 2px rgba(168,85,247,.55),0 0 42px rgba(168,85,247,.72),0 30px 90px rgba(2,6,23,.72)!important}.publish-help-callout{position:fixed;z-index:15003;width:270px;display:grid;grid-template-columns:24px 1fr;gap:8px;padding:10px 11px;border:1px solid rgba(192,132,252,.78);border-radius:12px;background:#111429;color:#f8fafc;box-shadow:0 13px 34px rgba(2,6,23,.65),0 0 20px rgba(168,85,247,.25)}.publish-help-callout b{width:23px;height:23px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#7c3aed,#a855f7);font-size:10px}.publish-help-callout p{margin:1px 0 0;font-size:10px;line-height:1.4}.publish-help-callout:after{content:"";position:absolute;width:11px;height:11px;background:#111429;border-right:1px solid #c084fc;border-bottom:1px solid #c084fc}.publish-help-callout.is-top:after{bottom:-7px;left:var(--publish-arrow-x,50%);transform:translateX(-50%) rotate(45deg)}.publish-help-callout.is-bottom:after{top:-7px;left:var(--publish-arrow-x,50%);transform:translateX(-50%) rotate(225deg)}
    .publish-help-overlay{pointer-events:none}.publish-help-overlay__shade{display:none}.broadcast-publish-modal__dialog.is-publish-help-active{z-index:2!important;box-shadow:0 0 0 2px rgba(168,85,247,.55),0 0 42px rgba(168,85,247,.72),0 30px 90px rgba(2,6,23,.72),0 0 0 100vmax rgba(2,6,23,.76)!important}
    .broadcast-publish-modal__footer-help{margin-right:auto;margin-left:0}.broadcast-publish-modal__footer:has(.broadcast-publish-modal__footer-help:hover),.broadcast-publish-modal__footer:has(.broadcast-publish-modal__footer-help:focus-visible){border-color:#c084fc;box-shadow:inset 0 0 22px rgba(168,85,247,.2),0 -2px 18px rgba(168,85,247,.22)}
