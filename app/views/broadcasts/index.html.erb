    --broadcast-action-delete-hover-bg: linear-gradient(180deg, #a73340, #7f2230);
    --broadcast-action-delete-hover-border: rgba(248, 113, 113, .3);
    --broadcast-action-power-off-hover-bg: linear-gradient(180deg, #a84b1f, #783313);
    --broadcast-action-power-off-hover-border: rgba(251, 146, 60, .34);
    --broadcast-action-power-on-hover-bg: linear-gradient(180deg, #0f513f, #0a3329);
    --broadcast-action-power-on-hover-border: rgba(52, 211, 153, .24);
    --broadcast-action-edit-hover-bg: linear-gradient(180deg, #1c4f9a, #123979);
    --broadcast-action-edit-hover-border: rgba(96, 165, 250, .26);
    --broadcast-action-volume-hover-bg: linear-gradient(180deg, #334155, #1e293b);
    --broadcast-action-volume-hover-border: rgba(148, 163, 184, .32);
    --broadcast-action-schedule-hover-bg: linear-gradient(180deg, #6d28d9, #4c1d95);
