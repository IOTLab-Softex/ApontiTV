  .broadcasts-action i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    font-size: 12px;
    line-height: 1;
    text-align: center;
  }

  .broadcasts-action i::before {
    display: block;
    width: 100%;
    line-height: 14px;
  }

  .broadcasts-action span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .broadcasts-action--play {
    color: #166534;
    background: #dcfce7;
    border-color: #bbf7d0;
  }

  .broadcasts-action--stop {
    color: #991b1b;
    background: #fee2e2;
    border-color: #fecaca;
  }

  .broadcasts-action--edit {
    color: #1d4ed8;
    background: #dbeafe;
    border-color: #bfdbfe;
  }

  .broadcasts-action--preview {
    color: #0f172a;
    background: #e2e8f0;
    border-color: #cbd5e1;
  }

  .broadcasts-action--power {
    min-width: 104px;
  }

  .broadcasts-action--power-on {
    color: #065f46;
    background: #d1fae5;
    border-color: #a7f3d0;
  }

  .broadcasts-action--power-off {
    color: #9a3412;
    background: #ffedd5;
    border-color: #fed7aa;
  }

  .broadcasts-action--delete {
    color: #7f1d1d;
    background: #fee2e2;
    border-color: #fecaca;
  }

  .broadcasts-panel--table .broadcasts-action {
