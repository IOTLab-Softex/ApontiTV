<%= stylesheet_link_tag "broadcasts_index", "data-turbo-track": "reload" %>
<% content_for :page_kicker, "Broadcast Center" %>
<% content_for :page_title, "TVs" %>
<% content_for :page_subtitle, I18n.t("BroadcastsSubtitle") %>

<div class="broadcasts-index">
  <section class="broadcasts-toolbar">
    <div class="broadcasts-toolbar__actions" data-toolbar-help-panel data-toolbar-help-kind="actions">
      <button type="button"
              class="broadcast-card-modern__tv-help broadcasts-toolbar__help"
              data-toolbar-help-open
              aria-label="Explicar as ações desta barra"
              aria-pressed="false"
              title="Ajuda das ações">
        <i class="far fa-circle-question" aria-hidden="true"></i>
      </button>
      <%= link_to safe_join([tag.i("", class: "fas fa-plus", aria: { hidden: true }), content_tag(:span, I18n.t("AddNewTV"))]), new_broadcast_path, class: "broadcasts-toolbar__btn broadcasts-toolbar__btn--primary", title: I18n.t("AddNewTV"), aria: { label: I18n.t("AddNewTV") }, data: { toolbar_help_tip: "Cadastre uma nova TV e configure como ela receberá e exibirá o conteúdo." } %>
      <button type="button" class="broadcasts-toolbar__btn broadcasts-toolbar__btn--primary broadcasts-toolbar__publish" data-publish-open data-toolbar-help-tip="Envie uma playlist para várias TVs de uma só vez." title="<%= I18n.t("PublishPlaylist") %>" aria-label="<%= I18n.t("PublishPlaylist") %>">
        <i class="fas fa-upload" aria-hidden="true"></i>
        <span><%= I18n.t("PublishPlaylist") %></span>
      </button>
      <% if current_user.admin? %>
        <button type="button"
                class="broadcasts-toolbar__btn broadcasts-toolbar__btn--secondary"
                data-power-schedule-open
                data-toolbar-help-tip="Defina em conjunto os horários de ligar e desligar das TVs."
                data-power-schedule-scope="all"
                data-power-schedule-action="<%= update_power_schedule_all_broadcasts_path(locale: I18n.locale) %>"
                data-power-schedule-name="<%= I18n.t("AllTvs", default: "Todas as TVs") %>"
                data-power-schedule-on=""
                data-power-schedule-off=""
                data-power-schedule-days=""
                title="<%= I18n.t("PowerSchedule", default: "Agendamento de energia") %>"
                aria-label="<%= I18n.t("PowerSchedule", default: "Agendamento de energia") %>">
          <i class="fas fa-calendar-alt" aria-hidden="true"></i>
          <span><%= I18n.t("PowerSchedule", default: "Agendamento") %></span>
        </button>
      <% end %>
    </div>

    <div class="broadcasts-view-switch" role="tablist" aria-label="<%= I18n.t("ViewMode") %>" data-toolbar-help-panel data-toolbar-help-kind="views">
      <button type="button"
              class="broadcast-card-modern__tv-help broadcasts-toolbar__help"
              data-toolbar-help-open
              aria-label="Explicar os modos de visualização"
              aria-pressed="false"
              title="Ajuda da visualização">
        <i class="far fa-circle-question" aria-hidden="true"></i>
      </button>
      <button type="button" class="broadcasts-view-switch__btn" data-view-target="table" data-toolbar-help-tip="Mostra as TVs em uma tabela compacta, com os principais dados em colunas."><span class="material-symbols-rounded" aria-hidden="true">table_rows</span><span><%= I18n.t("Table") %></span></button>
      <button type="button" class="broadcasts-view-switch__btn is-active" data-view-target="cards" data-toolbar-help-tip="Mostra cada TV em um card visual com prévia, estado e controles."><span class="material-symbols-rounded" aria-hidden="true">grid_view</span><span>Cards</span></button>
    </div>
  </section>

  <script>
    function setupBroadcastsToolbarHelp() {
      const toolbar = document.querySelector(".broadcasts-toolbar");
      if (!toolbar || toolbar.dataset.toolbarHelpReady === "true") return;
      toolbar.dataset.toolbarHelpReady = "true";

      toolbar.querySelectorAll("[data-toolbar-help-panel]").forEach(function(panel) {
        const openButton = panel.querySelector("[data-toolbar-help-open]");
        if (!openButton) return;
        let spotlight = null;
        let callouts = [];

        const positionHelp = function() {
          if (!spotlight) return;
          const panelRect = panel.getBoundingClientRect();
          const hole = spotlight.querySelector(".toolbar-help-spotlight__hole");
          hole?.setAttribute("x", panelRect.left - 12);
          hole?.setAttribute("y", panelRect.top - 12);
          hole?.setAttribute("width", panelRect.width + 24);
          hole?.setAttribute("height", panelRect.height + 24);
          hole?.setAttribute("rx", "20");
          hole?.setAttribute("ry", "20");

          const occupied = [];
          callouts.forEach(function(item, index) {
            const targetRect = item.target.getBoundingClientRect();
            const bubbleRect = item.bubble.getBoundingClientRect();
            const preferredPlace = index % 2 === 1 ? "bottom" : "top";
            const places = [preferredPlace, preferredPlace === "top" ? "bottom" : "top"];
            const horizontalOffsets = [0, -100, 100, -(bubbleRect.width + 10), bubbleRect.width + 10];
            let best = null;

            places.forEach(function(place, placeIndex) {
              horizontalOffsets.forEach(function(offset) {
                let left = targetRect.left + targetRect.width / 2 - bubbleRect.width / 2 + offset;
                let top = place === "bottom" ? targetRect.bottom + 14 : targetRect.top - bubbleRect.height - 14;
                left = Math.max(8, Math.min(left, innerWidth - bubbleRect.width - 8));
                top = Math.max(8, Math.min(top, innerHeight - bubbleRect.height - 8));
                const box = { left: left, top: top, right: left + bubbleRect.width, bottom: top + bubbleRect.height, place: place };
                let overlap = 0;
                occupied.forEach(function(other) {
                  const overlapWidth = Math.max(0, Math.min(box.right + 10, other.right) - Math.max(box.left - 10, other.left));
                  const overlapHeight = Math.max(0, Math.min(box.bottom + 10, other.bottom) - Math.max(box.top - 10, other.top));
                  overlap += overlapWidth * overlapHeight;
                });
                const score = overlap * 10000 + placeIndex * 500 + Math.abs(offset);
                if (!best || score < best.score) best = Object.assign(box, { score: score });
              });
            });

            item.bubble.dataset.place = best.place;
            item.bubble.style.left = `${best.left}px`;
            item.bubble.style.top = `${best.top}px`;
            const targetCenterX = targetRect.left + targetRect.width / 2;
            const arrowX = Math.max(14, Math.min(targetCenterX - best.left, bubbleRect.width - 14));
            item.bubble.style.setProperty("--callout-arrow-x", `${arrowX}px`);
            item.bubble.style.setProperty("--toolbar-help-delay", `${index * 70}ms`);
            occupied.push(best);
          });
        };

        const closeHelp = function() {
          panel.classList.remove("is-toolbar-help-active");
          document.body.classList.remove("toolbar-help-callouts-visible");
          openButton.setAttribute("aria-pressed", "false");
          callouts.forEach(function(item) { item.bubble.remove(); });
          callouts = [];
          spotlight?.remove();
          spotlight = null;
        };

        const openHelp = function() {
          toolbar.querySelectorAll("[data-toolbar-help-open][aria-pressed='true']").forEach(function(button) {
            if (button !== openButton) button.click();
          });
          panel.classList.add("is-toolbar-help-active");
          openButton.setAttribute("aria-pressed", "true");
          spotlight = document.createElement("div");
          spotlight.className = "toolbar-help-spotlight";
          spotlight.innerHTML = '<svg width="100%" height="100%"><defs><filter id="toolbar-help-soft-edge" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter><mask id="toolbar-help-cutout" maskUnits="userSpaceOnUse"><rect width="100%" height="100%" fill="white"></rect><rect class="toolbar-help-spotlight__hole" fill="black" filter="url(#toolbar-help-soft-edge)"></rect></mask></defs><rect width="100%" height="100%" fill="rgba(2,6,23,.84)" mask="url(#toolbar-help-cutout)"></rect></svg>';
          document.body.appendChild(spotlight);

          panel.querySelectorAll("[data-toolbar-help-tip]").forEach(function(target) {
            if (target.hidden || target.offsetParent === null) return;
            const bubble = document.createElement("div");
            bubble.className = "desktop-help-callout toolbar-help-callout";
            bubble.innerHTML = `<span>${callouts.length + 1}</span><p>${target.dataset.toolbarHelpTip}</p>`;
            document.body.appendChild(bubble);
            callouts.push({ target: target, bubble: bubble });
          });
          requestAnimationFrame(function() { positionHelp(); document.body.classList.add("toolbar-help-callouts-visible"); });
        };

        openButton.addEventListener("click", function(event) {
          event.preventDefault();
          event.stopPropagation();
          spotlight ? closeHelp() : openHelp();
        });
        panel.addEventListener("click", function(event) {
          if (spotlight && !event.target.closest("[data-toolbar-help-open]")) {
            event.preventDefault();
            event.stopPropagation();
          }
        }, true);
        document.addEventListener("click", function() { if (spotlight) closeHelp(); });
        document.addEventListener("keydown", function(event) { if (event.key === "Escape" && spotlight) closeHelp(); });
        window.addEventListener("resize", positionHelp);
        window.addEventListener("scroll", positionHelp, true);
      });

      const requestedHelp = new URLSearchParams(window.location.search).get("help");
      const requestedKind = requestedHelp === "toolbar_actions" ? "actions" : (requestedHelp === "view_switch" ? "views" : null);
      if (requestedKind && document.body.dataset.requestedToolbarHelpOpened !== "true") {
        const requestedPanel = toolbar.querySelector(`[data-toolbar-help-kind="${requestedKind}"]`);
        const requestedButton = requestedPanel?.querySelector("[data-toolbar-help-open]");
        if (requestedButton) {
          document.body.dataset.requestedToolbarHelpOpened = "true";
          window.setTimeout(function() {
            requestedPanel.scrollIntoView({ behavior: "smooth", block: "center" });
            window.setTimeout(function() { requestedButton.click(); }, 350);
          }, 180);
        }
      }
    }
    document.addEventListener("DOMContentLoaded", setupBroadcastsToolbarHelp);
    document.addEventListener("turbo:load", setupBroadcastsToolbarHelp);
    if (document.readyState !== "loading") setupBroadcastsToolbarHelp();
  </script>

  <section class="broadcasts-panel broadcasts-panel--table" data-view-panel="table" hidden>
    <div class="broadcasts-table-wrap">
      <table class="broadcasts-table">
        <thead>
          <tr>
            <th><span class="broadcasts-table__heading"><span class="material-symbols-rounded" aria-hidden="true">tv</span>TV</span></th>
            <th><span class="broadcasts-table__heading"><span class="material-symbols-rounded" aria-hidden="true">sensors</span>Status</span></th>
            <th><span class="broadcasts-table__heading"><span class="material-symbols-rounded" aria-hidden="true">playlist_play</span>Conteúdo</span></th>
            <th><span class="broadcasts-table__heading"><span class="material-symbols-rounded" aria-hidden="true">devices</span>Dispositivo</span></th>
            <th><span class="broadcasts-table__heading broadcasts-table__heading--actions"><span class="material-symbols-rounded" aria-hidden="true">tune</span><%= I18n.t("Actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @broadcasts.each do |broadcast| %>
            <% tv_power_status = broadcast.tv_power_status %>
            <% tv_power_on = tv_power_status == :on %>
            <% tv_power_available = tv_power_status != :unavailable %>
            <% tv_power_button_path = tv_power_on ? power_off_tv_broadcast_path(broadcast) : power_on_tv_broadcast_path(broadcast) %>
            <% tv_power_button_label = tv_power_on ? I18n.t("PowerOffTv") : I18n.t("PowerOnTv") %>
            <% tv_power_button_class = tv_power_on ? "broadcasts-action--power-off" : "broadcasts-action--power-on" %>
            <% tv_power_status_label = tv_power_on ? I18n.t("On") : (tv_power_available ? I18n.t("Off") : I18n.t("NoIp")) %>
            <% tv_power_status_class = tv_power_on ? "broadcasts-status--online" : (tv_power_available ? "broadcasts-status--offline" : "broadcasts-status--neutral") %>
            <% stream_display_url = broadcast.ffmpeg_stream_url %>
            <% playback_display_url = broadcast.app_playback_url %>
            <% preview_playlist_items = broadcast.playlist_items.to_a %>
            <% current_preview_item = broadcast.current_player_playlist_item || (broadcast.playlist_enabled? ? preview_playlist_items.first : nil) %>
            <% web_only_preview = broadcast.official_app_browser_rotation_enabled? && broadcast.official_app_web_only? %>
            <% preview_src =
              if web_only_preview
                broadcast.official_app_page_url
              elsif current_preview_item&.media&.attached?
                mobile_playlist_item_broadcast_path(broadcast, current_preview_item, v: current_preview_item.updated_at.to_i)
              elsif broadcast.official_app_direct_video_playback_enabled?
                mobile_prepared_video_broadcast_path(broadcast, v: broadcast.cache_key_with_version)
              elsif broadcast.current_stream_filename.present?
                preview_stream_broadcast_path(broadcast, filename: broadcast.current_stream_filename)
              end %>
            <% preview_type =
              if web_only_preview
                "text/html"
              elsif current_preview_item&.media&.attached?
                current_preview_item.media.content_type
              elsif broadcast.official_app_direct_video_playback_enabled?
                "video/mp4"
              else
                "application/x-mpegURL"
              end %>
            <% preview_key =
              if web_only_preview
                "web-only-#{broadcast.id}-#{broadcast.updated_at.to_i}"
              elsif current_preview_item&.media&.attached?
                "playlist-item-#{current_preview_item.id}-#{current_preview_item.updated_at.to_i}"
              elsif broadcast.official_app_direct_video_playback_enabled?
                "direct-video-#{broadcast.id}-#{broadcast.cache_key_with_version}"
              elsif broadcast.current_stream_filename.present?
                "stream-#{broadcast.id}-#{broadcast.current_stream_filename}"
              else
                "empty-#{broadcast.id}-#{broadcast.updated_at.to_i}"
              end %>
            <tr>
              <td class="broadcasts-table__name-cell" data-label="TV">
                <div class="broadcasts-table__title">
                  <span class="broadcasts-table__avatar" aria-hidden="true"><i class="fas fa-tv"></i></span>
                  <div>
                    <strong><%= broadcast.name %></strong>
                    <small><i class="fas fa-shield-alt" aria-hidden="true"></i> <%= broadcast.playback_app_type_official_app? ? I18n.t("Official") : I18n.t("Generic") %></small>
                  </div>
                </div>
              </td>
              <td class="broadcasts-table__status-cell" data-label="Status">
                <div class="broadcasts-table__status-list">
                <span class="broadcasts-status broadcasts-status--player-<%= broadcast.app_player_online? ? 'online' : 'offline' %>"
                      data-player-status-id="<%= broadcast.id %>" data-status-icon="true"
                      aria-label="<%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %>"
                      title="<%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %>">
                  <i class="fas fa-mobile-alt" aria-hidden="true"></i>
                  <span data-status-label><%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %></span>
                </span>
                <span class="broadcasts-status <%= broadcast.effective_production_status == 'running' ? 'broadcasts-status--online' : 'broadcasts-status--offline' %>"
                      data-broadcast-status-id="<%= broadcast.id %>" data-status-icon="true"
                      aria-label="<%= broadcast.effective_production_status == 'running' ? I18n.t("InProduction") : I18n.t("Stopped") %>"
                      title="<%= broadcast.effective_production_status == 'running' ? I18n.t("InProduction") : I18n.t("Stopped") %>">
                  <i class="fas <%= broadcast.effective_production_status == 'running' ? 'fa-broadcast-tower' : 'fa-pause' %>" aria-hidden="true"></i>
                  <span data-status-label><%= broadcast.effective_production_status == "running" ? I18n.t("InProduction") : I18n.t("Stopped") %></span>
                </span>
                <span class="broadcasts-status <%= tv_power_status_class %>"
                      data-tv-power-status-id="<%= broadcast.id %>" data-status-icon="true"
                      aria-label="<%= tv_power_status_label %>"
                      title="<%= tv_power_status_label %>">
                  <i class="fas <%= tv_power_on ? 'fa-tv' : (tv_power_available ? 'fa-power-off' : 'fa-exclamation-triangle') %>" aria-hidden="true"></i>
                  <span data-status-label><%= tv_power_status_label %></span>
                </span>
                </div>
              </td>
              <td data-label="Conteúdo">
                <div class="broadcasts-table__stream">
                  <strong><%= broadcast.preview_playback_mode_label %></strong>
                  <span class="broadcasts-table__muted"><%= broadcast.video.attached? ? broadcast.video.filename.to_s : I18n.t("FlowNotConfigured") %></span>
                </div>
              </td>
              <td data-label="Dispositivo">
                <div class="broadcasts-table__device">
                  <span class="broadcasts-table__pill"><%= broadcast.tv_device_type_label %></span>
                  <span class="broadcasts-table__muted"><%= broadcast.playback_app_type_official_app? ? I18n.t("Official") : I18n.t("Generic") %></span>
                  <% if broadcast.playback_app_type_official_app? %>
                    <span class="broadcast-app-version broadcast-app-version--<%= broadcast.official_app_version_known? ? (broadcast.official_app_outdated? ? 'outdated' : 'current') : 'unknown' %>">
                      <i class="fas <%= broadcast.official_app_version_known? ? (broadcast.official_app_outdated? ? 'fa-exclamation-circle' : 'fa-check-circle') : 'fa-question-circle' %>" aria-hidden="true"></i>
                      <%= broadcast.app_version_name.present? ? "v#{broadcast.app_version_name}" : "Versão não informada" %>
                    </span>
                  <% end %>
                </div>
              </td>
              <td data-label="<%= I18n.t("Actions") %>">
                <div class="broadcasts-actions broadcasts-actions--clean">
                  <% if preview_src.present? %>
    <button class="broadcasts-action icon broadcasts-action--preview" data-preview-open
      data-preview-button-id="<%= broadcast.id %>"
      data-preview-key="<%= preview_key %>"
      data-preview-name="<%= broadcast.name %>"
      data-preview-mode="<%= broadcast.preview_playback_mode_label %>"
      data-preview-orientation="<%= broadcast.orientation.presence || 'landscape' %>"
      data-preview-src="<%= preview_src %>"
      data-preview-type="<%= preview_type %>"
      title="<%= I18n.t("Preview", default: "Preview") %>"
      aria-label="<%= I18n.t("Preview", default: "Preview") %>">
      <i class="fas fa-eye"></i>
    </button>
  <% end %>

  <%= button_to safe_join([tag.i("", class: "fas fa-play", aria: { hidden: true })]),
    start_broadcast_path(broadcast),
    method: :post,
    class: "broadcasts-action icon play",
    title: I18n.t("Play"),
    aria: { label: I18n.t("Play") } %>

  <%= button_to safe_join([tag.i("", class: "fas fa-stop", aria: { hidden: true })]),
    stop_broadcast_path(broadcast),
    method: :post,
    class: "broadcasts-action icon stop",
    title: I18n.t("Stop"),
    aria: { label: I18n.t("Stop") } %>

  <!-- MENU -->
  <div class="broadcasts-dropdown">
<button type="button" class="broadcasts-action icon more" title="<%= I18n.t("Actions") %>" aria-label="<%= I18n.t("Actions") %>">
  <i class="fas fa-ellipsis-v"></i>
</button>

    <div class="broadcasts-dropdown__menu">

  <% if tv_power_available %>
    <%= button_to safe_join([tag.i("", class: "fas fa-power-off", aria: { hidden: true }), content_tag(:span, tv_power_button_label)]),
      tv_power_button_path,
      method: :post,
      class: "dropdown-item",
      title: tv_power_button_label,
      aria: { label: tv_power_button_label } %>
  <% end %>

  <% if current_user.admin? %>
    <%= link_to safe_join([tag.i("", class: "fas fa-edit", aria: { hidden: true }), content_tag(:span, I18n.t("Edit"))]),
      edit_broadcast_path(broadcast),
      class: "dropdown-item",
      aria: { label: I18n.t("Edit") } %>
  <% end %>

  <% if current_user.admin? %>
    <%= button_to safe_join([tag.i("", class: "fas fa-trash", aria: { hidden: true }), content_tag(:span, I18n.t("Delete"))]),
      broadcast_path(broadcast),
      method: :delete,
      class: "dropdown-item",
      title: I18n.t("Delete"),
      aria: { label: I18n.t("Delete") } %>
  <% end %>

</div>
  </div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <footer class="broadcasts-table-footer">
      <span>Mostrando <%= @broadcasts.size %> de <%= @broadcasts.size %> TVs</span>
      <nav class="broadcasts-table-pagination" aria-label="Paginação da tabela">
        <button type="button" disabled aria-label="Página anterior"><i class="fas fa-chevron-left"></i></button>
        <button type="button" class="is-current" aria-current="page">1</button>
        <button type="button" disabled aria-label="Próxima página"><i class="fas fa-chevron-right"></i></button>
      </nav>
    </footer>
  </section>

  <section class="broadcasts-panel broadcasts-panel--cards" data-view-panel="cards">
    <div class="broadcasts-cards-grid">
      <div class="broadcasts-cards-main">
      <button type="button" class="broadcast-card-modern__tv-help" data-tv-help-open aria-label="Ajuda dos controles das TVs" title="Como usar os cards das TVs">
        <i class="far fa-circle-question" aria-hidden="true"></i>
      </button>
      <% @broadcasts.each do |broadcast| %>
        <% tv_power_status = broadcast.tv_power_status %>
        <% tv_power_on = tv_power_status == :on %>
        <% tv_power_available = tv_power_status != :unavailable %>
        <% tv_power_button_path = tv_power_on ? power_off_tv_broadcast_path(broadcast) : power_on_tv_broadcast_path(broadcast) %>
        <% tv_power_button_label = tv_power_on ? I18n.t("PowerOffTv") : I18n.t("PowerOnTv") %>
        <% tv_power_button_class = tv_power_on ? "broadcasts-action--power-off" : "broadcasts-action--power-on" %>
        <% tv_power_status_class = tv_power_on ? "broadcasts-status--online" : (tv_power_available ? "broadcasts-status--offline" : "broadcasts-status--neutral") %>
        <% tv_power_status_label = tv_power_on ? I18n.t("TvOn") : (tv_power_available ? I18n.t("TvOff") : I18n.t("TvNoIp")) %>
        <% tv_volume_available = broadcast.adb_device? && tv_power_available %>
        <% tv_volume_percent = tv_volume_available ? broadcast.synced_tv_volume_percent : broadcast.tv_volume_percent.to_i.clamp(0, 100) %>
        <% stream_display_url = broadcast.ffmpeg_stream_url %>
        <% playback_display_url = broadcast.app_playback_url %>
        <% preview_playlist_items = broadcast.playlist_items.to_a %>
        <% current_preview_item = broadcast.current_player_playlist_item || (broadcast.playlist_enabled? ? preview_playlist_items.first : nil) %>
        <% preview_slide_index = current_preview_item.present? ? (preview_playlist_items.index { |item| item.id == current_preview_item.id } || 0) : 0 %>
        <% web_only_preview = broadcast.official_app_browser_rotation_enabled? && broadcast.official_app_web_only? %>
        <% preview_src =
          if web_only_preview
            broadcast.official_app_page_url
          elsif current_preview_item&.media&.attached?
            mobile_playlist_item_broadcast_path(broadcast, current_preview_item, v: current_preview_item.updated_at.to_i)
          elsif broadcast.official_app_direct_video_playback_enabled?
            mobile_prepared_video_broadcast_path(broadcast, v: broadcast.cache_key_with_version)
          elsif broadcast.current_stream_filename.present?
            preview_stream_broadcast_path(broadcast, filename: broadcast.current_stream_filename)
          end %>
        <% preview_type =
          if web_only_preview
            "text/html"
          elsif current_preview_item&.media&.attached?
            current_preview_item.media.content_type
          elsif broadcast.official_app_direct_video_playback_enabled?
            "video/mp4"
          else
            "application/x-mpegURL"
          end %>
        <% preview_is_image = preview_type.to_s.start_with?("image/") %>
        <% preview_thumb_src =
          if web_only_preview
            nil
          elsif current_preview_item&.media&.attached?
            media_library_thumbnail_path(current_preview_item.media.blob)
          else
            mobile_thumbnail_broadcast_path(broadcast, v: broadcast.cache_key_with_version)
          end %>
        <% preview_key =
          if web_only_preview
            "web-only-#{broadcast.id}-#{broadcast.updated_at.to_i}"
          elsif current_preview_item&.media&.attached?
            "playlist-item-#{current_preview_item.id}-#{current_preview_item.updated_at.to_i}"
          elsif broadcast.official_app_direct_video_playback_enabled?
            "direct-video-#{broadcast.id}-#{broadcast.cache_key_with_version}"
          elsif broadcast.current_stream_filename.present?
            "stream-#{broadcast.id}-#{broadcast.current_stream_filename}"
          else
            "empty-#{broadcast.id}-#{broadcast.updated_at.to_i}"
          end %>
        <% production_running = broadcast.effective_production_status == "running" %>
        <% app_is_current = broadcast.official_app_version_known? && !broadcast.official_app_outdated? %>
        <article class="broadcast-card-modern" data-tv-help-card>
          <div class="broadcast-card-modern__top">
            <div>
              <h2><%= broadcast.name %></h2>
              <p><%= broadcast.video.filename.to_s if broadcast.video.attached? %></p>
            </div>
            <div class="broadcast-card-modern__badges">
              <span class="broadcasts-status broadcast-status-icon broadcasts-status--player-<%= broadcast.app_player_online? ? 'online' : 'offline' %>"
                    data-player-status-id="<%= broadcast.id %>"
                    data-status-icon="true"
                    title="<%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %>"
                    aria-label="<%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %>">
                <i class="fas <%= broadcast.app_player_online? ? 'fa-mobile-alt' : 'fa-mobile-alt' %>" aria-hidden="true"></i>
                <span class="broadcast-status-icon__label" data-status-label><%= broadcast.app_player_online? ? I18n.t("AppOpen") : I18n.t("AppClosed") %></span>
              </span>
              <span class="broadcasts-status broadcast-status-icon <%= broadcast.effective_production_status == 'running' ? 'broadcasts-status--online' : 'broadcasts-status--offline' %>"
                    data-broadcast-status-id="<%= broadcast.id %>"
                    data-status-icon="true"
                    title="<%= broadcast.effective_production_status == 'running' ? I18n.t("InProduction") : I18n.t("Stopped") %>"
                    aria-label="<%= broadcast.effective_production_status == 'running' ? I18n.t("InProduction") : I18n.t("Stopped") %>">
                <i class="fas <%= broadcast.effective_production_status == 'running' ? 'fa-broadcast-tower' : 'fa-pause' %>" aria-hidden="true"></i>
                <span class="broadcast-status-icon__label" data-status-label><%= broadcast.effective_production_status == "running" ? I18n.t("InProduction") : I18n.t("Stopped") %></span>
              </span>
              <span class="broadcasts-status broadcast-status-icon <%= tv_power_status_class %>"
                    data-tv-power-status-id="<%= broadcast.id %>"
                    data-status-icon="true"
                    title="<%= tv_power_status_label %>"
                    aria-label="<%= tv_power_status_label %>">
                <i class="fas <%= tv_power_on ? 'fa-tv' : (tv_power_available ? 'fa-power-off' : 'fa-exclamation-triangle') %>" aria-hidden="true"></i>
                <span class="broadcast-status-icon__label" data-status-label><%= tv_power_status_label %></span>
              </span>
              <% if current_user.admin? %>
                <div class="broadcast-card-modern__top-actions">
                  <% if broadcast.playback_app_type_official_app? && broadcast.adb_device? %>
                    <% update_app_label = if broadcast.official_app_outdated?
                                            "Atualizar app para v#{Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME}"
                                          elsif app_is_current
                                            "App atualizado · v#{Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME}"
                                          else
                                            "Instalar/atualizar app para v#{Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME}"
                                          end %>
                    <%= button_to safe_join([tag.i("", class: "fas fa-cloud-download-alt", aria: { hidden: true })]), update_official_app_broadcast_path(broadcast), method: :post, disabled: app_is_current, form: { class: "broadcast-app-update-top-form", data: { turbo_confirm: "Atualizar o Aponti TV em #{broadcast.name}? A TV precisa estar ligada e com o ADB autorizado." } }, class: "broadcast-app-update-top #{app_is_current ? 'is-current' : 'is-needed'}", title: update_app_label, aria: { label: update_app_label } %>
                  <% end %>
                  <%= button_to toggle_presentation_mode_broadcast_path(broadcast), method: :post, form: { class: "broadcast-presentation-toggle-form" }, class: "broadcast-presentation-toggle #{'is-active' if broadcast.presentation_mode_enabled?}", title: (broadcast.presentation_mode_enabled? ? "Desativar modo apresentação" : "Ativar modo apresentação"), aria: { label: (broadcast.presentation_mode_enabled? ? "Desativar modo apresentação" : "Ativar modo apresentação") } do %>
                    <i class="fas fa-chalkboard-teacher" aria-hidden="true"></i>
                  <% end %>
                  <% if broadcast.playback_app_type_official_app? %>
                    <%= button_to toggle_forecast_widget_broadcast_path(broadcast), method: :post, form: { class: "broadcast-presentation-toggle-form" }, class: "broadcast-presentation-toggle #{'is-active' if broadcast.widget_forecast_enabled?}", title: (broadcast.widget_forecast_enabled? ? "Desativar previsão nesta TV" : "Ativar previsão nesta TV"), aria: { label: (broadcast.widget_forecast_enabled? ? "Desativar previsão nesta TV" : "Ativar previsão nesta TV") } do %>
                      <i class="fas fa-cloud-sun" aria-hidden="true"></i>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="broadcast-card-modern__video broadcast-card-modern__video--<%= broadcast.orientation.presence || 'landscape' %>"
               data-orientation="<%= broadcast.orientation.presence || 'landscape' %>"
               data-dashboard-preview-card-id="<%= broadcast.id %>"
               data-dashboard-preview-key="<%= preview_key %>">
            <div class="broadcast-card-modern__preview-loading" data-dashboard-preview-loading <%= "hidden" if web_only_preview %>>
              <span></span>
            </div>
            <%= image_tag "data:image/gif;base64,R0lGODlhAQABAAAAACw=",
                          class: "broadcast-video broadcast-preview-image broadcast-preview-image--thumb",
                          alt: "Preview de #{broadcast.name}",
                          loading: "lazy",
                          decoding: "async",
                          data: {
                            dashboard_preview: true,
                            dashboard_preview_kind: "image",
                            dashboard_preview_src: preview_thumb_src,
                            dashboard_preview_image_id: broadcast.id
                          },
                          hidden: web_only_preview %>
            <iframe class="broadcast-video broadcast-preview-web"
                    data-dashboard-preview-web
                    src="<%= web_only_preview ? preview_src : nil %>"
                    title="Preview web de <%= broadcast.name %>"
                    loading="lazy"
                    sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
                    <%= "hidden" unless web_only_preview %>></iframe>
            <button type="button"
                    class="broadcast-card-modern__preview-open"
                    data-preview-open
                    data-preview-button-id="<%= broadcast.id %>"
                    data-preview-key="<%= preview_key %>"
                    data-preview-name="<%= broadcast.name %>"
                    data-preview-mode="<%= broadcast.preview_playback_mode_label %>"
                    data-preview-orientation="<%= broadcast.orientation.presence || 'landscape' %>"
                    data-preview-src="<%= preview_src %>"
                    data-preview-type="<%= preview_type %>"
                    title="<%= I18n.t("Preview", default: "Visualizar") %>"
                    aria-label="<%= I18n.t("Preview", default: "Visualizar") %>"
                    <%= "hidden" if preview_src.blank? %>>
              <i class="fas fa-eye" aria-hidden="true"></i>
            </button>
            <div class="broadcast-card-modern__video-fallback" hidden><%= I18n.t("PreviewUnavailable") %></div>
          </div>

          <dl class="broadcast-card-modern__meta">
            <div><dt>App</dt><dd><%= broadcast.playback_app_type_official_app? ? I18n.t("Official") : I18n.t("Generic") %></dd></div>
            <% if broadcast.playback_app_type_official_app? %>
              <div class="broadcast-card-modern__version">
                <dt>Versão instalada</dt>
                <dd>
                  <span class="broadcast-app-version broadcast-app-version--<%= broadcast.official_app_version_known? ? (broadcast.official_app_outdated? ? 'outdated' : 'current') : 'unknown' %>" title="Versão atual disponível: <%= Broadcast::OFFICIAL_APP_CURRENT_VERSION_NAME %>">
                    <i class="fas <%= broadcast.official_app_version_known? ? (broadcast.official_app_outdated? ? 'fa-exclamation-circle' : 'fa-check-circle') : 'fa-question-circle' %>" aria-hidden="true"></i>
                    <% if broadcast.official_app_version_known? %>
                      v<%= broadcast.app_version_name.presence || broadcast.app_version_code %> · <%= broadcast.official_app_outdated? ? "Desatualizada" : "Atualizada" %>
                    <% else %>
                      Não informada
                    <% end %>
                  </span>
                </dd>
              </div>
            <% end %>
            <div><dt>TV</dt><dd><%= broadcast.tv_device_type_label %></dd></div>
            <div><dt>IP</dt><dd><%= broadcast.tv_ip.presence || "-" %></dd></div>
            <div><dt><%= I18n.t("Power") %></dt><dd><%= broadcast.control_method_summary %></dd></div>
            <div><dt><%= I18n.t("OfficialWeb") %></dt><dd><%= broadcast.official_app_browser_rotation_summary %></dd></div>
            <% if broadcast.playback_app_type_official_app? %>
              <div><dt>Previsão</dt><dd><%= broadcast.widget_forecast_enabled? ? "Ativada" : "Desativada" %></dd></div>
            <% end %>
          </dl>

          <div class="broadcast-card-modern__stream">
            <span><%= I18n.t("AppFlow") %></span>
            <strong><%= broadcast.preview_playback_mode_label %></strong>
            <code><%= stream_display_url.presence || playback_display_url.presence || I18n.t("FlowNotConfigured") %></code>
          </div>

          <% if preview_playlist_items.any? && !web_only_preview %>
            <div class="broadcast-card-modern__slide-dots"
                 data-preview-slide-dots
                 data-slide-count="<%= preview_playlist_items.length %>"
                 data-slide-index="<%= preview_slide_index %>"
                 role="img"
                 aria-label="Slide <%= preview_slide_index + 1 %> de <%= preview_playlist_items.length %>">
              <% preview_playlist_items.each_index do |index| %>
                <span class="<%= 'is-active' if index == preview_slide_index %>" aria-hidden="true"></span>
              <% end %>
            </div>
          <% end %>

          <div class="broadcasts-actions broadcasts-actions--card">
            <% if tv_power_available %>
              <%= button_to safe_join([tag.i("", class: "fas fa-power-off", aria: { hidden: true }), content_tag(:span, tv_power_button_label, class: "broadcast-action__label")]), tv_power_button_path, method: :post, class: "broadcasts-action broadcasts-action--power #{tv_power_button_class}", title: tv_power_button_label, aria: { label: tv_power_button_label }, data: { power_control: true, power_state: (tv_power_on ? "on" : "off"), power_on_action: power_on_tv_broadcast_path(broadcast), power_off_action: power_off_tv_broadcast_path(broadcast), power_on_label: I18n.t("PowerOnTv"), power_off_label: I18n.t("PowerOffTv") } %>
            <% end %>
            <% if tv_volume_available %>
              <button type="button"
                      class="broadcasts-action broadcasts-action--volume"
                      title="<%= I18n.t("SetVolume") %>"
                      aria-label="<%= I18n.t("SetVolume") %>"
                      data-volume-open
                      data-volume-tv-name="<%= broadcast.name %>"
                      data-volume-current="<%= tv_volume_percent %>"
                      data-volume-action="<%= set_volume_tv_broadcast_path(broadcast) %>"
                      data-volume-mute-action="<%= mute_tv_broadcast_path(broadcast) %>">
                <i class="fas fa-volume-up" aria-hidden="true"></i>
                <span class="broadcast-action__label"><%= I18n.t("SetVolume") %></span>
              </button>
            <% end %>
            <span class="broadcast-action-slot" data-production-play-action-id="<%= broadcast.id %>" <%= "hidden" if production_running %>>
              <%= button_to safe_join([tag.i("", class: "fas fa-play", aria: { hidden: true }), content_tag(:span, I18n.t("Play"), class: "broadcast-action__label")]), start_broadcast_path(broadcast), method: :post, class: "broadcasts-action broadcasts-action--play", title: I18n.t("Play"), aria: { label: I18n.t("Play") } %>
            </span>
            <span class="broadcast-action-slot" data-production-stop-action-id="<%= broadcast.id %>" <%= "hidden" unless production_running %>>
              <%= button_to safe_join([tag.i("", class: "fas fa-stop", aria: { hidden: true }), content_tag(:span, I18n.t("Stop"), class: "broadcast-action__label")]), stop_broadcast_path(broadcast), method: :post, class: "broadcasts-action broadcasts-action--stop", title: I18n.t("Stop"), aria: { label: I18n.t("Stop") } %>
            </span>
            <% if current_user.admin? %>
              <button type="button"
                      class="broadcasts-action broadcasts-action--schedule"
                      title="<%= I18n.t("PowerSchedule", default: "Agendamento de energia") %>"
                      aria-label="<%= I18n.t("PowerSchedule", default: "Agendamento de energia") %>"
                      data-power-schedule-open
                      data-power-schedule-scope="single"
                      data-power-schedule-action="<%= update_power_schedule_broadcast_path(broadcast, locale: I18n.locale) %>"
                      data-power-schedule-name="<%= broadcast.name %>"
                      data-power-schedule-on="<%= broadcast.tv_power_on_time_input_value %>"
                      data-power-schedule-off="<%= broadcast.tv_power_off_time_input_value %>"
                      data-power-schedule-days="<%= broadcast.send(:normalized_tv_disabled_weekdays).join(",") %>">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                <span class="broadcast-action__label"><%= I18n.t("PowerSchedule", default: "Agendamento") %></span>
              </button>
            <% end %>
            <% if current_user.admin? %>
              <%= link_to safe_join([tag.i("", class: "fas fa-edit", aria: { hidden: true }), content_tag(:span, I18n.t("Edit"), class: "broadcast-action__label")]), edit_broadcast_path(broadcast), class: "broadcasts-action broadcasts-action--edit", title: I18n.t("Edit"), aria: { label: I18n.t("Edit") } %>
            <% end %>
            <% if current_user.admin? %>
              <%= button_to safe_join([tag.i("", class: "fas fa-trash", aria: { hidden: true }), content_tag(:span, I18n.t("Delete"), class: "broadcast-action__label")]), broadcast_path(broadcast), method: :delete, form: { data: { turbo_confirm: I18n.t("ConfirmDeleteTv") } }, class: "broadcasts-action broadcasts-action--delete", title: I18n.t("Delete"), aria: { label: I18n.t("Delete") } %>
            <% end %>
          </div>
        </article>
      <% end %>
      </div>

      <script>
        function setupTvCardHelp() {
            const cardsMain = document.querySelector(".broadcasts-cards-main");
            const card = cardsMain?.querySelector("[data-tv-help-card]");
            const helpButton = cardsMain?.querySelector("[data-tv-help-open]");
            if (!cardsMain || !card || !helpButton || cardsMain.dataset.tvHelpReady === "true") return;
            cardsMain.dataset.tvHelpReady = "true";
            let bubbles = [];
            let spotlight = null;

            const descriptions = [
              { selector:".broadcast-card-modern__badges", text:"Mostra o estado do aplicativo, da transmissão e da energia da TV." },
              { selector:".broadcast-card-modern__video", text:"Mostra uma prévia do conteúdo que está sendo exibido nesta TV." },
              { selector:".broadcast-card-modern__meta", text:"Exibe o tipo de aplicativo, dispositivo, IP e método de controle configurado." },
              { selector:".broadcast-card-modern__slide-dots", text:"Indica quantos slides existem e qual deles está sendo exibido agora." },
              { selector:".broadcasts-action--play", text:"Inicia a reprodução da playlist nesta TV." },
              { selector:".broadcasts-action--stop", text:"Para a reprodução no slide atual." },
              { selector:".broadcasts-action--schedule", text:"Programa os horários para ligar e desligar a TV.", place:"bottom", lock:true }
            ];

            const positionSpotlight = function() {
              if (!spotlight) return;
              const rect = card.getBoundingClientRect();
              const hole = spotlight.querySelector(".tv-help-spotlight__hole");
              hole?.setAttribute("x", rect.left - 12);
              hole?.setAttribute("y", rect.top - 12);
              hole?.setAttribute("width", rect.width + 24);
              hole?.setAttribute("height", rect.height + 24);
              hole?.setAttribute("rx", "28");
              hole?.setAttribute("ry", "28");
            };

            const positionBubbles = function() {
              positionSpotlight();
              const occupied = [];
              bubbles.forEach(function(item) {
                const target = item.target.getBoundingClientRect();
                const bubbleRect = item.bubble.getBoundingClientRect();
                const gap = 14;
                const candidates = item.lock ? [item.place] : [item.place || "top", "top", "left", "right", "bottom"].filter(function(place, index, list) { return list.indexOf(place) === index; });
                let best = null;
                candidates.forEach(function(place, placeIndex) {
                  [0, -38, 38, -76, 76].forEach(function(offset) {
                    let left = target.left + target.width / 2 - bubbleRect.width / 2;
                    let top = target.top - bubbleRect.height - gap;
                    if (place === "bottom") top = target.bottom + gap;
                    if (place === "left") { left = target.left - bubbleRect.width - gap; top = target.top + target.height / 2 - bubbleRect.height / 2; }
                    if (place === "right") { left = target.right + gap; top = target.top + target.height / 2 - bubbleRect.height / 2; }
                    if (place === "top" || place === "bottom") left += offset; else top += offset;
                    left = Math.max(8, Math.min(left, innerWidth - bubbleRect.width - 8));
                    top = Math.max(8, Math.min(top, innerHeight - bubbleRect.height - 8));
                    const box = { left:left, top:top, right:left + bubbleRect.width, bottom:top + bubbleRect.height, place:place };
                    let overlap = 0;
                    occupied.forEach(function(other) { overlap += Math.max(0, Math.min(box.right + 8, other.right) - Math.max(box.left - 8, other.left)) * Math.max(0, Math.min(box.bottom + 8, other.bottom) - Math.max(box.top - 8, other.top)); });
                    const score = overlap * 10000 + placeIndex * 500 + Math.abs(offset);
                    if (!best || score < best.score) best = Object.assign(box, { score:score });
                  });
                });
                item.bubble.dataset.place = best.place;
                item.bubble.style.left = `${best.left}px`;
                item.bubble.style.top = `${best.top}px`;
                item.bubble.style.setProperty("--callout-arrow-x", `${Math.max(14, Math.min(target.left + target.width / 2 - best.left, bubbleRect.width - 14))}px`);
                item.bubble.style.setProperty("--callout-arrow-y", `${Math.max(14, Math.min(target.top + target.height / 2 - best.top, bubbleRect.height - 14))}px`);
                occupied.push(best);
              });
            };

            const closeHelp = function() {
              card.classList.remove("is-tv-help-active");
              cardsMain.classList.remove("is-tv-help-active");
              bubbles.forEach(function(item) { item.bubble.remove(); });
              bubbles = [];
              spotlight?.remove();
              spotlight = null;
              helpButton.setAttribute("aria-pressed", "false");
              document.body.classList.remove("tv-help-callouts-visible");
            };

            const openHelp = function() {
              card.classList.add("is-tv-help-active");
              cardsMain.classList.add("is-tv-help-active");
              helpButton.setAttribute("aria-pressed", "true");
              spotlight = document.createElement("div");
              spotlight.className = "tv-help-spotlight";
              spotlight.innerHTML = '<svg width="100%" height="100%"><defs><filter id="tv-help-soft-edge" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter><mask id="tv-help-cutout" maskUnits="userSpaceOnUse"><rect width="100%" height="100%" fill="white"></rect><rect class="tv-help-spotlight__hole" fill="black" filter="url(#tv-help-soft-edge)"></rect></mask></defs><rect width="100%" height="100%" fill="rgba(2,6,23,.84)" mask="url(#tv-help-cutout)"></rect></svg>';
              document.body.appendChild(spotlight);
              let number = 0;
              descriptions.forEach(function(entry) {
                const target = card.querySelector(entry.selector);
                if (!target || target.hidden || target.offsetParent === null) return;
                number += 1;
                const bubble = document.createElement("div");
                bubble.className = "desktop-help-callout tv-help-callout";
                bubble.innerHTML = `<span>${number}</span><p>${entry.text}</p>`;
                document.body.appendChild(bubble);
                bubbles.push({ target:target, bubble:bubble, place:entry.place || "top", lock:Boolean(entry.lock) });
              });
              requestAnimationFrame(function() { positionBubbles(); document.body.classList.add("tv-help-callouts-visible"); });
            };

            helpButton.setAttribute("aria-pressed", "false");
            helpButton.addEventListener("click", function(event) { event.preventDefault(); event.stopPropagation(); card.classList.contains("is-tv-help-active") ? closeHelp() : openHelp(); });
            card.addEventListener("click", function(event) { if (card.classList.contains("is-tv-help-active") && !event.target.closest("[data-tv-help-open]")) { event.preventDefault(); event.stopPropagation(); } }, true);
            document.addEventListener("click", function() { if (card.classList.contains("is-tv-help-active")) closeHelp(); });
            document.addEventListener("keydown", function(event) { if (event.key === "Escape" && card.classList.contains("is-tv-help-active")) closeHelp(); });
            window.addEventListener("resize", positionBubbles);
            window.addEventListener("scroll", positionBubbles, true);
            const requestedTvHelp = new URLSearchParams(window.location.search).get("help");
            if ((requestedTvHelp === "tv_controls" || requestedTvHelp === "tv_schedule") && document.body.dataset.requestedHelpOpened !== "true") {
              document.body.dataset.requestedHelpOpened = "true";
              window.setTimeout(function() {
                cardsMain.scrollIntoView({ behavior:"smooth", block:"center" });
                window.setTimeout(function() { if (!card.classList.contains("is-tv-help-active")) helpButton.click(); }, 450);
              }, 180);
            }
        }
        document.addEventListener("DOMContentLoaded", setupTvCardHelp);
        document.addEventListener("turbo:load", setupTvCardHelp);
        if (document.readyState !== "loading") setupTvCardHelp();
      </script>

      <aside class="broadcasts-side-panel">
        <button type="button" class="broadcast-card-modern__help" data-desktop-help-open aria-label="Abrir manual da Área de trabalho" title="Como usar este card">
          <i class="far fa-circle-question" aria-hidden="true"></i>
        </button>
      <article class="broadcast-card-modern broadcast-card-modern--desktop">
        <div class="broadcast-card-modern__top broadcast-card-modern__top--desktop">
          <i class="fas fa-desktop" aria-hidden="true"></i>
          <div>
            <h2><%= I18n.t("Desktop") %></h2>
            <p>Personalize o papel de parede dos computadores por grupo.</p>
          </div>
          <%= link_to desktop_agents_path, class: "broadcast-card-modern__groups-link", data: { desktop_help_tip: "Crie grupos e escolha quais computadores pertencem a cada um.", desktop_help_place: "top-left", desktop_help_lock: "true" } do %><i class="fas fa-list-ul"></i><span>Ver grupos</span><% end %>
        </div>

        <div class="broadcast-card-modern__desktop">
          <% wallpaper_targets = [{ id: nil, name: "Todos", count: @desktop_agent_total, path: Rails.root.join("public", "wallpapers", "wallpaper.jpeg"), url: "/wallpapers/wallpaper.jpeg" }] + @desktop_groups.map { |group| { id: group.id, name: group.name, count: @desktop_agent_counts_by_group.fetch(group.id, 0), path: group.wallpaper_path, url: "/wallpapers/groups/#{group.id}.jpeg" } } %>
          <% wallpaper_path = Rails.root.join("public", "wallpapers", "wallpaper.jpeg") %>
          <% wallpaper_version = File.exist?(wallpaper_path) ? File.mtime(wallpaper_path).to_i : Time.current.to_i %>
          <% current_wallpaper_url = File.exist?(wallpaper_path) ? "/wallpapers/wallpaper.jpeg?v=#{wallpaper_version}" : nil %>
          <div class="broadcast-card-modern__wallpaper-frame">
            <button type="button" class="broadcast-card-modern__desktop-arrow is-prev" data-desktop-group-prev data-desktop-help-tip="Volta para o grupo anterior." data-desktop-help-place="left" data-desktop-help-lock="true" aria-label="Grupo anterior"><i class="fas fa-chevron-left"></i></button>
            <div class="broadcast-card-modern__group-peek is-prev" data-desktop-group-peek-prev aria-hidden="true"><img alt="Preview do grupo anterior"></div>
            <div
              class="broadcast-card-modern__wallpaper-progress <%= 'broadcast-card-modern__wallpaper-progress--has-image' if current_wallpaper_url.present? %>"
              data-wallpaper-progress
              data-wallpaper-status-url="<%= status_wallpapers_path %>"
              style="--wallpaper-progress: <%= current_wallpaper_url.present? ? '100%' : '0%' %>; --wallpaper-apply-left: 75%;"
            >
              <div class="broadcast-card-modern__wallpaper-layer broadcast-card-modern__wallpaper-layer--old" data-wallpaper-old>
                <% if current_wallpaper_url.present? %>
                  <%= image_tag current_wallpaper_url, alt: I18n.t("CurrentWallpaper"), data: { wallpaper_old_image: true } %>
                <% else %>
                  <span><%= I18n.t("NoWallpaper") %></span>
                <% end %>
              </div>
              <div class="broadcast-card-modern__wallpaper-layer broadcast-card-modern__wallpaper-layer--new" data-wallpaper-new>
                <% if current_wallpaper_url.present? %>
                  <%= image_tag current_wallpaper_url, alt: I18n.t("NewWallpaper"), data: { wallpaper_new_image: true } %>
                <% else %>
                  <span data-wallpaper-new-empty><%= I18n.t("ChooseImage") %></span>
                <% end %>
              </div>
              <div class="broadcast-card-modern__wallpaper-actions">
                <label class="broadcast-card-modern__wallpaper-upload" data-desktop-help-tip="Escolha uma nova imagem. O anexo fica salvo como rascunho deste grupo." data-desktop-help-place="top" data-desktop-help-lock="true" title="<%= I18n.t("ChooseImage") %>" aria-label="<%= I18n.t("ChooseImage") %>">
                  <i class="fas fa-upload" aria-hidden="true"></i>
                  <span data-wallpaper-file-name><%= I18n.t("ChooseImage") %></span>
                  <%= file_field_tag :wallpaper, class: "broadcasts-upload broadcasts-upload--hidden", accept: "image/*", data: { wallpaper_input: true }, form: "wallpaper-upload-form" %>
                </label>
                <button type="submit" form="wallpaper-upload-form" class="broadcast-card-modern__wallpaper-apply" data-desktop-help-tip="Aplica a imagem nova nos computadores do grupo selecionado." data-desktop-help-place="top" title="<%= I18n.t("ApplyWallpaper") %>" aria-label="<%= I18n.t("ApplyWallpaper") %>" data-wallpaper-apply hidden disabled>
                  <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            <div class="broadcast-card-modern__group-peek is-next" data-desktop-group-peek-next aria-hidden="true"><img alt="Preview do próximo grupo"></div>
            <button type="button" class="broadcast-card-modern__desktop-arrow is-next" data-desktop-group-next data-desktop-help-tip="Avança para o próximo grupo." data-desktop-help-place="right" data-desktop-help-lock="true" aria-label="Próximo grupo"><i class="fas fa-chevron-right"></i></button>
            <span class="broadcast-card-modern__wallpaper-apply-hint">
              <span class="broadcast-card-modern__wallpaper-apply-hint-icon" aria-hidden="true">&#128071;</span>
              <span class="broadcast-card-modern__wallpaper-apply-hint-text"><%= I18n.t("ClickHereApplyHtml").html_safe %></span>
            </span>
          </div>
          <div class="broadcast-card-modern__group-dots" data-desktop-group-dots>
            <% wallpaper_targets.each_with_index do |target, index| %><button type="button" class="<%= 'is-active' if index.zero? %>" data-desktop-group-dot="<%= index %>" data-group-id="<%= target[:id] %>" data-group-name="<%= target[:name] %>" data-group-count="<%= target[:count] %>" data-group-total="<%= wallpaper_targets.size %>" data-group-wallpaper-url="<%= File.exist?(target[:path]) ? "#{target[:url]}?v=#{File.mtime(target[:path]).to_i}" : current_wallpaper_url %>" aria-label="<%= target[:name] %>"></button><% end %>
          </div>
          <div class="broadcast-card-modern__group-current">
            <span>Grupo atual</span>
            <strong data-desktop-group-name>Todos</strong>
            <small data-desktop-group-count><%= wallpaper_targets.first[:count] %> computadores · 1 de <%= wallpaper_targets.size %></small>
          </div>
          <div class="broadcast-card-modern__agent-progress" data-wallpaper-agent-progress hidden>
            <div class="broadcast-card-modern__agent-progress-track">
              <span data-wallpaper-agent-progress-fill></span>
            </div>
            <strong data-wallpaper-agent-progress-label><%= I18n.t("SendingToComputers") %></strong>
          </div>

          <form action="<%= wallpapers_path %>" method="post" enctype="multipart/form-data" id="wallpaper-upload-form" data-wallpaper-upload-form>
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <input type="hidden" name="desktop_group_id" value="" data-desktop-group-input>
            <p><%= I18n.t("RecommendedResolution") %></p>
          </form>
        </div>
      </article>

      <script>
        function setupDesktopCardHelp() {
          const panel = document.querySelector(".broadcasts-side-panel");
          const openButton = document.querySelector("[data-desktop-help-open]");
          if (!panel || !openButton || panel.dataset.desktopHelpReady === "true") return;
          panel.dataset.desktopHelpReady = "true";
          let callouts = [];
          let spotlight = null;
          const positionSpotlight = function() {
            if (!spotlight) return;
            const card = panel.querySelector(".broadcast-card-modern--desktop");
            if (!card) return;
            const rect = card.getBoundingClientRect();
            const padding = 13;
            const hole = spotlight.querySelector(".desktop-help-spotlight__hole");
            if (!hole) return;
            hole.setAttribute("x", rect.left - padding);
            hole.setAttribute("y", rect.top - padding);
            hole.setAttribute("width", rect.width + (padding * 2));
            hole.setAttribute("height", rect.height + (padding * 2));
            hole.setAttribute("rx", "38");
            hole.setAttribute("ry", "38");
          };
          const positionCallouts = function() {
            positionSpotlight();
            const occupied = [];
            const viewportPadding = 8;
            const separation = 10;
            callouts.forEach(function(item) {
              const rect = item.target.getBoundingClientRect();
              const bubble = item.bubble;
              const bubbleRect = bubble.getBoundingClientRect();
              const gap = 15;
              const placements = item.target.dataset.desktopHelpLock === "true" ? [item.place] : [item.place, "top", "bottom", "left", "right"].filter(function(place, index, list) { return list.indexOf(place) === index; });
              const offsets = [0, -28, 28, -56, 56];
              let best = null;

              placements.forEach(function(place, placeIndex) {
                offsets.forEach(function(offset) {
                  let left = rect.left + (rect.width / 2) - (bubbleRect.width / 2);
                  let top = rect.top - bubbleRect.height - gap;
                  if (place === "bottom") top = rect.bottom + gap;
                  if (place === "bottom-left") { left = rect.left - bubbleRect.width + (rect.width * .35); top = rect.bottom + gap; }
                  if (place === "top-left") { left = rect.left - bubbleRect.width + (rect.width * .35); top = rect.top - bubbleRect.height - gap; }
                  if (place === "left") { left = rect.left - bubbleRect.width - gap; top = rect.top + (rect.height / 2) - (bubbleRect.height / 2); }
                  if (place === "right") { left = rect.right + gap; top = rect.top + (rect.height / 2) - (bubbleRect.height / 2); }
                  if (place === "top" || place === "bottom" || place === "bottom-left" || place === "top-left") left += offset; else top += offset;
                  left = Math.max(viewportPadding, Math.min(left, window.innerWidth - bubbleRect.width - viewportPadding));
                  top = Math.max(viewportPadding, Math.min(top, window.innerHeight - bubbleRect.height - viewportPadding));
                  const candidate = { left:left, top:top, right:left + bubbleRect.width, bottom:top + bubbleRect.height, place:place };
                  let overlap = 0;
                  occupied.forEach(function(box) {
                    const width = Math.max(0, Math.min(candidate.right + separation, box.right) - Math.max(candidate.left - separation, box.left));
                    const height = Math.max(0, Math.min(candidate.bottom + separation, box.bottom) - Math.max(candidate.top - separation, box.top));
                    overlap += width * height;
                  });
                  const score = (overlap * 10000) + (placeIndex * 900) + (Math.abs(offset) * 3);
                  if (!best || score < best.score) best = Object.assign(candidate, { score:score });
                });
              });

              bubble.dataset.place = best.place;
              bubble.style.left = `${best.left}px`;
              bubble.style.top = `${best.top}px`;
              const targetX = rect.left + (rect.width / 2) - best.left;
              const targetY = rect.top + (rect.height / 2) - best.top;
              bubble.style.setProperty("--callout-arrow-x", `${Math.max(14, Math.min(targetX, bubbleRect.width - 14))}px`);
              bubble.style.setProperty("--callout-arrow-y", `${Math.max(14, Math.min(targetY, bubbleRect.height - 14))}px`);
              occupied.push(best);
            });
          };
          const revealHelpControls = function() {
            panel.querySelectorAll("[data-desktop-help-tip][hidden]").forEach(function(target) {
              target.dataset.desktopHelpWasHidden = "true";
              target.hidden = false;
              target.classList.add("is-help-preview");
            });
          };
          const restoreHelpControls = function() {
            panel.querySelectorAll("[data-desktop-help-was-hidden='true']").forEach(function(target) {
              target.hidden = true;
              target.classList.remove("is-help-preview");
              delete target.dataset.desktopHelpWasHidden;
            });
          };
          const removeCallouts = function() { callouts.forEach(function(item) { item.bubble.remove(); }); callouts = []; };
          const showCallouts = function() {
            removeCallouts();
            spotlight?.remove();
            spotlight = document.createElement("div");
            spotlight.className = "desktop-help-spotlight";
            spotlight.setAttribute("aria-hidden", "true");
            spotlight.innerHTML = '<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><defs><filter id="desktop-help-soft-edge" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9"></feGaussianBlur></filter><mask id="desktop-help-cutout" maskUnits="userSpaceOnUse"><rect width="100%" height="100%" fill="white"></rect><rect class="desktop-help-spotlight__hole" fill="black" filter="url(#desktop-help-soft-edge)"></rect></mask></defs><rect width="100%" height="100%" fill="rgba(2,6,23,.84)" mask="url(#desktop-help-cutout)"></rect></svg>';
            document.body.appendChild(spotlight);
            revealHelpControls();
            let visibleIndex = 0;
            panel.querySelectorAll("[data-desktop-help-tip]").forEach(function(target) {
              if (target.hidden || target.offsetParent === null) return;
              visibleIndex += 1;
              const bubble = document.createElement("div");
              const place = target.dataset.desktopHelpPlace || "top";
              bubble.className = "desktop-help-callout";
              bubble.dataset.place = place;
              bubble.innerHTML = `<span>${visibleIndex}</span><p>${target.dataset.desktopHelpTip}</p>`;
              document.body.appendChild(bubble);
              callouts.push({ target: target, bubble: bubble, place: place });
            });
            requestAnimationFrame(function() { positionCallouts(); document.body.classList.add("desktop-help-callouts-visible"); });
          };
          const closeHelp = function() { panel.classList.remove("is-help-active"); document.body.classList.remove("desktop-help-callouts-visible"); removeCallouts(); restoreHelpControls(); spotlight?.remove(); spotlight = null; openButton.setAttribute("aria-pressed", "false"); };
          openButton.setAttribute("aria-pressed", "false");
          openButton.addEventListener("click", function(event) {
            event.stopPropagation();
            const active = panel.classList.toggle("is-help-active");
            openButton.setAttribute("aria-pressed", String(active));
            if (active) showCallouts(); else closeHelp();
          });
          panel.addEventListener("click", function(event) { event.stopPropagation(); });
          document.addEventListener("click", closeHelp);
          document.addEventListener("keydown", function(event) { if (event.key === "Escape") closeHelp(); });
          window.addEventListener("resize", positionCallouts);
          window.addEventListener("scroll", positionCallouts, true);
          const requestedDesktopHelp = new URLSearchParams(window.location.search).get("help");
          if ((requestedDesktopHelp === "desktop_all" || requestedDesktopHelp === "desktop_group") && document.body.dataset.requestedHelpOpened !== "true") {
            document.body.dataset.requestedHelpOpened = "true";
            window.setTimeout(function() {
              const dots = panel.querySelectorAll("[data-desktop-group-dot]");
              const targetDot = requestedDesktopHelp === "desktop_group" ? (dots[1] || dots[0]) : dots[0];
              targetDot?.click();
              panel.scrollIntoView({ behavior:"smooth", block:"center" });
              window.setTimeout(function() { if (!panel.classList.contains("is-help-active")) openButton.click(); }, requestedDesktopHelp === "desktop_group" ? 950 : 420);
            }, 180);
          }
        }
        document.addEventListener("DOMContentLoaded", setupDesktopCardHelp);
        document.addEventListener("turbo:load", setupDesktopCardHelp);
        if (document.readyState !== "loading") setupDesktopCardHelp();
      </script>

      <script>
        document.addEventListener("DOMContentLoaded", function() {
          const wallpaperForm = document.querySelector("[data-wallpaper-upload-form]");
          const wallpaperInput = document.querySelector("[data-wallpaper-input]");
          const wallpaperProgress = document.querySelector("[data-wallpaper-progress]");
          const wallpaperNewLayer = document.querySelector("[data-wallpaper-new]");
          const wallpaperApply = document.querySelector("[data-wallpaper-apply]");
          const wallpaperFileName = document.querySelector("[data-wallpaper-file-name]");
          const wallpaperProgressLabel = document.querySelector("[data-wallpaper-progress-label]");
          const wallpaperOldLayer = document.querySelector("[data-wallpaper-old]");
          const wallpaperAgentProgress = document.querySelector("[data-wallpaper-agent-progress]");
          const wallpaperAgentProgressFill = document.querySelector("[data-wallpaper-agent-progress-fill]");
          const wallpaperAgentProgressLabel = document.querySelector("[data-wallpaper-agent-progress-label]");
          const groupInput = document.querySelector("[data-desktop-group-input]");
          const groupName = document.querySelector("[data-desktop-group-name]");
          const groupCount = document.querySelector("[data-desktop-group-count]");
          const groupTargets = <%= raw wallpaper_targets.map.with_index { |target, index| { id: target[:id], name: target[:name], count: target[:count], index: index, total: wallpaper_targets.size, url: File.exist?(target[:path]) ? "#{target[:url]}?v=#{File.mtime(target[:path]).to_i}" : current_wallpaper_url } }.to_json %>;
          let activeGroupIndex = 0;
          if (!wallpaperForm || !wallpaperInput || !wallpaperProgress || !wallpaperNewLayer || !wallpaperApply) return;

          const wallpaperDrafts = window.desktopWallpaperDrafts ||= new Map();
          let agentProgressTimer = null;
          let agentProgressTimeout = null;
          let pendingPulseTimer = null;
          let applyButtonTimer = null;
          let wallpaperProgressFrame = null;
          const wallpaperApplyFollowStartPosition = 60;
          const wallpaperApplyRestPosition = 75;

          function buttonPositionForProgress(value) {
            const progressValue = Number(value) || 0;
            if (wallpaperProgress.classList.contains("broadcast-card-modern__wallpaper-progress--button-catching")) {
              if (progressValue <= wallpaperApplyFollowStartPosition) return wallpaperApplyFollowStartPosition;
              return Math.max(8, Math.min(92, progressValue));
            }
            return progressValue <= wallpaperApplyRestPosition ? wallpaperApplyRestPosition : Math.max(8, Math.min(92, progressValue));
          }

          function setWallpaperProgress(value, options) {
            const syncButton = !options || options.syncButton !== false;
            const normalizedValue = Math.max(0, Math.min(100, Number(value) || 0));
            wallpaperProgress.style.setProperty("--wallpaper-progress", normalizedValue + "%");
            if (syncButton) {
              const buttonPosition = buttonPositionForProgress(normalizedValue) + "%";
              wallpaperProgress.style.setProperty("--wallpaper-apply-left", buttonPosition);
              wallpaperProgress.parentElement?.style.setProperty("--wallpaper-apply-left", buttonPosition);
            }
            if (wallpaperProgress.classList.contains("broadcast-card-modern__wallpaper-progress--button-catching") &&
                normalizedValue >= wallpaperApplyFollowStartPosition) {
              wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--hint-visible");
            }
            if (wallpaperProgressLabel) wallpaperProgressLabel.textContent = Math.round(normalizedValue) + "%";
          }

          function setApplyButtonPosition(value) {
            const buttonPosition = buttonPositionForProgress(value) + "%";
            wallpaperProgress.style.setProperty("--wallpaper-apply-left", buttonPosition);
            wallpaperProgress.parentElement?.style.setProperty("--wallpaper-apply-left", buttonPosition);
          }

          function clearWallpaperProgressAnimation() {
            if (wallpaperProgressFrame) window.cancelAnimationFrame(wallpaperProgressFrame);
            wallpaperProgressFrame = null;
          }

          function clearApplyButtonTimer() {
            if (applyButtonTimer) window.clearTimeout(applyButtonTimer);
            applyButtonTimer = null;
            wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--button-catching", "broadcast-card-modern__wallpaper-progress--hint-visible");
          }

          function stopPendingPulse() {
            if (pendingPulseTimer) window.clearInterval(pendingPulseTimer);
            pendingPulseTimer = null;
            clearApplyButtonTimer();
          }

          function startPendingPulse() {
            stopPendingPulse();
            let expanded = false;
            pendingPulseTimer = window.setInterval(function() {
              if (!wallpaperProgress.classList.contains("broadcast-card-modern__wallpaper-progress--pending") ||
                  wallpaperProgress.classList.contains("broadcast-card-modern__wallpaper-progress--applying")) {
                stopPendingPulse();
                return;
              }

              expanded = !expanded;
              setWallpaperProgress(expanded ? 78 : 75);
            }, 2100);
          }

          function animateWallpaperProgressTo(value, delay, options) {
            window.setTimeout(function() {
              wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--resetting");
              const from = Number((wallpaperProgress.style.getPropertyValue("--wallpaper-progress") || "0").replace("%", "")) || 0;
              const to = Number(value) || 0;
              const duration = options && options.duration ? options.duration : 3000;
              const startedAt = performance.now();
              clearWallpaperProgressAnimation();

              function tick(now) {
                const elapsed = Math.min(1, (now - startedAt) / duration);
                const eased = 1 - Math.pow(1 - elapsed, 3);
                setWallpaperProgress(from + ((to - from) * eased), options);
                if (elapsed < 1) {
                  wallpaperProgressFrame = window.requestAnimationFrame(tick);
                } else {
                  wallpaperProgressFrame = null;
                  setWallpaperProgress(to, options);
                }
              }

              wallpaperProgressFrame = window.requestAnimationFrame(tick);
            }, delay || 80);
          }

          function scheduleWallpaperProgress(points) {
            points.forEach(function(point) {
              window.setTimeout(function() {
                setWallpaperProgress(point.value);
              }, point.delay);
            });
          }

          function setAgentProgress(percent, label) {
            if (!wallpaperAgentProgress || !wallpaperAgentProgressFill || !wallpaperAgentProgressLabel) return;
            wallpaperAgentProgress.hidden = false;
            wallpaperAgentProgressFill.style.width = Math.max(0, Math.min(100, percent)) + "%";
            wallpaperAgentProgressLabel.textContent = label;
          }

          function agentProgressLabel(applied, total, online) {
            if (total > 0) {
              return `<%= j I18n.t("ComputersUpdatedPrefix") %> ${applied}/${total}${online > 0 ? ` (${online} online)` : ""}`;
            }
            return "<%= j I18n.t("NoApprovedAgents") %>";
          }

          function hideAgentProgress() {
            if (agentProgressTimer) window.clearInterval(agentProgressTimer);
            if (agentProgressTimeout) window.clearTimeout(agentProgressTimeout);
            agentProgressTimer = null;
            agentProgressTimeout = null;
            if (wallpaperAgentProgress) wallpaperAgentProgress.hidden = true;
          }

          function updateWallpaperLayers(oldUrl, newUrl) {
            const urls = [oldUrl, newUrl === undefined ? oldUrl : newUrl];
            [wallpaperOldLayer, wallpaperNewLayer].forEach(function(layer, index) {
              if (!layer) return;
              const url = urls[index];
              if (!url) return;
              let image = layer.querySelector("img");
              if (!image) {
                image = document.createElement("img");
                layer.innerHTML = "";
                layer.appendChild(image);
              }
              image.dataset[index === 0 ? "wallpaperOldImage" : "wallpaperNewImage"] = "true";
              image.src = url;
            });
          }

          function pollAgentProgress(version, initialProgress) {
            const statusUrl = wallpaperProgress.dataset.wallpaperStatusUrl;
            if (!statusUrl || !version) return;

            hideAgentProgress();
            const firstPercent = initialProgress && Number.isFinite(initialProgress.percent) ? initialProgress.percent : 0;
            const firstTotal = initialProgress && Number.isFinite(initialProgress.total) ? initialProgress.total : 0;
            const firstApplied = initialProgress && Number.isFinite(initialProgress.applied) ? initialProgress.applied : 0;
            const firstOnline = initialProgress && Number.isFinite(initialProgress.online) ? initialProgress.online : 0;
            setAgentProgress(firstTotal > 0 ? firstPercent : 12, agentProgressLabel(firstApplied, firstTotal, firstOnline));

            const refresh = function() {
              fetch(`${statusUrl}?version=${encodeURIComponent(version)}&desktop_group_id=${encodeURIComponent(groupInput?.value || "")}`, {
                headers: { "Accept": "application/json" },
                credentials: "same-origin"
              })
                .then(function(response) { return response.json(); })
                .then(function(data) {
                  const total = Number(data.total || 0);
                  const applied = Number(data.applied || 0);
                  const percent = Number(data.percent || 0);
                  const online = Number(data.online || 0);
                  setAgentProgress(total > 0 ? percent : 12, agentProgressLabel(applied, total, online));
                  if (data.complete) {
                    setAgentProgress(100, "<%= j I18n.t("WallpaperAppliedAllOnline") %>");
                    window.setTimeout(hideAgentProgress, 1200);
                  }
                })
                .catch(function() {
                  setAgentProgress(100, "<%= j I18n.t("AgentTrackingFailed") %>");
                  window.setTimeout(hideAgentProgress, 1600);
                });
            };

            refresh();
            agentProgressTimer = window.setInterval(refresh, 2500);
            agentProgressTimeout = window.setTimeout(function() {
              setAgentProgress(100, "<%= j I18n.t("AgentWaitTimeout") %>");
              window.setTimeout(hideAgentProgress, 1800);
            }, 60000);
          }

          function uploadWallpaperInBackground(file) {
            const uploadGroupKey = String(groupInput?.value || "");
            const formData = new FormData(wallpaperForm);
            formData.set("wallpaper", file);
            formData.set("desktop_group_id", uploadGroupKey);

            fetch(wallpaperForm.action, {
              method: "POST",
              headers: { "Accept": "application/json" },
              credentials: "same-origin",
              body: formData
            })
              .then(function(response) {
                if (!response.ok) throw new Error("upload_failed");
                return response.json();
              })
              .then(function(data) {
                const wallpaper = data.wallpaper || {};
                if (String(groupInput?.value || "") === uploadGroupKey) updateWallpaperLayers(wallpaper.url);
                const activeDot = Array.from(document.querySelectorAll("[data-desktop-group-dot]")).find(function(dot) {
                  return String(dot.dataset.groupId || "") === uploadGroupKey;
                });
                if (activeDot && wallpaper.url) activeDot.dataset.groupWallpaperUrl = wallpaper.url;
                const appliedDraft = wallpaperDrafts.get(uploadGroupKey);
                if (appliedDraft?.objectUrl) URL.revokeObjectURL(appliedDraft.objectUrl);
                wallpaperDrafts.delete(uploadGroupKey);
                if (String(groupInput?.value || "") === uploadGroupKey) {
                  wallpaperInput.value = "";
                  wallpaperApply.hidden = true;
                  wallpaperApply.disabled = true;
                }
                wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--pending", "broadcast-card-modern__wallpaper-progress--applying");
                stopPendingPulse();
                setWallpaperProgress(100);
                pollAgentProgress(wallpaper.version, data.progress);
              })
              .catch(function() {
                setAgentProgress(100, "<%= j I18n.t("WallpaperApplyError") %>");
                window.setTimeout(hideAgentProgress, 1800);
                wallpaperApply.disabled = false;
                wallpaperApply.hidden = false;
                wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--applying");
                wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--pending");
                startPendingPulse();
              });
          }

          wallpaperInput.addEventListener("change", function() {
            const file = wallpaperInput.files && wallpaperInput.files[0];
            if (!file || !file.type || !file.type.startsWith("image/")) return;

            const groupKey = String(groupInput?.value || "");
            const previousDraft = wallpaperDrafts.get(groupKey);
            if (previousDraft?.objectUrl) URL.revokeObjectURL(previousDraft.objectUrl);
            const pendingObjectUrl = URL.createObjectURL(file);
            wallpaperDrafts.set(groupKey, { file: file, objectUrl: pendingObjectUrl, fileName: file.name });

            let image = wallpaperNewLayer.querySelector("[data-wallpaper-new-image]");
            if (!image) {
              image = document.createElement("img");
              image.alt = "<%= j I18n.t("NewWallpaper") %>";
              image.dataset.wallpaperNewImage = "true";
              wallpaperNewLayer.innerHTML = "";
              wallpaperNewLayer.appendChild(image);
            }

            image.src = pendingObjectUrl;
            wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--has-image", "broadcast-card-modern__wallpaper-progress--pending");
            wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--applying", "broadcast-card-modern__wallpaper-progress--hint-visible");
            wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--resetting");
            clearApplyButtonTimer();
            clearWallpaperProgressAnimation();
            setWallpaperProgress(0);
            wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--button-catching");
            setApplyButtonPosition(0);
            wallpaperProgress.offsetHeight;
            animateWallpaperProgressTo(75, 120, { duration: 3000 });
            applyButtonTimer = window.setTimeout(function() {
              wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--button-catching");
            }, 3300);
            window.setTimeout(startPendingPulse, 3500);
            wallpaperApply.hidden = false;
            wallpaperApply.disabled = false;
            if (wallpaperFileName) wallpaperFileName.textContent = file.name;
          });

          document.addEventListener("desktop-group:changed", function(event) {
            const groupKey = String(event.detail?.groupId || "");
            const draft = wallpaperDrafts.get(groupKey);
            stopPendingPulse();
            clearWallpaperProgressAnimation();
            clearApplyButtonTimer();
            wallpaperProgress.classList.remove("broadcast-card-modern__wallpaper-progress--pending", "broadcast-card-modern__wallpaper-progress--applying", "broadcast-card-modern__wallpaper-progress--resetting", "broadcast-card-modern__wallpaper-progress--button-catching");
            if (draft) {
              const transfer = new DataTransfer();
              transfer.items.add(draft.file);
              wallpaperInput.files = transfer.files;
              updateWallpaperLayers(event.detail?.wallpaperUrl || "", draft.objectUrl);
              wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--has-image", "broadcast-card-modern__wallpaper-progress--pending");
              setWallpaperProgress(75);
              wallpaperApply.hidden = false;
              wallpaperApply.disabled = false;
              if (wallpaperFileName) wallpaperFileName.textContent = draft.fileName;
              startPendingPulse();
            } else {
              wallpaperInput.value = "";
              if (event.detail?.wallpaperUrl) updateWallpaperLayers(event.detail.wallpaperUrl);
              setWallpaperProgress(event.detail?.wallpaperUrl ? 100 : 0);
              wallpaperApply.hidden = true;
              wallpaperApply.disabled = true;
              if (wallpaperFileName) wallpaperFileName.textContent = "<%= j I18n.t("ChooseImage") %>";
            }
          });

          wallpaperForm.addEventListener("submit", function(event) {
            const file = wallpaperInput.files && wallpaperInput.files[0];
            if (!file) {
              event.preventDefault();
              return;
            }

            if (!wallpaperProgress.classList.contains("broadcast-card-modern__wallpaper-progress--applying")) {
              event.preventDefault();
              stopPendingPulse();
              clearWallpaperProgressAnimation();
              wallpaperProgress.classList.add("broadcast-card-modern__wallpaper-progress--applying");
              wallpaperApply.disabled = true;
              scheduleWallpaperProgress([
                { value: 86, delay: 120 },
                { value: 92, delay: 850 },
                { value: 97, delay: 1700 },
                { value: 100, delay: 2500 }
              ]);
              wallpaperApply.hidden = false;
              window.setTimeout(function() {
                uploadWallpaperInBackground(file);
              }, 3300);
            }
          });

          function showDesktopGroup(index) {
            if (!groupTargets.length) return;
            activeGroupIndex = (index + groupTargets.length) % groupTargets.length;
            const target = groupTargets[activeGroupIndex];
            if (groupInput) groupInput.value = target.id || "";
            if (groupName) groupName.textContent = target.name;
            if (groupCount) groupCount.textContent = `${target.count} computadores · ${activeGroupIndex + 1} de ${target.total}`;
            if (target.url) updateWallpaperLayers(target.url);
            document.querySelectorAll("[data-desktop-group-dot]").forEach(function(dot, dotIndex) { dot.classList.toggle("is-active", dotIndex === activeGroupIndex); });
          }
        });
      </script>
      <script>
        (function setupDesktopGroupCarousel() {
          const card = document.querySelector(".broadcast-card-modern--desktop");
          if (!card || card.dataset.groupCarouselReady === "true") return;
          const dots = Array.from(card.querySelectorAll("[data-desktop-group-dot]"));
          if (!dots.length) return;
          const name = card.querySelector("[data-desktop-group-name]");
          const count = card.querySelector("[data-desktop-group-count]");
          const input = card.querySelector("[data-desktop-group-input]");
          let previousPeek = card.querySelector("[data-desktop-group-peek-prev]");
          let nextPeek = card.querySelector("[data-desktop-group-peek-next]");
          const carouselFrame = card.querySelector(".broadcast-card-modern__wallpaper-frame");
          let current = 0;
          let carouselInitialized = false;
          let carouselAnimationTimer = null;
          let groupLabelSwapTimer = null;
          let carouselAnimating = false;
          let wheelAccumulator = 0;
          let wheelResetTimer = null;

          function selectGroup(index) {
            if (carouselAnimating) return;
            const previousIndex = current;
            const direction = index >= previousIndex ? "next" : "prev";
            const targetIndex = (index + dots.length) % dots.length;
            if (carouselInitialized && targetIndex !== previousIndex) {
              animateCarousel(direction, targetIndex, function() { commitGroup(targetIndex); });
              return;
            }
            commitGroup(targetIndex);
            carouselInitialized = true;
          }

          function commitGroup(targetIndex) {
            current = targetIndex;
            const selected = dots[current];
            dots.forEach(function(dot, dotIndex) { dot.classList.toggle("is-active", dotIndex === current); });
            if (name) name.textContent = selected.dataset.groupName || "Todos";
            if (count) count.textContent = `${selected.dataset.groupCount || 0} computadores · ${current + 1} de ${selected.dataset.groupTotal || dots.length}`;
            if (input) input.value = selected.dataset.groupId || "";
            const wallpaperUrl = selected.dataset.groupWallpaperUrl;
            if (wallpaperUrl) card.querySelectorAll("[data-wallpaper-old] img, [data-wallpaper-new] img").forEach(function(image) { image.src = wallpaperUrl; });
            updatePeek(previousPeek, dots[(current - 1 + dots.length) % dots.length]);
            updatePeek(nextPeek, dots[(current + 1) % dots.length]);
            document.dispatchEvent(new CustomEvent("desktop-group:changed", {
              detail: { groupId: selected.dataset.groupId || "", wallpaperUrl: wallpaperUrl || "" }
            }));
          }

          function animateCarousel(direction, targetIndex, onComplete) {
            if (carouselAnimationTimer) window.clearTimeout(carouselAnimationTimer);
            if (groupLabelSwapTimer) window.clearTimeout(groupLabelSwapTimer);
            carouselAnimating = true;
            card.classList.remove("is-sliding-next", "is-sliding-prev");
            card.querySelector(".broadcast-card-modern__group-current")?.classList.remove("is-group-label-entering");
            void card.offsetWidth;
            card.classList.add(direction === "next" ? "is-sliding-next" : "is-sliding-prev");
            groupLabelSwapTimer = window.setTimeout(function() {
              const incoming = dots[targetIndex];
              const label = card.querySelector(".broadcast-card-modern__group-current");
              if (name) name.textContent = incoming.dataset.groupName || "Todos";
              if (count) count.textContent = `${incoming.dataset.groupCount || 0} computadores · ${targetIndex + 1} de ${incoming.dataset.groupTotal || dots.length}`;
              label?.classList.add("is-group-label-entering");
            }, 300);
            carouselAnimationTimer = window.setTimeout(function() {
              rotatePeekRoles();
              if (onComplete) onComplete();
              card.classList.remove("is-sliding-next", "is-sliding-prev");
              card.querySelector(".broadcast-card-modern__group-current")?.classList.remove("is-group-label-entering");
              carouselAnimating = false;
            }, 840);
          }

          function rotatePeekRoles() {
            const oldPreviousPeek = previousPeek;
            previousPeek = nextPeek;
            nextPeek = oldPreviousPeek;
            previousPeek.classList.remove("is-next");
            previousPeek.classList.add("is-prev");
            nextPeek.classList.remove("is-prev");
            nextPeek.classList.add("is-next");
          }

          function updatePeek(peek, target) {
            if (!peek || !target) return;
            const image = peek.querySelector("img");
            const url = target.dataset.groupWallpaperUrl;
            peek.classList.toggle("has-image", Boolean(url));
            if (image && url) image.src = url;
            peek.title = target.dataset.groupName || "Grupo";
          }

          card.querySelector("[data-desktop-group-prev]")?.addEventListener("click", function(event) { event.preventDefault(); selectGroup(current - 1); });
          card.querySelector("[data-desktop-group-next]")?.addEventListener("click", function(event) { event.preventDefault(); selectGroup(current + 1); });
          dots.forEach(function(dot, index) { dot.addEventListener("click", function() { selectGroup(index); }); });
          carouselFrame?.addEventListener("wheel", function(event) {
            event.preventDefault();
            if (carouselAnimating) return;
            const movement = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
            wheelAccumulator += movement;
            if (wheelResetTimer) window.clearTimeout(wheelResetTimer);
            wheelResetTimer = window.setTimeout(function() { wheelAccumulator = 0; }, 180);
            if (Math.abs(wheelAccumulator) < 28) return;
            const direction = wheelAccumulator > 0 ? 1 : -1;
            wheelAccumulator = 0;
            selectGroup(current + direction);
          }, { passive: false });
          card.dataset.groupCarouselReady = "true";
          selectGroup(0);
        })();
      </script>
      </aside>
    </div>
  </section>

</div>

