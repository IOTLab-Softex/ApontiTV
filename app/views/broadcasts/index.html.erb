            </div>
            <p class="broadcast-playlist-editor__count">Mostrando <%= @video_library_blobs.size %> item<%= @video_library_blobs.size == 1 ? "" : "s" %></p>
          </section>

          <section class="broadcast-publish-section broadcast-playlist-editor__order-section" data-playlist-editor-help-tip="Organize a sequência de exibição arrastando os itens selecionados e remova o que não deve fazer parte da playlist.">
            <div class="broadcast-publish-section__title">
              <h3><span class="material-symbols-rounded" aria-hidden="true">format_list_numbered</span> <%= I18n.t("PlaylistOrder") %></h3>
              <span class="broadcast-playlist-editor__pill" data-playlist-order-count><%= I18n.t("ItemsCount", count: 0) %></span>
            </div>
            <div class="broadcast-playlist-order" data-playlist-order>
              <div class="broadcast-playlist-order__empty" data-playlist-order-empty>
                <span class="material-symbols-rounded" aria-hidden="true">video_file</span>
                <strong><%= I18n.t("PlaylistEmpty") %></strong>
                <span><%= I18n.t("SelectLibraryItemsToStart") %></span>
              </div>
