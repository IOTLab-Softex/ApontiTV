              <h3><i class="fas fa-list-ul" aria-hidden="true"></i> <%= I18n.t("PlaylistOrder") %></h3>
              <span class="broadcast-playlist-editor__pill" data-playlist-order-count><%= I18n.t("ItemsCount", count: 0) %></span>
            </div>
            <div class="broadcast-playlist-order" data-playlist-order>
              <div class="broadcast-playlist-order__empty" data-playlist-order-empty>
                <i class="far fa-file-video" aria-hidden="true"></i>
                <strong><%= I18n.t("PlaylistEmpty") %></strong>
                <span><%= I18n.t("SelectLibraryItemsToStart") %></span>
              </div>
            </div>
            <button type="button" class="broadcast-playlist-clear-order" data-playlist-clear-items title="<%= I18n.t("ClearOrder") %>">
              <i class="fas fa-trash-alt" aria-hidden="true"></i>
              <span><%= I18n.t("ClearOrder") %></span>
            </button>
          </section>
        </div>

        <div class="broadcast-publish-modal__footer">
          <button type="button" class="broadcast-preview-modal__close" data-playlist-editor-close><%= I18n.t("Cancel") %></button>
          <button type="submit" class="broadcasts-toolbar__btn broadcasts-toolbar__btn--primary">
            <i class="fas fa-save" aria-hidden="true"></i>
            <span><%= I18n.t("SavePlaylist") %></span>
