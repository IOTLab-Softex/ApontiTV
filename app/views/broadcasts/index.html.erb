        <div class="broadcast-publish-modal__body">
          <section class="broadcast-publish-section broadcast-playlist-editor__settings" data-playlist-editor-help-tip="Defina o nome, duração das imagens, comportamento dos vídeos, transição e sincronização entre TVs.">
            <h3><span class="material-symbols-rounded" aria-hidden="true">tune</span> <%= I18n.t("PlaylistSettings") %></h3>
            <div class="broadcast-playlist-editor__settings-grid">
              <label class="broadcast-playlist-field" data-playlist-settings-help-tip="Dê um nome claro para identificar esta playlist na hora de publicar.">
