    min-height: 42px;
    border: 0;
    border-radius: 7px;
    color: #fff;
    background: linear-gradient(180deg, #a33af2, #7c28df);
    box-shadow: 0 10px 24px rgba(139, 47, 242, .28);
  }

  .broadcast-system-summary {
    position: relative;
    overflow: hidden;
    padding: 16px;
    border-radius: 12px;
    color: #f8fbff;
    background:
      radial-gradient(circle at 10% 0%, rgba(139, 47, 242, .20), transparent 160px),
      linear-gradient(180deg, #11182b 0%, #0b1020 100%);
    border: 1px solid rgba(168, 85, 247, .18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04), 0 18px 42px rgba(2, 6, 23, .30);
  }

  .broadcast-system-summary::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(255,255,255,.055), transparent 28%),
      radial-gradient(circle at 86% 12%, rgba(56, 189, 248, .12), transparent 26%);
  }

  .broadcast-system-summary__header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .broadcast-system-summary__header span {
    display: block;
    margin: 0;
    color: #a8b4ce;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .broadcast-system-summary__header h2 {
    margin: 4px 0 0;
    color: #fff;
    font-size: 30px;
    line-height: 1.2;
  }

  .broadcast-system-summary__header > i {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #d8b4fe;
    background: rgba(139, 47, 242, .18);
    border: 1px solid rgba(168, 85, 247, .24);
  }

  .broadcast-system-summary__health {
    position: relative;
    z-index: 1;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(148, 163, 184, .14);
    box-shadow: inset 0 1px 2px rgba(0,0,0,.24);
  }

  .broadcast-system-summary__health span {
    display: block;
    width: var(--summary-health);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #22c55e, #8b2ff2 62%, #38bdf8);
    box-shadow: 0 0 18px rgba(139, 47, 242, .35);
    transition: width .35s ease;
  }

  .broadcast-system-summary__caption {
    position: relative;
    z-index: 1;
    margin: 10px 0 14px;
    color: #a8b4ce;
    font-size: 12px;
    font-weight: 750;
  }

  .broadcast-system-summary__caption strong {
    color: #fff;
  }

  .broadcast-system-summary__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .broadcast-system-summary__item {
    min-height: 70px;
    padding: 11px;
    border-radius: 10px;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 9px;
    background: rgba(255, 255, 255, .055);
    border: 1px solid rgba(255, 255, 255, .055);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.035);
  }

  .broadcast-system-summary__item i {
    grid-row: 1 / 3;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
  }

  .broadcast-system-summary__item strong {
    color: #ffffff;
    font-size: 21px;
    line-height: 1;
  }

  .broadcast-system-summary__item span {
    margin-top: 4px;
    color: #a8b4ce;
    font-size: 10.5px;
    font-weight: 750;
  }

  .broadcast-system-summary__item--purple i {
    color: #d8b8ff;
    background: rgba(147, 51, 234, .24);
  }

  .broadcast-system-summary__item--green i {
    color: #5df49c;
    background: rgba(22, 163, 74, .23);
  }

  .broadcast-system-summary__item--violet i {
    color: #d7adff;
    background: rgba(126, 34, 206, .25);
  }

  .broadcast-system-summary__item--blue i {
    color: #93c5fd;
    background: rgba(37, 99, 235, .24);
  }

  .broadcasts-status--player-online {
    color: #67f3a3;
    background: rgba(21, 129, 82, .22);
    animation: player-pulse 2s ease-in-out infinite;
  }

  .broadcasts-status--player-offline {
    color: #b8c0d5;
    background: rgba(148, 163, 184, .13);
  }

  @keyframes player-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    50%       { box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
  }

  .broadcasts-player-time {
    margin-top: 4px;
    font-size: 11px;
    color: #94a3b8;
  }

  .broadcast-card-modern__badges {
    position: relative;
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    align-self: flex-start;
    padding-right: 0;
    min-width: 112px;
  }

  .broadcast-card-modern__badges::after {
    content: none;
  }

