                <% end %>
                <label class="broadcast-playlist-icon-btn broadcast-publish-upload-control" title="<%= I18n.t("UploadMedia") %>" aria-label="<%= I18n.t("UploadMedia") %>" data-action-label="<%= I18n.t("UploadMedia") %>">
                  <span class="material-symbols-rounded" aria-hidden="true">upload</span>
