<div class="broadcast-power-schedule-modal" data-power-schedule-modal hidden>
  <div class="broadcast-power-schedule-modal__backdrop" data-power-schedule-close></div>
  <form class="broadcast-power-schedule-modal__dialog" method="post" data-power-schedule-form role="dialog" aria-modal="true" aria-labelledby="broadcast-power-schedule-title">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div class="broadcast-power-schedule-modal__header">
      <div>
        <strong id="broadcast-power-schedule-title" data-power-schedule-title><%= I18n.t("PowerSchedule", default: "Agendamento de energia da TV") %></strong>
        <p data-power-schedule-subtitle><%= I18n.t("SetPowerSchedule", default: "Defina os horarios e dias de energia.") %></p>
      </div>
      <button type="button" class="broadcast-material-icon-button broadcast-power-schedule-modal__close" data-power-schedule-close aria-label="<%= I18n.t("Close") %>" title="<%= I18n.t("Close") %>">
        <span class="material-symbols-rounded" aria-hidden="true">close</span>
      </button>
    </div>

    <div class="broadcast-power-schedule-modal__body">
      <div class="broadcast-power-schedule-modal__times">
        <label class="broadcast-power-schedule-modal__field">
          <span><%= I18n.t("PowerOnTime", default: "Horario de ligar") %></span>
          <input type="time" name="broadcast[tv_power_on_time]" step="60" data-power-schedule-on-input>
        </label>
        <label class="broadcast-power-schedule-modal__field">
          <span><%= I18n.t("PowerOffTime", default: "Horario de desligar") %></span>
          <input type="time" name="broadcast[tv_power_off_time]" step="60" data-power-schedule-off-input>
        </label>
      </div>

      <fieldset class="broadcast-power-schedule-modal__days">
        <legend><%= I18n.t("PowerDisabledDays", default: "Dias em que a TV deve permanecer desligada") %></legend>
        <input type="hidden" name="broadcast[tv_disabled_weekdays][]" value="">
        <% [["0", "Dom"], ["1", "Seg"], ["2", "Ter"], ["3", "Qua"], ["4", "Qui"], ["5", "Sex"], ["6", "Sab"]].each do |value, label| %>
          <label class="broadcast-power-schedule-modal__day">
            <%= check_box_tag "broadcast[tv_disabled_weekdays][]", value, false, data: { power_schedule_day: value } %>
            <span><%= label %></span>
          </label>
        <% end %>
      </fieldset>

      <section class="broadcast-power-schedule-modal__current" data-power-schedule-current hidden>
        <div class="broadcast-power-schedule-modal__current-heading">
          <span class="material-symbols-rounded" aria-hidden="true">event_note</span>
          <div>
            <strong>Agendamentos atuais</strong>
            <small>Configuração de energia registrada em cada TV</small>
          </div>
        </div>

        <% scheduled_broadcasts = @broadcasts.select(&:tv_power_schedule_configured?) %>
        <% if scheduled_broadcasts.any? %>
          <div class="broadcast-power-schedule-modal__current-list">
            <% scheduled_broadcasts.each do |broadcast| %>
              <% disabled_days = broadcast.send(:normalized_tv_disabled_weekdays) %>
              <% weekday_labels = { "0" => "Dom", "1" => "Seg", "2" => "Ter", "3" => "Qua", "4" => "Qui", "5" => "Sex", "6" => "Sáb" } %>
              <article class="broadcast-power-schedule-modal__current-item">
                <div class="broadcast-power-schedule-modal__current-name">
                  <span class="material-symbols-rounded" aria-hidden="true">tv</span>
                  <strong><%= broadcast.name %></strong>
                </div>
                <div class="broadcast-power-schedule-modal__current-values">
                  <span><span class="material-symbols-rounded" aria-hidden="true">power_settings_new</span> Liga <strong><%= broadcast.tv_power_on_time_input_value.presence || "--:--" %></strong></span>
                  <span><span class="material-symbols-rounded" aria-hidden="true">mode_off_on</span> Desliga <strong><%= broadcast.tv_power_off_time_input_value.presence || "--:--" %></strong></span>
                  <span><span class="material-symbols-rounded" aria-hidden="true">event_busy</span> Desligada: <strong><%= disabled_days.any? ? disabled_days.map { |day| weekday_labels[day] }.compact.join(", ") : "Nenhum dia" %></strong></span>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="broadcast-power-schedule-modal__current-empty">
            <span class="material-symbols-rounded" aria-hidden="true">event_available</span>
            <span>Nenhuma TV possui agendamento configurado.</span>
          </div>
        <% end %>
      </section>
    </div>

    <div class="broadcast-power-schedule-modal__footer">
      <button type="button" class="broadcast-material-footer-button" data-power-schedule-close>
        <span class="material-symbols-rounded" aria-hidden="true">close</span>
        <span><%= I18n.t("Cancel") %></span>
      </button>
      <button type="submit" class="broadcast-material-footer-button broadcast-material-footer-button--primary">
        <span class="material-symbols-rounded" aria-hidden="true">save</span>
        <span><%= I18n.t("Save", default: "Salvar") %></span>
      </button>
    </div>
  </form>
</div>

