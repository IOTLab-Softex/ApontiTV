  .broadcast-publish-form {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .broadcast-publish-modal__header,
  .broadcast-publish-modal__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(172, 188, 230, .12);
  }

  .broadcast-publish-requirements {
    margin-right: auto;
