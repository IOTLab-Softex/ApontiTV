                    <% [["fade", "Fade", "fade.png"], ["slide", "Slide", "slide.png"], ["blur", "Blur", "blur.png"], ["zoom", "Zoom", "zoom.png"], ["wipe", "Wipe vertical", "wipe_vertical.png"], ["push", "Push lateral", "push_lateral.png"], ["flip", "Flip", "flip.png"], ["cross_zoom", "Cross zoom", "cross_zoom.png"], ["aponti_smooth", "Aponti Smooth", "aponti_smooth.png"], ["none", "Sem efeito", "sem_efeito.png"]].each do |value, label, icon| %>
