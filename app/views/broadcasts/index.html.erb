  .broadcast-publish-modal__header strong {
    display: block;
    font-size: 18px;
    color: #ffffff;
  }

  .broadcast-publish-modal__header p {
    margin: 6px 0 0;
    color: #a8b4ce;
    font-size: 13px;
  }

  .broadcast-publish-modal__body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, .9fr);
    gap: 18px;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    padding: 20px 22px;
  }

  .broadcast-publish-section {
    min-width: 0;
    padding: 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, .035);
    border: 1px solid rgba(172, 188, 230, .1);
