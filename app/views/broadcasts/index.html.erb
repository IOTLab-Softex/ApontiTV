                  <span>
                    <strong><%= blob.filename.to_s %></strong>
                    <small><%= blob.content_type.to_s.start_with?("image/") ? I18n.t("Image") : I18n.t("Video") %> - <%= number_to_human_size(blob.byte_size) %> - <%= blob.created_at.strftime("%d/%m/%Y %H:%M") %></small>
