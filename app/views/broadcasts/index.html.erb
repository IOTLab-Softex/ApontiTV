                <i class="fas <%= broadcast.effective_production_status == 'running' ? 'fa-broadcast-tower' : 'fa-pause' %>" aria-hidden="true"></i>
                <span class="broadcast-status-icon__label" data-status-label><%= broadcast.effective_production_status == "running" ? I18n.t("InProduction") : I18n.t("Stopped") %></span>
