  .broadcasts-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: stretch;
    justify-content: center;
    max-width: 360px;
    margin: 0 auto;
  }

  .broadcasts-actions form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    height: 36px;
    margin: 0;
  }

  .broadcasts-action {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 36px;
    padding: 0 11px;
    border-radius: 8px;
    border: 1px solid transparent;
    text-decoration: none;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    line-height: 1;
    box-sizing: border-box;
    white-space: nowrap;
