  }

  .broadcast-dashboard-stat,
  .broadcast-dashboard-panel,
  .broadcast-dashboard__footer article {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, .14);
    border-radius: 8px;
    background:
      radial-gradient(circle at 12% 0%, rgba(139, 92, 246, .14), transparent 34%),
      linear-gradient(180deg, rgba(17, 24, 39, .96), rgba(8, 13, 30, .96));
    box-shadow: 0 20px 44px rgba(2, 6, 23, .28), inset 0 1px 0 rgba(255, 255, 255, .04);
  }

  .broadcast-dashboard-stat {
