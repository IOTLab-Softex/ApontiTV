            <div class="broadcast-publish-library" data-playlist-library>
              <% @video_library_blobs.each do |blob| %>
                <% thumbnail_url = media_library_thumbnail_path(blob, v: blob.checksum.presence || blob.created_at.to_i) %>
                <label class="broadcast-publish-video" data-library-blob-id="<%= blob.id %>">
                  <%= check_box_tag "playlist_media_blob_ids[]", blob.id, false, data: { playlist_media_choice: true } %>
                  <span class="broadcast-playlist-thumb-preview" data-playlist-hover-preview>
                    <%= image_tag "data:image/gif;base64,R0lGODlhAQABAAAAACw=", alt: blob.filename.to_s, loading: "lazy", decoding: "async", data: { lazy_preview: true, preview_src: thumbnail_url } %>
