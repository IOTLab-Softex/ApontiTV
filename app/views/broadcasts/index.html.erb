  [data-publish-modal] .broadcast-publish-tvs {
    align-content: start;
    grid-auto-rows: max-content;
  }

  [data-publish-modal] .broadcast-publish-tv {
    height: auto;
    min-height: 58px;
    align-self: start;
  }

  @media (max-width: 900px) {
    [data-publish-modal] .broadcast-publish-modal__body { grid-template-rows: auto; }
    [data-publish-modal] .broadcast-publish-section { height: auto; min-height: 320px; }
    [data-publish-modal] .broadcast-playlist-list,
    [data-publish-modal] .broadcast-publish-tvs { height: auto; max-height: 390px; }
