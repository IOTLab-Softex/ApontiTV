            </span>
            <span class="broadcast-action-slot" data-production-stop-action-id="<%= broadcast.id %>" <%= "hidden" unless production_running %>>
              <%= button_to safe_join([tag.i("", class: "fas fa-stop", aria: { hidden: true }), content_tag(:span, I18n.t("Stop"), class: "broadcast-action__label")]), stop_broadcast_path(broadcast), method: :post, class: "broadcasts-action broadcasts-action--stop", title: I18n.t("Stop"), aria: { label: I18n.t("Stop") } %>
            </span>
            <% if current_user.admin? %>
              <button type="button"
                      class="broadcasts-action broadcasts-action--schedule"
