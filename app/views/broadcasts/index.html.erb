  .broadcast-card-modern__wallpaper-progress {
    --wallpaper-progress: 0%;
    --wallpaper-apply-left: 75%;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, .16);
    background: #070b18;
    box-shadow: inset 0 0 26px rgba(0, 0, 0, .24);
