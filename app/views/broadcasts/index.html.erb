                      aria-label="<%= I18n.t("PowerSchedule", default: "Agendamento de energia") %>"
                      data-power-schedule-open
                      data-power-schedule-scope="single"
                      data-power-schedule-action="<%= update_power_schedule_broadcast_path(broadcast, locale: I18n.locale) %>"
                      data-power-schedule-name="<%= broadcast.name %>"
                      data-power-schedule-on="<%= broadcast.tv_power_on_time_input_value %>"
                      data-power-schedule-off="<%= broadcast.tv_power_off_time_input_value %>"
