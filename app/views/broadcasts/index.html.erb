                  <option value="video_end"><%= I18n.t("WaitVideoEnd") %></option>
                </select>
              </label>
              <label class="broadcast-playlist-field" data-playlist-timing-settings data-playlist-settings-help-tip="Escolha o efeito visual usado na passagem entre dois itens.">
                <span><%= I18n.t("TransitionEffect") %></span>
                <div class="broadcast-transition-picker" data-transition-picker>
                  <select name="transition_style" data-playlist-transition-style tabindex="-1" aria-hidden="true">
                    <option value="fade">Fade</option><option value="slide">Slide</option><option value="blur">Blur</option>
                    <option value="zoom">Zoom</option><option value="wipe">Wipe vertical</option><option value="push">Push lateral</option>
                    <option value="flip">Flip</option><option value="cross_zoom">Cross zoom</option>
                    <option value="aponti_smooth">Aponti Smooth</option><option value="none">Sem efeito</option>
                  </select>
                  <button type="button" class="broadcast-transition-picker__trigger" data-transition-trigger aria-haspopup="listbox" aria-expanded="false">
                    <img src="<%= asset_path('effect_icons/fade.png') %>" alt="" data-transition-current-icon>
                    <span data-transition-current-label>Fade</span>
                    <span class="material-symbols-rounded" aria-hidden="true">expand_more</span>
                  </button>
                  <div class="broadcast-transition-picker__menu" data-transition-menu role="listbox" hidden>
                    <% [["fade", "Fade", "fade.png"], ["slide", "Slide", "slide.png"], ["blur", "Blur", "blur.png"], ["zoom", "Zoom", "zoom.png"], ["wipe", "Wipe vertical", "wipe_vertical.png"], ["push", "Push lateral", "push_lateral.png"], ["flip", "Flip", "flip.png"], ["cross_zoom", "Cross zoom", "cross_zoom.png"], ["aponti_smooth", "Aponti Smooth", "aponti_smooth.png"], ["none", "Sem efeito", "sem_efeito.png"]].each do |value, label, icon| %>
                      <button type="button" class="broadcast-transition-picker__option" data-transition-option="<%= value %>" data-transition-icon="<%= asset_path("effect_icons/#{icon}") %>" role="option">
                        <img src="<%= asset_path("effect_icons/#{icon}") %>" alt=""><span><%= label %></span><span class="material-symbols-rounded" aria-hidden="true">check</span>
                      </button>
                    <% end %>
                  </div>
                </div>
              </label>
              <label class="broadcast-playlist-field" data-playlist-timing-settings data-playlist-settings-help-tip="Controle em milissegundos a velocidade do efeito de transição.">
