                <span><%= I18n.t("SelectedItems") %></span>
                <small data-playlist-selected-count>0</small>
              </button>
            </div>
            <div class="broadcast-publish-library broadcast-publish-library--selected" data-playlist-library-panel="selected" data-playlist-selected-library hidden>
