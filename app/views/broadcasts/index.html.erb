/* dropdown */
.broadcasts-dropdown {
  position: relative;
  z-index: 10000;
}

.broadcasts-dropdown:hover {
  z-index: 99999;
}

.broadcasts-dropdown__menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: var(--table-surface-strong, #fff);
  border-radius: 12px;
  box-shadow: 0 14px 35px rgba(15, 23, 42, 0.18);
  padding: 6px;
  display: none;
  flex-direction: column;
  min-width: 170px;
  z-index: 999999;
