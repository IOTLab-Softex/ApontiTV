        bubbles.forEach((item,index)=>{
          const r=item.target.getBoundingClientRect(),b=item.bubble,center=r.top+r.height/2;
          b.classList.remove('is-side-left','is-side-right','is-top','is-bottom');
          if(item.footerIndex===1){
            const left=Math.min(innerWidth-b.offsetWidth-8,r.right+14),top=Math.max(8,Math.min(center-b.offsetHeight/2,innerHeight-b.offsetHeight-8));
            b.classList.add('is-side-right');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--playlist-help-arrow-y',`${Math.max(12,Math.min(center-top-6,b.offsetHeight-18))}px`);return;
          }
          if(item.settingIndex!==null||item.footerIndex!==null){
            const alternatingIndex=item.settingIndex!==null?item.settingIndex:item.footerIndex,above=alternatingIndex%2===0,left=Math.max(8,Math.min(r.left+r.width/2-b.offsetWidth/2,innerWidth-b.offsetWidth-8)),rawTop=above?r.top-b.offsetHeight-12:r.bottom+12,top=Math.max(8,Math.min(rawTop,innerHeight-b.offsetHeight-8));
            b.classList.add(above?'is-top':'is-bottom');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--publish-arrow-x',`${Math.max(14,Math.min(r.left+r.width/2-left,b.offsetWidth-14))}px`);return;
          }
          const targetOnLeft=r.left+r.width/2<dialogRect.left+dialogRect.width/2,placeLeft=index===1?true:index===2?false:targetOnLeft,left=placeLeft?Math.max(8,r.left-b.offsetWidth-14):Math.min(innerWidth-b.offsetWidth-8,r.right+14),top=Math.max(8,Math.min(center-b.offsetHeight/2,innerHeight-b.offsetHeight-8));
          b.classList.add(placeLeft?'is-side-left':'is-side-right');b.style.left=`${left}px`;b.style.top=`${top}px`;b.style.setProperty('--playlist-help-arrow-y',`${Math.max(12,Math.min(center-top-6,b.offsetHeight-18))}px`);
