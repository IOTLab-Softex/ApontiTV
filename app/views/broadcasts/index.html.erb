              <% end %>
            </div>
            <p class="broadcast-playlist-editor__count">Mostrando <%= @video_library_blobs.size %> item<%= @video_library_blobs.size == 1 ? "" : "s" %></p>
          </section>

          <section class="broadcast-publish-section broadcast-playlist-editor__order-section">
