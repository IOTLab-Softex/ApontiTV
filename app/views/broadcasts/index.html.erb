          <button type="submit" class="broadcast-material-footer-button broadcast-material-footer-button--primary" data-playlist-editor-help-tip="Salva o nome, as configurações, as mídias selecionadas e a ordem da playlist.">
            <span class="material-symbols-rounded" aria-hidden="true">save</span>
            <span><%= I18n.t("SavePlaylist") %></span>
          </button>
        </div>
      </form>
      <div class="broadcast-media-upload-loading" data-playlist-upload-loading hidden role="status" aria-live="polite" aria-busy="true">
        <div class="broadcast-media-upload-loading__panel">
          <span class="broadcast-media-upload-loading__spinner" aria-hidden="true"></span>
