  .broadcast-material-button:hover,
  .broadcast-material-button:focus-visible {
    color: #111;
    background: #fff;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .3), inset 0 1px rgba(255, 255, 255, .65);
    transform: translateY(-1px);
    outline: 0;
  }

  .broadcast-material-icon-button {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    padding: 0;
    display: inline-grid;
    place-items: center;
    border: 0;
    border-radius: 10px;
    color: #e5e7eb;
    background: rgba(255, 255, 255, .09);
    box-shadow: inset 0 1px rgba(255, 255, 255, .08);
