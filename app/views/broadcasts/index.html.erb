  .broadcasts-panel--table .broadcasts-status--online { color:#9bec8e;background:rgba(101,163,13,.15);border-color:rgba(132,204,22,.32); }
  .broadcasts-panel--table .broadcasts-table__stream strong { color:#f8f9ff;font-size:12px; }
