  .broadcasts-panel--table .broadcasts-action.icon:hover { color:#fff;background:rgba(124,58,237,.28);border-color:rgba(168,85,247,.65);box-shadow:0 0 18px rgba(168,85,247,.2); }
  .broadcasts-table-footer { display:flex;align-items:center;justify-content:space-between;min-height:58px;padding:5px 17px;color:#8793aa;font-size:10px; }
  .broadcasts-table-pagination { display:flex;gap:9px; }
  .broadcasts-table-pagination button { width:32px;height:32px;display:grid;place-items:center;padding:0;border:1px solid rgba(122,139,177,.18);border-radius:8px;background:rgba(25,37,65,.64);color:#cbd5e1;font-size:11px; }
  .broadcasts-table-pagination button.is-current { border-color:#8b5cf6;background:linear-gradient(145deg,#7c3aed,#a855f7);color:#fff;box-shadow:0 7px 18px rgba(124,58,237,.35); }
