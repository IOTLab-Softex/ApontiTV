<% content_for :page_title, I18n.t("Users") %>
<% content_for :page_subtitle, "Administre contas, permiss&otilde;es e hist&oacute;rico de acesso.".html_safe %>

<div class="users-page">
  <section class="users-toolbar" aria-label="Ações de usuários">
    <div class="users-toolbar__actions">
      <%= link_to new_user_path, class: "users-action users-action--primary" do %>
        <span class="material-symbols-rounded" aria-hidden="true">person_add</span>
        <span>Adicionar usu&aacute;rio</span>
      <% end %>
    </div>
  </section>

  <section class="users-card">
    <div class="users-table-wrap">
      <table class="users-table">
        <thead>
          <tr>
            <th>E-mail</th>
            <th>Tipo</th>
            <th><%= I18n.t("LastAccess") %></th>
            <th><%= I18n.t("LastLogout") %></th>
            <th>A&ccedil;&otilde;es</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><strong><%= user.email %></strong></td>
              <td>
                <span class="users-pill <%= user.admin? ? "is-admin" : "is-client" %>">
                  <%= user.admin? ? "Admin" : "Cliente" %>
                </span>
              </td>
              <td><%= user.last_accessed_at.present? ? l(user.last_accessed_at, format: :short) : "-" %></td>
              <td><%= user.last_signed_out_at.present? ? l(user.last_signed_out_at, format: :short) : "-" %></td>
              <td>
                <div class="users-actions">
                  <%= link_to edit_user_path(user), class: "users-icon-btn", title: I18n.t("Edit"), aria: { label: I18n.t("Edit") } do %>
                    <span class="material-symbols-rounded" aria-hidden="true">edit</span>
                  <% end %>
                  <% unless user == current_user %>
                    <%= button_to user_path(user), method: :delete, data: { confirm: "Tem certeza?", turbo_confirm: "Tem certeza?" }, class: "users-icon-btn users-icon-btn--danger", title: I18n.t("Delete"), aria: { label: I18n.t("Delete") } do %>
                      <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
  .users-page {
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 28px 18px 54px;
    color: #f8fbff;
  }

  .users-page i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .users-card {
    border: 1px solid rgba(169, 184, 220, .14);
    border-radius: 12px;
    background: linear-gradient(180deg, #151b31 0%, #101729 100%);
    box-shadow: 0 28px 80px rgba(2, 6, 23, .3);
    overflow: hidden;
  }

  .users-toolbar {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .users-toolbar__actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    border: 0;
    border-radius: 14px;
    background: var(--app-banner-border);
    box-shadow: none;
  }

  .users-kicker {
    margin: 0 0 6px;
    color: #b88cff;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .users-card h1 {
    margin: 0;
    color: #ffffff;
    font-size: 26px;
  }

  .users-action,
  .users-icon-btn {
    border: 1px solid rgba(148, 163, 184, .18);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
  }

  .users-action {
    width: 44px;
    min-width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
  }

  .users-action > span:last-child {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .users-action .material-symbols-rounded { font-size: 21px; }

  .users-action--primary {
    border: 0;
    color: #171717;
    background: #f1f1f1;
    box-shadow: none;
    transition: background .18s ease, transform .18s ease;
  }

  .users-action--primary:hover,
  .users-action--primary:focus-visible {
    color: #171717;
    background: #ffffff;
    transform: translateY(-1px);
  }

  .users-table-wrap {
    overflow: auto;
  }

  .users-table {
    width: 100%;
    border-collapse: collapse;
  }

  .users-table thead { background: rgba(255, 255, 255, .035); }

  .users-table tbody tr {
    background: rgba(255, 255, 255, .025);
    transition: background .18s ease;
  }

  .users-table tbody tr:hover { background: rgba(255, 255, 255, .075); }

  .users-table th,
  .users-table td {
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, .07);
    text-align: left;
    white-space: nowrap;
  }

  .users-table th {
    color: #a8b4ce;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .users-table td {
    color: #dce4f8;
  }

  .users-pill {
    min-height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    color: #e5e7eb;
    background: rgba(255, 255, 255, .09);
    font-size: 12px;
    font-weight: 900;
  }

  .users-pill.is-client {
    color: #cbd5e1;
    background: rgba(148, 163, 184, .11);
  }

  .users-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .users-actions form {
    margin: 0;
  }

  .users-icon-btn {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: #dbe3f3;
    background: transparent;
    box-shadow: none;
    transition: color .18s ease, background .18s ease, transform .18s ease;
  }

  .users-icon-btn .material-symbols-rounded { font-size: 20px; }

  .users-icon-btn:hover,
  .users-icon-btn:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, .11);
    outline: none;
    transform: translateY(-1px);
  }

  .users-icon-btn--danger {
    color: #fda4af;
    border: 0;
    background: transparent;
  }

  .users-icon-btn--danger:hover,
  .users-icon-btn--danger:focus-visible { color: #fecdd3; background: rgba(244, 63, 94, .14); }

  html[data-theme="light"] .users-page,
  html[data-theme="light"] .users-table td,
  html[data-theme="light"] .users-card h1 {
    color: #111827;
  }

  html[data-theme="light"] .users-card {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    border-color: rgba(15, 23, 42, .1);
    box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
  }

  html[data-theme="light"] .users-toolbar__actions {
    background: #f5f5f5;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
  }

  html[data-theme="light"] .users-action--primary {
    color: #171717;
    background: #f1f1f1;
  }

  html[data-theme="light"] .users-action--primary:hover,
  html[data-theme="light"] .users-action--primary:focus-visible {
    background: #d8d8d8;
  }

  html[data-theme="light"] .users-table th {
    color: #64748b;
  }

  html[data-theme="light"] .users-icon-btn {
    color: #334155;
    background: transparent;
    border: 0;
  }

  html[data-theme="light"] .users-table thead { background: rgba(15, 23, 42, .035); }
  html[data-theme="light"] .users-table tbody tr { background: rgba(255, 255, 255, .55); }
  html[data-theme="light"] .users-table tbody tr:hover { background: rgba(124, 58, 237, .055); }
  html[data-theme="light"] .users-table th,
  html[data-theme="light"] .users-table td { border-bottom-color: rgba(15, 23, 42, .08); }
  html[data-theme="light"] .users-icon-btn:hover,
  html[data-theme="light"] .users-icon-btn:focus-visible { color:#111827; background:rgba(15,23,42,.07); }
  html[data-theme="light"] .users-icon-btn--danger { color:#e11d48; }
  html[data-theme="light"] .users-icon-btn--danger:hover { background:rgba(225,29,72,.09); }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .users-page,
    :root:not([data-theme="dark"]) .users-table td,
    :root:not([data-theme="dark"]) .users-card h1 {
      color: #111827;
    }

    :root:not([data-theme="dark"]) .users-card {
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      border-color: rgba(15, 23, 42, .1);
      box-shadow: 0 24px 60px rgba(15, 23, 42, .08);
    }

    :root:not([data-theme="dark"]) .users-toolbar__actions {
      background: #f5f5f5;
      box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    }

    :root:not([data-theme="dark"]) .users-action--primary {
      color: #171717;
      background: #f1f1f1;
    }

    :root:not([data-theme="dark"]) .users-table th {
      color: #64748b;
    }

    :root:not([data-theme="dark"]) .users-icon-btn {
      color: #334155;
      background: transparent;
      border: 0;
    }

    :root:not([data-theme="dark"]) .users-table thead { background: rgba(15, 23, 42, .035); }
    :root:not([data-theme="dark"]) .users-table tbody tr { background: rgba(255, 255, 255, .55); }
    :root:not([data-theme="dark"]) .users-table tbody tr:hover { background: rgba(124, 58, 237, .055); }
    :root:not([data-theme="dark"]) .users-table th,
    :root:not([data-theme="dark"]) .users-table td { border-bottom-color: rgba(15, 23, 42, .08); }
    :root:not([data-theme="dark"]) .users-icon-btn:hover { color:#111827; background:rgba(15,23,42,.07); }
    :root:not([data-theme="dark"]) .users-icon-btn--danger { color:#e11d48; }
  }

</style>
