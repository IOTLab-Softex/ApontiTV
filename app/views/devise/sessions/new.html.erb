<% content_for :page_title, "Login" %>
<% google_oauth_ready = StreamingConfiguration.google_oauth_ready? %>

<div class="login-container">
  <div class="logo-mobile">
    <%= image_tag "APONTI_MARCA.png", alt: "Aponti TV", class: "logo-mobile__image" %>
  </div>

  <div class="login-box">
    <div class="login-header">
      <%= image_tag "APONTI_MARCA.png", alt: "Aponti TV", class: "login-logo" %>
      <h2 class="login-h2">Login</h2>
      <p class="login-subtitle">Entre com sua conta do Andar360 autorizada para o Aponti TV.</p>
    </div>

    <% if flash.alert %>
      <div class="login-alert">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
        <span><%= flash.alert %></span>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form", data: { turbo: false, remote_login: true } }) do |f| %>
      <div class="login-field">
        <%= f.label :email do %>
          <i class="far fa-envelope" aria-hidden="true"></i>
          <span>CPF ou e-mail</span>
        <% end %>
        <%= f.text_field :email, autofocus: true, autocomplete: "username", class: "login-input", placeholder: "CPF ou e-mail do Andar360" %>
      </div>

      <div class="login-field">
        <%= f.label :password do %>
          <i class="fas fa-key" aria-hidden="true"></i>
          <span>Senha</span>
        <% end %>
        <div class="login-password-wrap">
          <%= f.password_field :password, autocomplete: "current-password", class: "login-input", id: "login-password-input", placeholder: "********" %>
          <button type="button" id="toggle-login-password" class="login-password-toggle" aria-label="Mostrar senha" aria-pressed="false">
            <i class="far fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="login-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me do %>
            <i class="fas fa-star" aria-hidden="true"></i>
            <span>Lembrar-me</span>
          <% end %>
        </div>
      <% end %>

      <div class="login-actions">
        <%= button_tag type: "submit", class: "login-button" do %>
          <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
          <span>Entrar</span>
        <% end %>
      </div>
    <% end %>

    <p style="text-align: center; margin-top: 16px;">
      <%= link_to "Esqueci minha senha", new_user_password_path, style: "color: #e9d5ff; text-decoration: underline;", data: { turbo: false } %>
    </p>

    <% if google_oauth_ready %>
      <div class="login-divider"><span>OU</span></div>
      <%= button_to user_google_oauth2_omniauth_authorize_path,
                    method: :post,
                    form: { data: { turbo: false }, class: "login-google-form" },
                    class: "login-google" do %>
        <span class="login-google__mark" aria-hidden="true">G</span>
        <span>Entrar com Google</span>
      <% end %>
    <% end %>

    <p class="login-admin-note">Nao tem uma conta? <span>Fale com o administrador</span></p>
  </div>
  <footer class="login-footer" data-auth-error="<%= flash.alert.present? ? 'true' : 'false' %>">
    <span>&copy; <%= Time.current.year %> Aponti TV. Todos os direitos reservados.</span>
  </footer>
</div>

<script>
  function initializeLoginScreen() {
    var input = document.getElementById("login-password-input");
    var toggle = document.getElementById("toggle-login-password");
    var box = document.querySelector(".login-box");

    if (box && box.dataset.enterBound !== "true") {
      box.dataset.enterBound = "true";
      box.addEventListener("animationend", function(event) {
        if (event.animationName === "loginBoxEnter3d") {
          box.classList.add("login-box--entered");
        }
      });
      setTimeout(function() {
        box.classList.add("login-box--entered");
      }, 2200);
    }

    if (input && toggle && toggle.dataset.bound !== "true") {
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", function() {
        var showing = input.type === "text";
        input.type = showing ? "password" : "text";
        toggle.setAttribute("aria-pressed", String(!showing));
        toggle.setAttribute("aria-label", showing ? "Mostrar senha" : "Ocultar senha");
        toggle.innerHTML = showing
          ? '<i class="far fa-eye" aria-hidden="true"></i>'
          : '<i class="far fa-eye-slash" aria-hidden="true"></i>';
      });
    }

    var footer = document.querySelector(".login-footer[data-auth-error='true']");
    if (footer && footer.dataset.errorAnimationBound !== "true") {
      footer.dataset.errorAnimationBound = "true";
      setTimeout(function() {
        footer.classList.add("login-footer--auth-error");
        footer.addEventListener("animationend", function() {
          footer.classList.remove("login-footer--auth-error");
      }, { once: true });
      }, 420);
    }

    var form = document.querySelector(".login-form[data-remote-login='true']");
    if (!form || form.dataset.remoteBound === "true") return;

    form.dataset.remoteBound = "true";
    form.addEventListener("submit", function(event) {
      event.preventDefault();

      var button = form.querySelector(".login-button");
      var originalButtonHtml = button ? button.innerHTML : "";
      var token = document.querySelector("meta[name='csrf-token']");

      if (button) {
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i><span>Entrando...</span>';
      }

      var loginUrl = new URL(form.action, window.location.origin);
      if (!loginUrl.pathname.match(/\.json$/)) {
        loginUrl.pathname = loginUrl.pathname.replace(/\/?$/, ".json");
      }

      fetch(loginUrl.toString(), {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-CSRF-Token": token ? token.content : "",
          "X-Requested-With": "XMLHttpRequest"
        },
        body: new FormData(form),
        credentials: "same-origin"
      })
        .then(function(response) {
          return response.json().then(function(data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function(result) {
          if (result.ok && result.data.redirect_url) {
            window.location.href = result.data.redirect_url;
            return;
          }

          showLoginError(result.data.error || "E-mail ou senha invalidos.");
        })
        .catch(function() {
          showLoginError("Nao foi possivel entrar agora. Tente novamente.");
        })
        .finally(function() {
          if (button) {
            button.disabled = false;
            button.innerHTML = originalButtonHtml;
          }
        });
    });
  }

  function showLoginError(message) {
    var box = document.querySelector(".login-box");
    var footer = document.querySelector(".login-footer");
    if (!box) return;

    var alert = box.querySelector(".login-alert");
    if (!alert) {
      alert = document.createElement("div");
      alert.className = "login-alert";
      alert.innerHTML = '<i class="fas fa-circle-exclamation" aria-hidden="true"></i><span></span>';
      var header = box.querySelector(".login-header");
      header.insertAdjacentElement("afterend", alert);
    }

    alert.querySelector("span").textContent = message;
    alert.classList.remove("login-alert--shake");
    void alert.offsetWidth;
    alert.classList.add("login-alert--shake");

    box.classList.remove("login-box--auth-error");
    void box.offsetWidth;
    box.classList.add("login-box--auth-error");
    box.addEventListener("animationend", function(event) {
      if (event.animationName === "loginBoxAuthError") {
        box.classList.remove("login-box--auth-error");
      }
    }, { once: true });

    if (footer) {
      footer.classList.remove("login-footer--auth-error");
      void footer.offsetWidth;
      footer.classList.add("login-footer--auth-error");
      footer.addEventListener("animationend", function() {
        footer.classList.remove("login-footer--auth-error");
      }, { once: true });
    }
  }

  document.addEventListener("DOMContentLoaded", initializeLoginScreen);
  document.addEventListener("turbo:load", initializeLoginScreen);
</script>

<%= render "devise/shared/login_styles" %>
