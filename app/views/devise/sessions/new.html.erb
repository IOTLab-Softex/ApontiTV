<% content_for :page_title, "Login" %>
<% google_oauth_ready = StreamingConfiguration.google_oauth_ready? %>

<div class="login-container">
  <div class="logo-mobile">
    <%= image_tag "APONTI_MARCA.png", alt: "Aponti TV", class: "logo-mobile__image" %>
  </div>

  <div class="login-visual" aria-hidden="true">
    <%= image_tag "aponti_login_illustration.png", alt: "", class: "login-visual__image" %>
  </div>

  <div class="login-box login-box--m3">
    <div class="login-header">
      <%= image_tag "APONTI_MARCA.png", alt: "Aponti TV", class: "login-logo" %>
      <h2 class="login-h2">Login</h2>
      <p class="login-subtitle">Entre com sua conta do Andar360 autorizada para o Aponti TV.</p>
    </div>

    <% if flash.alert %>
      <div class="login-alert">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
        <span><%= flash.alert %></span>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form", data: { turbo: false } }) do |f| %>
      <div class="login-field">
        <%= f.label :email do %>
          <i class="far fa-envelope" aria-hidden="true"></i>
          <span>CPF ou e-mail</span>
        <% end %>
        <%= f.text_field :email, autofocus: true, autocomplete: "username", class: "login-input", placeholder: "CPF ou e-mail do Andar360" %>
      </div>

      <div class="login-field">
        <%= f.label :password do %>
          <i class="fas fa-key" aria-hidden="true"></i>
          <span>Senha</span>
        <% end %>
        <div class="login-password-wrap">
          <%= f.password_field :password, autocomplete: "current-password", class: "login-input", id: "login-password-input", placeholder: "********" %>
          <button type="button" id="toggle-login-password" class="login-password-toggle" aria-label="Mostrar senha" aria-pressed="false">
            <i class="far fa-eye" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="login-remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me do %>
            <i class="fas fa-star" aria-hidden="true"></i>
            <span>Lembrar-me</span>
          <% end %>
        </div>
      <% end %>

      <div class="login-actions">
        <%= button_tag type: "submit", class: "login-button" do %>
          <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
          <span>Entrar</span>
        <% end %>
      </div>
    <% end %>

    <p style="text-align: center; margin-top: 16px;">
      <%= link_to "Esqueci minha senha", new_user_password_path, style: "color: #e9d5ff; text-decoration: underline;", data: { turbo: false } %>
    </p>

    <% if google_oauth_ready %>
      <div class="login-divider"><span>OU</span></div>
      <%= button_to user_google_oauth2_omniauth_authorize_path,
                    method: :post,
                    form: { data: { turbo: false }, class: "login-google-form" },
                    class: "login-google" do %>
        <span class="login-google__mark" aria-hidden="true">G</span>
        <span>Entrar com Google</span>
      <% end %>
    <% end %>

    <p class="login-admin-note">Nao tem uma conta? <span>Fale com o administrador</span></p>
  </div>
  <footer class="login-footer" data-auth-error="<%= flash.alert.present? ? 'true' : 'false' %>">
    <span>&copy; <%= Time.current.year %> Aponti TV. Todos os direitos reservados.</span>
  </footer>
</div>

<script>
  function initializeLoginScreen() {
    var input = document.getElementById("login-password-input");
    var toggle = document.getElementById("toggle-login-password");
    var box = document.querySelector(".login-box");

    if (input && toggle && toggle.dataset.bound !== "true") {
      toggle.dataset.bound = "true";
      toggle.addEventListener("click", function() {
        var showing = input.type === "text";
        input.type = showing ? "password" : "text";
        toggle.setAttribute("aria-pressed", String(!showing));
        toggle.setAttribute("aria-label", showing ? "Mostrar senha" : "Ocultar senha");
        toggle.innerHTML = showing
          ? '<i class="far fa-eye" aria-hidden="true"></i>'
          : '<i class="far fa-eye-slash" aria-hidden="true"></i>';
      });
    }

    var footer = document.querySelector(".login-footer[data-auth-error='true']");
    if (footer && footer.dataset.errorAnimationBound !== "true") {
      footer.dataset.errorAnimationBound = "true";
      setTimeout(function() {
        footer.classList.add("login-footer--auth-error");
        footer.addEventListener("animationend", function() {
          footer.classList.remove("login-footer--auth-error");
      }, { once: true });
      }, 420);
    }

    var form = document.querySelector(".login-form[data-remote-login='true']");
    if (!form || form.dataset.remoteBound === "true") return;

    form.dataset.remoteBound = "true";
    form.addEventListener("submit", function(event) {
      event.preventDefault();

      var button = form.querySelector(".login-button");
      var originalButtonHtml = button ? button.innerHTML : "";
      var token = document.querySelector("meta[name='csrf-token']");

      if (button) {
        button.disabled = true;
        button.innerHTML = '<i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i><span>Entrando...</span>';
      }

      var loginUrl = new URL(form.action, window.location.origin);
      if (!loginUrl.pathname.match(/\.json$/)) {
        loginUrl.pathname = loginUrl.pathname.replace(/\/?$/, ".json");
      }

      fetch(loginUrl.toString(), {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "X-CSRF-Token": token ? token.content : "",
          "X-Requested-With": "XMLHttpRequest"
        },
        body: new FormData(form),
        credentials: "same-origin"
      })
        .then(function(response) {
          return response.json().then(function(data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function(result) {
          if (result.ok && result.data.redirect_url) {
            window.location.href = result.data.redirect_url;
            return;
          }

          showLoginError(result.data.error || "E-mail ou senha invalidos.");
        })
        .catch(function() {
          showLoginError("Nao foi possivel entrar agora. Tente novamente.");
        })
        .finally(function() {
          if (button) {
            button.disabled = false;
            button.innerHTML = originalButtonHtml;
          }
        });
    });
  }

  function showLoginError(message) {
    var box = document.querySelector(".login-box");
    var footer = document.querySelector(".login-footer");
    if (!box) return;

    var alert = box.querySelector(".login-alert");
    if (!alert) {
      alert = document.createElement("div");
      alert.className = "login-alert";
      alert.innerHTML = '<i class="fas fa-circle-exclamation" aria-hidden="true"></i><span></span>';
      var header = box.querySelector(".login-header");
      header.insertAdjacentElement("afterend", alert);
    }

    alert.querySelector("span").textContent = message;
    alert.classList.remove("login-alert--shake");
    void alert.offsetWidth;
    alert.classList.add("login-alert--shake");

    box.classList.remove("login-box--auth-error");
    void box.offsetWidth;
    box.classList.add("login-box--auth-error");
    box.addEventListener("animationend", function(event) {
      if (event.animationName === "loginBoxAuthError") {
        box.classList.remove("login-box--auth-error");
      }
    }, { once: true });

    if (footer) {
      footer.classList.remove("login-footer--auth-error");
      void footer.offsetWidth;
      footer.classList.add("login-footer--auth-error");
      footer.addEventListener("animationend", function() {
        footer.classList.remove("login-footer--auth-error");
      }, { once: true });
    }
  }

  document.addEventListener("DOMContentLoaded", initializeLoginScreen);
  document.addEventListener("turbo:load", initializeLoginScreen);
</script>

<%= render "devise/shared/login_styles" %>

<style>
  /* Material 3 aplicado somente ao card da tela de login. */
  body:has(.login-box--m3),
  html[data-theme="light"] body:has(.login-box--m3),
  html[data-theme="dark"] body:has(.login-box--m3) {
    color-scheme: light;
    background:
      radial-gradient(circle at 22% 44%, rgba(221, 229, 255, .7), transparent 32%),
      radial-gradient(circle at 82% 48%, rgba(243, 237, 247, .92), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f7f9ff 48%, #f7f3f8 100%);
  }

  .login-container:has(.login-box--m3) {
    width: 100%;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(400px, 520px);
    align-items: center;
    justify-content: center;
    gap: clamp(32px, 5vw, 88px);
    padding: clamp(28px, 5vw, 76px);
    overflow: hidden;
    box-sizing: border-box;
  }

  .login-visual {
    width: 100%;
    max-width: 820px;
    min-width: 0;
    justify-self: end;
    display: grid;
    place-items: center;
  }

  .login-visual__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(78svh, 820px);
    object-fit: contain;
    filter: drop-shadow(0 24px 32px rgba(74, 68, 130, .12));
  }

  .login-box--m3,
  .login-box--m3.login-box--entered {
    --login-m3-surface: rgba(255, 251, 254, .97);
    --login-m3-surface-container: #f3edf7;
    --login-m3-surface-high: #ece6f0;
    --login-m3-outline: #79747e;
    --login-m3-outline-variant: #cac4d0;
    --login-m3-primary: #6750a4;
    --login-m3-on-primary: #ffffff;
    --login-m3-text: #1d1b20;
    --login-m3-muted: #625b71;
    color-scheme: light;
    width: min(100%, 448px);
    justify-self: start;
    padding: 32px;
    border: 1px solid var(--login-m3-outline-variant);
    border-radius: 28px;
    color: var(--login-m3-text);
    background: var(--login-m3-surface);
    box-shadow: 0 18px 46px rgba(0, 0, 0, .32);
    backdrop-filter: blur(22px) saturate(125%);
    opacity: 1;
    transform: none;
    animation: none;
    will-change: auto;
  }

  .login-box--m3.login-box--auth-error {
    animation: loginBoxAuthError 980ms cubic-bezier(.22, .9, .28, 1);
  }

  .login-box--m3::before {
    border-radius: inherit;
  }

  .login-box--m3 .login-header {
    margin-bottom: 24px;
  }

  .login-box--m3 .login-logo {
    width: min(100%, 238px);
    height: 68px;
    filter: brightness(0) saturate(100%) invert(35%) sepia(19%) saturate(2017%) hue-rotate(216deg) brightness(89%) contrast(88%);
  }

  .login-box--m3 .login-h2 {
    margin: 12px 0 6px;
    color: var(--login-m3-text);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .login-box--m3 .login-subtitle {
    color: var(--login-m3-muted) !important;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .login-box--m3 .login-form {
    gap: 18px;
  }

  .login-box--m3 .login-field {
    gap: 8px;
  }

  .login-box--m3 .login-field label,
  .login-box--m3 .login-remember label {
    color: var(--login-m3-text);
    font-size: 13px;
    font-weight: 600;
  }

  .login-box--m3 .login-field label i,
  .login-box--m3 .login-remember label i {
    color: var(--login-m3-primary);
  }

  .login-box--m3 .login-input {
    min-height: 56px;
    padding: 0 16px;
    border: 1px solid var(--login-m3-outline);
    border-radius: 12px;
    color: var(--login-m3-text);
    background: transparent;
    font-size: 15px;
    font-weight: 500;
    caret-color: var(--login-m3-primary);
  }

  .login-box--m3 .login-input::placeholder {
    color: #79747e;
  }

  .login-box--m3 .login-input:hover {
    border-color: var(--login-m3-text);
  }

  .login-box--m3 .login-input:focus {
    border-color: var(--login-m3-primary);
    border-width: 2px;
    background: transparent;
    box-shadow: 0 0 0 3px rgba(103, 80, 164, .12);
  }

  .login-box--m3 .login-password-wrap .login-input {
    padding-right: 54px;
  }

  .login-box--m3 .login-password-toggle {
    right: 8px;
    width: 40px;
    height: 40px;
    color: var(--login-m3-muted);
    border-radius: 20px;
  }

  .login-box--m3 .login-password-toggle:hover,
  .login-box--m3 .login-password-toggle:focus-visible {
    color: var(--login-m3-text);
    background: rgba(103, 80, 164, .1);
    outline: none;
  }

  .login-box--m3 .login-remember {
    min-height: 32px;
    margin: 0;
  }

  .login-box--m3 .login-remember input {
    width: 20px;
    height: 20px;
    accent-color: var(--login-m3-primary);
  }

  .login-box--m3 .login-button {
    min-height: 52px;
    border: 0;
    border-radius: 18px;
    color: var(--login-m3-on-primary);
    background: var(--login-m3-primary);
    box-shadow: none;
    font-size: 15px;
    font-weight: 700;
  }

  .login-box--m3 .login-button:hover,
  .login-box--m3 .login-button:focus-visible {
    color: var(--login-m3-on-primary);
    background: #7965af;
    box-shadow: 0 4px 12px rgba(0, 0, 0, .24);
    filter: none;
    transform: none;
    outline: none;
  }

  .login-box--m3 .login-button:active {
    background: #59418f;
  }

  .login-box--m3 .login-button:disabled {
    color: rgba(29, 27, 32, .38);
    background: rgba(29, 27, 32, .12);
    cursor: wait;
  }

  .login-box--m3 > p[style] a {
    color: var(--login-m3-primary) !important;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none !important;
  }

  .login-box--m3 > p[style] a:hover,
  .login-box--m3 > p[style] a:focus-visible {
    text-decoration: underline !important;
  }

  .login-box--m3 .login-divider {
    color: var(--login-m3-muted);
    font-weight: 600;
  }

  .login-box--m3 .login-divider::before,
  .login-box--m3 .login-divider::after {
    background: var(--login-m3-outline-variant);
  }

  .login-box--m3 .login-google {
    min-height: 52px;
    border: 1px solid var(--login-m3-outline);
    border-radius: 18px;
    color: var(--login-m3-primary);
    background: transparent;
    box-shadow: none;
    font-size: 15px;
    font-weight: 700;
  }

  .login-box--m3 .login-google:hover,
  .login-box--m3 .login-google:focus-visible {
    color: var(--login-m3-primary);
    border-color: var(--login-m3-primary);
    background: rgba(103, 80, 164, .08);
    filter: none;
    transform: none;
    outline: none;
  }

  .login-box--m3 .login-admin-note {
    color: var(--login-m3-muted) !important;
    font-weight: 500;
  }

  .login-box--m3 .login-admin-note span {
    color: var(--login-m3-primary);
    font-weight: 700;
  }

  .login-box--m3 .login-alert {
    border: 1px solid #f9dedc;
    border-radius: 14px;
    color: #410e0b;
    background: #f9dedc;
    font-weight: 600;
  }

  .login-container:has(.login-box--m3) .login-footer {
    color: #625b71;
    text-shadow: none;
  }

  @media (max-width: 980px) {
    .login-container:has(.login-box--m3) {
      grid-template-columns: minmax(0, 1fr) minmax(370px, 448px);
      gap: 24px;
      padding: 28px;
    }

    .login-visual__image {
      max-height: 66svh;
    }
  }

  @media (max-width: 700px) {
    body:has(.login-box--m3),
    html[data-theme="light"] body:has(.login-box--m3),
    html[data-theme="dark"] body:has(.login-box--m3) {
      background:
        radial-gradient(circle at 50% 0%, rgba(221, 229, 255, .82), transparent 38%),
        #f7f5fa;
    }

    .login-container:has(.login-box--m3) {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 18px 0 0;
    }

    .login-visual {
      display: none;
    }

    .login-box--m3,
    .login-box--m3.login-box--entered {
      width: 100%;
      padding: 24px 24px 32px;
      border-right: 0;
      border-bottom: 0;
      border-left: 0;
      border-radius: 32px 32px 0 0;
      background: rgba(255, 251, 254, .98);
      backdrop-filter: blur(18px);
    }

    .login-box--m3 .login-h2 {
      font-size: 24px;
    }

    .login-box--m3 .login-input {
      min-height: 52px;
    }
  }
</style>
