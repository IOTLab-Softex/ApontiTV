<div class="system-config-page">
  <div class="system-config-shell">
    <%= form_with(model: streaming_configuration, local: true, class: "system-config-form") do |form| %>
      <% if streaming_configuration.errors.any? %>
        <div class="system-config-errors">
          <strong><%= pluralize(streaming_configuration.errors.count, "erro") %> impediram salvar esta configuracao:</strong>
          <ul>
            <% streaming_configuration.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section class="system-config-section">
        <div class="system-config-section__title">
          <i class="fas fa-server" aria-hidden="true"></i>
          <div>
            <h2>Servidor de streaming</h2>
            <p>Configuracao usada pelo app e pelos servicos locais.</p>
          </div>
        </div>

        <div class="system-config-grid">
          <label class="system-config-field">
            <span>IP do servidor</span>
            <span class="system-config-input">
              <i class="fas fa-network-wired" aria-hidden="true"></i>
              <%= form.text_field :server_ip, value: streaming_configuration.server_ip || "192.168.1.253", placeholder: "192.168.1.253", required: true %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Porta</span>
            <span class="system-config-input">
              <i class="fas fa-ethernet" aria-hidden="true"></i>
              <%= form.number_field :port, value: streaming_configuration.port || 8080, placeholder: "8080", required: true %>
            </span>
          </label>

          <label class="system-config-field system-config-field--wide">
            <span>Nome do servidor</span>
            <span class="system-config-input">
              <i class="fas fa-tag" aria-hidden="true"></i>
              <%= form.text_field :server_name, value: streaming_configuration.server_name || "SoftexTv", placeholder: "Aponti TV", required: true %>
            </span>
          </label>
        </div>
      </section>

      <section class="system-config-section">
        <div class="system-config-section__title">
          <i class="fas fa-puzzle-piece" aria-hidden="true"></i>
          <div>
            <h2>Recursos</h2>
            <p>Ative widgets e defina onde eles aparecem.</p>
          </div>
        </div>

        <label class="system-config-toggle">
          <%= form.check_box :widgets, id: "streaming-checkbox", data: { id: streaming_configuration.id } %>
          <span class="system-config-toggle__track" aria-hidden="true"></span>
          <span>
            <strong>Ativar widgets</strong>
            <small>Inicia ou para o overlay de widgets do servidor.</small>
          </span>
        </label>

        <div class="system-config-widget-targets">
          <label class="system-config-toggle">
            <%= form.check_box :widgets_ffmpeg_enabled %>
            <span class="system-config-toggle__track" aria-hidden="true"></span>
            <span>
              <strong>Usar widgets no FFmpeg</strong>
              <small>Aplica o overlay nos fluxos HLS gerados pelo servidor.</small>
            </span>
          </label>

          <label class="system-config-toggle">
            <%= form.check_box :widgets_official_app_enabled %>
            <span class="system-config-toggle__track" aria-hidden="true"></span>
            <span>
              <strong>Usar widgets no app oficial</strong>
              <small>Mostra a barra no rodape por cima da reproducao no app Android.</small>
            </span>
          </label>
        </div>

      </section>

      <section class="system-config-section system-config-widget-bar">
        <div class="system-config-section__title">
          <i class="fas fa-window-maximize" aria-hidden="true"></i>
          <div>
            <h2>Barra de widgets do app oficial</h2>
            <p>Personalize a barra com clima no lado esquerdo e hora no lado direito.</p>
          </div>
        </div>

        <div class="system-config-widget-preview-grid">
          <label class="system-config-widget-preview"
                 data-widget-bar-preset
                 data-widget-style="solid"
                 data-widget-color="#0b1020"
                 data-widget-opacity="100"
                 data-widget-blur="false">
            <%= form.radio_button :widget_bar_style, "solid" %>
            <span class="system-config-widget-preview__thumb system-config-widget-preview__thumb--solid">
              <em>24°C</em>
              <strong>14:32</strong>
            </span>
            <span>Cor solida</span>
          </label>

          <label class="system-config-widget-preview"
                 data-widget-bar-preset
                 data-widget-style="transparent"
                 data-widget-color="#0b1020"
                 data-widget-opacity="58"
                 data-widget-blur="false">
            <%= form.radio_button :widget_bar_style, "transparent" %>
            <span class="system-config-widget-preview__thumb system-config-widget-preview__thumb--transparent">
              <em>24°C</em>
              <strong>14:32</strong>
            </span>
            <span>Transparente</span>
          </label>

          <label class="system-config-widget-preview"
                 data-widget-bar-preset
                 data-widget-style="transparent_blur"
                 data-widget-color="#0b1020"
                 data-widget-opacity="72"
                 data-widget-blur="true">
            <%= form.radio_button :widget_bar_style, "transparent_blur" %>
            <span class="system-config-widget-preview__thumb system-config-widget-preview__thumb--blur">
              <em>24°C</em>
              <strong>14:32</strong>
            </span>
            <span>Transparente com blur</span>
          </label>
        </div>

        <div class="system-config-grid">
          <label class="system-config-field">
            <span>Cor da barra</span>
            <span class="system-config-input system-config-input--color">
              <i class="fas fa-palette" aria-hidden="true"></i>
              <%= form.color_field :widget_bar_color, value: streaming_configuration.widget_bar_color.presence || "#0b1020" %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Opacidade (%)</span>
            <span class="system-config-input">
              <i class="fas fa-adjust" aria-hidden="true"></i>
              <%= form.number_field :widget_bar_opacity, min: 0, max: 100, step: 1 %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Comportamento</span>
            <span class="system-config-input">
              <i class="fas fa-layer-group" aria-hidden="true"></i>
              <%= form.select :widget_bar_behavior, [["Fixa", "fixed"], ["Subir ao aparecer", "slide"], ["Temporaria", "auto_hide"]] %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Efeito de entrada</span>
            <span class="system-config-input">
              <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
              <%= form.select :widget_bar_animation, [["Slide", "slide"], ["Fade", "fade"], ["Zoom suave", "zoom"], ["Aponti Smooth", "smooth"]] %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Posicao na reproducao</span>
            <span class="system-config-input">
              <i class="fas fa-object-group" aria-hidden="true"></i>
              <%= form.select :widget_bar_layout_mode, [["Sobrepor conteudo", "overlay"], ["Empurrar conteudo", "push_content"]] %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Espacamento da borda</span>
            <span class="system-config-input">
              <i class="fas fa-arrows-alt-v" aria-hidden="true"></i>
              <%= form.number_field :widget_bar_edge_spacing, min: 0, max: 120, step: 1, value: streaming_configuration.widget_bar_edge_spacing.to_i %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Tempo para aparecer</span>
            <span class="system-config-input system-config-input--split">
              <i class="fas fa-stopwatch" aria-hidden="true"></i>
              <%= form.number_field :widget_bar_appear_seconds, min: 0, max: 120, step: 1 %>
              <%= form.select :widget_bar_appear_unit, [["Segundos", "seconds"], ["Minutos", "minutes"]] %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Tempo para sumir</span>
            <span class="system-config-input system-config-input--split">
              <i class="fas fa-hourglass-half" aria-hidden="true"></i>
              <%= form.number_field :widget_bar_hide_seconds, min: 0, max: 120, step: 1 %>
              <%= form.select :widget_bar_hide_unit, [["Segundos", "seconds"], ["Minutos", "minutes"]] %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Conteudo</span>
            <span class="system-config-input">
              <i class="fas fa-cloud-sun" aria-hidden="true"></i>
              <%= form.select :widget_bar_content_mode, [["Clima e hora", "time_weather"], ["Somente clima", "weather"], ["Somente hora", "time"]] %>
            </span>
          </label>

          <label class="system-config-toggle system-config-toggle--inline">
            <%= form.check_box :widget_bar_blur_enabled %>
            <span class="system-config-toggle__track" aria-hidden="true"></span>
            <span>
              <strong>Aplicar blur</strong>
              <small>Disponivel em TVs Android com suporte visual.</small>
            </span>
          </label>

          <label class="system-config-field system-config-field--wide">
            <span>URL da API de clima</span>
            <span class="system-config-input">
              <i class="fas fa-cloud-sun-rain" aria-hidden="true"></i>
              <%= form.url_field :widget_bar_weather_api_url, placeholder: "https://roan.app.br/api/status" %>
            </span>
            <small>Aceita https://labs.aponti.org.br/api/current_data?station=estacao_01 ou https://roan.app.br/api/status.</small>
          </label>

          <label class="system-config-field system-config-field--wide">
            <span>Clima da barra para teste</span>
            <span class="system-config-input">
              <i class="fas fa-vial" aria-hidden="true"></i>
              <%= form.select :widget_bar_weather_test_condition, [
                ["Clima verdadeiro (API)", "real"],
                ["Padrao", "default"],
                ["Sol", "sun"],
                ["Chuva", "rain"],
                ["Nublado", "cloud"],
                ["Tempestade", "storm"]
              ] %>
            </span>
            <small>Use uma opcao de teste para validar a barra na TV. Volte para Clima verdadeiro (API) para usar os dados reais.</small>
          </label>
        </div>

        <div class="system-config-weather-assets">
          <div class="system-config-weather-assets__header">
            <i class="fas fa-images" aria-hidden="true"></i>
            <div>
              <h3>Imagens do clima no app oficial</h3>
              <p>Suba GIF, video, PNG ou JPG para o app trocar automaticamente conforme o clima.</p>
            </div>
          </div>

          <div class="system-config-weather-assets__grid">
            <% [
              ["Padrao", :widget_weather_default_image, :widget_weather_default_assets, "Usado quando o clima nao combinar."],
              ["Sol", :widget_weather_sun_image, :widget_weather_sun_assets, "Clear, sun ou ensolarado."],
              ["Chuva", :widget_weather_rain_image, :widget_weather_rain_assets, "Rain, drizzle ou chuva."],
              ["Nublado", :widget_weather_cloud_image, :widget_weather_cloud_assets, "Cloud, clouds ou nublado."],
              ["Tempestade", :widget_weather_storm_image, :widget_weather_storm_assets, "Storm, thunder ou tempestade."]
            ].each do |label, legacy_attachment_name, attachment_name, hint| %>
              <% legacy_attachment = streaming_configuration.public_send(legacy_attachment_name) %>
              <% attachments = streaming_configuration.public_send(attachment_name).attachments.to_a %>
              <% all_attachments = ([legacy_attachment.attachment].compact + attachments).select { |attachment| attachment.blob.present? } %>
              <% preview_attachments = all_attachments.first(4) %>
              <div class="system-config-weather-asset">
                <span class="system-config-weather-asset__preview <%= "system-config-weather-asset__preview--stack" if preview_attachments.size > 1 %>">
                  <% if preview_attachments.any? %>
                    <% preview_attachments.each do |attachment| %>
                      <%= image_tag url_for(attachment), alt: label %>
                    <% end %>
                  <% else %>
                    <i class="fas fa-cloud-sun" aria-hidden="true"></i>
                  <% end %>
                </span>
                <span class="system-config-weather-asset__body">
                  <strong><%= label %></strong>
                  <small><%= hint %></small>
                  <small><%= pluralize(all_attachments.size, "opcao cadastrada", "opcoes cadastradas") %></small>
                  <% if all_attachments.any? %>
                    <span class="system-config-weather-asset__chips">
                      <% all_attachments.each do |attachment| %>
                        <label class="system-config-weather-asset__chip">
                          <%= check_box_tag "streaming_configuration[remove_widget_weather_asset_ids][]", attachment.id, false %>
                          <span class="system-config-weather-asset__chip-preview">
                            <% if attachment.blob.content_type.to_s.start_with?("image/") %>
                              <%= image_tag url_for(attachment), alt: attachment.filename.to_s %>
                            <% else %>
                              <i class="fas fa-film" aria-hidden="true"></i>
                            <% end %>
                          </span>
                          <span class="system-config-weather-asset__chip-name"><%= attachment.filename.to_s %></span>
                          <i class="fas fa-trash" aria-hidden="true"></i>
                        </label>
                      <% end %>
                    </span>
                  <% end %>
                  <%= form.file_field attachment_name, multiple: true, accept: "image/gif,image/png,image/jpeg,image/webp,video/mp4,video/webm,video/quicktime,video/x-msvideo" %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <section class="system-config-section">
        <div class="system-config-section__title">
          <i class="fab fa-google" aria-hidden="true"></i>
          <div>
            <h2>Login com Google</h2>
            <p>Quando habilitado, aparece na tela de login e permite acesso apenas para e-mails ja cadastrados.</p>
          </div>
        </div>

        <label class="system-config-toggle">
          <%= form.check_box :google_oauth_enabled %>
          <span class="system-config-toggle__track" aria-hidden="true"></span>
          <span>
            <strong>Habilitar Entrar com Google</strong>
            <small>O botao so aparece quando Client ID e Client Secret estiverem preenchidos.</small>
          </span>
        </label>

        <div class="system-config-grid system-config-google-grid">
          <label class="system-config-field">
            <span>Google Client ID</span>
            <span class="system-config-input">
              <i class="fas fa-id-card" aria-hidden="true"></i>
              <%= form.text_field :google_client_id, autocomplete: "off", placeholder: "000000000000-xxxx.apps.googleusercontent.com" %>
            </span>
          </label>

          <label class="system-config-field">
            <span>Google Client Secret</span>
            <span class="system-config-input">
              <i class="fas fa-key" aria-hidden="true"></i>
              <%= form.password_field :google_client_secret, value: streaming_configuration.google_client_secret, autocomplete: "new-password", placeholder: "GOCSPX-..." %>
            </span>
          </label>
        </div>

        <div class="system-config-note">
          <i class="fas fa-link" aria-hidden="true"></i>
          <span>URI de callback: <code><%= "#{request.protocol}#{request.host_with_port}/users/auth/google_oauth2/callback" %></code></span>
        </div>
      </section>

      <footer class="system-config-footer">
        <%= link_to broadcasts_path, class: "system-config-btn system-config-btn--ghost" do %>
          <i class="fas fa-times" aria-hidden="true"></i>
          <span>Cancelar</span>
        <% end %>

        <%= button_tag type: "submit", class: "system-config-btn system-config-btn--primary" do %>
          <i class="fas fa-save" aria-hidden="true"></i>
          <span>Salvar configuracoes</span>
        <% end %>
      </footer>
    <% end %>
  </div>
</div>

<div class="system-config-converting-modal" data-weather-video-converting-modal aria-hidden="true">
  <div class="system-config-converting-modal__dialog">
    <span class="system-config-converting-modal__spinner" aria-hidden="true"></span>
    <strong>Convertendo arquivo</strong>
    <p>Estamos preparando a animacao para o app da TV. Mantenha esta janela aberta.</p>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", initializeStreamingConfigurationForm);
  document.addEventListener("turbo:load", initializeStreamingConfigurationForm);

  function initializeStreamingConfigurationForm() {
    const checkbox = document.querySelector("#streaming-checkbox");
    bindWidgetBarPresets();
    bindWeatherVideoConversionModal();
    if (!checkbox || checkbox.dataset.bound === "true") return;

    checkbox.dataset.bound = "true";
    checkbox.addEventListener("change", async (event) => {
      const isChecked = event.target.checked;
      const url = isChecked ? "/video/start" : "/video/stop";
      const csrfToken = document.querySelector("meta[name='csrf-token']")?.content;

      try {
        const response = await fetch(url, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": csrfToken
          },
          body: JSON.stringify({ video: { command: isChecked ? "start" : "stop" } })
        });
        const result = await response.json();
        if (!response.ok) alert(`Erro: ${result.error}`);
      } catch (error) {
        console.error("Erro na requisicao:", error);
      }
    });
  }

  function bindWidgetBarPresets() {
    const root = document.querySelector(".system-config-form");
    if (!root || root.dataset.widgetPresetsBound === "true") return;

    root.dataset.widgetPresetsBound = "true";
    const colorInput = root.querySelector("[name='streaming_configuration[widget_bar_color]']");
    const opacityInput = root.querySelector("[name='streaming_configuration[widget_bar_opacity]']");
    const blurInput = root.querySelector("[name='streaming_configuration[widget_bar_blur_enabled]']");

    root.querySelectorAll("[data-widget-bar-preset]").forEach((preset) => {
      preset.addEventListener("click", () => {
        const styleInput = preset.querySelector("[name='streaming_configuration[widget_bar_style]']");
        if (styleInput) {
          styleInput.checked = true;
          styleInput.dispatchEvent(new Event("change", { bubbles: true }));
        }

        if (colorInput && preset.dataset.widgetColor) colorInput.value = preset.dataset.widgetColor;
        if (opacityInput && preset.dataset.widgetOpacity) opacityInput.value = preset.dataset.widgetOpacity;
        if (blurInput && preset.dataset.widgetBlur) blurInput.checked = preset.dataset.widgetBlur === "true";
      });
    });
  }

  function bindWeatherVideoConversionModal() {
    const form = document.querySelector(".system-config-form");
    const modal = document.querySelector("[data-weather-video-converting-modal]");
    if (!form || !modal || form.dataset.weatherConversionBound === "true") return;

    form.dataset.weatherConversionBound = "true";
    form.addEventListener("submit", () => {
      const hasVideo = Array.from(form.querySelectorAll(".system-config-weather-asset input[type='file']")).some((input) => {
        return Array.from(input.files || []).some((file) => file.type && file.type.startsWith("video/"));
      });

      if (!hasVideo) return;
      modal.classList.add("is-visible");
      modal.setAttribute("aria-hidden", "false");
    });
  }
</script>

<style>
  .system-config-page {
    --system-config-card: rgba(18, 24, 44, .84);
    --system-config-card-strong: rgba(8, 12, 26, .58);
    --system-config-border: rgba(148, 163, 184, .18);
    --system-config-text: #ffffff;
    --system-config-muted: #aeb7cf;
    --system-config-input: rgba(8, 12, 26, .58);
    --system-config-input-border: rgba(148, 163, 184, .24);
    --system-config-icon: #9ca8c3;
    --system-config-accent: #8b2ff2;
    --system-config-shadow: 0 24px 70px rgba(0, 0, 0, .26);
    min-height: calc(100vh - 96px);
    padding: 28px 28px 112px;
    color: var(--system-config-text);
    box-sizing: border-box;
  }

  .system-config-shell {
    width: min(100%, 980px);
    margin: 0 auto;
  }

  .system-config-section,
  .system-config-footer {
    border: 1px solid var(--system-config-border);
    background: var(--system-config-card);
    box-shadow: var(--system-config-shadow), inset 0 1px 0 rgba(255, 255, 255, .05);
    backdrop-filter: blur(18px);
  }

  .system-config-kicker {
    color: #a855f7;
    font-size: 12px;
    font-weight: 950;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .system-config-section h2 {
    margin: 0;
    color: var(--system-config-text);
    letter-spacing: 0;
  }

  .system-config-section p,
  .system-config-toggle small,
  .system-config-note {
    color: var(--system-config-muted);
  }

  .system-config-form {
    display: grid;
    gap: 16px;
  }

  .system-config-section {
    padding: 22px;
    border-radius: 14px;
  }

  .system-config-section__title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .system-config-section__title > i {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #c084fc;
    background: rgba(139, 47, 242, .16);
  }

  .system-config-section h2 {
    font-size: 19px;
  }

  .system-config-section p {
    margin: 4px 0 0;
    font-size: 14px;
  }

  .system-config-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .system-config-field {
    display: grid;
    gap: 9px;
    color: var(--system-config-text);
    font-size: 13px;
    font-weight: 850;
  }

  .system-config-field--wide {
    grid-column: 1 / -1;
  }

  .system-config-input {
    min-height: 48px;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border: 1px solid var(--system-config-input-border);
    border-radius: 10px;
    background: var(--system-config-input);
  }

  .system-config-input i {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--system-config-icon);
  }

  .system-config-input input {
    width: 100%;
    min-width: 0;
    height: 46px;
    border: 0;
    outline: 0;
    color: var(--system-config-text);
    background: transparent;
    font: inherit;
  }

  .system-config-input input::placeholder {
    color: var(--system-config-muted);
  }

  .system-config-toggle {
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--system-config-border);
    border-radius: 12px;
    background: var(--system-config-card-strong);
    cursor: pointer;
  }

  .system-config-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .system-config-toggle__track {
    width: 50px;
    height: 28px;
    border-radius: 999px;
    position: relative;
    background: rgba(148, 163, 184, .22);
    transition: background .2s ease, box-shadow .2s ease;
  }

  .system-config-toggle__track::after {
    content: "";
    position: absolute;
    top: 4px;
    left: 4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    transition: transform .22s ease;
  }

  .system-config-toggle input:checked + .system-config-toggle__track {
    background: var(--system-config-accent);
    box-shadow: 0 0 24px rgba(168, 85, 247, .42);
  }

  .system-config-toggle input:checked + .system-config-toggle__track::after {
    transform: translateX(22px);
  }

  .system-config-toggle strong {
    display: block;
    color: var(--system-config-text);
