<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:page_title) ? "#{yield(:page_title)} | Aponti TV" : "Aponti TV" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "icone.png" %>
    <%= favicon_link_tag "icone.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <script>
      (function() {
        if (window.location.pathname.match(/\/users\/sign_in\/?$/)) {
          document.documentElement.dataset.theme = "dark";
          return;
        }

        var theme = localStorage.getItem("aponti-theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }

        document.documentElement.classList.add("app-sidebar-compact");

        var savedLocale = localStorage.getItem("aponti-locale");
        var currentLocale = "<%= I18n.locale %>";
        if ((savedLocale === "pt" || savedLocale === "en") && savedLocale !== currentLocale) {
          var url = new URL(window.location.href);
          if (!url.searchParams.has("locale")) {
            url.searchParams.set("locale", savedLocale);
            window.location.replace(url.toString());
          }
        }
      })();
    </script>
  </head>

  <body>
    <% page_title = content_for?(:page_title) ? yield(:page_title) : "#{controller_name.humanize} #{action_name.humanize}" %>
    <% page_title = I18n.t("Home") if controller_name == "dashboards" && action_name == "index" && !content_for?(:page_title) %>
    <% page_subtitle = content_for?(:page_subtitle) ? yield(:page_subtitle) : nil %>
    <% page_icon_class = content_for?(:page_icon) ? yield(:page_icon) : {
      "dashboards" => "fas fa-house-user",
      "broadcasts" => "fas fa-tv",
      "video_editor" => "fas fa-film",
      "media_library" => "fas fa-photo-video",
      "streaming_configurations" => "fas fa-gear",
      "users" => "fas fa-users",
      "access_logs" => "fas fa-file-lines",
      "desktop_agents" => "fas fa-desktop",
      "registrations" => "fas fa-key"
    }.fetch(controller_name, "fas fa-layer-group") %>
    <% show_back_navigation = !(controller_name == "license" && (action_name == "new" || action_name == "create")) &&
                              !((controller_name == "dashboards" && action_name == "index") ||
                                (controller_name == "users" && (action_name == "new" || action_name == "edit")) ||
                                (controller_name == "sessions" && action_name == "new")) %>
    <% show_app_chrome = !(controller_name == "license" && (action_name == "new" || action_name == "create")) &&
                         !(controller_name == "sessions" && action_name == "new") %>

    <% if show_app_chrome %>
      <aside class="app-sidebar" aria-label="<%= I18n.t("MainMenu") %>">
        <div class="app-sidebar__brand">
          <%= tag.img src: asset_path("APONTI_MARCA.png"), alt: "Aponti TV", class: "app-sidebar__logo", onerror: "this.hidden=true;this.nextElementSibling.hidden=false;" %>
          <%= tag.img src: asset_path("icone.png"), alt: "Aponti TV", class: "app-sidebar__logo-icon" %>
          <span class="app-sidebar__brand-fallback" hidden>Aponti TV</span>
        </div>

        <nav class="app-sidebar__nav">
          <%= link_to dashboard_path, class: "app-sidebar__link #{'is-active' if controller_name == 'dashboards'}", title: I18n.t("Dashboard") do %>
            <i class="fas fa-house-user" aria-hidden="true"></i>
            <span><%= I18n.t("Dashboard") %></span>
          <% end %>

          <%= link_to broadcasts_path, class: "app-sidebar__link #{'is-active' if controller_name == 'broadcasts' && action_name == 'index'}", title: "TVs" do %>
            <i class="fas fa-tv" aria-hidden="true"></i>
            <span>TVs</span>
          <% end %>

          <%= link_to video_editor_path, class: "app-sidebar__link #{'is-active' if controller_name == 'video_editor'}", title: "Aponti Studio" do %>
            <i class="fas fa-film" aria-hidden="true"></i>
            <span>Aponti Studio</span>
          <% end %>

          <%= link_to media_library_path, class: "app-sidebar__link #{'is-active' if controller_name == 'media_library'}", title: I18n.t("Library") do %>
            <i class="fas fa-photo-video" aria-hidden="true"></i>
            <span><%= I18n.t("Library") %></span>
          <% end %>

          <% if user_signed_in? && current_user.admin? %>
            <%= link_to export_m3u_broadcasts_path, class: "app-sidebar__link", title: I18n.t("Export M3U") do %>
              <i class="fas fa-file-export" aria-hidden="true"></i>
              <span><%= I18n.t("Export M3U") %></span>
            <% end %>

            <%= link_to edit_streaming_configuration_path(1), class: "app-sidebar__link #{'is-active' if controller_name == 'streaming_configurations'}", title: I18n.t("Configuration") do %>
              <i class="fas fa-gear" aria-hidden="true"></i>
              <span><%= I18n.t("Configuration") %></span>
            <% end %>
          <% end %>
        </nav>

        <% if user_signed_in? && current_user.admin? %>
          <div class="app-sidebar__section-title"><%= I18n.t("Management") %></div>
          <nav class="app-sidebar__nav app-sidebar__nav--management">
            <%= link_to users_path, class: "app-sidebar__link #{'is-active' if controller_name == 'users'}", title: I18n.t("Users") do %>
              <i class="fas fa-users" aria-hidden="true"></i>
              <span><%= I18n.t("Users") %></span>
            <% end %>

            <%= link_to access_logs_path, class: "app-sidebar__link #{'is-active' if controller_name == 'access_logs'}", title: I18n.t("AccessLogs") do %>
              <i class="fas fa-file-lines" aria-hidden="true"></i>
              <span><%= I18n.t("AccessLogs") %></span>
            <% end %>

            <%= link_to "#", class: "app-sidebar__link", title: "Backups" do %>
              <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
              <span>Backups</span>
            <% end %>

            <%= link_to desktop_agents_path, class: "app-sidebar__link #{'is-active' if controller_name == 'desktop_agents'}", title: I18n.t("WindowsAgents") do %>
              <i class="fas fa-desktop" aria-hidden="true"></i>
              <span><%= I18n.t("WindowsAgents") %></span>
            <% end %>
          </nav>
        <% end %>



        <div class="app-sidebar__profile">
          <% if user_signed_in? %>
            <button type="button"
                    class="app-sidebar__avatar app-sidebar__avatar--button"
                    title="<%= I18n.t("UserMenu") %>"
                    aria-label="<%= I18n.t("UserMenu") %>"
                    aria-expanded="false"
                    data-sidebar-profile-avatar-button>
              <%= current_user.email.to_s.first&.upcase || "U" %>
            </button>
            <div class="app-sidebar__profile-copy">
              <strong><%= current_user.email %></strong>
              <span><%= current_user.admin? ? I18n.t("Administrator") : I18n.t("User") %></span>
            </div>
            <button type="button" class="app-sidebar__logout" title="<%= I18n.t("UserMenu") %>" aria-label="<%= I18n.t("UserMenu") %>" aria-expanded="false" data-sidebar-profile-menu-button>
              <i class="fas fa-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="app-sidebar__context-menu" hidden data-sidebar-profile-menu>
              <div class="app-sidebar__context-title"><%= I18n.t("Theme") %></div>
              <div class="app-sidebar__theme-options" role="group" aria-label="<%= I18n.t("Theme") %>" data-theme-switch>
                <span class="app-sidebar__theme-thumb" aria-hidden="true"></span>
                <button type="button" data-theme-choice="system" title="<%= I18n.t("SystemTheme") %>" aria-label="<%= I18n.t("SystemTheme") %>">
                  <i class="fas fa-desktop" aria-hidden="true"></i>
                  <span class="app-sr-only"><%= I18n.t("SystemTheme") %></span>
                </button>
                <button type="button" data-theme-choice="light" title="<%= I18n.t("LightTheme") %>" aria-label="<%= I18n.t("LightTheme") %>">
                  <i class="far fa-sun" aria-hidden="true"></i>
                  <span class="app-sr-only"><%= I18n.t("LightTheme") %></span>
                </button>
                <button type="button" data-theme-choice="dark" title="<%= I18n.t("DarkTheme") %>" aria-label="<%= I18n.t("DarkTheme") %>">
                  <i class="far fa-moon" aria-hidden="true"></i>
                  <span class="app-sr-only"><%= I18n.t("DarkTheme") %></span>
                </button>
              </div>
              <%= link_to edit_user_registration_path, class: "app-sidebar__context-item" do %>
                <i class="fas fa-key" aria-hidden="true"></i>
                <span><%= I18n.t("ChangePassword") %></span>
              <% end %>
              <%= button_to destroy_user_session_path, method: :delete, class: "app-sidebar__context-item app-sidebar__context-item--danger" do %>
                <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                <span><%= I18n.t("Logout") %></span>
              <% end %>
            </div>
          <% else %>
            <div class="app-sidebar__avatar"><i class="fas fa-lock" aria-hidden="true"></i></div>
            <div class="app-sidebar__profile-copy">
              <strong><%= I18n.t("Guest") %></strong>
              <span><%= I18n.t("Unauthenticated") %></span>
            </div>
          <% end %>
        </div>
      </aside>
    <% end %>

    <% unless (controller_name == "license" && (action_name == "new" || action_name == "create")) ||
              (controller_name == "sessions" && action_name == "new") %>
      <header class="app-banner">
        <div class="app-banner__brand">
<% if show_back_navigation %>
  <%= link_to dashboard_path, class: 'app-banner__back-link' do %>
    <i class="fas fa-home" aria-hidden="true"></i>
    <span><%= I18n.t("Home") %></span>
  <% end %>
<% end %>

          <div class="app-banner__copy">
            <h1><i class="<%= page_icon_class %> app-banner__title-icon" aria-hidden="true"></i><span><%= page_title %></span></h1>
            <% if page_subtitle.present? && controller_name != "broadcasts" %>
              <p class="app-banner__subtitle"><%= page_subtitle %></p>
            <% end %>
          </div>
        </div>

        <div class="app-banner__tools">
          <% unless controller_name == "sessions" && action_name == "new" %>
            <div class="app-banner__language">
              <i class="fas fa-globe" aria-hidden="true"></i>
              <%= form_with(url: "/change_locale", method: :get, local: true) do %>
                <%= hidden_field_tag :return_to, request.fullpath %>
                <%= select_tag :locale, options_for_select([['English', 'en'], ['Português', 'pt']], I18n.locale), data: { locale_select: true }, onchange: 'localStorage.setItem("aponti-locale", this.value); this.form.submit();' %>
              <% end %>
            </div>
          <% end %>

          <% if user_signed_in? %>
            <div class="app-banner__notification-wrap" data-notifications-root>
              <button type="button"
                      class="app-banner__notification"
                      aria-label="<%= I18n.t("Notifications") %>"
                      aria-expanded="false"
                      data-notifications-button>
                <i class="far fa-bell" aria-hidden="true"></i>
                <span class="app-banner__notification-badge" data-notifications-count hidden>0</span>
              </button>
              <div class="app-banner__notification-menu" data-notifications-menu hidden>
                <section class="app-banner__notification-panel">
                  <div class="app-banner__notification-menu-header">
                    <span class="app-banner__notification-menu-mark" aria-hidden="true">
                      <i class="far fa-bell" aria-hidden="true"></i>
                    </span>
                    <span class="app-banner__notification-heading">
                      <strong><%= I18n.t("NotificationCenter") %></strong>
                      <small><%= I18n.t("NotificationCenterSubtitle") %></small>
                    </span>
                    <span class="app-banner__notification-menu-actions">
                      <button type="button" data-notifications-mark-read>
                        <i class="far fa-circle-check" aria-hidden="true"></i>
                        <span><%= I18n.t("MarkAllRead") %></span>
                      </button>
                      <%= link_to notifications_path, class: "app-banner__notification-history-link" do %>
                        <i class="far fa-clock" aria-hidden="true"></i>
                        <span><%= I18n.t("History") %></span>
                      <% end %>
                    </span>
                  </div>
                  <div class="app-banner__notification-list" data-notifications-list>
                    <p class="app-banner__notification-empty"><%= I18n.t("NotificationsEmpty") %></p>
                  </div>
                </section>
              </div>
            </div>
          <% elsif controller_name != "sessions" %>
            <%= link_to safe_join([tag.i("", class: "fas fa-sign-in-alt", aria: { hidden: true }), content_tag(:span, "Login")]), new_user_session_path, class: 'app-banner__btn app-banner__btn--primary' %>
          <% end %>
        </div>
      </header>
    <% end %>

    <main class="app-shell <%= 'app-shell--plain' if (controller_name == 'license' && (action_name == 'new' || action_name == 'create')) || (controller_name == 'sessions' && action_name == 'new') %>">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      function initializeApontiShell() {
        var menuButton = document.querySelector("[data-sidebar-profile-menu-button]");
        var avatarMenuButton = document.querySelector("[data-sidebar-profile-avatar-button]");
        var menu = document.querySelector("[data-sidebar-profile-menu]");
        var sidebar = document.querySelector(".app-sidebar");
        var root = document.documentElement;

        if (document.querySelector("[data-login-theme='light']")) {
          root.dataset.theme = "light";
          return;
        }

        if (document.querySelector("[data-login-theme='dark']")) {
          root.dataset.theme = "dark";
          return;
        }

        function currentTheme() {
          return localStorage.getItem("aponti-theme") || "system";
        }

        function applyTheme(theme, animate) {
          if (animate) {
            root.classList.add("app-theme-transitioning");
            window.clearTimeout(root._apontiThemeTransitionTimer);
            root._apontiThemeTransitionTimer = window.setTimeout(function() {
              root.classList.remove("app-theme-transitioning");
            }, 460);
          }

          if (theme === "light" || theme === "dark") {
            root.dataset.theme = theme;
            localStorage.setItem("aponti-theme", theme);
          } else {
            delete root.dataset.theme;
            localStorage.removeItem("aponti-theme");
            theme = "system";
          }

          document.querySelectorAll("[data-theme-choice]").forEach(function(button) {
            button.classList.toggle("is-active", button.dataset.themeChoice === theme);
          });

          document.querySelectorAll("[data-theme-switch]").forEach(function(switcher) {
            switcher.dataset.themeValue = theme;
          });
        }

        applyTheme(currentTheme(), false);

        function applySidebarCompact(isCompact) {
          root.classList.toggle("app-sidebar-compact", isCompact);
        }

        applySidebarCompact(true);

        if (sidebar && sidebar.dataset.sidebarHoverBound !== "true") {
          sidebar.dataset.sidebarHoverBound = "true";
          sidebar.addEventListener("mouseenter", function() {
            applySidebarCompact(false);
          });
          sidebar.addEventListener("mouseleave", function() {
            if (menu && !menu.hidden) {
              menu.hidden = true;
              if (menuButton) menuButton.setAttribute("aria-expanded", "false");
              if (avatarMenuButton) avatarMenuButton.setAttribute("aria-expanded", "false");
            }
            applySidebarCompact(true);
          });
        }

        document.querySelectorAll("[data-theme-choice]").forEach(function(button) {
          if (button.dataset.themeBound === "true") return;
          button.dataset.themeBound = "true";
          button.addEventListener("click", function() {
            applyTheme(button.dataset.themeChoice, true);
          });
        });

        initializeAppNotifications();

        if (!menu || (menuButton && menuButton.dataset.profileMenuBound === "true")) return;
        if (menuButton) menuButton.dataset.profileMenuBound = "true";

        function toggleProfileMenu(event) {
          event.stopPropagation();
          var willOpen = menu.hidden;
          menu.hidden = !willOpen;
          if (menuButton) menuButton.setAttribute("aria-expanded", String(willOpen));
          if (avatarMenuButton) avatarMenuButton.setAttribute("aria-expanded", String(willOpen));
          applyTheme(currentTheme(), false);
        }

        if (menuButton) menuButton.addEventListener("click", toggleProfileMenu);
        if (avatarMenuButton && avatarMenuButton.dataset.profileAvatarMenuBound !== "true") {
          avatarMenuButton.dataset.profileAvatarMenuBound = "true";
          avatarMenuButton.addEventListener("click", toggleProfileMenu);
        }

        menu.addEventListener("click", function(event) {
          event.stopPropagation();
        });

        document.addEventListener("click", function() {
          menu.hidden = true;
          if (menuButton) menuButton.setAttribute("aria-expanded", "false");
          if (avatarMenuButton) avatarMenuButton.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("keydown", function(event) {
          if (event.key === "Escape") {
            menu.hidden = true;
            if (menuButton) menuButton.setAttribute("aria-expanded", "false");
            if (avatarMenuButton) avatarMenuButton.setAttribute("aria-expanded", "false");
          }
        });
      }

      function initializeAppNotifications() {
        var root = document.querySelector("[data-notifications-root]");
        if (!root || root.dataset.notificationsBound === "true") return;

        root.dataset.notificationsBound = "true";
        var button = root.querySelector("[data-notifications-button]");
        var menu = root.querySelector("[data-notifications-menu]");
        var list = root.querySelector("[data-notifications-list]");
        var count = root.querySelector("[data-notifications-count]");
        var markRead = root.querySelector("[data-notifications-mark-read]");
        var totalLabels = root.querySelectorAll("[data-notifications-total]");
        var unreadLabels = root.querySelectorAll("[data-notifications-unread]");
        var tabButtons = root.querySelectorAll("[data-notifications-filter]");
        var currentFilter = "all";
        var csrf = document.querySelector("meta[name='csrf-token']")?.content || "";

        function escapeHtml(value) {
          return String(value || "").replace(/[&<>"']/g, function(character) {
            return {
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;"
            }[character];
          });
        }

        function timeAgo(isoDate) {
          var date = new Date(isoDate);
          if (Number.isNaN(date.getTime())) return "";
          var seconds = Math.max(1, Math.floor((Date.now() - date.getTime()) / 1000));
          if (seconds < 60) return "<%= j I18n.t("Now") %>";
          var minutes = Math.floor(seconds / 60);
          if (minutes < 60) return minutes + "min";
          var hours = Math.floor(minutes / 60);
          if (hours < 24) return hours + "h";
          return date.toLocaleDateString("<%= I18n.locale == :pt ? 'pt-BR' : 'en-US' %>", { day: "2-digit", month: "2-digit" });
        }

        function applyFilter() {
          list.querySelectorAll(".app-banner__notification-item").forEach(function(item) {
            var visible = currentFilter === "all" ||
              (currentFilter === "unread" && item.classList.contains("is-unread")) ||
              (currentFilter === "archived" && item.dataset.status === "archived");
            item.hidden = !visible;
          });
        }

        function render(data) {
          var unreadCount = Number(data.unread_count || 0);
          var notifications = Array.isArray(data.notifications) ? data.notifications : [];
          var visibleNotifications = notifications.filter(function(notification) {
            return notification.unread;
          });
          var notificationsCount = visibleNotifications.length;
          var badgeCount = unreadCount;
          count.hidden = badgeCount <= 0;
          count.textContent = badgeCount > 9 ? "9+" : String(badgeCount);
          button.classList.toggle("has-unread", unreadCount > 0);
          totalLabels.forEach(function(label) { label.textContent = String(notificationsCount); });
          unreadLabels.forEach(function(label) { label.textContent = String(unreadCount); });

          if (notificationsCount === 0) {
            list.innerHTML = '<p class="app-banner__notification-empty"><%= j I18n.t("NotificationsEmpty") %></p>';
            return;
          }

          list.innerHTML = visibleNotifications.map(function(notification) {
            return [
              '<article class="app-banner__notification-item app-banner__notification-item--' + escapeHtml(notification.severity) + (notification.unread ? ' is-unread' : '') + '" data-status="' + (notification.unread ? 'unread' : 'read') + '">',
                '<span class="app-banner__notification-dot-wrap">',
                  notification.unread ? '<span class="app-banner__notification-dot" aria-hidden="true"></span>' : '',
                '</span>',
                '<span class="app-banner__notification-icon"><i class="fas ' + escapeHtml(notification.icon_class) + '" aria-hidden="true"></i></span>',
                '<span class="app-banner__notification-body">',
                  '<strong>' + escapeHtml(notification.title) + '</strong>',
                  notification.message ? '<small>' + escapeHtml(notification.message) + '</small>' : '',
                '</span>',
                '<span class="app-banner__notification-meta">',
                  '<time>' + escapeHtml(timeAgo(notification.created_at)) + '</time>',
                '</span>',
              '</article>'
            ].join("");
          }).join("");
          applyFilter();
        }

        function refreshNotifications() {
          fetch("/notifications.json", { headers: { "Accept": "application/json" }, credentials: "same-origin" })
            .then(function(response) { return response.ok ? response.json() : Promise.reject(response); })
            .then(render)
            .catch(function() {});
        }

        button.addEventListener("click", function(event) {
          event.stopPropagation();
          var willOpen = menu.hidden;
          menu.hidden = !willOpen;
          button.setAttribute("aria-expanded", String(willOpen));
          if (willOpen) refreshNotifications();
        });

        menu.addEventListener("click", function(event) {
          event.stopPropagation();
        });

        if (markRead) {
          markRead.addEventListener("click", function() {
            fetch("/notifications/mark_all_read.json", {
              method: "POST",
              headers: { "X-CSRF-Token": csrf, "Accept": "application/json" },
              credentials: "same-origin"
            }).then(function(response) {
              if (response.ok) refreshNotifications();
            }).catch(function() {});
          });
        }

        tabButtons.forEach(function(tab) {
          tab.addEventListener("click", function() {
            currentFilter = tab.dataset.notificationsFilter || "all";
            tabButtons.forEach(function(otherTab) {
              otherTab.classList.toggle("is-active", otherTab === tab);
            });
            applyFilter();
          });
        });

        document.addEventListener("click", function() {
          menu.hidden = true;
          button.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("keydown", function(event) {
          if (event.key === "Escape") {
            menu.hidden = true;
            button.setAttribute("aria-expanded", "false");
          }
        });

        refreshNotifications();
        window.clearInterval(window.apontiNotificationsPoller);
        window.apontiNotificationsPoller = setInterval(refreshNotifications, 15000);
      }

      document.addEventListener("DOMContentLoaded", initializeApontiShell);
      document.addEventListener("turbo:load", initializeApontiShell);
    </script>
  </body>
</html>

<style>
  :root {
    --app-sidebar-width: 224px;
    --app-sidebar-expanded-width: 224px;
    --app-sidebar-compact-width: 76px;
    --app-banner-bg: linear-gradient(135deg, rgba(55, 25, 99, .33), rgba(0, 0, 0, .96));
    --app-banner-bg-solid: #0b1020;
    --app-banner-border: rgba(255, 255, 255, .08);
    --app-banner-shadow: 0 14px 30px rgba(0, 0, 0, .22);
    --app-banner-text: #ffffff;
    --app-banner-muted: rgba(255, 255, 255, .76);
    --app-banner-control-bg: rgba(7, 12, 26, .48);
    --app-banner-control-border: rgba(172, 188, 230, .16);
    --app-banner-control-hover: rgba(255, 255, 255, .14);
    --app-banner-control-text: #ffffff;
    color-scheme: dark light;
  }

  html.app-sidebar-compact {
