  }

  [data-theme="dark"] .app-banner__notification-item--success .app-banner__notification-icon {
    color: #86efac;
    background: rgba(22, 163, 74, .16);
  }

  [data-theme="dark"] .app-banner__notification-item--warning .app-banner__notification-icon {
    color: #fbbf24;
    background: rgba(245, 158, 11, .16);
  }

  [data-theme="dark"] .app-banner__notification-item--error .app-banner__notification-icon {
    color: #fca5a5;
    background: rgba(239, 68, 68, .16);
  }

  [data-theme="dark"] .app-banner__notification-item--info .app-banner__notification-icon {
    color: #d8b4fe;
    background: rgba(124, 58, 237, .18);
  }

  [data-theme="dark"] .app-banner__notification-footer {
    color: #c084fc;
    background: #090d1a;
  }

  .app-banner__profile {
    justify-content: space-between;
    width: auto;
  }

  .app-banner__profile-user {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    height: 100%;
  }

  .app-banner__profile-user i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    font-size: 19px;
    margin-top: 0;
    line-height: 1;
  }

  .app-banner__profile-user i::before {
    display: block;
    width: 100%;
    line-height: 20px;
  }

  .app-banner__profile-user strong {
    display: inline-flex;
    align-items: center;
    max-width: 180px;
    min-height: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1;
  }

  .app-banner__actions {
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .app-banner__actions form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .app-banner__btn {
    height: 46px;
    padding: 0 18px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    line-height: 1;
    box-sizing: border-box;
    white-space: nowrap;
    vertical-align: middle;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .app-banner__btn i,
  .app-banner__btn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .app-banner__btn i {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    font-size: 12px;
    text-align: center;
    margin: 0;
  }

  .app-banner__btn i::before {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    line-height: 1;
  }

  .app-banner__btn:hover {
    transform: translateY(-1px);
  }

  .app-banner__btn--primary {
    background: #0f766e;
    color: #ffffff;
  }

  .app-banner__btn--ghost {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .app-banner__btn--danger {
    background: linear-gradient(180deg, #d93a42, #b8232d);
    color: #ffffff;
    border-color: rgba(255,255,255,.08);
    box-shadow: 0 12px 22px rgba(185, 28, 28, .2);
  }

  .app-shell {
    margin-left: var(--app-sidebar-width);
    padding-top: 96px;
    min-height: 100vh;
    transition: margin-left .24s ease;
  }

  .app-shell--plain {
    margin-left: 0;
    padding-top: 0;
  }

  .container {
    width: min(100%, 1480px);
    margin-inline: auto;
    padding-inline: 26px;
  }

  @media (max-width: 980px) {
    .app-sidebar {
      position: relative;
      width: 100%;
      min-height: auto;
      padding-bottom: 16px;
    }

    .app-sidebar__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    html.app-sidebar-compact {
      --app-sidebar-width: 100%;
    }

    html.app-sidebar-compact .app-sidebar {
      padding-inline: 16px;
    }

    html.app-sidebar-compact .app-sidebar__brand {
      justify-content: space-between;
      padding: 0 10px;
    }

    html.app-sidebar-compact .app-sidebar__logo,
    html.app-sidebar-compact .app-sidebar__link span,
    html.app-sidebar-compact .app-sidebar__section-title {
      display: block;
    }

    html.app-sidebar-compact .app-sidebar__logo-icon {
      display: none;
    }

    html.app-sidebar-compact .app-sidebar__link {
      width: auto;
      grid-template-columns: 20px minmax(0, 1fr);
      justify-items: start;
      padding: 0 12px;
      gap: 12px;
    }

    .app-sidebar__premium,
    .app-sidebar__profile {
      display: none;
    }

    .app-banner {
      position: relative;
      left: 0;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
    }

    .app-banner__tools {
      align-items: stretch;
      justify-content: space-between;
    }

    .app-banner__notification-wrap {
      position: static;
    }

    .app-banner__notification-menu {
      top: 86px;
      right: 12px;
      left: 12px;
      width: auto;
    }

    .app-shell {
      margin-left: 0;
      padding-top: 24px;
    }
  }

  @media (max-width: 640px) {
    .app-banner {
      padding: 12px;
    }

    .app-banner__brand,
    .app-banner__profile,
    .app-banner__actions {
      align-items: stretch;
    }

    .app-banner__brand {
      flex-direction: row;
    }

    .app-banner__tools,
    .app-banner__profile {
      flex-direction: column;
      height: auto;
    }

    .app-banner__profile-user strong {
      max-width: none;
      white-space: normal;
    }

    .app-banner__notification-menu {
      top: 74px;
      max-height: calc(100vh - 92px);
      border-radius: 22px;
    }

    .app-banner__notification-menu-header {
      min-height: 78px;
      padding: 14px 16px;
      gap: 12px;
    }

    .app-banner__notification-menu-mark {
      width: 46px;
      height: 46px;
      border-radius: 15px;
      font-size: 22px;
    }

    .app-banner__notification-menu-header strong {
      font-size: 19px;
    }

    .app-banner__notification-menu-header button {
      font-size: 0;
    }

    .app-banner__notification-menu-header button i {
      font-size: 20px;
    }

    .app-banner__notification-list {
      max-height: calc(100vh - 228px);
      padding: 12px;
    }

    .app-banner__notification-item {
      grid-template-columns: 52px minmax(0, 1fr) 48px;
      gap: 12px;
      min-height: 82px;
      padding: 12px;
      border-radius: 16px;
    }

    .app-banner__notification-icon {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      font-size: 21px;
    }

    .app-banner__notification-body strong {
      font-size: 15px;
    }

    .app-banner__notification-body small {
      font-size: 13px;
    }

    .app-banner__notification-item time {
      font-size: 12px;
    }
  }

