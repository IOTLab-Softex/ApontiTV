    border-color: rgba(148, 163, 184, .16);
  }

  [data-theme="dark"] .app-banner__notification-menu-header strong,
  [data-theme="dark"] .app-banner__notification-body strong {
    color: #f8fbff;
  }

  [data-theme="dark"] .app-banner__notification-menu-header button {
