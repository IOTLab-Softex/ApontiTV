  .app-banner__notification-item.is-unread::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 12px;
    bottom: 12px;
    width: 3px;
    border-radius: 999px;
    background: linear-gradient(180deg, #7c3aed, #a855f7);
    box-shadow: 0 0 18px rgba(124, 58, 237, .45);
  }

  .app-banner__notification-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(148, 163, 184, .14);
    font-size: 18px;
  }

  .app-banner__notification-item--success .app-banner__notification-icon {
    color: #16a34a;
    background: linear-gradient(135deg, rgba(34, 197, 94, .14), rgba(220, 252, 231, .8));
  }

  .app-banner__notification-item--warning .app-banner__notification-icon {
    color: #f59e0b;
    background: linear-gradient(135deg, rgba(245, 158, 11, .14), rgba(254, 243, 199, .78));
  }

  .app-banner__notification-item--error .app-banner__notification-icon {
    color: #ef4444;
    background: linear-gradient(135deg, rgba(239, 68, 68, .14), rgba(254, 226, 226, .78));
  }

  .app-banner__notification-item--info .app-banner__notification-icon {
    color: #7c3aed;
    background: linear-gradient(135deg, rgba(124, 58, 237, .14), rgba(237, 233, 254, .78));
  }

  .app-banner__notification-body {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .app-banner__notification-body strong {
    color: #111827;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.18;
  }

  .app-banner__notification-body small {
    color: #64748b;
    font-size: 12.5px;
    font-weight: 650;
    line-height: 1.35;
  }

  .app-banner__notification-meta {
    display: grid;
    justify-items: center;
    gap: 10px;
    align-self: center;
    padding-top: 0;
  }

  .app-banner__notification-item time {
    color: #64748b;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .app-banner__notification-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #7c3aed;
    box-shadow: 0 0 14px rgba(124, 58, 237, .54);
  }

  .app-banner__notification-footer {
    min-height: 48px;
    border-top: 1px solid rgba(15, 23, 42, .08);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #7c3aed;
    text-decoration: none;
    font-size: 14px;
    font-weight: 900;
    background: color-mix(in srgb, var(--app-bg) 92%, #fff 8%);
  }

  .app-banner__notification-footer i {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(139, 47, 242, .08);
  }

  .notifications-history-page {
    padding-block: 18px 44px;
  }

  .notifications-history {
    width: min(920px, 100%);
    display: grid;
    gap: 12px;
  }

  .notifications-history__item {
    position: relative;
    min-height: 96px;
    border: 1px solid var(--app-border);
    border-radius: 18px;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 16px 18px;
    background: var(--app-surface);
    box-shadow: var(--app-card-shadow);
  }

  .notifications-history__item.is-unread::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 14px;
    bottom: 14px;
    width: 4px;
    border-radius: 999px;
    background: linear-gradient(180deg, #7c3aed, #a855f7);
  }

  .notifications-history__icon {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #7c3aed;
    background: rgba(139, 47, 242, .12);
    font-size: 24px;
  }

  .notifications-history__item--success .notifications-history__icon {
    color: #16a34a;
    background: rgba(34, 197, 94, .13);
  }

  .notifications-history__item--warning .notifications-history__icon {
    color: #f59e0b;
    background: rgba(245, 158, 11, .13);
  }

  .notifications-history__item--error .notifications-history__icon {
    color: #ef4444;
    background: rgba(239, 68, 68, .13);
  }

  .notifications-history__body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .notifications-history__body strong {
    color: var(--app-text);
    font-size: 18px;
    font-weight: 900;
  }

  .notifications-history__body small,
  .notifications-history__item time,
  .notifications-history__empty {
    color: var(--app-muted);
    font-weight: 700;
  }

  .notifications-history__body small {
    font-size: 14px;
    line-height: 1.4;
  }

  .notifications-history__item time {
    white-space: nowrap;
    font-size: 13px;
  }

  .notifications-history__empty {
    margin: 0;
    border: 1px solid var(--app-border);
    border-radius: 18px;
    padding: 32px;
    background: var(--app-surface);
    text-align: center;
  }

  [data-theme="dark"] .app-banner__notification-menu {
    background:
      radial-gradient(circle at 14% 0%, rgba(139, 47, 242, .16), transparent 30%),
