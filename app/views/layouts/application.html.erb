    background-clip: content-box;
  }

  .app-banner__notification-empty {
    margin: 0;
    padding: 34px 16px;
    color: var(--app-banner-muted);
    text-align: center;
    font-size: 13px;
    font-weight: 700;
  }

  .app-banner__notification-item {
    position: relative;
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 44px;
    gap: 11px;
    align-items: center;
    min-height: 70px;
    margin-bottom: 8px;
    padding: 10px 12px;
    border: 1px solid rgba(15, 23, 42, .08);
    border-radius: 12px;
    color: #111827;
    background: #ffffff;
    box-shadow: none;
    transition: background .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .app-banner__notification-item:hover {
    border-color: rgba(124, 58, 237, .24);
    background: #f8f5ff;
    box-shadow: 0 12px 28px rgba(124, 58, 237, .10);
    transform: translateY(-1px);
  }

  .app-banner__notification-item.is-unread {
    border-color: rgba(139, 47, 242, .12);
    background:
      linear-gradient(90deg, rgba(139, 47, 242, .12), transparent 72%),
      #ffffff;
