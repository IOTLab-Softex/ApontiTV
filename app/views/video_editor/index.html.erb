<% content_for :page_title, "Aponti Studio" %>
<% content_for :page_subtitle, I18n.t("StudioSubtitle") %>

<div class="video-editor-splash" id="ve-index-splash">
  <%= image_tag "APONTI_STUDIO_HORIZONTAL_RGB-01.png", alt: "Aponti Studio", class: "video-editor-splash__logo" %>
</div>

<div class="ve-index" id="ve-home-content" style="opacity:0;transition:opacity 0.45s ease;">

  <%# ── Toolbar (igual ao broadcasts) ──────────────────── %>
  <section class="broadcasts-toolbar">
    <div class="broadcasts-toolbar__actions">
      <%= link_to safe_join([tag.i("", class: "fas fa-plus", aria: { hidden: true }), content_tag(:span, I18n.t("NewProject"))]), new_video_editor_path, class: "broadcasts-toolbar__btn broadcasts-toolbar__btn--primary" %>
      <%= link_to safe_join([tag.i("", class: "fas fa-photo-video", aria: { hidden: true }), content_tag(:span, I18n.t("Library"))]), media_library_path, class: "broadcasts-toolbar__btn broadcasts-toolbar__btn--ghost" %>
    </div>
    <span class="ve-index__count">
      <%= I18n.t("ProjectCount", count: @projects.size) %>
    </span>
  </section>

  <%# ── Grid de projetos ────────────────────────────────── %>
  <% if @projects.any? %>
    <div class="ve-index__grid">
      <% @projects.each do |project| %>
        <% blob = project.rendered_blob %>
        <article class="ve-card">

          <div class="ve-card__thumb ve-card__thumb--<%= project.orientation %>">
            <% if blob.present? %>
              <video class="ve-card__video" muted preload="metadata" loop>
                <source src="<%= rails_blob_path(blob, only_path: true) %>" type="video/mp4">
              </video>
            <% end %>
            <div class="ve-card__cover">
              <% if blob.present? %>
                <div class="ve-card__play">
                  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </div>
              <% else %>
                <div class="ve-card__nopreview">
                  <i class="fas fa-film"></i>
                  <span><%= I18n.t("NoPreview") %></span>
                </div>
              <% end %>
            </div>
            <div class="ve-card__chips">
              <span class="ve-card__chip"><%= project.orientation == "portrait" ? "9:16" : "16:9" %></span>
              <% if blob.blank? %><span class="ve-card__chip ve-card__chip--warn"><%= I18n.t("Draft") %></span><% end %>
            </div>
          </div>

          <div class="ve-card__body">
            <p class="ve-card__title" title="<%= project.title %>"><%= project.title %></p>
            <p class="ve-card__meta">
              <i class="fas fa-clock"></i>
              <%= project.updated_at.strftime("%d/%m/%Y %H:%M") %>
              <span class="ve-card__sep">·</span>
              <%= project.orientation_label %>
            </p>
          </div>

          <div class="ve-card__foot">
            <%= link_to edit_video_editor_project_path(project), class: "ve-card__act ve-card__act--edit" do %>
              <i class="fas fa-pen"></i> <%= I18n.t("Edit") %>
            <% end %>
            <% if blob.present? %>
              <%= link_to new_broadcast_path(broadcast: { selected_video_blob_id: blob.id }), class: "ve-card__act ve-card__act--bc" do %>
                <i class="fas fa-broadcast-tower"></i> Broadcast
              <% end %>
            <% end %>
            <%= button_to video_editor_project_path(project), method: :delete,
                form: { data: { turbo_confirm: I18n.t("ConfirmDeleteProject", title: project.title) } },
                class: "ve-card__act ve-card__act--del" do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </div>

        </article>
      <% end %>
    </div>

  <% else %>
    <div class="ve-index__empty">
      <div class="ve-index__empty-icon"><i class="fas fa-film"></i></div>
      <p class="ve-index__empty-title"><%= I18n.t("NoProjectsYet") %></p>
      <p class="ve-index__empty-sub"><%= I18n.t("NoProjectsYetSubtitle") %></p>
      <%= link_to new_video_editor_path, class: "broadcasts-toolbar__btn broadcasts-toolbar__btn--primary" do %>
        <i class="fas fa-plus"></i>
        <span><%= I18n.t("CreateFirstProject") %></span>
      <% end %>
    </div>
  <% end %>

</div>

<style>
  /* ── Wrapper ─────────────────────────────────────────── */
  .ve-index {
    padding: 28px 0 88px;
  }

  .ve-index__count {
    font-size: 13px;
    font-weight: 700;
    color: #64748b;
    background: rgba(15,23,42,0.06);
    padding: 6px 14px;
    border-radius: 20px;
    white-space: nowrap;
  }

  /* ── Toolbar (re-usa broadcasts-toolbar__btn do broadcasts/index) */
  .broadcasts-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .broadcasts-toolbar__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .broadcasts-toolbar__actions form {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  .broadcasts-toolbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 15px;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid transparent;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    background: #fff;
    color: #172033;
    line-height: 1;
    box-sizing: border-box;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    white-space: nowrap;
    vertical-align: middle;
  }

  .broadcasts-toolbar__btn i,
  .broadcasts-toolbar__btn span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .broadcasts-toolbar__btn i {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    font-size: 13px;
    text-align: center;
  }

  .broadcasts-toolbar__btn i::before {
    display: block;
    width: 100%;
    line-height: 14px;
  }

  .broadcasts-toolbar__btn:hover { transform: translateY(-1px); }

  .broadcasts-toolbar__btn--primary {
    background: linear-gradient(135deg, #ff7a18, #ff9f43);
    color: #fff;
    box-shadow: 0 12px 24px rgba(255,122,24,0.22);
  }

  .broadcasts-toolbar__btn--ghost {
    background: rgba(255,255,255,0.82);
    border-color: rgba(23,32,51,0.12);
  }

  .broadcasts-toolbar__btn--ghost:hover {
    border-color: rgba(249,115,22,0.35);
    box-shadow: 0 10px 20px rgba(15,23,42,0.08);
  }

  /* ── Grid ────────────────────────────────────────────── */
  .ve-index__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
  }

  /* ── Card ────────────────────────────────────────────── */
  .ve-card {
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(148,163,184,0.18);
    box-shadow: 0 2px 10px rgba(15,23,42,0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .ve-card:hover {
    box-shadow: 0 10px 30px rgba(15,23,42,0.13);
    transform: translateY(-2px);
  }

  /* Thumb */
  .ve-card__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    overflow: hidden;
    flex-shrink: 0;
  }
  .ve-card__thumb--portrait { aspect-ratio: 9/16; max-height: 200px; }

  .ve-card__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }

  .ve-card__cover {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
  }

  .ve-card__play {
    width: 50px; height: 50px; border-radius: 50%;
    background: rgba(0,0,0,0.45);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transform: scale(0.8);
    transition: opacity 0.2s, transform 0.2s;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .ve-card:hover .ve-card__play { opacity: 1; transform: scale(1); }

  .ve-card__nopreview {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: rgba(255,255,255,0.28); font-size: 11px; font-weight: 600;
  }
  .ve-card__nopreview i { font-size: 26px; }

  .ve-card__chips {
    position: absolute; bottom: 8px; left: 8px;
    display: flex; gap: 5px;
  }
  .ve-card__chip {
    padding: 3px 8px; border-radius: 5px;
    font-size: 10px; font-weight: 800; letter-spacing: 0.04em;
    background: rgba(0,0,0,0.55); color: rgba(255,255,255,0.9);
    backdrop-filter: blur(4px);
  }
  .ve-card__chip--warn { background: rgba(245,158,11,0.85); color: #fff; }

  /* Body */
  .ve-card__body { padding: 12px 14px 8px; flex: 1; min-width: 0; }
  .ve-card__title {
    margin: 0 0 5px; font-size: 14px; font-weight: 700; color: #0f172a;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ve-card__meta {
    margin: 0; font-size: 11px; color: #94a3b8;
    display: flex; align-items: center; gap: 5px; flex-wrap: wrap;
  }
  .ve-card__meta i { font-size: 10px; }
  .ve-card__sep { color: #e2e8f0; }

  /* Footer */
  .ve-card__foot {
    display: flex; align-items: stretch;
    border-top: 1px solid rgba(148,163,184,0.12);
    background: #fafbfc;
  }
  .ve-card__foot form { margin: 0; display: flex; }

  .ve-card__act {
    flex: 1; display: inline-flex; align-items: center; justify-content: center;
    gap: 5px; padding: 9px 6px; font-size: 12px; font-weight: 700;
    text-decoration: none; border: none; background: transparent;
    cursor: pointer; transition: background 0.15s, color 0.15s; white-space: nowrap;
  }
  .ve-card__act + .ve-card__act,
  .ve-card__act + form .ve-card__act,
  form + .ve-card__act,
  form + form .ve-card__act { border-left: 1px solid rgba(148,163,184,0.12); }

  .ve-card__act--edit  { color: #f97316; }
  .ve-card__act--edit:hover { background: rgba(249,115,22,0.07); }
  .ve-card__act--bc    { color: #0ea5e9; }
  .ve-card__act--bc:hover { background: rgba(14,165,233,0.07); }
  .ve-card__act--del   { flex: 0; padding: 9px 14px; color: #ef4444; }
  .ve-card__act--del:hover { background: rgba(239,68,68,0.07); }

  /* Empty */
  .ve-index__empty {
    display: flex; flex-direction: column; align-items: center;
    gap: 16px; padding: 80px 24px; text-align: center;
  }
  .ve-index__empty-icon {
    width: 88px; height: 88px; border-radius: 24px;
    background: #f1f5f9; display: flex; align-items: center; justify-content: center;
    color: #94a3b8; font-size: 34px;
  }
  .ve-index__empty-title { margin: 0; font-size: 20px; font-weight: 800; color: #0f172a; }
  .ve-index__empty-sub   { margin: 0; font-size: 14px; color: #64748b; }
.video-editor-splash {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000000;
  overflow: hidden;
  transition: opacity 0.45s ease, visibility 0.45s ease;
}

.video-editor-splash::before {
  content: "";
  position: absolute;
  width: 120px;
  height: 120px;
  border: 3px solid rgba(124, 58, 237, 0.55);
  border-radius: 50%;
  background: rgba(124, 58, 237, 0.55);
  transform: scale(0);
  opacity: 0;
  animation: radar-scan 1.2s ease-out 0.75s forwards;
}

.video-editor-splash__logo {
  position: relative;
  z-index: 2;
  max-width: 360px;
  width: 55vw;
  animation: logo-zoom-back 0.8s cubic-bezier(.22,.8,.25,1) forwards;
}

.video-editor-splash.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

@keyframes logo-zoom-back {
  0% {
    transform: scale(2.4);
    opacity: 0;
  }

  35% {
    opacity: 1;
  }

  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes radar-scan {
  0% {
    transform: scale(0.2);
    opacity: 0.75;
  }

  70% {
    opacity: 0.35;
  }

  100% {
    transform: scale(18);
    opacity: 0;
  }
}
  </style>

<script>
  function initializeVideoEditorIndex() {
    var splash  = document.getElementById("ve-index-splash");
    var content = document.getElementById("ve-home-content");
    if (!splash && !content) return;

    if (splash && content) {
      setTimeout(function() {
        splash.classList.add("is-hidden");
        content.style.opacity = "1";
      }, 1400);
    } else if (content) {
      content.style.opacity = "1";
    }
    document.querySelectorAll(".ve-card__thumb").forEach(function(thumb) {
      if (thumb.dataset.videoPreviewBound === "true") return;
      thumb.dataset.videoPreviewBound = "true";

      var v = thumb.querySelector("video");
      if (!v) return;
      thumb.addEventListener("mouseenter", function() { v.play().catch(function(){}); });
      thumb.addEventListener("mouseleave", function() { v.pause(); v.currentTime = 0; });
    });
  }

  document.addEventListener("DOMContentLoaded", initializeVideoEditorIndex);
  document.addEventListener("turbo:load", initializeVideoEditorIndex);
</script>
