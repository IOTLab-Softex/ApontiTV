<% content_for :page_title, "Aponti Studio" %>
<% content_for :page_subtitle, I18n.t("CreatePlaylist", default: "Criar video") %>

<%
  restore =
    begin
      @restore_data.present? ? JSON.parse(@restore_data) : {}
    rescue JSON::ParserError
      {}
    end

  restore_manifest =
    begin
      value = restore["media_manifest"]
      value.is_a?(String) ? JSON.parse(value) : Array(value)
    rescue JSON::ParserError
      []
    end

  restore_media =
    if @project&.media_files&.attached?
      @project.media_files.map do |attachment|
        blob = attachment.blob
        manifest_item = restore_manifest.find { |item| item.is_a?(Hash) && item["blob_id"].to_i == blob.id }
        {
          blob_id: blob.id,
          name: blob.filename.to_s,
          content_type: blob.content_type.to_s,
          byte_size: blob.byte_size,
          duration: manifest_item&.dig("duration").to_f,
          url: rails_blob_path(blob, only_path: true)
        }
      end
    else
      []
    end
%>

<div class="video-editor-page"
     data-video-editor-page
     data-video-editor-save-draft-url="<%= save_draft_video_editor_path %>"
     data-video-editor-index-url="<%= video_editor_path %>"
     data-video-editor-initial-media="<%= json_escape(restore_media.to_json) %>"
     data-video-editor-initial-timeline="<%= json_escape(restore["timeline_data"].presence || "{}") %>">
  <%= form_with url: video_editor_create_path, method: :post, multipart: true, local: true, class: "video-editor-studio", data: { video_editor_form: true } do %>
    <input type="hidden" name="project_id" value="<%= @project&.id %>" data-video-editor-project-id>
    <input type="hidden" name="item_order" value="" data-video-editor-order>
    <input type="hidden" name="project_duration" value="<%= restore["project_duration"].presence || "" %>" data-video-editor-project-duration>
    <input type="hidden" name="timeline_data" value="" data-video-editor-timeline-data>
    <input type="hidden" name="media_manifest" value="" data-video-editor-media-manifest>

    <header class="video-editor-topbar">
      <nav class="video-editor-menubar" aria-label="Aponti Studio">
        <%= link_to video_editor_path, class: "video-editor-topbar__back", title: I18n.t("Back") do %>
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          <span><%= I18n.t("Back") %></span>
        <% end %>

        <div class="video-editor-menu">
          <button type="button"><i class="fas fa-folder-open" aria-hidden="true"></i> Midia</button>
          <div class="video-editor-menu__panel">
            <label>
              <i class="fas fa-upload" aria-hidden="true"></i>
              <span>Importar midia</span>
              <input type="file" name="media_files[]" accept="video/*,image/*,audio/*" multiple data-video-editor-files hidden>
            </label>
            <button type="button" data-video-editor-clear>
              <i class="fas fa-trash" aria-hidden="true"></i>
              <span>Limpar projeto</span>
            </button>
          </div>
        </div>

        <div class="video-editor-menu">
          <button type="button"><i class="fas fa-layer-group" aria-hidden="true"></i> Timeline</button>
          <div class="video-editor-menu__panel">
            <button type="button" data-video-editor-add-text-clip>
              <i class="fas fa-font" aria-hidden="true"></i>
              <span>Nova camada de texto</span>
            </button>
            <button type="button" data-video-editor-add-track>
              <i class="fas fa-plus" aria-hidden="true"></i>
              <span>Nova trilha</span>
            </button>
          </div>
        </div>

        <div class="video-editor-menu">
          <button type="button"><i class="fas fa-crop-alt" aria-hidden="true"></i> Formato</button>
          <div class="video-editor-menu__panel">
            <label>
              <i class="fas fa-mobile-alt" aria-hidden="true"></i>
              <span>Retrato 9:16</span>
              <input type="radio" name="orientation" value="portrait" data-video-editor-orientation <%= restore["orientation"].to_s == "landscape" ? "" : "checked" %>>
            </label>
            <label>
              <i class="fas fa-tv" aria-hidden="true"></i>
              <span>Paisagem 16:9</span>
              <input type="radio" name="orientation" value="landscape" data-video-editor-orientation <%= restore["orientation"].to_s == "landscape" ? "checked" : "" %>>
            </label>
          </div>
        </div>
      </nav>

      <div class="video-editor-topbar__actions">
        <button type="button" class="video-editor-link" data-video-editor-save-draft>
          <i class="fas fa-floppy-disk" aria-hidden="true"></i>
          <span>Salvar projeto</span>
        </button>
        <label class="video-editor-link">
          <i class="fas fa-plus" aria-hidden="true"></i>
          <span>Importar</span>
          <input type="file" name="media_files[]" accept="video/*,image/*,audio/*" multiple data-video-editor-files-secondary hidden>
        </label>
        <button type="submit" class="video-editor-submit" data-video-editor-submit disabled>
          <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
          <span>Gerar MP4</span>
        </button>
      </div>
    </header>

    <% if alert.present? || notice.present? %>
      <div class="video-editor-flash <%= alert.present? ? "video-editor-flash--alert" : "video-editor-flash--notice" %>">
        <%= alert.presence || notice %>
      </div>
    <% end %>

    <main class="video-editor-workspace">
      <aside class="video-editor-bin">
        <div class="video-editor-panel-title">
          <strong>Biblioteca do projeto</strong>
          <span data-video-editor-file-count>0 arquivos</span>
        </div>

        <label class="video-editor-dropzone" data-video-editor-dropzone>
          <span class="video-editor-dropzone__label">
            <i class="fas fa-cloud-arrow-up" aria-hidden="true"></i>
            <strong>Importar midia</strong>
            <span>Videos e imagens para montar o MP4.</span>
          </span>
          <input type="file" name="media_files[]" accept="video/*,image/*,audio/*" multiple data-video-editor-files-drop hidden>
        </label>

        <div class="video-editor-media-list" data-video-editor-media-list>
          <div class="video-editor-media-row">
            <i class="fas fa-photo-video" aria-hidden="true"></i>
            <span>
              <strong>Nenhuma midia importada</strong>
              <small>Clique em importar para comecar.</small>
            </span>
          </div>
        </div>
      </aside>

      <div class="video-editor-resizer video-editor-resizer--vertical" data-video-editor-resizer="media" aria-hidden="true"></div>

      <section class="video-editor-program">
        <div class="video-editor-program__header">
          <div>
            <strong data-video-editor-preview-title>Preview</strong>
            <span data-video-editor-preview-meta>Selecione uma midia para visualizar.</span>
          </div>
          <div class="video-editor-transport">
            <button type="button" data-video-editor-prev title="Anterior"><i class="fas fa-backward-step" aria-hidden="true"></i></button>
            <button type="button" data-video-editor-play title="Mostrar frame do ponteiro"><i class="fas fa-crosshairs" aria-hidden="true"></i></button>
            <button type="button" data-video-editor-next title="Proximo"><i class="fas fa-forward-step" aria-hidden="true"></i></button>
          </div>
        </div>

        <div class="video-editor-preview__screen is-portrait" data-video-editor-preview-screen>
          <img class="video-editor-preview__media" data-video-editor-preview-image hidden alt="">
          <video class="video-editor-preview__media" data-video-editor-preview-video muted playsinline preload="metadata" hidden></video>
          <div class="video-editor-preview__layers" data-video-editor-preview-layers></div>
          <div data-video-editor-preview-captions></div>
          <span class="video-editor-preview__transition-badge" data-video-editor-transition-badge hidden>Fade</span>
        </div>
      </section>

      <div class="video-editor-resizer video-editor-resizer--vertical" data-video-editor-resizer="inspector" aria-hidden="true"></div>

      <aside class="video-editor-inspector">
        <div class="video-editor-panel-title">
          <strong>Inspector</strong>
          <span data-video-editor-selected-label>Nenhum item</span>
        </div>

        <label class="video-editor-field">
          <span>Titulo do projeto</span>
          <input class="video-editor-input" type="text" name="title" value="<%= restore["title"].presence || "Aponti Studio #{Time.zone.now.strftime("%d/%m %H:%M")}" %>">
        </label>

        <label class="video-editor-field">
          <span>Inicio na timeline</span>
          <input class="video-editor-input" type="number" min="0" step="0.1" value="0" data-video-editor-timeline-start>
        </label>

        <label class="video-editor-field">
          <span>Trilha</span>
          <select class="video-editor-input" data-video-editor-track></select>
        </label>

        <label class="video-editor-field">
          <span>Duracao do item</span>
          <input class="video-editor-input" type="number" min="0.2" max="120" step="0.01" value="8" data-video-editor-duration>
        </label>

        <label class="video-editor-field">
          <span>Inicio do video</span>
          <input class="video-editor-input" type="number" min="0" step="0.01" value="0" data-video-editor-start-time>
        </label>

        <div class="video-editor-field">
          <span>Camadas de texto</span>
          <div class="video-editor-layer-toolbar">
            <button type="button" class="video-editor-link" data-video-editor-add-layer>
              <i class="fas fa-layer-group" aria-hidden="true"></i>
              <span>Nova camada</span>
            </button>
            <button type="button" class="video-editor-link video-editor-link--danger" data-video-editor-remove-layer>
              <i class="fas fa-trash" aria-hidden="true"></i>
              <span>Remover</span>
            </button>
          </div>
          <div class="video-editor-layer-list" data-video-editor-layer-list></div>
        </div>

        <label class="video-editor-field">
          <span>Texto da camada</span>
          <textarea class="video-editor-input video-editor-textarea" rows="3" data-video-editor-caption placeholder="Selecione ou crie uma camada"></textarea>
        </label>

        <label class="video-editor-field">
          <span>Posicao da legenda</span>
          <select class="video-editor-input" data-video-editor-caption-position>
            <option value="bottom_center">Rodape central</option>
            <option value="top_center">Topo central</option>
            <option value="center">Centro</option>
            <option value="bottom_left">Rodape esquerdo</option>
            <option value="bottom_right">Rodape direito</option>
          </select>
        </label>

        <label class="video-editor-field">
          <span>Transicao apos item</span>
          <select class="video-editor-input" data-video-editor-transition>
            <option value="cut">Corte seco</option>
            <option value="fade">Fade</option>
            <option value="slide">Slide</option>
            <option value="blur">Blur</option>
          </select>
        </label>

        <label class="video-editor-field">
          <span>Duracao da transicao</span>
          <input class="video-editor-input" type="number" min="0.1" max="5" step="0.1" value="0.5" data-video-editor-transition-duration>
        </label>

        <label class="video-editor-field">
          <span>Efeito no inicio</span>
          <select class="video-editor-input" data-video-editor-effect-in>
            <option value="none">Sem efeito</option>
            <option value="fade">Fade-in</option>
            <option value="slide">Entrada lateral</option>
          </select>
        </label>

        <label class="video-editor-field">
          <span>Efeito no final</span>
          <select class="video-editor-input" data-video-editor-effect-out>
            <option value="none">Sem efeito</option>
            <option value="fade">Fade-out</option>
            <option value="slide">Saida lateral</option>
          </select>
        </label>

        <label class="video-editor-field">
          <span>Duracao dos efeitos</span>
          <input class="video-editor-input" type="number" min="0.1" max="5" step="0.1" value="0.5" data-video-editor-effect-duration>
        </label>
      </aside>
    </main>

    <div class="video-editor-resizer video-editor-resizer--horizontal" data-video-editor-resizer="timeline" aria-hidden="true"></div>

    <section class="video-editor-timeline-shell">
      <div class="video-editor-project-duration">
        <div class="video-editor-timeline-headline">
          <span>Timeline</span>
          <span data-video-editor-total-duration>0s</span>
        </div>
        <div class="video-editor-player-controls" aria-label="Player da timeline">
          <button type="button" data-video-editor-player-start title="Voltar para o inicio"><i class="fas fa-backward-fast" aria-hidden="true"></i></button>
          <button type="button" data-video-editor-player-play title="Play"><i class="fas fa-play" aria-hidden="true"></i></button>
          <button type="button" data-video-editor-player-pause title="Pause"><i class="fas fa-pause" aria-hidden="true"></i></button>
          <button type="button" data-video-editor-player-stop title="Stop"><i class="fas fa-stop" aria-hidden="true"></i></button>
          <button type="button" data-video-editor-player-end title="Ir para o final"><i class="fas fa-forward-fast" aria-hidden="true"></i></button>
        </div>
        <div class="video-editor-render-range">
          <label>
            <span>Render inicio</span>
            <input type="number" min="0" step="0.1" value="0" data-video-editor-render-start>
          </label>
          <label>
            <span>Render fim</span>
            <input type="number" min="0.2" step="0.1" value="0" data-video-editor-render-end>
          </label>
        </div>
        <div class="video-editor-timeline-track-actions">
          <button type="button" class="video-editor-timeline-add-track" data-video-editor-add-track-kind="image" title="Criar camada de video/imagem">
            <i class="fas fa-photo-video" aria-hidden="true"></i>
            <span>Video/Imagem</span>
          </button>
          <button type="button" class="video-editor-timeline-add-track" data-video-editor-add-track-kind="audio" title="Criar camada de audio">
            <i class="fas fa-music" aria-hidden="true"></i>
            <span>Audio</span>
          </button>
          <button type="button" class="video-editor-timeline-add-track" data-video-editor-add-track-kind="text" title="Criar camada de texto">
            <i class="fas fa-font" aria-hidden="true"></i>
            <span>Texto</span>
          </button>
        </div>
      </div>
      <div class="video-editor-tracks">
        <div class="video-editor-track-labels">
          <span>Midia</span>
          <span>Legenda</span>
        </div>
        <div class="video-editor-track-area">
          <div class="video-editor-render-window" data-video-editor-render-window aria-hidden="true"></div>
          <span class="video-editor-render-window__handle video-editor-render-window__handle--start" data-video-editor-render-handle="start" data-label="Inicio"></span>
          <span class="video-editor-render-window__handle video-editor-render-window__handle--end" data-video-editor-render-handle="end" data-label="Fim"></span>
          <div class="video-editor-playhead" style="left:0%" aria-hidden="true"></div>
          <div class="video-editor-timeline" data-video-editor-timeline></div>
          <div class="video-editor-caption-track" data-video-editor-caption-track></div>
        </div>
      </div>
    </section>
  <% end %>
</div>

<style>
  .video-editor-layer-toolbar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .video-editor-link--danger {
    border-color: rgba(239, 68, 68, .24);
    color: #ef4444;
  }

  .video-editor-layer-list {
    display: grid;
    gap: 6px;
    max-height: 140px;
    overflow: auto;
  }

  .video-editor-layer-row {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid #d7dde5;
    border-radius: 7px;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #243041;
    font-weight: 800;
    cursor: pointer;
    text-align: left;
  }

  .video-editor-layer-row span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .video-editor-layer-row.is-selected {
    border-color: #8b35ee;
    background: rgba(139, 53, 238, .1);
    color: #5b21b6;
  }

  .video-editor-layer-empty {
    min-height: 34px;
    border: 1px dashed #cbd5e1;
    border-radius: 7px;
    display: grid;
    place-items: center;
    color: #64748b;
    font-size: 12px;
    font-weight: 800;
  }

  .video-editor-page .video-editor-track-labels,
  .video-editor-page .video-editor-caption-track {
    display: none;
  }

  .video-editor-page .video-editor-timeline-shell {
    overflow: auto;
  }

  .video-editor-page .video-editor-track-area,
  .video-editor-page .video-editor-timeline {
    min-height: 0;
    width: 100%;
  }

  .video-editor-page .video-editor-timeline {
    display: grid;
    gap: 8px;
    overflow: auto;
    padding: 8px;
  }

  .video-editor-page .video-editor-project-duration {
    position: static;
    height: auto;
    min-width: 0;
    margin-bottom: 8px;
    padding: 6px 8px;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: transparent;
    box-shadow: none;
  }

  .video-editor-timeline-headline,
  .video-editor-player-controls,
  .video-editor-timeline-track-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .video-editor-player-controls {
    flex: 0 0 auto;
    padding: 3px;
    border: 1px solid rgba(148, 163, 184, .24);
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    background: rgba(255, 255, 255, .54);
  }

  .video-editor-page .video-editor-project-duration .video-editor-player-controls button {
    position: static;
    inset: auto;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border: 0;
    border-radius: 8px;
    display: inline-grid;
    place-items: center;
    background: transparent;
    color: #334155;
    cursor: pointer;
    box-shadow: none;
    transform: none;
  }

  .video-editor-page .video-editor-project-duration .video-editor-player-controls button:hover,
  .video-editor-page .video-editor-project-duration .video-editor-player-controls button.is-active {
    background: rgba(124, 58, 237, .12);
    color: #6d28d9;
  }

  .video-editor-timeline-track-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .video-editor-render-range {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .video-editor-render-range label {
    min-width: 98px;
    display: grid;
    gap: 3px;
    color: #64748b;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .video-editor-render-range input {
    width: 100%;
    height: 30px;
    border: 1px solid rgba(148, 163, 184, .32);
    border-radius: 8px;
    padding: 0 8px;
    background: rgba(255, 255, 255, .78);
    color: #0f172a;
    font-weight: 900;
  }

  .video-editor-page .video-editor-project-duration span {
    position: static;
    transform: none;
    color: #243041;
    font-size: 13px;
    font-weight: 900;
  }

  .video-editor-page .video-editor-project-duration .video-editor-timeline-add-track {
    position: static;
    top: auto;
    right: auto;
    width: auto;
    height: auto;
    min-width: 0;
    min-height: 30px;
    padding: 0 10px;
    border: 1px solid rgba(124, 58, 237, .24);
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(124, 58, 237, .08);
    color: #6d28d9;
    font-weight: 900;
    cursor: pointer;
    box-shadow: none;
  }

  .video-editor-multitrack-row {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 8px;
    min-height: 54px;
  }

  .video-editor-timeline-ruler {
    display: grid;
    grid-template-columns: 132px minmax(720px, 1fr);
    gap: 8px;
    min-height: 30px;
    position: sticky;
    top: 0;
    z-index: 15;
    background: rgba(248, 250, 252, .92);
    backdrop-filter: blur(10px);
  }

  .video-editor-timeline-ruler__label {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: #64748b;
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .video-editor-timeline-ruler__ticks {
    position: relative;
    min-height: 30px;
    border: 1px solid rgba(148, 163, 184, .22);
    border-radius: 8px;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(124, 58, 237, .12) 1px, transparent 1px) 0 0 / 10% 100%,
      rgba(255, 255, 255, .58);
  }

  .video-editor-timeline-ruler__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(100, 116, 139, .34);
  }

  .video-editor-timeline-ruler__tick span {
    position: absolute;
    top: 7px;
    left: 6px;
    color: #64748b;
    font-size: 10px;
    font-weight: 900;
    white-space: nowrap;
  }

  .video-editor-multitrack-row__label {
    border: 1px solid rgba(148, 163, 184, .28);
    border-radius: 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px;
    padding: 0 10px;
    background: rgba(15, 23, 42, .04);
    color: #243041;
  }

  .video-editor-multitrack-row__label strong,
  .video-editor-multitrack-row__label small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .video-editor-multitrack-row__label small {
    color: #64748b;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .02em;
  }

  .video-editor-multitrack-row__label {
    cursor: grab;
    touch-action: none;
  }

  .video-editor-multitrack-row__label.is-selected {
    border-color: rgba(124, 58, 237, .72);
    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, .24);
  }

  .video-editor-multitrack-row.is-disabled {
    opacity: .48;
  }

  .video-editor-multitrack-row.is-drop-before .video-editor-multitrack-row__label {
    border-top-color: #7c3aed;
    box-shadow: inset 0 3px 0 #7c3aed;
  }

  .video-editor-track-tools {
    display: inline-flex;
    gap: 4px;
  }

  .video-editor-track-tools button {
    width: 24px;
    height: 24px;
    border: 1px solid rgba(148, 163, 184, .28);
    border-radius: 7px;
    display: inline-grid;
    place-items: center;
