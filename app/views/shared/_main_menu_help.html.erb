<div class="main-menu-help" data-main-menu-help hidden>
  <div class="main-menu-help__shade" data-main-menu-help-close></div>
  <div data-main-menu-help-callouts></div>
</div>

<style>
  .app-sidebar__brand{position:relative}.app-sidebar__help{position:absolute;right:4px;top:50%;width:30px;height:30px;display:grid;place-items:center;padding:0;border:0;border-radius:50%;background:transparent;color:#d8b4fe;font-size:16px;cursor:pointer;transform:translateY(-50%);filter:drop-shadow(0 0 5px rgba(168,85,247,.55));transition:.2s}.app-sidebar__help:hover,.app-sidebar__help:focus-visible{color:#fff;transform:translateY(-50%) scale(1.14);filter:drop-shadow(0 0 10px #c084fc);outline:0}.app-sidebar:has(.app-sidebar__help:hover),.app-sidebar:has(.app-sidebar__help:focus-visible){border-right-color:#a855f7;box-shadow:7px 0 32px rgba(168,85,247,.32)}html[data-theme="light"] .app-sidebar__help{color:#6d28d9}
  html.app-sidebar-compact .app-sidebar__help{display:none}.app-sidebar:hover .app-sidebar__help{display:grid}
  .main-menu-help{position:fixed;z-index:30000;inset:0}.main-menu-help[hidden]{display:none}.main-menu-help__shade{position:absolute;inset:0;background:rgba(2,6,23,.82);backdrop-filter:blur(2px)}.main-menu-help__spotlight{position:fixed;z-index:1;border:2px solid #a855f7;border-radius:0 24px 24px 0;box-shadow:0 0 0 6px rgba(168,85,247,.17),0 0 42px rgba(168,85,247,.7);pointer-events:none}.main-menu-help__title{position:fixed;z-index:3;display:flex;align-items:center;gap:12px;width:min(330px,calc(100vw - 28px));padding:16px 18px;border:1px solid rgba(192,132,252,.65);border-radius:15px;background:linear-gradient(145deg,#171a35,#0b1025);color:#fff;box-shadow:0 18px 45px rgba(2,6,23,.7),0 0 25px rgba(168,85,247,.25)}.main-menu-help__title>i{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,#7c3aed,#a855f7);font-size:18px}.main-menu-help__title strong,.main-menu-help__title span{display:block}.main-menu-help__title span{margin-top:3px;color:#aeb9cf;font-size:11px}.main-menu-help__callout{position:fixed;z-index:3;width:260px;display:grid;grid-template-columns:25px 1fr;gap:9px;padding:11px 12px;border:1px solid rgba(192,132,252,.72);border-radius:12px;background:#111429;color:#f8fafc;box-shadow:0 12px 34px rgba(2,6,23,.65)}.main-menu-help__callout b{width:23px;height:23px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#7c3aed,#a855f7);font-size:10px}.main-menu-help__callout strong{display:block;font-size:12px}.main-menu-help__callout p{margin:4px 0 0;color:#aeb9cf;font-size:10px;line-height:1.4}.main-menu-help__callout:before{content:"";position:absolute;left:-7px;top:17px;width:12px;height:12px;border-left:1px solid #c084fc;border-bottom:1px solid #c084fc;background:#111429;transform:rotate(45deg)}.main-menu-help__close{position:fixed;z-index:4;right:24px;bottom:24px;display:flex;align-items:center;gap:8px;padding:12px 18px;border:0;border-radius:12px;background:linear-gradient(145deg,#7c3aed,#a855f7);color:#fff;font-weight:800;cursor:pointer;box-shadow:0 13px 30px rgba(124,58,237,.38)}body.main-menu-help-open{overflow:hidden}body.main-menu-help-open .app-sidebar{z-index:30002!important}body.main-menu-help-open .app-sidebar__help{z-index:4;color:#fff}
  @media(max-width:760px){.main-menu-help__callout{width:min(230px,calc(100vw - 100px))}.main-menu-help__title{display:none}.main-menu-help__close{right:12px;bottom:12px}}
  body.main-menu-help-open .app-sidebar{border-right:2px solid #a855f7!important;box-shadow:5px 0 0 rgba(168,85,247,.2),10px 0 38px rgba(168,85,247,.72)!important}
  .main-menu-help__callout{width:360px;min-height:0;padding:8px 11px;grid-template-columns:23px 1fr;gap:8px}.main-menu-help__callout p{margin-top:2px;white-space:nowrap;font-size:9px}.main-menu-help__callout:before{top:var(--main-menu-arrow-y,17px)}
</style>

<script>
  function setupMainMenuHelp(){
    const overlay=document.querySelector('[data-main-menu-help]'),sidebar=document.querySelector('[data-main-menu-help-panel]'),open=document.querySelector('[data-main-menu-help-open]');if(!overlay||!sidebar||!open||overlay.dataset.ready==='true')return;overlay.dataset.ready='true';
    const host=overlay.querySelector('[data-main-menu-help-callouts]');
    const items=[
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(1)',title:'Visão geral',text:'Acompanhe os principais dados e atalhos do sistema.'},
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(2)',title:'TVs',text:'Cadastre TVs, publique playlists e controle a reprodução.'},
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(3)',title:'Aponti Studio',text:'Crie e edite os conteúdos que serão exibidos.'},
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(4)',title:'Biblioteca',text:'Organize imagens e vídeos disponíveis para publicação.'},
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(5)',title:'Exportar M3U',text:'Baixe a lista de transmissões no formato M3U.'},
      {selector:'.app-sidebar__nav:first-of-type .app-sidebar__link:nth-child(6)',title:'Configuração',text:'Ajuste transmissão, widgets e preferências do sistema.'},
      {selector:'.app-sidebar__nav--management .app-sidebar__link:nth-child(1)',title:'Usuários',text:'Cadastre pessoas e controle as permissões de acesso.'},
      {selector:'.app-sidebar__nav--management .app-sidebar__link:nth-child(2)',title:'Logs de acesso',text:'Consulte o histórico de entradas e atividades.'},
      {selector:'.app-sidebar__nav--management .app-sidebar__link:nth-child(3)',title:'Backups',text:'Acesse as opções de segurança e recuperação.'},
      {selector:'.app-sidebar__nav--management .app-sidebar__link:nth-child(4)',title:'Agentes Windows',text:'Gerencie computadores e papéis de parede.'},
      {selector:'.app-sidebar__profile',title:'Perfil e aparência',text:'Altere o tema, a senha da conta ou encerre a sessão.'}
    ];
    function position(){if(overlay.hidden)return;const s=sidebar.getBoundingClientRect();const left=Math.min(innerWidth-385,s.right+22);host.replaceChildren();items.forEach((item,index)=>{const target=document.querySelector(item.selector);if(!target)return;const r=target.getBoundingClientRect(),node=document.createElement('article');node.className='main-menu-help__callout';node.innerHTML=`<b>${index+1}</b><div><strong>${item.title}</strong><p>${item.text}</p></div>`;host.appendChild(node);const center=r.top+r.height/2,maxTop=innerHeight-node.offsetHeight-8,top=Math.max(8,Math.min(center-node.offsetHeight/2,maxTop)),arrow=Math.max(9,Math.min(center-top-6,node.offsetHeight-18));node.style.left=`${Math.max(86,left)}px`;node.style.top=`${top}px`;node.style.setProperty('--main-menu-arrow-y',`${arrow}px`)})}
    function show(){overlay.dataset.restoreCompact=String(document.documentElement.classList.contains('app-sidebar-compact'));overlay.hidden=false;document.body.classList.add('main-menu-help-open');document.documentElement.classList.remove('app-sidebar-compact');open.setAttribute('aria-expanded','true');requestAnimationFrame(()=>requestAnimationFrame(position))}function close(){overlay.hidden=true;document.body.classList.remove('main-menu-help-open');if(overlay.dataset.restoreCompact==='true')document.documentElement.classList.add('app-sidebar-compact');open.setAttribute('aria-expanded','false')}
    open.addEventListener('click',()=>overlay.hidden?show():close());overlay.querySelectorAll('[data-main-menu-help-close]').forEach(e=>e.addEventListener('click',close));window.addEventListener('resize',position);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!overlay.hidden)close()});if(new URLSearchParams(location.search).get('help')==='main_menu')show();
  }
  document.addEventListener('DOMContentLoaded',setupMainMenuHelp);document.addEventListener('turbo:load',setupMainMenuHelp);if(document.readyState!=='loading')setupMainMenuHelp();
</script>
