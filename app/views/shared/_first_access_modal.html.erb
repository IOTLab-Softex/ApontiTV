<div class="first-access-modal" data-first-access-modal data-complete-url="<%= onboarding_complete_path %>">
  <div class="first-access-modal__backdrop" aria-hidden="true"></div>
  <section class="first-access-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="first-access-title" aria-describedby="first-access-description">
    <header class="first-access-modal__header">
      <div class="first-access-modal__brand" aria-hidden="true"><span class="material-symbols-rounded">tv</span></div>
      <div>
        <span class="first-access-modal__version">NOVA VERSÃO 1.3</span>
        <h2 id="first-access-title">Um Aponti TV mais simples e conectado</h2>
        <p id="first-access-description">Conheça as cinco principais novidades disponíveis para você.</p>
      </div>
    </header>

    <div class="first-access-modal__features">
      <article class="first-access-feature">
        <span class="first-access-feature__icon is-purple material-symbols-rounded" aria-hidden="true">video_library</span>
        <div><strong>Playlists mais simples de organizar</strong><p>Escolha mídias, altere a ordem de reprodução e configure transições em um editor mais claro e rápido.</p></div>
      </article>
      <article class="first-access-feature">
        <span class="first-access-feature__icon is-green material-symbols-rounded" aria-hidden="true">help</span>
        <div><strong>Ajuda dentro de cada tela</strong><p>Use os ícones de ajuda para entender os recursos e receber orientações sem sair da página.</p></div>
      </article>
      <article class="first-access-feature">
        <span class="first-access-feature__icon is-blue material-symbols-rounded" aria-hidden="true">dashboard</span>
        <div><strong>Nova administração das TVs</strong><p>Tabela e cards responsivos, status mais claros e ações rápidas com o visual Material 3.</p></div>
      </article>
      <article class="first-access-feature">
        <span class="first-access-feature__icon is-amber material-symbols-rounded" aria-hidden="true">partly_cloudy_day</span>
        <div><strong>Previsão dos próximos dias</strong><p>Ative os cards do clima, escolha o tempo de exibição e personalize o recurso para cada TV.</p></div>
      </article>
      <article class="first-access-feature is-wide">
        <span class="first-access-feature__icon is-rose material-symbols-rounded" aria-hidden="true">system_update</span>
        <div><strong>Atualizações centralizadas</strong><p>Confira a versão instalada e disponibilize novas versões do aplicativo diretamente pelo sistema.</p></div>
      </article>
    </div>

    <footer class="first-access-modal__footer">
      <div class="first-access-modal__hint"><span class="material-symbols-rounded" aria-hidden="true">help</span><span>Os ícones de ajuda continuam disponíveis em cada tela.</span></div>
      <button type="button" class="first-access-modal__start" data-first-access-complete><span>Começar a usar</span><span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></button>
    </footer>
  </section>
</div>

<style>
.first-access-modal{position:fixed;z-index:20000;inset:0;display:grid;place-items:center;padding:24px;color:#1d1b20}.first-access-modal__backdrop{position:absolute;inset:0;background:rgba(29,27,32,.62);backdrop-filter:blur(12px)}.first-access-modal__dialog{position:relative;width:min(920px,calc(100vw - 48px));max-height:calc(100vh - 48px);overflow:auto;border:1px solid #cac4d0;border-radius:28px;background:#fffbfe;box-shadow:0 24px 70px rgba(29,27,32,.28);animation:first-access-enter .28s cubic-bezier(.2,0,0,1)}
.first-access-modal__header{display:flex;align-items:center;gap:20px;padding:28px 30px 22px;border-bottom:1px solid rgba(121,116,126,.2);background:linear-gradient(110deg,#f7f2fa,#fffbfe 58%,#f3edff)}.first-access-modal__brand{display:grid;place-items:center;flex:0 0 68px;width:68px;height:68px;border-radius:22px;color:#eaddff;background:#4f378b}.first-access-modal__brand span{font-size:34px;font-variation-settings:"FILL" 1}.first-access-modal__version{display:block;margin-bottom:6px;color:#6750a4;font-size:11px;font-weight:800;letter-spacing:.12em}.first-access-modal h2{margin:0;color:#1d1b20;font-size:clamp(25px,3vw,36px);line-height:1.16}.first-access-modal__header p{margin:8px 0 0;color:#625b71;font-size:14px}
.first-access-modal__features{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:22px 30px 24px}.first-access-feature{display:grid;grid-template-columns:52px minmax(0,1fr);align-items:start;gap:14px;min-height:112px;padding:17px;border:1px solid rgba(121,116,126,.22);border-radius:20px;background:#f7f2fa;transition:.18s}.first-access-feature:hover{background:#f3edff;transform:translateY(-1px)}.first-access-feature.is-wide{grid-column:1/-1;min-height:96px}.first-access-feature__icon{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;font-size:25px;font-variation-settings:"FILL" 1}.first-access-feature__icon.is-purple{color:#4f378b;background:#eaddff}.first-access-feature__icon.is-green{color:#005234;background:#c8f5df}.first-access-feature__icon.is-blue{color:#004a77;background:#c9e6ff}.first-access-feature__icon.is-amber{color:#5b4300;background:#f8e6ad}.first-access-feature__icon.is-rose{color:#7d294d;background:#ffd8e7}.first-access-feature strong{display:block;margin-top:2px;color:#1d1b20;font-size:14px;line-height:1.3}.first-access-feature p{margin:7px 0 0;color:#625b71;font-size:12px;line-height:1.45}
.first-access-modal__footer{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:82px;padding:16px 30px;border-top:1px solid rgba(121,116,126,.2);background:#f7f2fa}.first-access-modal__hint{display:flex;align-items:center;gap:9px;color:#625b71;font-size:12px}.first-access-modal__hint .material-symbols-rounded{color:#6750a4;font-size:20px}.first-access-modal__start{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:48px;padding:0 22px;border:0;border-radius:16px;color:#fff;background:#6750a4;box-shadow:0 3px 8px rgba(103,80,164,.22);font:inherit;font-size:14px;font-weight:700;cursor:pointer}.first-access-modal__start:hover{background:#5b4297}.first-access-modal__start:focus-visible{outline:3px solid #d0bcff;outline-offset:3px}.first-access-modal.is-closing{opacity:0;pointer-events:none;transition:.18s}body.first-access-modal-open{overflow:hidden}
html[data-theme="dark"] .first-access-modal{color:#e6e1e5}html[data-theme="dark"] .first-access-modal__dialog{border-color:#49454f;background:#211f26;box-shadow:0 24px 80px rgba(0,0,0,.62)}html[data-theme="dark"] .first-access-modal__header{border-color:#49454f;background:linear-gradient(110deg,#2b2930,#211f26 58%,#292334)}html[data-theme="dark"] .first-access-modal__version{color:#d0bcff}html[data-theme="dark"] .first-access-modal h2,html[data-theme="dark"] .first-access-feature strong{color:#e6e1e5}html[data-theme="dark"] .first-access-modal__header p,html[data-theme="dark"] .first-access-feature p,html[data-theme="dark"] .first-access-modal__hint{color:#cac4d0}html[data-theme="dark"] .first-access-feature{border-color:#49454f;background:#2b2930}html[data-theme="dark"] .first-access-feature:hover{background:#332f3b}html[data-theme="dark"] .first-access-modal__footer{border-color:#49454f;background:#1d1b20}

/* A apresentação permanece escura e usa uma lista simples de novidades. */
.first-access-modal{color:#e6e1e5}.first-access-modal__backdrop{background:rgba(8,7,10,.78)}.first-access-modal__dialog{width:min(760px,calc(100vw - 48px));border-color:#49454f;background:#211f26;box-shadow:0 24px 80px rgba(0,0,0,.62)}.first-access-modal__header{border-color:rgba(202,196,208,.14);background:linear-gradient(110deg,#2b2930,#211f26 58%,#292334)}.first-access-modal__version{color:#d0bcff}.first-access-modal h2,.first-access-feature strong{color:#e6e1e5}.first-access-modal__header p,.first-access-feature p,.first-access-modal__hint{color:#cac4d0}
.first-access-modal__features{display:flex;flex-direction:column;gap:18px;padding:22px 30px 26px}.first-access-feature,.first-access-feature.is-wide{display:grid;grid-template-columns:48px minmax(0,1fr);align-items:center;gap:15px;min-height:0;padding:0;border:0;border-radius:0;background:transparent;transform:none}.first-access-feature:hover{background:transparent;transform:none}.first-access-feature__icon{width:48px;height:48px;border-radius:50%;font-size:23px}.first-access-feature strong{margin:0;font-size:14px}.first-access-feature p{margin:4px 0 0;font-size:12px;line-height:1.42}.first-access-modal__footer{border-color:rgba(202,196,208,.14);background:#1d1b20}
@keyframes first-access-enter{from{opacity:0;transform:translateY(14px) scale(.98)}}@media(max-width:700px){.first-access-modal{padding:10px}.first-access-modal__dialog{width:100%;max-height:calc(100vh - 20px);border-radius:24px}.first-access-modal__header{align-items:flex-start;padding:22px 18px 18px}.first-access-modal__brand{width:54px;height:54px;flex-basis:54px;border-radius:18px}.first-access-modal h2{font-size:23px}.first-access-modal__features{gap:16px;padding:20px 18px 24px}.first-access-feature,.first-access-feature.is-wide{grid-column:auto;min-height:0;padding:0}.first-access-modal__footer{position:sticky;bottom:0;flex-direction:column;align-items:stretch;gap:12px;padding:14px 16px}.first-access-modal__hint{justify-content:center;text-align:center}.first-access-modal__start{width:100%}}
</style>

<script>
function setupFirstAccessModal(){const modal=document.querySelector('[data-first-access-modal]');if(!modal||modal.dataset.ready==='true')return;modal.dataset.ready='true';document.body.classList.add('first-access-modal-open');const button=modal.querySelector('[data-first-access-complete]');function done(){button.disabled=true;modal.classList.add('is-closing');document.body.classList.remove('first-access-modal-open');fetch(modal.dataset.completeUrl,{method:'POST',credentials:'same-origin',headers:{'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]')?.content||''}}).catch(()=>{}).finally(()=>setTimeout(()=>modal.remove(),190))}button.addEventListener('click',done);requestAnimationFrame(()=>button.focus())}document.addEventListener('DOMContentLoaded',setupFirstAccessModal);document.addEventListener('turbo:load',setupFirstAccessModal);if(document.readyState!=='loading')setupFirstAccessModal();
</script>
