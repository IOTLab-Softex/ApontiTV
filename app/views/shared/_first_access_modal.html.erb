<div class="first-access-modal" data-first-access-modal data-complete-url="<%= onboarding_complete_path %>" data-step="1">
  <div class="first-access-modal__backdrop" aria-hidden="true"><svg width="100%" height="100%"><defs><filter id="first-access-soft-edge"><feGaussianBlur stdDeviation="7"/></filter><mask id="first-access-mask"><rect width="100%" height="100%" fill="white"/><rect data-first-access-help-hole fill="black" filter="url(#first-access-soft-edge)"/><rect data-first-access-tool-hole fill="black" filter="url(#first-access-soft-edge)"/></mask></defs><rect width="100%" height="100%" fill="rgba(2,6,23,.9)" mask="url(#first-access-mask)"/></svg></div>
  <div class="first-access-modal__pointer" data-first-access-help-pointer hidden><strong>A Ajuda geral fica aqui</strong><i class="fas fa-long-arrow-alt-right"></i></div><span class="first-access-modal__target" data-first-access-help-target hidden></span>
  <div class="first-access-modal__pointer" data-first-access-tool-pointer hidden><strong>Cada ferramenta tem sua própria ajuda</strong><i class="fas fa-long-arrow-alt-right"></i></div><span class="first-access-modal__target is-tool" data-first-access-tool-target hidden></span>

  <section class="first-access-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="first-access-title">
    <div class="first-access-modal__steps" aria-label="Etapa da apresentação"><span data-step-dot="1"></span><span data-step-dot="2"></span><span data-step-dot="3"></span></div>
    <div class="first-access-modal__page" data-first-access-page="1">
      <span class="first-access-modal__eyebrow">BEM-VINDO</span><h2 id="first-access-title">O Aponti TV está cada vez mais fácil de usar</h2>
      <p>Conheça o novo mecanismo de ajuda, criado para orientar você dentro do sistema no momento em que a dúvida aparecer.</p>
      <div class="first-access-modal__brand"><i class="fas fa-tv"></i></div><h3>Aponti TV</h3><small class="first-access-modal__slogan">CONTROLE. CONTEÚDO. CONEXÃO.</small>
      <div class="first-access-modal__cards">
        <article><i class="far fa-circle-question"></i><div><strong>Ajuda por ferramenta</strong><p>Explicações rápidas junto de cada recurso.</p></div></article>
        <article><i class="fas fa-mouse-pointer"></i><div><strong>Tutoriais visuais</strong><p>Destaques e balões mostram onde clicar.</p></div></article>
        <article><i class="fas fa-life-ring"></i><div><strong>Ajuda geral</strong><p>Todos os guias reunidos em um só lugar.</p></div></article>
      </div>
    </div>
    <div class="first-access-modal__page" data-first-access-page="2" hidden>
      <span class="first-access-modal__eyebrow">ETAPA 2 DE 3</span><div class="first-access-modal__page-icon"><i class="fas fa-life-ring"></i></div><h2>Quando precisar, abra a Ajuda geral</h2>
      <p>O botão <strong>Ajuda</strong>, no topo da tela, reúne todos os tutoriais. Volte a qualquer orientação sempre que quiser, sem interromper o seu trabalho.</p>
      <div class="first-access-modal__tip"><i class="fas fa-lightbulb"></i><span>Use a Ajuda geral para conhecer uma tela inteira, revisar funções ou descobrir recursos novos.</span></div>
    </div>
    <div class="first-access-modal__page" data-first-access-page="3" hidden>
      <span class="first-access-modal__eyebrow">ETAPA 3 DE 3</span><div class="first-access-modal__page-icon"><i class="far fa-circle-question"></i></div><h2>Ajuda exatamente onde você precisa</h2>
      <p>Cada ferramenta possui seu próprio ícone de ajuda. Passe o mouse para iluminar o painel e clique para abrir um tutorial visual com balões sobre cada controle.</p>
      <div class="first-access-modal__tip"><i class="fas fa-magic"></i><span>Aprenda enquanto usa: sem sair da tela, sem procurar manuais e sem perder o contexto da tarefa.</span></div>
    </div>
    <footer class="first-access-modal__footer"><button type="button" class="is-back" data-first-access-back hidden><i class="fas fa-arrow-left"></i> Voltar</button><small>Esta apresentação será exibida apenas neste primeiro acesso.</small><button type="button" class="is-next" data-first-access-next>Continuar <i class="fas fa-arrow-right"></i></button></footer>
  </section>
</div>

<style>
.first-access-modal{position:fixed;z-index:20000;inset:0;display:grid;place-items:center;padding:24px;color:#f8fafc}.first-access-modal__backdrop{position:absolute;inset:0}.first-access-modal__backdrop svg{width:100%;height:100%}.first-access-modal__dialog{position:relative;width:min(900px,calc(100vw - 48px));overflow:hidden;border:1px solid rgba(167,139,250,.42);border-radius:25px;background:radial-gradient(circle at 50% 35%,rgba(109,40,217,.22),transparent 32%),linear-gradient(145deg,#10152d,#050a1d);box-shadow:0 35px 100px #000c,0 0 60px rgba(109,40,217,.18);animation:first-access-enter .4s ease}.first-access-modal__steps{position:absolute;z-index:2;top:21px;left:50%;display:flex;gap:8px;transform:translateX(-50%)}.first-access-modal__steps span{width:8px;height:8px;border-radius:20px;background:#334155;transition:.25s}.first-access-modal__steps .is-active{width:28px;background:#a855f7;box-shadow:0 0 14px #a855f7}.first-access-modal__page{min-height:490px;padding:58px 52px 28px;text-align:center;animation:first-access-page .3s ease}.first-access-modal__eyebrow{display:block;margin-bottom:12px;color:#c4b5fd;font-size:12px;font-weight:900;letter-spacing:.22em}.first-access-modal h2{max-width:760px;margin:0 auto;font-size:clamp(29px,3vw,43px);line-height:1.12}.first-access-modal__page>p{max-width:690px;margin:18px auto 0;color:#b8c2d9;font-size:17px;line-height:1.55}.first-access-modal__brand,.first-access-modal__page-icon{display:grid;place-items:center;margin:27px auto 13px;border:1px solid #d8b4fe73;border-radius:30px;background:linear-gradient(145deg,#b454ff,#6d28d9);box-shadow:0 20px 50px #6d28d96b;color:white}.first-access-modal__brand{width:112px;height:112px;font-size:45px}.first-access-modal__page-icon{width:105px;height:105px;margin-top:55px;font-size:42px}.first-access-modal h3{margin:0;font-size:32px}.first-access-modal__slogan{display:block;margin-top:8px;color:#b99af7;font-weight:800;letter-spacing:.2em}.first-access-modal__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:27px;text-align:left}.first-access-modal__cards article{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:center;padding:16px;border:1px solid #a78bfa33;border-radius:15px;background:#141c39b8}.first-access-modal__cards article>i{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;background:#6d28d961;color:#e9d5ff;font-size:18px}.first-access-modal__cards strong{font-size:13px}.first-access-modal__cards p{margin:5px 0 0;color:#9eabc4;font-size:11px;line-height:1.45}.first-access-modal__tip{max-width:650px;display:flex;align-items:center;gap:15px;margin:30px auto 0;padding:18px 20px;border:1px solid #a78bfa40;border-radius:15px;background:#1e29469e;color:#cbd5e1;text-align:left;font-size:13px;line-height:1.5}.first-access-modal__tip i{color:#c084fc;font-size:22px}.first-access-modal__footer{min-height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:15px;padding:15px 28px;border-top:1px solid #a78bfa29;background:#0206176b}.first-access-modal__footer small{color:#8491aa;font-size:11px;text-align:center}.first-access-modal__footer button{min-height:44px;display:flex;align-items:center;gap:9px;padding:10px 20px;border-radius:12px;font-weight:800;cursor:pointer}.first-access-modal__footer .is-next{justify-self:end;border:0;background:linear-gradient(145deg,#7c3aed,#a855f7);color:white}.first-access-modal__footer .is-back{justify-self:start;border:1px solid #a78bfa47;background:transparent;color:#cbd5e1}.first-access-modal__pointer{position:fixed;z-index:20003;display:flex;align-items:center;gap:10px;pointer-events:none}.first-access-modal__pointer strong{padding:9px 12px;border:1px solid #d8b4feb3;border-radius:10px;background:#34136a;box-shadow:0 0 20px #a855f77a;font-size:12px}.first-access-modal__pointer i{color:#d8b4fe;font-size:25px}.first-access-modal__pointer:not(.is-left){flex-direction:row-reverse}.first-access-modal__pointer:not(.is-left) i{transform:rotate(180deg)}.first-access-modal__target{position:fixed;z-index:20002;border:2px solid #c084fc;border-radius:12px;box-shadow:0 0 0 5px #a855f733,0 0 28px #c084fce6;pointer-events:none}.first-access-modal__target.is-tool{border-radius:50%}.first-access-modal [hidden]{display:none!important}.first-access-modal.is-closing{opacity:0;pointer-events:none;transition:.2s}body.first-access-modal-open{overflow:hidden}@keyframes first-access-enter{from{opacity:0;transform:translateY(18px) scale(.97)}}@keyframes first-access-page{from{opacity:0;transform:translateX(12px)}}
@media(max-width:700px){.first-access-modal{padding:10px}.first-access-modal__dialog{width:100%;max-height:calc(100vh - 20px);overflow:auto}.first-access-modal__page{min-height:0;padding:55px 20px 24px}.first-access-modal h2{font-size:27px}.first-access-modal__page>p{font-size:14px}.first-access-modal__brand{width:82px;height:82px;font-size:33px}.first-access-modal__cards{grid-template-columns:1fr}.first-access-modal__cards article{padding:10px}.first-access-modal__footer{position:sticky;bottom:0;grid-template-columns:auto 1fr auto;padding:12px}.first-access-modal__footer small,.first-access-modal__pointer strong{display:none}}
</style>

<script>
function setupFirstAccessModal(){const m=document.querySelector('[data-first-access-modal]');if(!m||m.dataset.ready==='true')return;m.dataset.ready='true';document.body.classList.add('first-access-modal-open');const pages=[...m.querySelectorAll('[data-first-access-page]')],dots=[...m.querySelectorAll('[data-step-dot]')],next=m.querySelector('[data-first-access-next]'),back=m.querySelector('[data-first-access-back]'),help=document.querySelector('[data-general-help-button]'),tool=document.querySelector('.broadcast-card-modern__help i'),hp=m.querySelector('[data-first-access-help-pointer]'),ht=m.querySelector('[data-first-access-help-target]'),hh=m.querySelector('[data-first-access-help-hole]'),tp=m.querySelector('[data-first-access-tool-pointer]'),tt=m.querySelector('[data-first-access-tool-target]'),th=m.querySelector('[data-first-access-tool-hole]');let step=1;
function clear(h){['x','y','width','height'].forEach(a=>h?.setAttribute(a,'0'))}function pos(el,p,t,h,round){if(!el||!p||!t||!h)return;const r=el.getBoundingClientRect(),q=p.getBoundingClientRect(),pad=round?14:12;h.setAttribute('x',r.left-pad);h.setAttribute('y',r.top-pad);h.setAttribute('width',r.width+pad*2);h.setAttribute('height',r.height+pad*2);h.setAttribute('rx',round?18:16);Object.assign(t.style,{left:`${r.left-6}px`,top:`${r.top-6}px`,width:`${r.width+12}px`,height:`${r.height+12}px`});const left=r.left>innerWidth/2;p.style.left=left?`${Math.max(8,r.left-q.width-20)}px`:`${Math.min(innerWidth-q.width-8,r.right+20)}px`;p.style.top=`${Math.max(8,Math.min(r.top+r.height/2-q.height/2,innerHeight-q.height-8))}px`;p.classList.toggle('is-left',left)}
function render(){pages.forEach((p,i)=>p.hidden=i+1!==step);dots.forEach((d,i)=>d.classList.toggle('is-active',i+1===step));back.hidden=step===1;next.innerHTML=step===3?'Começar a usar <i class="fas fa-check"></i>':'Continuar <i class="fas fa-arrow-right"></i>';[hp,ht,tp,tt].forEach(e=>{if(e)e.hidden=true});clear(hh);clear(th);if(step===2&&help){hp.hidden=ht.hidden=false;requestAnimationFrame(()=>pos(help,hp,ht,hh,false))}if(step===3&&tool){tp.hidden=tt.hidden=false;requestAnimationFrame(()=>pos(tool,tp,tt,th,true))}requestAnimationFrame(()=>next.focus())}
function done(){m.classList.add('is-closing');document.body.classList.remove('first-access-modal-open');fetch(m.dataset.completeUrl,{method:'POST',credentials:'same-origin',headers:{'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]')?.content||''}}).catch(()=>{}).finally(()=>setTimeout(()=>m.remove(),210))}next.addEventListener('click',()=>{if(step<3){step++;render()}else done()});back.addEventListener('click',()=>{if(step>1){step--;render()}});window.addEventListener('resize',render);render()}
document.addEventListener('DOMContentLoaded',setupFirstAccessModal);document.addEventListener('turbo:load',setupFirstAccessModal);if(document.readyState!=='loading')setupFirstAccessModal();
</script>
