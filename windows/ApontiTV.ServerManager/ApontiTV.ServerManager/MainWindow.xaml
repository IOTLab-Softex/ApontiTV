<Window x:Class="ApontiTV.ServerManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Aponti TV • Servidor" Icon="Assets/aponti-tv.ico" Width="960" Height="680" MinWidth="790" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F3F6FF" FontFamily="Segoe UI">
  <Window.Resources><Style TargetType="Button"><Setter Property="Foreground" Value="#F3F6FF"/><Setter Property="Background" Value="#202A42"/><Setter Property="BorderBrush" Value="#34415F"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,9,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#141C30"/><Setter Property="BorderBrush" Value="#283550"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style></Window.Resources>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,22"><Border Width="54" Height="54" CornerRadius="15" Background="#6D5DFB" Margin="0,0,15,0"><TextBlock Text="▶" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Aponti TV" FontSize="26" FontWeight="Bold"/><TextBlock Text="Controle e diagnóstico do servidor" Foreground="#9EABC6" FontSize="13"/></StackPanel><TextBlock x:Name="ClockText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9EABC6"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="RAILS" Foreground="#8997B5" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,5"><Ellipse x:Name="RailsDot" Width="11" Height="11" Fill="#64748B" Margin="0,0,9,0"/><TextBlock x:Name="RailsStatus" Text="Verificando..." FontSize="17" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="RailsDetail" Foreground="#8997B5" FontSize="12"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Text="NGINX" Foreground="#8997B5" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,5"><Ellipse x:Name="NginxDot" Width="11" Height="11" Fill="#64748B" Margin="0,0,9,0"/><TextBlock x:Name="NginxStatus" Text="Verificando..." FontSize="17" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="NginxDetail" Foreground="#8997B5" FontSize="12"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Text="INICIALIZAÇÃO" Foreground="#8997B5" FontSize="11" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,5"><Ellipse x:Name="AutoDot" Width="11" Height="11" Fill="#64748B" Margin="0,0,9,0"/><TextBlock x:Name="AutoStatus" Text="Verificando..." FontSize="17" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Iniciar junto com o Windows" Foreground="#8997B5" FontSize="12"/></StackPanel></Border>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,0,0,11"><Button x:Name="StartButton" Content="▶  Iniciar" Background="#315C46" Click="Start_Click"/><Button x:Name="StopButton" Content="■  Parar" Background="#63343E" Click="Stop_Click"/><Button x:Name="RestartButton" Content="↻  Reiniciar" Click="Restart_Click"/><Button Content="↗  Abrir sistema" Click="Open_Click"/><Button Content="⚙  Precompilar assets" Click="Assets_Click"/><Button x:Name="AutoButton" Content="Inicialização automática" Click="Auto_Click"/></WrapPanel>
    <Border Grid.Row="3" Background="#080D19" BorderBrush="#283550" BorderThickness="1" CornerRadius="13" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LOG DO SERVIDOR" Foreground="#8997B5" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="↻  Atualizar" Padding="11,5" Margin="0" Click="RefreshLog_Click"/></Grid><TextBox x:Name="LogBox" Grid.Row="1" Background="Transparent" Foreground="#C9D3E8" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></Border>
    <TextBlock x:Name="MessageText" Grid.Row="4" Margin="2,12,0,0" Foreground="#9EABC6" Text="Pronto."/>
  </Grid>
</Window>
