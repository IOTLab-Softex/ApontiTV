<Window x:Class="ApontiTV.ServerManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
  <Border CornerRadius="10" ClipToBounds="True" Background="#16003F">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="#05010D"/>
    </Border.Effect>
    <Image Source="Assets/aponti-tv-splash.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
  </Border>
</Window>
