#!/usr/bin/env ruby
require "fileutils"
require "openssl"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)
SSL_DIR = File.join(APP_ROOT, "config", "ssl")
KEY_PATH = File.join(SSL_DIR, "localhost-key.pem")
CERT_PATH = File.join(SSL_DIR, "localhost-cert.pem")
HOST = ENV.fetch("SSL_HOST", "127.0.0.1")
PORT = ENV.fetch("SSL_PORT", "3000")

def ensure_certificate!
  return if File.exist?(KEY_PATH) && File.exist?(CERT_PATH)

  FileUtils.mkdir_p(SSL_DIR)

  key = OpenSSL::PKey::RSA.new(2048)
  cert = OpenSSL::X509::Certificate.new
  cert.version = 2
  cert.serial = Random.rand(100_000..999_999)
  cert.subject = OpenSSL::X509::Name.parse("/C=BR/O=SoftexTV/CN=localhost")
  cert.issuer = cert.subject
  cert.public_key = key.public_key
  cert.not_before = Time.now
  cert.not_after = Time.now + (365 * 24 * 60 * 60)

  extension_factory = OpenSSL::X509::ExtensionFactory.new
  extension_factory.subject_certificate = cert
  extension_factory.issuer_certificate = cert

  cert.add_extension(extension_factory.create_extension("basicConstraints", "CA:FALSE", true))
  cert.add_extension(extension_factory.create_extension("keyUsage", "keyEncipherment,dataEncipherment,digitalSignature", true))
  cert.add_extension(extension_factory.create_extension("extendedKeyUsage", "serverAuth", false))
  cert.add_extension(extension_factory.create_extension("subjectKeyIdentifier", "hash", false))
  cert.add_extension(extension_factory.create_extension("authorityKeyIdentifier", "keyid:always,issuer:always", false))
  cert.add_extension(
    extension_factory.create_extension(
      "subjectAltName",
      "DNS:localhost,IP:127.0.0.1,IP:::1",
      false
    )
  )

  cert.sign(key, OpenSSL::Digest::SHA256.new)

  File.write(KEY_PATH, key.to_pem)
  File.write(CERT_PATH, cert.to_pem)
end

Dir.chdir(APP_ROOT) do
  ensure_certificate!

  ENV["HTTPS"] = "true"
  ENV["SSL_HOST"] = HOST
  ENV["SSL_PORT"] = PORT
  ENV["SSL_KEY_PATH"] = KEY_PATH
  ENV["SSL_CERT_PATH"] = CERT_PATH

  exec Gem.ruby, "-S", "bundle", "exec", "ruby", "bin/rails", "server"
end
