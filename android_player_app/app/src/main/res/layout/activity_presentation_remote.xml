<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aponti_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controle de apresentação"
            android:textColor="@color/aponti_text"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remoteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Carregando TVs de apresentação..."
            android:textColor="@color/aponti_text_soft"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/presentationTvSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@color/aponti_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Escolha o slide"
            android:textColor="@color/aponti_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presentationSlideStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/showSelectedSlideButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:text="EXIBIR SLIDE SELECIONADO" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousSlideButton"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:text="◀"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playPauseButton"
                android:layout_width="104dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="16dp"
                android:text="PAUSE"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextSlideButton"
                android:layout_width="72dp"
                android:layout_height="64dp"
                android:text="▶"
                android:textSize="22sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pointerModeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="ATIVAR PONTEIRO" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Mova o celular para apontar uma área da apresentação"
            android:textColor="@color/aponti_text_soft"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/shakeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@color/aponti_surface"
            android:gravity="center"
            android:padding="18dp"
            android:text="Chacoalhe para a direita para avançar ou para a esquerda para voltar"
            android:textColor="@color/aponti_text_soft"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
