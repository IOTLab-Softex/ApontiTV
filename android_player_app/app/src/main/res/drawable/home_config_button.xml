<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#7A5B22D8" />
            <stroke
                android:width="2dp"
                android:color="#E8C7B2FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#8B6B2EEB" />
            <stroke
                android:width="2dp"
                android:color="#F2D9C7FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#4A351077" />
            <stroke
                android:width="1dp"
                android:color="#B1795CFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
