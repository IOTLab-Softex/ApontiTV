<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#111A2B"
                android:startColor="#09111F" />
        </shape>
    </item>

    <item
        android:gravity="center"
        android:bottom="16dp"
        android:top="16dp"
        android:left="24dp"
        android:right="24dp">
        <bitmap
            android:src="@drawable/logo_aponti_marca"
            android:gravity="center" />
    </item>
</layer-list>
